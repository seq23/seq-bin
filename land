#!/bin/bash
# land — merge a PR and put it in production, as ONE action.
#
# WHY THIS EXISTS. On 18 Sep 2026 four PRs were merged and nothing was deployed.
# She opened the app to look at a redesign that had landed on `main` an hour
# earlier and saw the old page. Her words: "i dont see a home page redesign" and
# then "how can we fucking fix this so that you merge and deploy at the same
# time". The failure was never permission — merging unprompted was already the
# standing rule. The failure was that merge and deploy were two steps, and the
# second one waited on somebody remembering it.
#
# A rule in CLAUDE.md telling the next agent to remember would be a wish. This is
# the rule as code: you cannot run the merge half without the deploy half.
#
#   land            # the PR for the current branch
#   land 96         # that PR number
#   land --promote [<repo>] [--run-e2e]   # ship the newest e2e-green main commit to production
#
# It refuses rather than guesses: not green, head moved, main red -> it stops and
# says which, and it does NOT deploy. A red main after a merge is the case this
# repo has actually hit (PR #16 in boss-os passed on its head and the merge
# commit went red, already deployed by then), so main is watched to a terminal
# state every single time, not sampled once.
#
# BUILD FIRST, TEST IN BATCHES (26 Sep 2026). A repo whose route names a full e2e workflow
# (E2E_WF) no longer runs that suite per merge: the merge gate is the fast check, and the browser
# suites run nightly + on dispatch. So for those repos `land <pr>` is: fast check green -> merge ->
# main's FAST run green -> deploy STAGING from the merge sha -> production ONLY if a completed run
# of the e2e workflow on that exact sha concluded success; otherwise it prints WAITING and exits 0.
# `land --promote <repo>` then ships the newest main commit whose e2e run passed and that is newer
# than what production runs. Production's record is the GitHub Deployments API (environment
# "production", one deployment per land, `gh api repos/../deployments`), written by this script on
# every production deploy of an e2e-routed repo and read back by --promote; nothing is written to
# the git graph. Both deploys run from a clean detached worktree at exactly that sha, never the
# working tree. `--run-e2e` makes --promote dispatch the e2e workflow on main's head and wait for it
# (ceiling 1.5x the last completed run) when no green run is newer than production.
# Repos with no E2E_WF on their route are unchanged: merge -> production, as before.
set -uo pipefail

# RUN FROM A COPY. bash reads a script incrementally, so editing this file while a `land` is in
# flight corrupts that run: on 21 Sep 2026 an edit landed mid-run and a live `land 152` died with
# "syntax error near unexpected token `else'" at a line it had not reached when it started. The
# first thing this script does is copy itself somewhere immutable and re-exec from there.
if [ -z "${LAND_RUNNING_FROM_COPY:-}" ]; then
  _copy="$(mktemp -t land.XXXXXX)" || exit 1
  cat "$0" > "$_copy" && chmod +x "$_copy"
  LAND_RUNNING_FROM_COPY=1 exec bash "$_copy" "$@"
fi

say() { printf '\n\033[1m%s\033[0m\n' "$*"; }
die() { printf '\n\033[31mSTOPPED: %s\033[0m\n' "$*"; exit 1; }

MODE="land"; PR=""; TARGET=""; RUN_E2E=""
for a in "$@"; do
  case "$a" in
    --promote) MODE="promote" ;;
    --run-e2e) RUN_E2E=1 ;;
    -h|--help) sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --*) die "unknown flag $a (land [<pr>] | land --promote [<repo>] [--run-e2e])" ;;
    *) if [ "$MODE" = promote ]; then TARGET="$a"; else PR="$a"; fi ;;
  esac
done
[ -z "$RUN_E2E" ] || [ "$MODE" = promote ] || die "--run-e2e only means something with --promote"
if [ -n "$TARGET" ]; then
  case "$TARGET" in */*|.*) : ;; *) [ -d "$TARGET" ] || TARGET="$HOME/GitHub/$TARGET" ;; esac
  [ -d "$TARGET" ] || die "no such repo directory: $TARGET"
  cd "$TARGET" || die "cannot enter $TARGET"
fi
REPO_DIR="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "not in a git repo"; exit 1; }
cd "$REPO_DIR" || exit 1
# A worktree is named after its branch dir, not the repo. Ask git for the
# repo's own name (the common dir) so `land` from a worktree routes correctly.
NAME="$(basename "$(git rev-parse --path-format=absolute --git-common-dir | sed 's#/\.git$##')")"

# The 7403 trap. `npm run deploy:production` in west-peek-os does NOT default the
# account id the way boss-os's script does, so in any shell that lacks it — a
# background job, a fresh login, a launchd context — the very first step fails
# with "The given account is not valid or is not authorized to access this
# service [code: 7403]". That reads like a revoked token and is not one. It cost
# a deploy on 18 Sep 2026: main was green, the merge was done, and production
# silently stayed on the old build. Set it here so no caller has to know.
export CLOUDFLARE_ACCOUNT_ID="${CLOUDFLARE_ACCOUNT_ID:-8d147e242033699dd37c6f5a451f48d2}"

# How this repo reaches production. westpeek-live deploys itself through Workers
# Builds on merge; the two Worker repos deploy only when a person runs the script.
# Every West Peek web property the "web property change" lane can target MUST have a row here —
# tests/test-land-routes.sh evals this block verbatim and fails if one is missing.
# A row may also set: STAGING (a staging deploy command, run from the merge sha right after
# main's fast check is green), E2E_WF (the name of the full post-merge browser workflow; set,
# production waits for a green run of it on the exact sha — see the header), and SMOKE (a URL
# that must answer 200 with "ok":true after a production deploy).
# --- routes begin (tests/test-land-routes.sh evals this block verbatim) ---
STAGING=""; E2E_WF=""; SMOKE=""
case "$NAME" in
  west-peek-os)         DEPLOY="npm run deploy:production" ; SELF="" ;;
  # 26 Sep 2026 (build first, test in batches): the 217 Playwright journeys left ci.yml for
  # `e2e.yml` (nightly 07:00 UTC + workflow_dispatch), so a merge waits only on the fast CI run and
  # production moves only to a sha the journeys passed — deploy.yml fires on e2e's success and
  # records the GitHub Deployment; `land <pr>` prints WAITING; `land --promote boss-os [--run-e2e]`
  # ships the newest e2e-green commit from here. No staging target in this repo.
  boss-os)              DEPLOY="npm run deploy:production" ; SELF="" ; E2E_WF="e2e" ;;
  westpeek-live)        DEPLOY="" ; SELF="deploys itself through Workers Builds" ;;
  # The loop repos run in GitHub Actions straight from main: the merge IS the
  # deploy. Every scheduled lane checks out main at fire time.
  how-we-know)          DEPLOY="" ; SELF="runs its lanes from main in GitHub Actions" ;;
  # Cloudflare Pages deploys every push to main; Deploy Distribution (IndexNow/GSC) fires on green.
  sprylabs-hpc-site)    DEPLOY="" ; SELF="deploys itself through Cloudflare Pages on push to main" ;;
  # Same shape as the hpc site (wrangler.toml pages_build_output_dir = dist); Deploy Distribution
  # (IndexNow/GSC) fires on a completed green Validate Repo. Added 21 Sep 2026 with PR #140.
  # One build feeds six Cloudflare Pages projects (Git integration: check-runs "Cloudflare Pages:
  # local-guides-generator-{trt,pi,dentistry,neuro,uscis-medical}" and the base project on the main
  # commit), serving hormonesivhair.com, theaccidentguides.com, dentistryguides.com,
  # neuroevalguides.com and uscisexam.com. Deploy Distribution (IndexNow/GSC) runs on push to main.
  # Added 25 Sep 2026 when the Bing Webmaster fix PR #48 had no route to land on.
  local-guides-generator) DEPLOY="" ; SELF="deploys itself through Cloudflare Pages on push to main (6 projects, 5 domains)" ;;
  local-guides-citation-velocity) DEPLOY="" ; SELF="deploys itself through Cloudflare Pages on push to main; Deploy Distribution fires on green Validate Repo" ;;
  # Client repo; Cloudflare Pages builds main on push, Content Publish fires on its schedule.
  # Added 23 Sep 2026 after #28 had to be merged and its deploy checked by hand.
  hicks-consulting-canonical) DEPLOY="" ; SELF="deploys itself through Cloudflare Pages on push to main" ;;
  # Three Cloudflare Pages projects (ventures, productions, community) each build from main on push.
  join-west-peek-main)  DEPLOY="" ; SELF="deploys itself through Cloudflare Pages on push to main (3 projects)" ;;
  # The state Worker (D1 durable state) redeploys on every land; the Actions lanes read main at fire time.
  creator-network)      DEPLOY="npm run deploy:state" ; SELF="" ;;
  # Sheila's creator dashboard: one Worker (app + API + crons). The script builds the client,
  # applies D1 migrations and deploys with FAKE_SERVICES=0. Added 25 Sep 2026 with the repo.
  # 26 Sep 2026: staging on every land; production waits for the `e2e` workflow (jobs e2e,
  # e2e-open, help-screenshots — nightly 08:00 UTC + workflow_dispatch) on the exact sha.
  sheila-creator-dashboard) DEPLOY="npm run deploy:production" ; SELF="" ; STAGING="npm run deploy:staging" ; E2E_WF="e2e" ; SMOKE="https://sheilastudio.seq-taylor.workers.dev/healthz" ;;
  # ~/bin (seq23/seq-bin): launchd runs the WORKING COPY, and this script has
  # already checked out main and pulled it above, so the merge IS the deploy.
  # Added 21 Sep 2026 with seq-bin #4.
  bin|seq-bin)          DEPLOY="" ; SELF="is the launchd working copy, already fast-forwarded to main above" ;;
  # West Peek web properties on Cloudflare Pages Git integration: the project builds `main` on push
  # (check-run "Cloudflare Pages" on the merge commit), so the merge IS the deploy. Read from each
  # repo's wrangler.toml (pages_build_output_dir) / Pages project source, 23 Sep 2026, so the web
  # property change lane can land them. Hosts: pitch.joinwestpeek.com + pitchlab.joinwestpeek.com,
  # network.joinwestpeek.com, venturedeals.joinwestpeek.com, dilution.joinwestpeek.com.
  west-peek-pitch-lab)  DEPLOY="" ; SELF="deploys itself through Cloudflare Pages on push to main (pitch.joinwestpeek.com)" ;;
  west-peek-network-os) DEPLOY="" ; SELF="deploys itself through Cloudflare Pages on push to main (network.joinwestpeek.com)" ;;
  # 26 Sep 2026 (build first, test in batches): Pages builds every push to main as the STAGING
  # preview (main.<project>.pages.dev) and the `production` branch as production; only the repo's
  # promote.yml moves that branch, on a green nightly e2e (secondaries 07:40 UTC, dilution 07:20).
  # The "Cloudflare Pages" check-run on the merge commit is the staging build, and that is what
  # pages_watch confirms here. Promote by hand: gh workflow run e2e.yml --ref main (in that repo).
  secondaries)          DEPLOY="" ; SELF="deploys itself through Cloudflare Pages: main -> staging preview on push; production (venturedeals.joinwestpeek.com) = the production branch, moved by promote.yml on a green nightly e2e" ;;
  founder-dilution-dashboard) DEPLOY="" ; SELF="deploys itself through Cloudflare Pages: main -> staging preview on push; production (dilution.joinwestpeek.com) = the production branch, moved by promote.yml on a green nightly e2e" ;;
  # Grid velocity/canonical sites, added 25 Sep 2026 when six green query-coverage PRs could not land.
  # Each read from the repo's wrangler config AND the check-runs GitHub records on its main commit
  # (the Cloudflare app's "Cloudflare Pages" / "Workers Builds" run links the production project),
  # cross-checked against `wrangler pages project list` (Git Provider: Yes). None has a deploy.yml.
  # wrangler.toml pages_build_output_dir = "dist"; Pages project horse-legal-guide-velocity.
  horse-legal-guide-velocity) DEPLOY="" ; SELF="deploys itself through Cloudflare Pages on push to main (horselegalguide.com)" ;;
  # No wrangler config; Pages project wpp-llm builds from Git (check-run "Cloudflare Pages" on main).
  WPP-llm|wpp-llm)      DEPLOY="" ; SELF="deploys itself through Cloudflare Pages on push to main (virtualagency-os.com)" ;;
  # wrangler.toml pages_build_output_dir = "dist"; Pages project approvalprep (also serves
  # employmentverificationletter.com and letterofexplanation.com).
  approvalprep)         DEPLOY="" ; SELF="deploys itself through Cloudflare Pages on push to main (approvalprep.com)" ;;
  # OpenNext Worker (wrangler.jsonc main = .open-next/worker.js). Workers Builds builds and deploys
  # main on push: the active deployment on 25 Sep (version 86754b7d) is the one the "Workers Builds:
  # dream-wedding-builder" check-run on main dd5050f produced. `npm run deploy` exists but is NOT
  # the route — running it too would race Workers Builds.
  dream-wedding-builder) DEPLOY="" ; SELF="deploys itself through Workers Builds on push to main" ;;
  # No wrangler config; three Pages projects build from main on push (check-runs "Cloudflare Pages:
  # founderoperatorlibrary / memphisvendorlibrary / professionalresourcelibrary" on main).
  authority-backlink-network) DEPLOY="" ; SELF="deploys itself through Cloudflare Pages on push to main (3 projects)" ;;
  # No wrangler config; Pages project p-n-p builds from Git; deploy-distribution.yml does IndexNow/GSC.
  p-n-p)                DEPLOY="" ; SELF="deploys itself through Cloudflare Pages on push to main (porchandparty901.com)" ;;
  # wrangler.toml pages_build_output_dir = "public"; Pages project justbeingmercedes (Direct Upload).
  # .github/workflows/deploy.yml runs `wrangler pages deploy` on push to main with the vault's
  # cloudflare-claude-deploy token (repo secret CLOUDFLARE_API_TOKEN); first green run 36191953200.
  # 26 Sep 2026: deploy.yml publishes the `staging` preview on every push to main and
  # justbeingmercedes.com only from a sha the nightly e2e.yml (08:20 UTC) passed (workflow_run).
  justbeingmercedes)    DEPLOY="" ; SELF="deploys itself through Cloudflare Pages (deploy.yml): main -> staging preview on push; justbeingmercedes.com only from an e2e-green sha, nightly" ;;
  *) die "$NAME has no deploy route recorded in this script. Add one before landing." ;;
esac
# --- routes end ---

# WHAT LANDS WHERE. Pure — no gh, no git — so tests/test-land-plan.sh can prove every branch.
# --- plan begin (tests/test-land-plan.sh evals this block verbatim) ---
# land_plan DEPLOY STAGING E2E_WF E2E_CONCLUSION -> the steps, space-separated, in order, out of:
#   staging     deploy staging from the merge sha
#   production  deploy production (no e2e workflow on the route, or its run on this sha succeeded)
#   waiting     production waits for a green full-e2e run on this sha (land --promote ships it)
#   self        the repo deploys itself; nothing for this script to run
# E2E_CONCLUSION is the conclusion of the newest COMPLETED run of E2E_WF on the exact sha, or ""
# when there is none (still running counts as none: a run that has not finished proves nothing).
land_plan() {
  local deploy="$1" staging="$2" e2e="$3" conc="$4" out=""
  [ -n "$staging" ] && out="staging"
  if [ -z "$deploy" ]; then printf '%s\n' "${out:+$out }self"; return 0; fi
  if [ -z "$e2e" ] || [ "$conc" = success ]; then printf '%s\n' "${out:+$out }production"; return 0; fi
  printf '%s\n' "${out:+$out }waiting"
}
# promote_pick PRODUCTION_SHA < "sha<TAB>green|other" lines, main's commits NEWEST FIRST
#   -> prints the newest green commit that is newer than production, exit 0; exit 1 if none.
# Reaching production's own sha ends the walk: everything below it is already shipped or older.
# An unrecorded production ("") means any green commit qualifies.
promote_pick() {
  local prod="$1" sha verdict
  while IFS=$'\t' read -r sha verdict; do
    [ -n "$sha" ] || continue
    [ "$sha" = "$prod" ] && return 1
    [ "$verdict" = green ] && { printf '%s\n' "$sha"; return 0; }
  done
  return 1
}
# --- plan end ---

# The newest completed run of the e2e workflow on exactly this sha, or "" (none, or none finished).
e2e_verdict() { # $1 sha
  gh run list --workflow "$E2E_WF" --branch main --limit 50 --json headSha,status,conclusion \
    -q "[.[] | select(.headSha == \"$1\" and .status == \"completed\")][0].conclusion // empty" 2>/dev/null
}
# What production runs, from the GitHub Deployments record this script writes (newest first).
production_sha() {
  gh api "repos/{owner}/{repo}/deployments?environment=production&per_page=1" --jq '.[0].sha // empty' 2>/dev/null
}
record_production() { # $1 sha  $2 note -> one GitHub deployment (environment production) + a success status
  local id
  id="$(printf '{"ref":"%s","environment":"production","auto_merge":false,"required_contexts":[],"description":"%s","production_environment":true}' "$1" "$2" \
        | gh api -X POST "repos/{owner}/{repo}/deployments" --input - --jq '.id' 2>/dev/null)"
  if [ -z "$id" ]; then
    say "     WARNING: production is live on ${1:0:7} but the GitHub deployment record could not be written; land --promote will not know. Record by hand: gh api -X POST repos/{owner}/{repo}/deployments -f ref=$1 -f environment=production"
    return 0
  fi
  printf '{"state":"success","environment":"production","description":"%s"%s}' "$2" "${SMOKE:+,\"environment_url\":\"${SMOKE%/healthz}\"}" \
    | gh api -X POST "repos/{owner}/{repo}/deployments/$id/statuses" --input - >/dev/null 2>&1 || true
  echo "     recorded: GitHub deployment $id — production = ${1:0:7}"
}
# NEVER A DIRTY TREE. Deploy from a detached worktree at exactly the sha, so what ships is what
# main's checks read — not a branch checkout, not a working tree with edits. node_modules is
# shared from this checkout when the lockfile at that sha is identical (the repo convention for
# worktrees); otherwise `npm ci` in the worktree.
deploy_at() { # $1 sha  $2 command
  local sha="$1" cmd="$2" wt rc
  wt="$(mktemp -d -t land-deploy.XXXXXX)" || return 1
  git worktree add -q --detach "$wt" "$sha" || { rm -rf "$wt"; echo "     could not check out $sha into a worktree"; return 1; }
  if [ -f "$wt/package-lock.json" ]; then
    if [ -d "$REPO_DIR/node_modules" ] && cmp -s "$wt/package-lock.json" "$REPO_DIR/package-lock.json"; then
      ln -s "$(cd "$REPO_DIR/node_modules" && pwd -P)" "$wt/node_modules"
    else
      (cd "$wt" && npm ci --no-audit --no-fund --silent) || { git worktree remove --force "$wt" >/dev/null 2>&1; return 1; }
    fi
  fi
  (cd "$wt" && echo "     in $wt @ ${sha:0:7}: $cmd" && eval "$cmd"); rc=$?
  git worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
  return $rc
}
smoke_check() { # $1 url -> 200 and "ok":true, read up to 40 s for the edge to serve the new version
  local body="" i
  for i in 1 2 3 4 5 6 7 8; do
    body="$(curl -s -m 15 "$1" 2>/dev/null || true)"
    case "$body" in *'"ok":true'*) echo "     smoke: $1 -> $body"; return 0 ;; esac
    [ "$i" -lt 8 ] && sleep 5
  done
  echo "     smoke FAILED: $1 -> ${body:-no answer}"
  return 1
}
# Wait for one run to a terminal conclusion, bounded by 1.5x the workflow's last completed
# duration (a step past 1.5x is cancelled and investigated, never watched). Prints the conclusion.
wait_run_bounded() { # $1 run id  $2 ceiling seconds
  local rid="$1" deadline=$(( $(date +%s) + $2 )) conc=""
  while :; do
    conc="$(gh run view "$rid" --json conclusion -q '.conclusion' 2>/dev/null)"
    [ -n "$conc" ] && break
    if [ "$(date +%s)" -ge "$deadline" ]; then
      gh run cancel "$rid" >/dev/null 2>&1 || true
      echo "cancelled-at-ceiling"; return 1
    fi
    sleep 20
  done
  echo "$conc"
}
last_duration() { # $1 workflow -> seconds of its newest completed run on main (default 1800)
  gh run list --workflow "$1" --branch main --status completed --limit 1 --json createdAt,updatedAt \
    -q '.[0] | ((.updatedAt | fromdateiso8601) - (.createdAt | fromdateiso8601))' 2>/dev/null | grep -E '^[0-9]+$' || echo 1800
}

# ---------------------------------------------------------------------------------------------
# land --promote [<repo>] [--run-e2e]: the newest e2e-green main commit, newer than production.
if [ "$MODE" = promote ]; then
  [ -n "$DEPLOY" ] && [ -n "$E2E_WF" ] || die "$NAME has no full-e2e route (E2E_WF unset): land <pr> ships it to production directly, so there is nothing to promote"
  say "1/4  reading main, production and the $E2E_WF runs for $NAME"
  git fetch -q origin main || die "could not fetch main"
  HEADSHA="$(git rev-parse origin/main)"
  PROD="$(production_sha)"
  echo "     main ${HEADSHA:0:7}; production ${PROD:-unrecorded (no GitHub deployment yet: any e2e-green commit qualifies)}"
  # The list is built FIRST and promote_pick reads it from a variable: 26 Sep 2026, the first
  # real --promote piped `git rev-list | while | promote_pick`, promote_pick stopped at its
  # answer, git took SIGPIPE, pipefail made the whole pipeline 141, and `|| CAND=""` threw the
  # right sha away — "nothing to promote" with a green commit sitting right there.
  pick_candidate() {
    local greens list
    greens="$(gh run list --workflow "$E2E_WF" --branch main --status success --limit 100 --json headSha -q '.[].headSha' 2>/dev/null | sort -u)"
    list="$(git rev-list --max-count=50 origin/main | while read -r sha; do
      if grep -qx "$sha" <<<"$greens"; then printf '%s\tgreen\n' "$sha"; else printf '%s\tother\n' "$sha"; fi
    done)"
    promote_pick "$PROD" <<<"$list"
  }
  CAND="$(pick_candidate)" || CAND=""
  if [ -z "$CAND" ] && [ -n "$PROD" ] && [ "$PROD" = "$HEADSHA" ]; then
    say "NOTHING TO PROMOTE — production already runs main's head ${HEADSHA:0:7}."; exit 0
  fi
  if [ -z "$CAND" ] && [ -n "$RUN_E2E" ]; then
    say "2/4  no e2e-green commit newer than production — running $E2E_WF on main ${HEADSHA:0:7} (--run-e2e)"
    # An in-flight run on the head (the nightly, or someone's dispatch) is waited for, not doubled.
    RID="$(gh run list --workflow "$E2E_WF" --branch main --limit 10 --json databaseId,headSha,status \
            -q "[.[] | select(.headSha == \"$HEADSHA\" and .status != \"completed\")][0].databaseId // empty" 2>/dev/null)"
    if [ -z "$RID" ]; then
      T0="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      gh workflow run "$E2E_WF" --ref main >/dev/null || die "could not dispatch $E2E_WF on main"
      for _ in $(seq 1 12); do
        sleep 10
        RID="$(gh run list --workflow "$E2E_WF" --branch main --event workflow_dispatch --limit 5 --json databaseId,headSha,createdAt \
                -q "[.[] | select(.headSha == \"$HEADSHA\" and .createdAt >= \"$T0\")][0].databaseId // empty" 2>/dev/null)"
        [ -n "$RID" ] && break
      done
      [ -n "$RID" ] || die "dispatched $E2E_WF on main but no run appeared in 2 minutes. Check: gh run list --workflow $E2E_WF"
    fi
    CEIL=$(( $(last_duration "$E2E_WF") * 3 / 2 )); [ "$CEIL" -ge 600 ] || CEIL=600
    echo "     run $RID, ceiling $((CEIL / 60)) min (1.5x the last completed run)"
    CONC="$(wait_run_bounded "$RID" "$CEIL")" || true
    echo "     $E2E_WF on ${HEADSHA:0:7}: $CONC"
    [ "$CONC" = success ] || die "$E2E_WF run $RID on main ${HEADSHA:0:7} ended $CONC. Nothing promoted; production stays on ${PROD:-its current build}. Fix main first: gh run view $RID"
    CAND="$(pick_candidate)" || CAND=""
  fi
  if [ -z "$CAND" ]; then
    HEADCONC="$(e2e_verdict "$HEADSHA")"
    die "nothing to promote: no main commit newer than production ${PROD:0:7} has a green $E2E_WF run (main head ${HEADSHA:0:7}: ${HEADCONC:-no completed run}). Run one: land --promote $NAME --run-e2e"
  fi
  say "2/4  promoting ${CAND:0:7} — $(git log --format='%s' -1 "$CAND")"
  [ "$CAND" = "$HEADSHA" ] || echo "     (main's head ${HEADSHA:0:7} has no green $E2E_WF run yet; ${CAND:0:7} is the newest that does)"
  say "3/4  deploying production from exactly ${CAND:0:7}"
  deploy_at "$CAND" "$DEPLOY" || die "production deploy from ${CAND:0:7} failed — read the error, it explains itself. Production's record is unchanged (still ${PROD:-unrecorded})."
  say "4/4  smoke + record"
  if [ -n "$SMOKE" ]; then smoke_check "$SMOKE" || die "production deployed from ${CAND:0:7} but the smoke check failed. Not recorded; read the deploy output."; fi
  record_production "$CAND" "land --promote from ${CAND:0:7}"
  say "PROMOTED — $NAME production now runs ${CAND:0:7} (full $E2E_WF green on that sha)."
  exit 0
fi

[ -n "$PR" ] || PR="$(gh pr view --json number -q .number 2>/dev/null)"
[ -n "$PR" ] || die "no PR number given and none open for this branch"

# ALREADY MERGED IS NOT A FAILURE. 21 Sep 2026: Porter's newsletter job landed join-west-peek-main
# #14 on its first LAND run, the run failed on an unrelated read, and the retry ran `land 14` against
# a merged PR — which this script answered "UNKNOWN/UNKNOWN — not landing", so the card never went
# DONE for a change that was live. A merged PR skips verify+merge and goes straight to watching the
# merge commit's run on main and deploying, which is the only work still owed.
PRSTATE="$(gh pr view "$PR" --json state,mergeCommit -q '.state+"/"+(.mergeCommit.oid // "")' 2>/dev/null)"
if [ "${PRSTATE%%/*}" = "MERGED" ]; then
  MERGESHA="${PRSTATE##*/}"
  say "1/5  PR #$PR is already MERGED as ${MERGESHA:0:7} — verifying main and the deploy for it, nothing to merge"
  ALREADY_MERGED=1
else
  ALREADY_MERGED=""
fi

if [ -z "$ALREADY_MERGED" ]; then
say "1/5  verifying PR #$PR myself"
# Never take an agent's word that CI is green: two reported green on red on
# 17 Sep, and one had read `mergeable` (merge conflicts) rather than the checks.
gh pr checks "$PR" || die "PR #$PR is not green"
# EVERY BUCKET, NOT THE EXIT CODE. 21 Sep 2026, boss-os #35: the Playwright job had been CANCELLED
# at its 30-minute cap, `gh pr checks` printed it as "fail" and still exited 0, and this script
# merged a PR whose merge state read UNSTABLE. A cancelled, skipped-by-failure or failing check is
# not green whatever the exit code says; only `pass` (and a genuinely `skipping` job) is.
NOTGREEN="$(gh pr checks "$PR" --json name,bucket -q '.[] | select(.bucket != "pass" and .bucket != "skipping") | "\(.name): \(.bucket)"' 2>/dev/null)"
[ -z "$NOTGREEN" ] || die "PR #$PR is not green — $(echo "$NOTGREEN" | tr '\n' ';')"
HEAD="$(gh pr view "$PR" --json headRefOid -q .headRefOid)"
RUNSHA="$(gh pr checks "$PR" --json link -q '.[0].link' | grep -oE '[0-9]+$' | head -1 \
          | xargs -I{} gh run view {} --json headSha -q .headSha 2>/dev/null)"
[ -n "$RUNSHA" ] && [ "$RUNSHA" != "$HEAD" ] && die "the green run is for $RUNSHA but the PR head is $HEAD — stale checks"
# UNKNOWN is GitHub still computing — it answers that for a minute after anything merges to main
# (19 Sep: #132 stopped as UNKNOWN/UNKNOWN seconds after #135 landed, and was clean). Wait it out.
for _ in $(seq 1 12); do
  STATE="$(gh pr view "$PR" --json mergeable,mergeStateStatus -q '.mergeable+"/"+.mergeStateStatus')"
  [ "${STATE%%/*}" = "UNKNOWN" ] || break
  sleep 10
done
[ "${STATE%%/*}" = "MERGEABLE" ] || die "PR #$PR is $STATE — resolve conflicts BY HAND, never with a union script"
case "${STATE##*/}" in
  CLEAN|HAS_HOOKS|UNSTABLE) : ;;   # UNSTABLE is a failing NON-required check; the bucket scan above already refused a real failure
  *) die "PR #$PR merge state is ${STATE##*/} — not landing" ;;
esac
echo "     green, head $HEAD, $STATE"

say "2/5  merging"
gh pr merge "$PR" --squash || die "merge failed"
fi

say "3/5  syncing main"
# From a worktree, main is checked out elsewhere and cannot be switched to here; fetching
# is enough — every later step reads origin/main through the API, not the working tree.
if git checkout -q main 2>/dev/null; then
  git pull -q || die "could not sync main"
  git log --oneline -1
else
  git fetch -q origin main || die "could not fetch main"
  git log --oneline -1 origin/main
fi

say "4/5  watching main to a terminal state"
# A green PR is not a green merge: `pull_request` builds the branch head, not the
# result of merging. Give GitHub a moment to register the run before asking.
sleep 12
# COULD NOT CHECK IS NOT THE SAME AS RED, and conflating them is how a poll lies.
# On 18 Sep 2026 GitHub rate-limited the API mid-watch, `gh run watch` exited non-zero
# having never read a conclusion, and this script announced "main is RED after merging
# #103. Not deploying." Main was green. The merge had landed and the deploy was skipped
# on the strength of an error message about rate limits.
#
# That is the failure CLAUDE.md names: a loop that watches only for the success marker
# hangs or lies through a crash, because silence looks identical to failure. So the
# conclusion is now READ BACK EXPLICITLY and each of the three outcomes is distinct:
# success deploys, failure refuses, and unreadable says so and refuses — a different
# sentence, because the operator's next move is different.
# WHICH RUN IS "MAIN". Since west-peek-os split its Playwright journeys into their own workflow
# (21 Sep 2026), a push to main starts TWO runs, and `[0]` of the list is whichever GitHub
# registered last — a coin flip between the gate and a 20-minute journey suite that the Deploy
# does not even wait for. The run watched here is the one the Deploy waits for: `deploy.yml`
# names it in `workflow_run: workflows: [..]`. A repo with no deploy.yml, or none of that
# workflow's runs on the list, gets the newest run, as before.
# --- pick_run begin (tests/test-land-pick-run.sh evals this block verbatim) ---
GATE_WF="$(sed -n 's/^ *workflows: *\[ *\([^],]*\).*/\1/p' .github/workflows/deploy.yml 2>/dev/null | head -1 | tr -d '"'"'"' ')"
pick_run() {
  # $1: a jq boolean over one run. Newest matching run of the gate workflow; else the newest match.
  # The full e2e workflow (E2E_WF, routes block) is never "main's run": production waits for it
  # separately, and the fast check is what a merge is judged on.
  gh run list --branch main --limit 20 --json databaseId,headSha,event,name \
    -q "[.[] | select($1) | select(.name != \"${E2E_WF:-}\")] as \$r | ((\$r | map(select(.name == \"${GATE_WF:-}\")) | .[0]) // \$r[0]) | .databaseId // empty" 2>/dev/null
}
# --- pick_run end ---
if [ -n "$ALREADY_MERGED" ] && [ -n "$MERGESHA" ]; then
  # The run for THIS merge commit, not whatever landed on main most recently since.
  RID="$(pick_run ".headSha == \"$MERGESHA\" and .event == \"push\"")"
  [ -n "$RID" ] || RID="$(pick_run "true")"
else
RID="$(pick_run "true")"
fi
if [ -z "$RID" ]; then
  die "could not read main's latest run (API error or rate limit). #$PR IS MERGED. Nothing was deployed. Re-run 'land $PR' when the API answers, or deploy by hand once main is green."
fi
# POLL FOR A TERMINAL CONCLUSION. `gh run watch` is not a reliable block: on 18 Sep it returned
# while the run was still `in_progress`, leaving the conclusion empty, and this script reported
# "could not read whether main is green" on a run that was simply not finished yet. Watching is a
# convenience; the terminal state is the contract, so wait for it explicitly.
#
# A transient API error must not end the wait either — that is the same "silence looks like
# failure" trap one layer down. Read errors are tolerated for a while and only become an answer
# if they persist to the deadline.
gh run watch "$RID" >/dev/null 2>&1 || true
CONC=""; STAT=""
DEADLINE=$(( $(date +%s) + 2700 ))   # 45 min: CI here runs ~14 min, twice over is ample
while :; do
  CONC="$(gh run view "$RID" --json conclusion -q '.conclusion' 2>/dev/null)"
  STAT="$(gh run view "$RID" --json status -q '.status' 2>/dev/null)"
  [ -n "$CONC" ] && break
  [ "$(date +%s)" -ge "$DEADLINE" ] && break
  sleep 20
done
echo "     ${STAT:-unknown} ${CONC:-unreadable}"
case "$CONC" in
  success) : ;;
  "")
    die "could not read whether main is green (API error or rate limit). #$PR IS MERGED. Nothing was deployed — this is NOT a failing build, it is an unanswered question. Re-run 'land $PR' when the API answers."
    ;;
  cancelled|skipped)
    # SUPERSEDED ONLY IF SOMETHING SUPERSEDED IT. On 21 Sep 2026 (boss-os #33) the run on main was
    # cancelled with NO later commit behind it — the concurrency group fired on something other
    # than a merge — and this branch declared it superseded, exited 0, and the Deploy workflow
    # skipped: an undeployed main wearing a reassuring sentence. So the claim is checked: if the
    # cancelled run's SHA is still main's head, nothing superseded it, and the run is re-run and
    # watched to its own terminal state instead. Only a run whose commit has been passed by a
    # newer one is superseded.
    RSHA="$(gh run view "$RID" --json headSha -q '.headSha' 2>/dev/null)"
    git fetch -q origin main 2>/dev/null || true
    MSHA="$(git rev-parse origin/main 2>/dev/null)"
    if [ -n "$RSHA" ] && [ "$RSHA" = "$MSHA" ]; then
      say "     cancelled with NO later commit on main — nothing superseded it. Re-running $RID."
      gh run rerun "$RID" >/dev/null 2>&1 || die "could not re-run $RID. #$PR IS MERGED and NOT deployed; main has no green run for $MSHA. Re-run it by hand: gh run rerun $RID"
      sleep 15
      gh run watch "$RID" >/dev/null 2>&1 || true
      CONC=""; DEADLINE=$(( $(date +%s) + 2700 ))
      while :; do
        CONC="$(gh run view "$RID" --json conclusion -q '.conclusion' 2>/dev/null)"
        [ -n "$CONC" ] && [ "$CONC" != "cancelled" ] && break
        [ "$(date +%s)" -ge "$DEADLINE" ] && break
        sleep 20
      done
      echo "     re-run: ${CONC:-unreadable}"
      case "$CONC" in
        success) ;;
        "") die "could not read the re-run's conclusion. #$PR IS MERGED and NOT deployed. Check: gh run view $RID" ;;
        *) die "main is $CONC on the re-run after merging #$PR. Not deploying. Fix main first." ;;
      esac
    else
    # SUPERSEDED IS NOT BROKEN. `ci.yml` sets concurrency with cancel-in-progress, so merging a
    # second PR while the first one's run is still going cancels the first — by design, because
    # validating a commit nobody will deploy is waste. On 18 Sep this script read that as
    # "main is cancelled after merging #101. Not deploying. Fix main first." Nothing was wrong:
    # #104 had merged thirty seconds later and its run was validating BOTH changes.
    #
    # Nothing is deployed from here, and that is correct — the newer run carries this commit and
    # the Deploy workflow fires on it. Saying so is the whole point; the previous wording sent the
    # operator hunting a failure that did not exist.
    say "     superseded — a later merge cancelled this run and is validating your commit too"
    say "#$PR IS MERGED. Not deploying from here: the newer run on main carries it, and the"
    say "Deploy workflow ships on that run's success. Watch it with:  gh run list --branch main"
    exit 0
    fi
    ;;
  *)
    die "main is $CONC after merging #$PR. Not deploying. Fix main first."
    ;;
esac

# A SELF-DEPLOYING REPO IS NOT DEPLOYED UNTIL ITS CLOUDFLARE BUILD SAYS SO. 25 Sep 2026,
# local-guides-generator #48: main's GitHub workflows went green, this script printed "nothing to
# run", and the base Cloudflare Pages project's production build had failed on the merge commit.
# The Cloudflare app posts one check-run per project ("Cloudflare Pages: <project>", "Workers
# Builds: <worker>") on the commit it builds; wait for those to reach a terminal state and refuse
# on any that did not succeed. A repo whose deploy posts no such check (the Actions-driven loop
# repos, ~/bin) gets the old sentence once none has appeared.
# --- pages_watch begin (tests/test-land-pages-watch.sh evals this block verbatim) ---
pages_watch() { # $1 merge sha -> 0 all succeeded | 1 failed or timed out (prints which) | 2 none posted
  local sha="$1" rows pending failed
  local appear_by=$((SECONDS + ${PAGES_APPEAR_SECS:-180})) deadline=$((SECONDS + ${PAGES_WAIT_SECS:-1200}))
  while :; do
    rows="$(gh api "repos/{owner}/{repo}/commits/$sha/check-runs" \
      --jq '.check_runs[] | select(.name | test("^(Cloudflare Pages|Workers Builds)")) | "\(.status)\t\(.conclusion)\t\(.name)"' 2>/dev/null)"
    if [ -z "$rows" ]; then
      [ "$SECONDS" -ge "$appear_by" ] && return 2
    else
      pending="$(printf '%s\n' "$rows" | awk -F'\t' '$1 != "completed"' | wc -l | tr -d ' ')"
      if [ "$pending" = 0 ]; then
        failed="$(printf '%s\n' "$rows" | awk -F'\t' '$2 != "success" && $2 != "skipped" && $2 != "neutral" {print $3 " (" $2 ")"}')"
        [ -z "$failed" ] && return 0
        printf '%s\n' "$failed"
        return 1
      fi
      if [ "$SECONDS" -ge "$deadline" ]; then
        printf 'still running at the deadline: %s\n' "$(printf '%s\n' "$rows" | awk -F'\t' '$1 != "completed" {print $3}' | paste -sd, -)"
        return 1
      fi
    fi
    sleep 15
  done
}
# --- pages_watch end ---

if [ -z "$DEPLOY" ]; then
  say "5/5  $NAME $SELF — confirming the Cloudflare build(s) on the merge commit"
  MSHA_PAGES="${MERGESHA:-$(gh pr view "$PR" --json mergeCommit -q '.mergeCommit.oid' 2>/dev/null)}"
  [ -n "$MSHA_PAGES" ] || die "#$PR IS MERGED and main is green, but its merge commit could not be read, so the Cloudflare build was not confirmed. Check the check-runs on main."
  PW_OUT="$(pages_watch "$MSHA_PAGES")"; PW=$?
  case "$PW" in
    0) say "LANDED — #$PR is merged, main is green, and every Cloudflare build on ${MSHA_PAGES:0:7} succeeded." ;;
    2) say "     no Cloudflare check-run on ${MSHA_PAGES:0:7}; $NAME $SELF — nothing to run" ;;
    *) die "#$PR IS MERGED and main's workflows are green, but a Cloudflare build on ${MSHA_PAGES:0:7} did not succeed — that project was NOT updated: $(echo "$PW_OUT" | paste -sd';' -). Fix main now." ;;
  esac
  exit 0
fi

# DO NOT RACE THE WORKFLOW. Since `deploy.yml` landed, a green `main` deploys itself, and this
# script deploying too means two `wrangler d1 migrations apply` runs against the same database at
# once. On 18 Sep they collided four seconds apart: the workflow started at 16:54:25, this script's
# deploy failed at 16:54:29 with a 7403 that reads like a revoked token and was nothing of the kind.
# The workflow's `concurrency` group serialises workflow runs; it cannot see a laptop.
#
# So where the repo deploys itself, this script WAITS and reports rather than competing. It still
# has a job: confirming the deploy actually happened. An automation nobody checks is how "merged"
# and "shipped" came apart in the first place.
# A ROUTE WITH E2E_WF IS NOT DEPLOYED BY GREEN MAIN. Since 26 Sep 2026 boss-os's deploy.yml fires on
# the nightly e2e workflow, not on CI: after a merge there is no Deploy run to wait for, and the
# newest "Deploy" on the list would be an OLDER commit's — "LANDED, the Deploy workflow shipped it"
# about a deploy that never happened. Those routes fall through to the plan below (WAITING).
if [ -f ".github/workflows/deploy.yml" ] && [ -z "$E2E_WF" ]; then
  say "5/5  $NAME deploys itself on green main — waiting for that run rather than racing it"
  sleep 20
  DRID="$(gh run list --branch main --limit 10 --json databaseId,name,headSha \
            -q "[.[]|select(.name==\"Deploy\")][0].databaseId" 2>/dev/null)"
  if [ -z "$DRID" ]; then
    say "     no Deploy run found yet. #$PR IS MERGED and main is green; the workflow fires on its own."
    say "     Check with:  gh run list --branch main"
    exit 0
  fi
  gh run watch "$DRID" >/dev/null 2>&1 || true
  DCONC="$(gh run view "$DRID" --json conclusion -q '.conclusion' 2>/dev/null)"
  case "$DCONC" in
    success) say "LANDED — #$PR is merged, main is green, and the Deploy workflow shipped it."; exit 0 ;;
    skipped) say "#$PR IS MERGED. That Deploy run was skipped (it fired on a superseded CI run)."
             say "A later run carries your commit. Watch:  gh run list --branch main"; exit 0 ;;
    "")      die "#$PR IS MERGED and main is green, but the Deploy run's outcome could not be read. Check it before assuming production changed." ;;
    *)       die "#$PR IS MERGED and main is green, but the Deploy workflow finished $DCONC. Production was NOT updated. Read that run." ;;
  esac
fi

if [ -z "$E2E_WF" ] && [ -z "$STAGING" ]; then
  say "5/5  deploying"
  # Never a bare `wrangler deploy`: it ships a stale client and the LOCAL DEV
  # bindings. On 17 Sep it tried to push WP_OS_ENV "local" and a dev passcode to
  # production and failed only because of an unrelated error.
  $DEPLOY || die "deploy failed — read the error, it explains itself (a missing CLOUDFLARE_ACCOUNT_ID surfaces as a 7403 that reads like permissions and is not)"
  say "LANDED — #$PR is merged, main is green, and it is in production."
  exit 0
fi

# STAGING NOW, PRODUCTION WHEN THE FULL E2E SAYS SO (routes with STAGING / E2E_WF; header above).
MSHA="${MERGESHA:-$(gh pr view "$PR" --json mergeCommit -q '.mergeCommit.oid' 2>/dev/null)}"
[ -n "$MSHA" ] || die "#$PR IS MERGED and main is green, but its merge commit could not be read, so nothing was deployed. Re-run 'land $PR'."
E2E_CONC=""; [ -z "$E2E_WF" ] || E2E_CONC="$(e2e_verdict "$MSHA")"
PLAN="$(land_plan "$DEPLOY" "$STAGING" "$E2E_WF" "$E2E_CONC")"
say "5/5  ${MSHA:0:7}: $PLAN${E2E_WF:+ ($E2E_WF on this sha: ${E2E_CONC:-no completed run})}"
for step in $PLAN; do
  case "$step" in
    staging)
      say "     staging <- ${MSHA:0:7}"
      deploy_at "$MSHA" "$STAGING" || die "#$PR IS MERGED and main is green, but the STAGING deploy from ${MSHA:0:7} failed — read the error, it explains itself. Production untouched."
      ;;
    production)
      say "     production <- ${MSHA:0:7}"
      deploy_at "$MSHA" "$DEPLOY" || die "#$PR IS MERGED and main is green, but the production deploy from ${MSHA:0:7} failed — read the error, it explains itself (a missing CLOUDFLARE_ACCOUNT_ID surfaces as a 7403 that reads like permissions and is not)."
      if [ -n "$SMOKE" ]; then smoke_check "$SMOKE" || die "#$PR deployed to production from ${MSHA:0:7} but the smoke check failed. Not recorded; read the deploy output."; fi
      [ -z "$E2E_WF" ] || record_production "$MSHA" "land #$PR from ${MSHA:0:7}"
      say "LANDED — #$PR is merged, main is green, ${STAGING:+staging and }production run ${MSHA:0:7}."
      ;;
    waiting)
      say "WAITING — #$PR is merged, main's fast check is green${STAGING:+, staging runs ${MSHA:0:7}}."
      say "production waits for full $E2E_WF on $MSHA; run \`land --promote $NAME\` after it passes (or \`land --promote $NAME --run-e2e\` to run it now)"
      ;;
  esac
done
exit 0
