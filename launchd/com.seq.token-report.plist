<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- token-report --nightly (28 Nov 2026, her yes to the token cuts: "Count the cost of every job"). 23:30 Central,
     window class ANY (a 15-second read of this Mac's own transcripts); the day's JSON and the week-against-baseline
     verdict go to ~/Work/tasks/measure/. A Mac asleep at 23:30 runs it on wake. -->
<dict>
	<key>Label</key>
	<string>com.seq.token-report</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>node /Users/sequoiataylor/bin/token-report.mjs --nightly</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
	<key>StandardOutPath</key>
	<string>/Users/sequoiataylor/Library/Logs/token-report.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/sequoiataylor/Library/Logs/token-report.log</string>
</dict>
</plist>
