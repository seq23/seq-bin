<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.seq.ci-sweep</string>
  <!-- 07:00 local (CT). Her design, 23 Sep 2026, moved 06:00 -> 07:00 on her
       instruction 24 Sep 2026: one progress-driven run with a 3h30 budget
       (done ~10:30) that parks what only she can clear, fixes and merges the
       rest, and sends one morning summary. If it does not end MAIN-GREEN,
       com.seq.ci-sweep-retry.plist tries it exactly once more at 08:00; a
       second non-green ending waits for tomorrow's 07:00 run, briefed with
       what both tries did. If the Mac is asleep at 07:00, launchd fires the
       missed run once at wake.
       Versioned in seq23/seq-bin (launchd/com.seq.ci-sweep.plist); install with
       the steps in README.md. ci-sweep-selftest.sh asserts this schedule. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>/Users/sequoiataylor/bin/ci-sweep.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>/Users/sequoiataylor/Library/Logs/ci-sweep/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/sequoiataylor/Library/Logs/ci-sweep/launchd.err</string>
  <key>RunAtLoad</key><false/>
</dict></plist>
