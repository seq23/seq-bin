  ST_TH="$(gh api "repos/{owner}/{repo}/commits/$HEAD" --jq '.commit.tree.sha' 2>/dev/null || true)"
  if [ -n "$ST_TM" ] && [ "$ST_TM" = "$ST_TH" ] && [ -n "$ST_WFPATH" ] \
     && { [ -z "$ST_GATE" ] || [ "$ST_GATE" = "$PR_WF" ]; } \
     && git show "origin/main:$ST_WFPATH" >/dev/null 2>&1 \
     && ! git show "origin/main:$ST_WFPATH" | grep -vE '^[[:space:]]*(#|group:)' | grep -qE 'github\.(event|ref|head_ref|base_ref)'; then
