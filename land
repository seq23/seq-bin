  justbeingmercedes)    DEPLOY="" ; SELF="deploys itself through Cloudflare Pages (deploy.yml): main -> staging preview on push; justbeingmercedes.com by deploy.yml's production path (small change: on the fast check; large: on a green e2e)" ; E2E_WF="e2e" ; PROMOTE_VIA="deploy.yml" ;;
  # wrangler.toml pages_build_output_dir = "public"; Pages project topbarz-voting (Direct Upload:
  # public/ + Pages Functions, D1 and R2; voting.topbarz.xyz). Its deploy.yml fires on a green
  # Validate on main and ships that sha itself — preview database migrated, staging published, a
  # live check, then production database migrated, production published, a live check — so land
  # WAITS for that Deploy run (the deploy.yml guard below) and never races it with a second
  # `d1 migrations apply` from the laptop. The command here is the same full path by hand
  # (break-glass). No browser suite in the repo, so no E2E_WF. Added 2 Oct 2026.
  topbarz-voting)       DEPLOY="npm run deploy:production" ; SELF="" ;;
  *) die "$NAME has no deploy route recorded in this script. Add one before landing." ;;
esac
[ -z "$PROMOTE_VIA" ] || PROMOTE_WF="$PROMOTE_VIA"
# --- routes end ---

# WHAT LANDS WHERE. Pure — no gh, no git — so tests/test-land-plan.sh can prove every branch.
# --- plan begin (tests/test-land-plan.sh evals this block verbatim) ---
# land_plan DEPLOY STAGING E2E_WF E2E_CONCLUSION LARGE LAST_VERDICT -> the steps, space-separated,
# in order, out of:
#   staging     deploy staging from the merge sha
#   production  deploy production now: no e2e workflow on the route; or its run on this sha
#               succeeded; or the change is SMALL and the suite is not known red
#   suite       a LARGE change (or --run-e2e): run the e2e workflow on main, production only on green
#   blocked     a small change, but the suite is KNOWN RED — or whether it is could not be read:
#               production untouched
#   self        the repo deploys itself; nothing for this script to run
# DEPLOY is the route's deploy command, or its PROMOTE_VIA workflow (either means "land ships it").
# E2E_CONCLUSION is the conclusion of the newest COMPLETED run of E2E_WF on the exact sha, or ""
# when there is none (still running counts as none: a run that has not finished proves nothing).
# LARGE is why the change is large (non-empty: the large block's reason, an unproven large commit
# production has not seen, or "--run-e2e given"), or "" for a small change.
# LAST_VERDICT is the conclusion of the newest e2e run on main that reached a verdict (cancelled and
# skipped are not verdicts), "none" when no run ever did, or "" when the history could not be read.
# FAIL CLOSED: "" is never "not red", and neither is any word this does not know.
land_plan() {
  local deploy="$1" staging="$2" e2e="$3" conc="$4" large="${5-}" last="${6-}" out=""
  [ -n "$staging" ] && out="staging"
  if [ -z "$deploy" ]; then printf '%s\n' "${out:+$out }self"; return 0; fi
  if [ -z "$e2e" ] || [ "$conc" = success ]; then printf '%s\n' "${out:+$out }production"; return 0; fi
  if [ -n "$large" ]; then printf '%s\n' "${out:+$out }suite"; return 0; fi
  # A small change. A red verdict on this exact sha blocks it whatever came after.
  case "$conc" in ""|cancelled|skipped) : ;; *) printf '%s\n' "${out:+$out }blocked"; return 0 ;; esac
  case "$last" in
    success|none) printf '%s\n' "${out:+$out }production" ;;
    *) printf '%s\n' "${out:+$out }blocked" ;;
  esac
}
# promote_pick PRODUCTION_SHA < "sha<TAB>green|other" lines, main's commits NEWEST FIRST
#   -> prints the newest green commit that is newer than production, exit 0; exit 1 if none.
# Reaching production's own sha ends the walk: everything below it is already shipped or older.
# An unrecorded production ("") means any green commit qualifies.
promote_pick() {
  local prod="$1" sha verdict
  while IFS=$'\t' read -r sha verdict; do
    [ -n "$sha" ] || continue
    [ "$sha" = "$prod" ] && return 1
    [ "$verdict" = green ] && { printf '%s\n' "$sha"; return 0; }
  done
  return 1
}
# --- plan end ---

# WHAT COUNTS AS A LARGE CHANGE. Pure — no gh — so tests/test-land-large.sh can prove every rule.
# --- large begin (tests/test-land-large.sh evals this block verbatim) ---
# large_reason ADDITIONS DELETIONS CHANGED_FILES < the changed paths, one per line
#   -> prints WHY the change is large (one line, with the numbers that decided it) and returns 0;
#      prints nothing and returns 1 for a small change. The thresholds are env-overridable so a
#      repo can be driven harder or softer from the shell without editing this file:
#   LAND_LARGE_LINES     additions + deletions at or above this is large                (200)
#   LAND_LARGE_FILES     changed files at or above this is large                         (8)
#   LAND_LARGE_UI_LINES  a UI-surface file touched AND this many lines changed is large (40)
#   Any change to a migration, the e2e specs or a Playwright config is large at any size: the
#   schema and the browser-test contract are exactly what the suite exists to prove.
LAND_LARGE_LINES="${LAND_LARGE_LINES:-200}"
LAND_LARGE_FILES="${LAND_LARGE_FILES:-8}"
LAND_LARGE_UI_LINES="${LAND_LARGE_UI_LINES:-40}"
LAND_UI_PATH='(^|/)(client|app|public|pages|components|views|ui|routes|functions)/|\.(tsx|jsx|html|css|vue|svelte)$'
LAND_CONTRACT_PATH='(^|/)(migrations|e2e)/|(^|/)tests/e2e/|(^|/)playwright[a-z.]*\.config\.[jt]s$'
large_reason() {
  local add="${1-}" del="${2-}" files="${3-}" lines paths ui contract
  case "${add:-?}${del:-?}${files:-?}" in *[!0-9]*) echo "PR size unreadable (+${add:-?}/-${del:-?}, ${files:-?} files) — treated as large, fail closed"; return 0 ;; esac
  lines=$((add + del))
  paths="$(cat)"
  contract="$(grep -E "$LAND_CONTRACT_PATH" <<<"$paths" | head -1)"
  ui="$(grep -Ec "$LAND_UI_PATH" <<<"$paths")"
  if [ "$lines" -ge "$LAND_LARGE_LINES" ]; then echo "$lines lines changed (+$add/-$del) ≥ $LAND_LARGE_LINES"; return 0; fi
  if [ "$files" -ge "$LAND_LARGE_FILES" ]; then echo "$files files changed ≥ $LAND_LARGE_FILES"; return 0; fi
  if [ -n "$contract" ]; then echo "touches the schema or the browser-test contract ($contract)"; return 0; fi
  if [ "$ui" -gt 0 ] && [ "$lines" -ge "$LAND_LARGE_UI_LINES" ]; then echo "$ui UI-surface file(s) touched with $lines lines changed (≥ $LAND_LARGE_UI_LINES)"; return 0; fi
  return 1
}
# --- large end ---

# The newest completed run of the e2e workflow on exactly this sha, or "" (none, or none finished).
e2e_verdict() { # $1 sha
  gh run list --workflow "$E2E_WF" --branch main --limit 50 --json headSha,status,conclusion \
    -q "[.[] | select(.headSha == \"$1\" and .status == \"completed\")][0].conclusion // empty" 2>/dev/null
}
# --- verdict begin (tests/test-land-plan.sh evals this block verbatim) ---
# KNOWN RED (header). The newest run of the e2e workflow on main that reached a verdict: cancelled
# and skipped runs are passed over. Prints "<conclusion><TAB><run id><TAB><sha>", or "none" when no
# run on main ever reached one. Prints NOTHING when the history could not be read (after gh_read's
# retries) — land_plan reads nothing as blocked, never as "not red".
e2e_last_verdict() {
  gh_read $'^(none|[a-z_]+\t[0-9]+\t[0-9a-f]{40})$' run list --workflow "$E2E_WF" --branch main --limit 30 --json conclusion,headSha,databaseId,status \
    -q '[.[] | select(.status == "completed" and .conclusion != "cancelled" and .conclusion != "skipped")][0] | if . == null then "none" else "\(.conclusion)\t\(.databaseId)\t\(.headSha)" end' || true
}
# --- verdict end ---
# What production runs, as an ANSWER: the sha, "unrecorded" (no production deployment yet), or
# "unreadable" (the API did not answer — never mistaken for unrecorded).
production_state() {
  gh_read '^(unrecorded|[0-9a-f]{40})$' api "repos/{owner}/{repo}/deployments?environment=production&per_page=1" --jq '.[0].sha // "unrecorded"' || echo unreadable
}
# --- range begin (tests/test-land-large.sh evals this block verbatim, after the large block) ---
# EVERY CHANGE PRODUCTION HAS NOT SEEN IS JUDGED (header). Walks main's commits between what
# production runs and the sha about to ship (first-parent: one commit per squash-merged PR) and
# judges each with large_reason from its own diff. Prints why (0) when one is large, or when the
# range cannot be judged (fail closed); prints nothing (1) when every one is small. An unrecorded
# production has no range to judge: the PR alone decides.
LAND_RANGE_MAX="${LAND_RANGE_MAX:-30}"
unshipped_large_reason() { # $1 production state  $2 sha about to ship
  local prod="$1" sha="$2" c n=0 stat add del files why subj
  case "$prod" in
    unrecorded) return 1 ;;
    unreadable) echo "what production runs could not be read, so the changes it has not seen cannot be judged — treated as large, fail closed"; return 0 ;;
  esac
  [ "$prod" != "$sha" ] || return 1
  git merge-base --is-ancestor "$prod" "$sha" 2>/dev/null \
    || { echo "production's recorded sha ${prod:0:7} is not an ancestor of ${sha:0:7} in this checkout, so the changes it has not seen cannot be judged — treated as large, fail closed"; return 0; }
  n="$(git rev-list --count --first-parent "$prod..$sha" 2>/dev/null)" || n=""
  case "${n:-?}" in *[!0-9]*) echo "the commits since production ${prod:0:7} could not be counted — treated as large, fail closed"; return 0 ;; esac
  [ "$n" -le "$LAND_RANGE_MAX" ] || { echo "$n commits on main since production ${prod:0:7} (more than $LAND_RANGE_MAX) — treated as large"; return 0; }
  for c in $(git rev-list --first-parent "$prod..$sha"); do
    stat="$(git diff --numstat "$c^" "$c" 2>/dev/null)" || { echo "commit ${c:0:7} since production ${prod:0:7} could not be measured — treated as large, fail closed"; return 0; }
    add="$(awk -F'\t' '{a += $1} END {print a + 0}' <<<"$stat")"; del="$(awk -F'\t' '{d += $2} END {print d + 0}' <<<"$stat")"
    files="$(grep -c . <<<"$stat" || true)"
    if why="$(cut -f3- <<<"$stat" | large_reason "$add" "$del" "$files")"; then
      subj="$(git log --format=%s -1 "$c" 2>/dev/null)"
      echo "main carries ${c:0:7} (${subj:0:50}) past production ${prod:0:7}, large and not yet proven: $why"
      return 0
    fi
  done
  echo "     judged all $n change(s) main carries past production ${prod:0:7}: none is large" >&2
  return 1
}
# --- range end ---
# What production runs, from the GitHub Deployments record this script writes (newest first).
production_sha() {
  gh api "repos/{owner}/{repo}/deployments?environment=production&per_page=1" --jq '.[0].sha // empty' 2>/dev/null
}
record_production() { # $1 sha  $2 note -> one GitHub deployment (environment production) + a success status
  # GitHub refuses a description over 140 characters (422), and a refused record is an unrecorded
  # production. Quotes and backslashes would break the JSON below. Neither is worth losing it for.
  local id note
  note="${2//\"/}"; note="${note//\\/}"; note="${note:0:140}"
  set -- "$1" "$note"
  id="$(printf '{"ref":"%s","environment":"production","auto_merge":false,"required_contexts":[],"description":"%s","production_environment":true}' "$1" "$2" \
        | gh api -X POST "repos/{owner}/{repo}/deployments" --input - --jq '.id' 2>/dev/null)"
  if [ -z "$id" ]; then
    say "     WARNING: production is live on ${1:0:7} but the GitHub deployment record could not be written; land --promote will not know. Record by hand: gh api -X POST repos/{owner}/{repo}/deployments -f ref=$1 -f environment=production"
    return 0
  fi
  printf '{"state":"success","environment":"production","description":"%s"%s}' "$2" "${SMOKE:+,\"environment_url\":\"${SMOKE%/healthz}\"}" \
    | gh api -X POST "repos/{owner}/{repo}/deployments/$id/statuses" --input - >/dev/null 2>&1 || true
  echo "     recorded: GitHub deployment $id — production = ${1:0:7}"
}
# NEVER A DIRTY TREE. Deploy from a detached worktree at exactly the sha, so what ships is what
# main's checks read — not a branch checkout, not a working tree with edits. node_modules is
# shared from this checkout when the lockfile at that sha is identical (the repo convention for
# worktrees); otherwise `npm ci` in the worktree.
deploy_at() { # $1 sha  $2 command
  local sha="$1" cmd="$2" wt rc
  wt="$(mktemp -d -t land-deploy.XXXXXX)" || return 1
  git worktree add -q --detach "$wt" "$sha" || { rm -rf "$wt"; echo "     could not check out $sha into a worktree"; return 1; }
  if [ -f "$wt/package-lock.json" ]; then
    if [ -d "$REPO_DIR/node_modules" ] && cmp -s "$wt/package-lock.json" "$REPO_DIR/package-lock.json"; then
      ln -s "$(cd "$REPO_DIR/node_modules" && pwd -P)" "$wt/node_modules"
    else
      (cd "$wt" && npm ci --no-audit --no-fund --silent) || { git worktree remove --force "$wt" >/dev/null 2>&1; return 1; }
    fi
  fi
  (cd "$wt" && echo "     in $wt @ ${sha:0:7}: $cmd" && eval "$cmd"); rc=$?
  git worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
  return $rc
}
smoke_check() { # $1 url -> 200 and "ok":true, read up to 40 s for the edge to serve the new version
  local body="" i
  for i in 1 2 3 4 5 6 7 8; do
    body="$(curl -s -m 15 "$1" 2>/dev/null || true)"
    case "$body" in *'"ok":true'*) echo "     smoke: $1 -> $body"; return 0 ;; esac
    [ "$i" -lt 8 ] && sleep 5
  done
  echo "     smoke FAILED: $1 -> ${body:-no answer}"
  return 1
}
# Wait for one run to a terminal conclusion, bounded by 1.5x the workflow's last completed
# duration (a step past 1.5x is cancelled and investigated, never watched). Prints the conclusion.
wait_run_bounded() { # $1 run id  $2 ceiling seconds
  local rid="$1" deadline=$(( $(date +%s) + $2 )) conc=""
  while :; do
    conc="$(gh run view "$rid" --json conclusion -q '.conclusion' 2>/dev/null)"
    [ -n "$conc" ] && break
    if [ "$(date +%s)" -ge "$deadline" ]; then
      gh run cancel "$rid" >/dev/null 2>&1 || true
      echo "cancelled-at-ceiling"; return 1
    fi
    sleep 20
  done
  echo "$conc"
}
last_duration() { # $1 workflow -> seconds of its newest completed run on main (default 1800)
  gh run list --workflow "$1" --branch main --status completed --limit 1 --json createdAt,updatedAt \
    -q '.[0] | ((.updatedAt | fromdateiso8601) - (.createdAt | fromdateiso8601))' 2>/dev/null | grep -E '^[0-9]+$' || echo 1800
}
# Run the full e2e workflow on main's head (or adopt the run already in flight on it) and wait,
# bounded by 1.5x its last completed duration (floor 10 min). Sets RID and CONC; never dies, so the
# caller words the stop for its own path.
run_e2e_on_main() { # $1 sha of main's head
  local sha="$1" t0 ceil
  RID="$(gh run list --workflow "$E2E_WF" --branch main --limit 10 --json databaseId,headSha,status \
          -q "[.[] | select(.headSha == \"$sha\" and .status != \"completed\")][0].databaseId // empty" 2>/dev/null)"
  if [ -z "$RID" ]; then
    t0="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    gh workflow run "$E2E_WF" --ref main >/dev/null || { CONC="could-not-dispatch"; return 1; }
    for _ in $(seq 1 12); do
      sleep 10
      RID="$(gh run list --workflow "$E2E_WF" --branch main --event workflow_dispatch --limit 5 --json databaseId,headSha,createdAt \
              -q "[.[] | select(.headSha == \"$sha\" and .createdAt >= \"$t0\")][0].databaseId // empty" 2>/dev/null)"
      [ -n "$RID" ] && break
    done
    [ -n "$RID" ] || { CONC="no-run-appeared"; return 1; }
  fi
  ceil=$(( $(last_duration "$E2E_WF") * 3 / 2 )); [ "$ceil" -ge 600 ] || ceil=600
  echo "     run $RID, ceiling $((ceil / 60)) min (1.5x the last completed run)"
  CONC="$(wait_run_bounded "$RID" "$ceil")" || true
  echo "     $E2E_WF on ${sha:0:7}: $CONC"
  [ "$CONC" = success ]
}
# The PR's size, read from GitHub into PR_ADD / PR_DEL / PR_FILES / PR_PATHS (so the small-change
# reason can print the numbers that decided it), then judged by large_reason: pr_large_reason
# prints the reason (0) or nothing (1). A size that cannot be read is judged large by large_reason
# itself (fail closed: the suite runs).
PR_ADD="?"; PR_DEL="?"; PR_FILES="?"; PR_PATHS=""
pr_size() { # $1 pr number
  local stats
  stats="$(gh pr view "$1" --json additions,deletions,changedFiles,files \
            -q '"\(.additions) \(.deletions) \(.changedFiles)", (.files[].path)' 2>/dev/null)" || stats=""
  [ -n "$stats" ] || stats="? ? ?"
  read -r PR_ADD PR_DEL PR_FILES <<<"$(head -1 <<<"$stats")"
  PR_PATHS="$(tail -n +2 <<<"$stats")"
}
pr_large_reason() { large_reason "$PR_ADD" "$PR_DEL" "$PR_FILES" <<<"$PR_PATHS"; }
# A SELF-DEPLOYING REPO SHIPS PRODUCTION THROUGH ITS OWN WORKFLOW (PROMOTE_VIA, routes block): one
# writer of production, and a gate that runs where the deploy runs. land dispatches it with the sha
# and the reason, finds the run it started, and waits for it — bounded by 1.5x that workflow's last
# completed run (floor 6 min), cancelled past it. 0 only when that run concluded success.
promote_dispatch() { # $1 sha  $2 reason
  local sha="$1" why t0 rid="" ceil conc
  why="${2//\"/}"; why="${why//\\/}"; why="${why:0:140}"
  t0="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  gh workflow run "$PROMOTE_VIA" --ref main -f sha="$sha" -f reason="$why" >/dev/null || { echo "     could not dispatch $PROMOTE_VIA"; return 1; }
  for _ in $(seq 1 12); do
    sleep 10
    rid="$(gh run list --workflow "$PROMOTE_VIA" --event workflow_dispatch --limit 5 --json databaseId,createdAt \
            -q "[.[] | select(.createdAt >= \"$t0\")][0].databaseId // empty" 2>/dev/null)"
    [ -n "$rid" ] && break
  done
  [ -n "$rid" ] || { echo "     dispatched $PROMOTE_VIA for ${sha:0:7} but no run appeared in 2 minutes. Check: gh run list --workflow $PROMOTE_VIA"; return 1; }
  ceil=$(( $(last_duration "$PROMOTE_VIA") * 3 / 2 )); [ "$ceil" -ge "${LAND_WAIT_FLOOR_SECS:-360}" ] || ceil=${LAND_WAIT_FLOOR_SECS:-360}
  echo "     $PROMOTE_VIA run $rid for ${sha:0:7} — waiting (ceiling $((ceil / 60)) min)"
  conc="$(wait_run_bounded "$rid" "$ceil")" || true
  echo "     $PROMOTE_VIA run $rid: $conc"
  [ "$conc" = success ]
}

# NEVER RACE THE REPO'S OWN PROMOTE. 26 Sep 2026: sheila-creator-dashboard grew promote.yml (fires
# on a green e2e run of main, deploys production from that sha, records the GitHub Deployment). Its
# already-live check only catches the SEQUENTIAL case; a person running `land --promote` in the same
# minutes would build + `d1 migrations apply` + `wrangler deploy` the same sha on top of it. So
# before deciding what to promote, an in-flight promote run (queued, waiting, in_progress) is
# waited for — bounded by 1.5x its last completed duration, floor 6 min — and production is read
# only after it finishes (which is then usually "NOTHING TO PROMOTE"). Past the ceiling it is
# cancelled and this stops by name; nothing is ever deployed on top of it. A repo with no
# promote.yml on origin/main has nothing to wait for and this is silent.
# $1 (optional): a sha whose promote run is EXPECTED to appear (the --run-e2e path: promote.yml
# fires on the e2e success just waited for) — polled for up to LAND_PROMOTE_APPEAR_SECS (120 s).
# PROMOTE_WF comes from the routes block (promote.yml unless the route names another).
promote_wait_inflight() {
  local expect="${1:-}" appear_by=$((SECONDS + ${LAND_PROMOTE_APPEAR_SECS:-120})) row="" rid sha st ceil conc
  git cat-file -e "origin/main:.github/workflows/$PROMOTE_WF" 2>/dev/null || return 0
  while :; do
    row="$(gh run list --workflow "$PROMOTE_WF" --limit 10 --json databaseId,headSha,status \
            -q '[.[] | select(.status != "completed")][0] | select(. != null) | "\(.databaseId)\t\(.headSha)\t\(.status)"' 2>/dev/null)"
    [ -n "$row" ] && break
    [ -n "$expect" ] && [ "$SECONDS" -lt "$appear_by" ] || return 0
    sleep 10
  done
  IFS=$'\t' read -r rid sha st <<<"$row"
  ceil=$(( $(last_duration "$PROMOTE_WF") * 3 / 2 )); [ "$ceil" -ge "${LAND_WAIT_FLOOR_SECS:-360}" ] || ceil=${LAND_WAIT_FLOOR_SECS:-360}
  echo "     promote run $rid in flight for ${sha:0:7} ($st) — waiting (ceiling $((ceil / 60)) min, 1.5x its last completed run)"
  conc="$(wait_run_bounded "$rid" "$ceil")" || true
  [ "$conc" != cancelled-at-ceiling ] || die "NAMED STOP [PROMOTE_RUN_PAST_CEILING] $PROMOTE_WF run $rid on ${sha:0:7} ran past $((ceil / 60)) min and was cancelled. Nothing deployed on top of it: read the run (gh run view $rid), then land --promote $NAME again."
  echo "     promote run $rid finished: $conc — reading production again"
}

# ---------------------------------------------------------------------------------------------
# land --promote [<repo>] [--run-e2e]: the newest e2e-green main commit, newer than production.
if [ "$MODE" = promote ]; then
  { [ -n "$DEPLOY" ] || [ -n "$PROMOTE_VIA" ]; } && [ -n "$E2E_WF" ] || die "$NAME has no full-e2e route (E2E_WF unset): land <pr> ships it to production directly, so there is nothing to promote"
  say "1/4  reading main, production and the $E2E_WF runs for $NAME"
  git fetch -q origin main || die "could not fetch main"
  HEADSHA="$(git rev-parse origin/main)"
  promote_wait_inflight
  PROD="$(production_sha)"
  echo "     main ${HEADSHA:0:7}; production ${PROD:-unrecorded (no GitHub deployment yet: any e2e-green commit qualifies)}"
  # The list is built FIRST and promote_pick reads it from a variable: 26 Sep 2026, the first
  # real --promote piped `git rev-list | while | promote_pick`, promote_pick stopped at its
  # answer, git took SIGPIPE, pipefail made the whole pipeline 141, and `|| CAND=""` threw the
  # right sha away — "nothing to promote" with a green commit sitting right there.
  pick_candidate() {
    local greens list
    greens="$(gh run list --workflow "$E2E_WF" --branch main --status success --limit 100 --json headSha -q '.[].headSha' 2>/dev/null | sort -u)"
    list="$(git rev-list --max-count=50 origin/main | while read -r sha; do
      if grep -qx "$sha" <<<"$greens"; then printf '%s\tgreen\n' "$sha"; else printf '%s\tother\n' "$sha"; fi
    done)"
    promote_pick "$PROD" <<<"$list"
  }
  CAND="$(pick_candidate)" || CAND=""
  if [ -z "$CAND" ] && [ -n "$PROD" ] && [ "$PROD" = "$HEADSHA" ]; then
    say "NOTHING TO PROMOTE — production already runs main's head ${HEADSHA:0:7}."; exit 0
  fi
  if [ -z "$CAND" ] && [ -n "$RUN_E2E" ]; then
    say "2/4  no e2e-green commit newer than production — running $E2E_WF on main ${HEADSHA:0:7} (--run-e2e)"
    # An in-flight run on the head (someone's dispatch) is waited for, not doubled.
    RID=""; CONC=""
    run_e2e_on_main "$HEADSHA" || true
    case "$CONC" in
      could-not-dispatch) die "could not dispatch $E2E_WF on main" ;;
      no-run-appeared) die "dispatched $E2E_WF on main but no run appeared in 2 minutes. Check: gh run list --workflow $E2E_WF" ;;
    esac
    [ "$CONC" = success ] || die "$E2E_WF run $RID on main ${HEADSHA:0:7} ended $CONC. Nothing promoted; production stays on ${PROD:-its current build}. Fix main first: gh run view $RID"
    # That success is exactly what the repo's promote.yml (if any) fires on: wait for it, then
    # read production again — it has usually just shipped this very sha.
    promote_wait_inflight "$HEADSHA"
    PROD="$(production_sha)"
    if [ "$PROD" = "$HEADSHA" ]; then say "NOTHING TO PROMOTE — the repo's own $PROMOTE_WF shipped main's head ${HEADSHA:0:7} on that green run."; exit 0; fi
    CAND="$(pick_candidate)" || CAND=""
  fi
  if [ -z "$CAND" ]; then
    HEADCONC="$(e2e_verdict "$HEADSHA")"
    die "nothing to promote: no main commit newer than production ${PROD:0:7} has a green $E2E_WF run (main head ${HEADSHA:0:7}: ${HEADCONC:-no completed run}). A small change ships on the fast check with: land <pr> (a merged PR is fine). To prove the head with the suite: land --promote $NAME --run-e2e"
  fi
  say "2/4  promoting ${CAND:0:7} — $(git log --format='%s' -1 "$CAND")"
  [ "$CAND" = "$HEADSHA" ] || echo "     (main's head ${HEADSHA:0:7} has no green $E2E_WF run yet; ${CAND:0:7} is the newest that does)"
  say "3/4  deploying production from exactly ${CAND:0:7}"
  if [ -n "$PROMOTE_VIA" ]; then
    promote_dispatch "$CAND" "land --promote: $E2E_WF green on ${CAND:0:7}" || die "$NAME's own $PROMOTE_VIA did not ship ${CAND:0:7}. Production's record is unchanged (still ${PROD:-unrecorded}). Read that run: gh run list --workflow $PROMOTE_VIA"
    say "4/4  smoke + record"
    if [ -n "$SMOKE" ]; then smoke_check "$SMOKE" || die "production deployed from ${CAND:0:7} but the smoke check failed; read the $PROMOTE_VIA run."; fi
    [ "$(production_sha)" = "$CAND" ] || die "$PROMOTE_VIA ran green for ${CAND:0:7} but production's GitHub Deployment record does not name it. Read that run before assuming production moved."
  else
  deploy_at "$CAND" "$DEPLOY" || die "production deploy from ${CAND:0:7} failed — read the error, it explains itself. Production's record is unchanged (still ${PROD:-unrecorded})."
  say "4/4  smoke + record"
  if [ -n "$SMOKE" ]; then smoke_check "$SMOKE" || die "production deployed from ${CAND:0:7} but the smoke check failed. Not recorded; read the deploy output."; fi
  record_production "$CAND" "land --promote from ${CAND:0:7}"
  fi
  say "PROMOTED — $NAME production now runs ${CAND:0:7} (full $E2E_WF green on that sha)."
  exit 0
fi

[ -n "$PR" ] || PR="$(gh pr view --json number -q .number 2>/dev/null)"
[ -n "$PR" ] || die "no PR number given and none open for this branch"

# ALREADY MERGED IS NOT A FAILURE. 21 Sep 2026: Porter's newsletter job landed join-west-peek-main
# #14 on its first LAND run, the run failed on an unrelated read, and the retry ran `land 14` against
# a merged PR — which this script answered "UNKNOWN/UNKNOWN — not landing", so the card never went
# DONE for a change that was live. A merged PR skips verify+merge and goes straight to watching the
# merge commit's run on main and deploying, which is the only work still owed.
PRSTATE="$(gh pr view "$PR" --json state,mergeCommit -q '.state+"/"+(.mergeCommit.oid // "")' 2>/dev/null)"
if [ "${PRSTATE%%/*}" = "MERGED" ]; then
  MERGESHA="${PRSTATE##*/}"
  say "1/5  PR #$PR is already MERGED as ${MERGESHA:0:7} — verifying main and the deploy for it, nothing to merge"
  ALREADY_MERGED=1
else
  ALREADY_MERGED=""
fi

if [ -z "$ALREADY_MERGED" ]; then
say "1/5  verifying PR #$PR myself"
# Never take an agent's word that CI is green: two reported green on red on
# 17 Sep, and one had read `mergeable` (merge conflicts) rather than the checks.
# The checks are read as JSON and judged here, never by gh's exit code, which is 1 both for a
# failing check and for a network error. A valid JSON array IS the answer; anything else is no answer.
if ! CHECKS="$(gh_read '^\[' pr checks "$PR" --json name,bucket,link)"; then
  grep -qi 'no checks reported' <<<"$(gh_err)" && die "PR #$PR has no checks at all — green cannot be verified"
  unverified "$(gh_kind "$(gh_err)")" "the checks on PR #$PR could not be read: $(gh_err)"
fi
jq -r '.[] | "\(.name)\t\(.bucket)\t\(.link)"' <<<"$CHECKS"
[ "$(jq 'length' <<<"$CHECKS")" -gt 0 ] || die "PR #$PR has no checks at all — green cannot be verified"
# EVERY BUCKET, NOT THE EXIT CODE. 21 Sep 2026, boss-os #35: the Playwright job had been CANCELLED
# at its 30-minute cap, `gh pr checks` printed it as "fail" and still exited 0, and this script
# merged a PR whose merge state read UNSTABLE. A cancelled, skipped-by-failure or failing check is
# not green whatever the exit code says; only `pass` (and a genuinely `skipping` job) is.
NOTGREEN="$(jq -r '.[] | select(.bucket != "pass" and .bucket != "skipping") | "\(.name): \(.bucket)"' <<<"$CHECKS")"
[ -z "$NOTGREEN" ] || die "PR #$PR is not green — $(echo "$NOTGREEN" | tr '\n' ';')"
# An EMPTY HEAD IS NOT A HEAD. The merge below is pinned to it, so it must be a real sha.
HEAD="$(gh_read '^[0-9a-f]{40}$' pr view "$PR" --json headRefOid -q .headRefOid)" \
  || unverified "$(gh_kind "$(gh_err)")" "PR #$PR's head commit could not be read: $(gh_err)"
# The stale-checks test reads an Actions run's sha. Only an Actions run link carries a run id —
# a Cloudflare Pages link ends in a uuid whose trailing digits are not one.
RUNID="$(jq -r '[.[] | .link | capture("/actions/runs/(?<id>[0-9]+)") | .id][0] // empty' <<<"$CHECKS")"
if [ -n "$RUNID" ]; then
  RUNSHA="$(gh_read '^[0-9a-f]{40}$' run view "$RUNID" --json headSha -q .headSha)" \
    || unverified "$(gh_kind "$(gh_err)")" "the sha of green run $RUNID could not be read: $(gh_err)"
  [ "$RUNSHA" = "$HEAD" ] || die "the green run is for $RUNSHA but the PR head is $HEAD — stale checks"
fi
# UNKNOWN is GitHub still computing — it answers that for a minute after anything merges to main
# (19 Sep: #132 stopped as UNKNOWN/UNKNOWN seconds after #135 landed, and was clean). Wait it out.
for _ in $(seq 1 12); do
  STATE="$(gh_read '^[A-Z_]+/[A-Z_]+$' pr view "$PR" --json mergeable,mergeStateStatus -q '.mergeable+"/"+.mergeStateStatus')" \
    || unverified "$(gh_kind "$(gh_err)")" "PR #$PR's merge state could not be read: $(gh_err)"
  [ "${STATE%%/*}" = "UNKNOWN" ] || break
  sleep 10
done
[ "${STATE%%/*}" = "MERGEABLE" ] || die "PR #$PR is $STATE — resolve conflicts BY HAND, never with a union script"
case "${STATE##*/}" in
  CLEAN|HAS_HOOKS|UNSTABLE) : ;;   # UNSTABLE is a failing NON-required check; the bucket scan above already refused a real failure
  *) die "PR #$PR merge state is ${STATE##*/} — not landing" ;;
esac
echo "     green, head $HEAD, $STATE"

say "2/5  merging"
# Pinned to the head verified above: a push after the check cannot ride in unverified.
if ! MERGE_OUT="$(gh pr merge "$PR" --squash --match-head-commit "$HEAD" 2>&1)"; then
  echo "$MERGE_OUT"
  # A merge whose ANSWER was lost may still have happened; ask before calling it a failure.
  MSTATE="$(gh_read '^(OPEN|CLOSED|MERGED)$' pr view "$PR" --json state -q .state)" || MSTATE=""
  case "$MSTATE" in
    MERGED) echo "     the merge call errored but PR #$PR reads MERGED — carrying on" ;;
    OPEN) [ "$(gh_kind "$MERGE_OUT")" != api ] && unverified "$(gh_kind "$MERGE_OUT")" "the merge call did not answer and PR #$PR is still open"
          die "merge failed" ;;
    "") unverified "$(gh_kind "$(gh_err)")" "the merge call failed and PR #$PR's state could not be read back — check it: gh pr view $PR" ;;
    *) die "merge failed — PR #$PR is $MSTATE" ;;
  esac
fi
fi

say "3/5  syncing main"
# THE OWNER'S WORKING TREE IS NEVER MUTATED HERE. This step used to `git checkout main && git pull`
# in whatever checkout land ran from. 26 Sep 2026, local-guides-citation-velocity #159: her tree
# carried regenerated artifacts/validation/*.json, the pull aborted, and land said "STOPPED: could
# not sync main" AFTER the merge — a landed PR reported as a failure, main never watched, nothing
# confirmed deployed. Every later step reads origin/main (the API, `git show origin/main:`, or a
# throwaway worktree for a scripted deploy), so all this step NEEDS is the fetch. The local branch
# is fast-forwarded only when that cannot touch her work: on main, and no tracked file changed.
# --- sync begin (tests/test-land-flow.sh) ---
git fetch -q origin main || git fetch -q origin main || die "#$PR IS MERGED, but origin/main could not be fetched. Nothing was deployed. Re-run 'land $PR'."
SYNCED=""
CUR="$(git symbolic-ref -q --short HEAD)"
DIRTY="$(git status --porcelain --untracked-files=no)"
if [ "$CUR" != main ]; then
  echo "     local checkout is on ${CUR:-a detached HEAD} — left exactly as it is; later steps read origin/main"
elif [ -n "$DIRTY" ]; then
  echo "     local main has $(grep -c . <<<"$DIRTY") uncommitted tracked change(s) — left exactly as they are, not fast-forwarded; later steps read origin/main"
elif git merge -q --ff-only origin/main 2>/dev/null; then
  SYNCED=1
else
  echo "     local main has commits origin/main does not — left as it is; later steps read origin/main"
fi
# --- sync end ---
git log --oneline -1 origin/main

say "4/5  watching main to a terminal state"
# A green PR is not a green merge: `pull_request` builds the branch head, not the
# result of merging. Give GitHub a moment to register the run before asking.
sleep 12
# COULD NOT CHECK IS NOT THE SAME AS RED, and conflating them is how a poll lies.
# On 18 Sep 2026 GitHub rate-limited the API mid-watch, `gh run watch` exited non-zero
# having never read a conclusion, and this script announced "main is RED after merging
# #103. Not deploying." Main was green. The merge had landed and the deploy was skipped
# on the strength of an error message about rate limits.
#
# That is the failure CLAUDE.md names: a loop that watches only for the success marker
# hangs or lies through a crash, because silence looks identical to failure. So the
# conclusion is now READ BACK EXPLICITLY and each of the three outcomes is distinct:
# success deploys, failure refuses, and unreadable says so and refuses — a different
# sentence, because the operator's next move is different.
# WHICH RUN IS "MAIN". Since west-peek-os split its Playwright journeys into their own workflow
# (21 Sep 2026), a push to main starts TWO runs, and `[0]` of the list is whichever GitHub
# registered last — a coin flip between the gate and a 20-minute journey suite that the Deploy
# does not even wait for. The run watched here is the one the Deploy waits for: `deploy.yml`
# names it in `workflow_run: workflows: [..]`. A repo with no deploy.yml, or none of that
# workflow's runs on the list, gets the newest run, as before.
# THE WORKFLOW THAT JUDGED THE PR JUDGES THE MERGE. 2 Oct 2026, local-guides-citation-velocity #163
# and #166: that repo has no deploy.yml, so no gate was named and "main's run" was `[0]` of the
# list — a 20-second "CI Health Red Recovery" run. This script printed "completed success" and
# "LANDED — main is green" while Validate Repo on #163's merge commit had been CANCELLED, and the
# release lane went red behind that sentence. The PR's own checks name the workflow that gates this
# repo (PR_WF); pick_run prefers it whenever deploy.yml's gate has no run on the list. Unreadable
# is empty, and empty behaves exactly as before. RUNID is step 1's read; an already-merged PR
# skipped step 1, so its checks are read here (tolerantly: this only chooses which run to watch).
PR_RUNID="${RUNID:-}"
[ -n "$PR_RUNID" ] || PR_RUNID="$(gh pr checks "$PR" --json name,bucket,link 2>/dev/null | jq -r '[.[] | .link | capture("/actions/runs/(?<id>[0-9]+)") | .id][0] // empty' 2>/dev/null || true)"
PR_WF=""
[ -z "$PR_RUNID" ] || PR_WF="$(gh run view "$PR_RUNID" --json workflowName -q '.workflowName // empty' 2>/dev/null || true)"
case "$PR_WF" in *\"*|*\\*) PR_WF="" ;; esac   # never splice a quote or backslash into pick_run's jq filter: fall back to "newest"
# --- pick_run begin (tests/test-land-pick-run.sh evals this block verbatim) ---
# Read from origin/main, not the working tree: the local checkout may be on any branch (step 3).
GATE_WF="$(git show origin/main:.github/workflows/deploy.yml 2>/dev/null | sed -n 's/^ *workflows: *\[ *\([^],]*\).*/\1/p' | head -1 | tr -d '"'"'"' ')"
pick_run() {
  # $1: a jq boolean over one run. Newest matching run of the gate workflow (deploy.yml's); else
  # of the workflow that ran the PR's own checks (PR_WF); else the newest match.
  # The full e2e workflow (E2E_WF, routes block) is never "main's run": production waits for it
  # separately, and the fast check is what a merge is judged on.
  gh run list --branch main --limit 20 --json databaseId,headSha,event,name \
    -q "[.[] | select($1) | select(.name != \"${E2E_WF:-}\")] as \$r | ((\$r | map(select(.name == \"${GATE_WF:-}\")) | .[0]) // (\$r | map(select(.name == \"${PR_WF:-}\")) | .[0]) // \$r[0]) | .databaseId // empty" 2>/dev/null
}
# --- pick_run end ---
# THE RUN FOR THIS MERGE COMMIT, fresh merge or not. 7 Oct 2026 (sprylabs-hpc-site #119): a fresh
# merge took pick_run "true" 12 s after merging, before GitHub had created the merge commit's run,
# and watched a JULY "Validate Repo" run (30281425800) to "failure" - main was red on paper while the
# real run for a8190f1 was still in progress. So the merge sha is read back and its push run is
# waited for (LAND_RUN_APPEAR_SECS, default 180 s); only a repo whose merge starts no run at all
# falls back to the newest run, and says so.
[ -n "${MERGESHA:-}" ] || MERGESHA="$(gh pr view "$PR" --json mergeCommit -q '.mergeCommit.oid // empty' 2>/dev/null || true)"
RID=""
if [ -n "$MERGESHA" ]; then
  APPEAR_DEADLINE=$(( $(date +%s) + ${LAND_RUN_APPEAR_SECS:-180} ))
  while :; do
    RID="$(pick_run ".headSha == \"$MERGESHA\" and .event == \"push\"")"
    [ -n "$RID" ] && break
    [ "$(date +%s)" -ge "$APPEAR_DEADLINE" ] && break
    sleep 10
  done
fi
if [ -z "$RID" ]; then
  RID="$(pick_run "true")"
  [ -z "$RID" ] || echo "     no run for merge commit ${MERGESHA:0:7} appeared in ${LAND_RUN_APPEAR_SECS:-180} s — watching main's newest run instead"
fi
[ -z "$RID" ] || echo "     watching run $RID${PR_WF:+ (the PR was judged by \"$PR_WF\"${GATE_WF:+; deploy.yml gate \"$GATE_WF\"})}"
if [ -z "$RID" ]; then
  die "could not read main's latest run (API error or rate limit). #$PR IS MERGED. Nothing was deployed. Re-run 'land $PR' when the API answers, or deploy by hand once main is green."
fi
# POLL FOR A TERMINAL CONCLUSION. `gh run watch` is not a reliable block: on 18 Sep it returned
# while the run was still `in_progress`, leaving the conclusion empty, and this script reported
# "could not read whether main is green" on a run that was simply not finished yet. Watching is a
# convenience; the terminal state is the contract, so wait for it explicitly.
#
# A transient API error must not end the wait either — that is the same "silence looks like
# failure" trap one layer down. Read errors are tolerated for a while and only become an answer
# if they persist to the deadline.
gh run watch "$RID" >/dev/null 2>&1 || true
CONC=""; STAT=""
DEADLINE=$(( $(date +%s) + 2700 ))   # 45 min: CI here runs ~14 min, twice over is ample
while :; do
  CONC="$(gh run view "$RID" --json conclusion -q '.conclusion' 2>/dev/null)"
  STAT="$(gh run view "$RID" --json status -q '.status' 2>/dev/null)"
  [ -n "$CONC" ] && break
  [ "$(date +%s)" -ge "$DEADLINE" ] && break
  sleep 20
done
echo "     ${STAT:-unknown} ${CONC:-unreadable}"
case "$CONC" in
  success) : ;;
  "")
    die "could not read whether main is green (API error or rate limit). #$PR IS MERGED. Nothing was deployed — this is NOT a failing build, it is an unanswered question. Re-run 'land $PR' when the API answers."
    ;;
  cancelled|skipped)
    # SUPERSEDED ONLY IF SOMETHING SUPERSEDED IT. On 21 Sep 2026 (boss-os #33) the run on main was
    # cancelled with NO later commit behind it — the concurrency group fired on something other
    # than a merge — and this branch declared it superseded, exited 0, and the Deploy workflow
    # skipped: an undeployed main wearing a reassuring sentence. So the claim is checked: if the
    # cancelled run's SHA is still main's head, nothing superseded it, and the run is re-run and
    # watched to its own terminal state instead. Only a run whose commit has been passed by a
    # newer one is superseded.
    RSHA="$(gh run view "$RID" --json headSha -q '.headSha' 2>/dev/null)"
    git fetch -q origin main 2>/dev/null || true
    MSHA="$(git rev-parse origin/main 2>/dev/null)"
    if [ -n "$RSHA" ] && [ "$RSHA" = "$MSHA" ]; then
      say "     cancelled with NO later commit on main — nothing superseded it. Re-running $RID."
      gh run rerun "$RID" >/dev/null 2>&1 || die "could not re-run $RID. #$PR IS MERGED and NOT deployed; main has no green run for $MSHA. Re-run it by hand: gh run rerun $RID"
      sleep 15
      gh run watch "$RID" >/dev/null 2>&1 || true
      CONC=""; DEADLINE=$(( $(date +%s) + 2700 ))
      while :; do
        CONC="$(gh run view "$RID" --json conclusion -q '.conclusion' 2>/dev/null)"
        [ -n "$CONC" ] && [ "$CONC" != "cancelled" ] && break
        [ "$(date +%s)" -ge "$DEADLINE" ] && break
        sleep 20
      done
      echo "     re-run: ${CONC:-unreadable}"
      case "$CONC" in
        success) ;;
        "") die "could not read the re-run's conclusion. #$PR IS MERGED and NOT deployed. Check: gh run view $RID" ;;
        *) die "main is $CONC on the re-run after merging #$PR. Not deploying. Fix main first." ;;
      esac
    else
    # SUPERSEDED IS NOT BROKEN. `ci.yml` sets concurrency with cancel-in-progress, so merging a
    # second PR while the first one's run is still going cancels the first — by design, because
    # validating a commit nobody will deploy is waste. On 18 Sep this script read that as
    # "main is cancelled after merging #101. Not deploying. Fix main first." Nothing was wrong:
    # #104 had merged thirty seconds later and its run was validating BOTH changes.
    #
    # Nothing is deployed from here, and that is correct — the newer run carries this commit and
    # the Deploy workflow fires on it. Saying so is the whole point; the previous wording sent the
    # operator hunting a failure that did not exist.
    say "     superseded — a later merge cancelled this run and is validating your commit too"
    say "#$PR IS MERGED. Not deploying from here: the newer run on main carries it, and the"
    say "Deploy workflow ships on that run's success. Watch it with:  gh run list --branch main"
    exit 0
    fi
    ;;
  *)
    die "main is $CONC after merging #$PR. Not deploying. Fix main first."
    ;;
esac

# A SELF-DEPLOYING REPO IS NOT DEPLOYED UNTIL ITS CLOUDFLARE BUILD SAYS SO. 25 Sep 2026,
# local-guides-generator #48: main's GitHub workflows went green, this script printed "nothing to
# run", and the base Cloudflare Pages project's production build had failed on the merge commit.
# The Cloudflare app posts one check-run per project ("Cloudflare Pages: <project>", "Workers
# Builds: <worker>") on the commit it builds; wait for those to reach a terminal state and refuse
# on any that did not succeed. A repo whose deploy posts no such check (the Actions-driven loop
# repos, ~/bin) gets the old sentence once none has appeared.
# --- pages_watch begin (tests/test-land-pages-watch.sh evals this block verbatim) ---
pages_watch() { # $1 merge sha -> 0 all succeeded | 1 failed or timed out (prints which) | 2 none posted
  local sha="$1" rows pending failed
  local appear_by=$((SECONDS + ${PAGES_APPEAR_SECS:-180})) deadline=$((SECONDS + ${PAGES_WAIT_SECS:-1200}))
  while :; do
    rows="$(gh api "repos/{owner}/{repo}/commits/$sha/check-runs" \
      --jq '.check_runs[] | select(.name | test("^(Cloudflare Pages|Workers Builds)")) | "\(.status)\t\(.conclusion)\t\(.name)"' 2>/dev/null)"
    if [ -z "$rows" ]; then
      [ "$SECONDS" -ge "$appear_by" ] && return 2
    else
      pending="$(printf '%s\n' "$rows" | awk -F'\t' '$1 != "completed"' | wc -l | tr -d ' ')"
      if [ "$pending" = 0 ]; then
        failed="$(printf '%s\n' "$rows" | awk -F'\t' '$2 != "success" && $2 != "skipped" && $2 != "neutral" {print $3 " (" $2 ")"}')"
        [ -z "$failed" ] && return 0
        printf '%s\n' "$failed"
        return 1
      fi
      if [ "$SECONDS" -ge "$deadline" ]; then
        printf 'still running at the deadline: %s\n' "$(printf '%s\n' "$rows" | awk -F'\t' '$1 != "completed" {print $3}' | paste -sd, -)"
        return 1
      fi
    fi
    sleep 15
  done
}
# --- pages_watch end ---

# ~/bin IS PRODUCTION: launchd runs its working copy, so here — and only here — the local checkout
# must move. Her uncommitted work in it is never touched: the fast-forward runs only on main and only
# when no file she has changed is one the incoming commits change (git refuses to clobber either way).
if [ -z "$DEPLOY" ] && { [ "$NAME" = bin ] || [ "$NAME" = seq-bin ]; } && [ -z "$SYNCED" ]; then
  say "5/5  $NAME $SELF"
  [ "$CUR" = main ] || die "#$PR IS MERGED and main is green, but $REPO_DIR is on ${CUR:-a detached HEAD}, not main, so launchd still runs the old scripts. Switch it back: git -C $REPO_DIR checkout main && git -C $REPO_DIR merge --ff-only origin/main"
  OVERLAP="$(comm -12 <(git status --porcelain --untracked-files=no | cut -c4- | sort -u) <(git diff --name-only HEAD origin/main | sort -u))"
  [ -z "$OVERLAP" ] || die "#$PR IS MERGED and main is green, but the merge changes file(s) with uncommitted local edits in $REPO_DIR ($(echo "$OVERLAP" | paste -sd, -)), so it was NOT fast-forwarded and launchd still runs the old scripts. Nothing of hers was touched."
  git merge -q --ff-only origin/main || die "#$PR IS MERGED and main is green, but $REPO_DIR could not fast-forward to origin/main (local commits?), so launchd still runs the old scripts."
  say "LANDED — #$PR is merged, main is green, and $REPO_DIR is at $(git log --oneline -1) (her $(grep -c . <<<"$DIRTY") uncommitted change(s) untouched)."
  exit 0
fi

if [ -z "$DEPLOY" ]; then
  say "5/5  $NAME $SELF — confirming the Cloudflare build(s) on the merge commit"
  MSHA_PAGES="${MERGESHA:-$(gh pr view "$PR" --json mergeCommit -q '.mergeCommit.oid' 2>/dev/null)}"
  [ -n "$MSHA_PAGES" ] || die "#$PR IS MERGED and main is green, but its merge commit could not be read, so the Cloudflare build was not confirmed. Check the check-runs on main."
  PW_OUT="$(pages_watch "$MSHA_PAGES")"; PW=$?
  # A route with PROMOTE_VIA is only STAGED by that build: production moves through the repo's own
  # workflow, and the plan below decides when (small: now, on the fast check; large: after a green
  # suite). Every other self-deploying repo is done here, as before.
  case "$PW" in
    0) if [ -n "$PROMOTE_VIA" ]; then echo "     staging: every Cloudflare build on ${MSHA_PAGES:0:7} succeeded"
       elif [ -n "$DEPLOY_WF" ]; then echo "     every Cloudflare build on ${MSHA_PAGES:0:7} succeeded (upload only — production moves through $DEPLOY_WF)"
       else say "LANDED — #$PR is merged, main is green, and every Cloudflare build on ${MSHA_PAGES:0:7} succeeded."; fi ;;
    2) if [ -n "$PROMOTE_VIA" ]; then echo "     no Cloudflare check-run on ${MSHA_PAGES:0:7}; staging is published by the repo's own workflow on push"
       elif [ -n "$DEPLOY_WF" ]; then echo "     no Cloudflare check-run on ${MSHA_PAGES:0:7}; production moves through $DEPLOY_WF"
       else say "     no Cloudflare check-run on ${MSHA_PAGES:0:7}; $NAME $SELF — nothing to run"; fi ;;
    *) die "#$PR IS MERGED and main's workflows are green, but a Cloudflare build on ${MSHA_PAGES:0:7} did not succeed — that project was NOT updated: $(echo "$PW_OUT" | paste -sd';' -). Fix main now." ;;
  esac
  # A DEPLOY_WF route is not deployed by that build either: production moves only when the repo's
  # own deploy workflow finishes on the merge commit, so it falls through to the wait below.
  { [ -n "$PROMOTE_VIA" ] && [ -n "$E2E_WF" ]; } || [ -n "$DEPLOY_WF" ] || exit 0
  if [ -n "$DEPLOY_WF" ] && ! git cat-file -e "origin/main:.github/workflows/$DEPLOY_WF" 2>/dev/null; then
    die "NAMED STOP [DEPLOY_WF_MISSING] #$PR IS MERGED and main is green, but $NAME's route ships production through .github/workflows/$DEPLOY_WF and origin/main carries no such file, so production was NOT confirmed. Fix the route in ~/bin/land (or restore the workflow)."
  fi
fi

# DO NOT RACE THE WORKFLOW. Since `deploy.yml` landed, a green `main` deploys itself, and this
# script deploying too means two `wrangler d1 migrations apply` runs against the same database at
# once. On 18 Sep they collided four seconds apart: the workflow started at 16:54:25, this script's
# deploy failed at 16:54:29 with a 7403 that reads like a revoked token and was nothing of the kind.
# The workflow's `concurrency` group serialises workflow runs; it cannot see a laptop.
#
# So where the repo deploys itself, this script WAITS and reports rather than competing. It still
# has a job: confirming the deploy actually happened. An automation nobody checks is how "merged"
# and "shipped" came apart in the first place.
# A ROUTE WITH E2E_WF IS NOT DEPLOYED BY GREEN MAIN. Since 26 Sep 2026 boss-os's deploy.yml fires on
# the nightly e2e workflow, not on CI: after a merge there is no Deploy run to wait for, and the
# newest "Deploy" on the list would be an OLDER commit's — "LANDED, the Deploy workflow shipped it"
# about a deploy that never happened. Those routes fall through to the plan below.
# Read from origin/main, not the working tree: the local checkout may be on any branch (step 3).
# The run is found BY THE MERGE COMMIT (deploy_wf_pick), never "the newest run named Deploy": that
# was an older commit's run whenever this one had not appeared yet, and a workflow named anything
# else ("Deploy Cloudflare Worker") was never found at all.
# --- deploy_wf begin (tests/test-land-routes.sh evals this block verbatim) ---
# deploy_wf_pick SHA < rows "id<TAB>headSha<TAB>status<TAB>conclusion", newest first -> the newest
# run whose headSha CONTAINS sha (it, or a later main commit — a concurrency group that cancels an
# older run in progress ships the newer one, which carries this merge), skipping runs that were
# skipped (the job's `if` refused that trigger) or cancelled (superseded). Prints
# "id<TAB>status<TAB>conclusion", or nothing when no such run exists yet. contains_sha is
# overridable (tests); here it asks git.
contains_sha() { [ "$1" = "$2" ] || git merge-base --is-ancestor "$1" "$2" 2>/dev/null; } # $1 sha  $2 later?
deploy_wf_pick() {
  local sha="$1" rid head st conc
  while IFS=$'\t' read -r rid head st conc || [ -n "$rid" ]; do
    [ -n "$rid" ] || continue
    case "$conc" in skipped|cancelled) continue ;; esac
    contains_sha "$sha" "$head" || continue
    printf '%s\t%s\t%s\n' "$rid" "$st" "$conc"; return 0
  done
  return 0
}
# --- deploy_wf end ---
DEPLOY_WF="${DEPLOY_WF:-deploy.yml}"
if git cat-file -e "origin/main:.github/workflows/$DEPLOY_WF" 2>/dev/null && [ -z "$E2E_WF" ]; then
  say "5/5  $NAME deploys itself on green main through $DEPLOY_WF — waiting for its run on the merge commit rather than racing it"
  DMSHA="${MERGESHA:-$(gh pr view "$PR" --json mergeCommit -q '.mergeCommit.oid' 2>/dev/null)}"
  [ -n "$DMSHA" ] || die "#$PR IS MERGED and main is green, but its merge commit could not be read, so the $DEPLOY_WF run was not found. Production NOT confirmed: gh run list --workflow $DEPLOY_WF"
  git fetch -q origin main 2>/dev/null || true
  DCEIL=$(( $(last_duration "$DEPLOY_WF") * 3 / 2 )); [ "$DCEIL" -ge "${LAND_WAIT_FLOOR_SECS:-360}" ] || DCEIL=${LAND_WAIT_FLOOR_SECS:-360}
  DAPPEAR=$((SECONDS + ${LAND_DEPLOY_APPEAR_SECS:-300})); DSEEN=""
  while :; do
    DROWS="$(gh run list --workflow "$DEPLOY_WF" --limit 20 --json databaseId,headSha,status,conclusion \
              -q '.[] | "\(.databaseId)\t\(.headSha)\t\(.status)\t\(.conclusion // "")"' 2>/dev/null)"
    DPICK="$(deploy_wf_pick "$DMSHA" <<<"$DROWS")"
    if [ -z "$DPICK" ]; then
      DSEEN="$(awk -F'\t' -v s="$DMSHA" '$2 == s {print $1 " " $4}' <<<"$DROWS" | paste -sd, -)"
      [ "$SECONDS" -lt "$DAPPEAR" ] || die "NAMED STOP [DEPLOY_RUN_NOT_FOUND] #$PR IS MERGED and main is green, but no $DEPLOY_WF run that ships ${DMSHA:0:7} appeared in $(( ${LAND_DEPLOY_APPEAR_SECS:-300} / 60 )) min${DSEEN:+ (only skipped/cancelled: $DSEEN)}. Production NOT confirmed: gh run list --workflow $DEPLOY_WF"
      sleep 15; git fetch -q origin main 2>/dev/null || true; continue
    fi
    IFS=$'\t' read -r DRID DST DCONC <<<"$DPICK"
    if [ "$DST" != completed ]; then
      echo "     $DEPLOY_WF run $DRID ($DST) — waiting (ceiling $((DCEIL / 60)) min, 1.5x its last completed run)"
      DCONC="$(wait_run_bounded "$DRID" "$DCEIL")" || true
      [ "$DCONC" != cancelled-at-ceiling ] || die "NAMED STOP [DEPLOY_RUN_PAST_CEILING] #$PR IS MERGED, but $DEPLOY_WF run $DRID ran past $((DCEIL / 60)) min and was cancelled. Production NOT confirmed: gh run view $DRID"
      # Superseded while we waited (concurrency cancel-in-progress): the newer run carries this merge.
      [ "$DCONC" != cancelled ] || { echo "     run $DRID was cancelled (superseded) — looking for the run that carries ${DMSHA:0:7}"; DAPPEAR=$((SECONDS + ${LAND_DEPLOY_APPEAR_SECS:-300})); continue; }
    fi
    break
  done
  case "$DCONC" in
    success) if [ -n "$SMOKE" ]; then smoke_check "$SMOKE" || die "#$PR IS MERGED and $DEPLOY_WF run $DRID finished green, but the production smoke check failed. Read that run: gh run view $DRID"; fi
             say "LANDED — #$PR is merged, main is green, and $DEPLOY_WF run $DRID shipped ${DMSHA:0:7} to production."; exit 0 ;;
    "")      die "#$PR IS MERGED and main is green, but $DEPLOY_WF run $DRID's outcome could not be read. Check it before assuming production changed: gh run view $DRID" ;;
    *)       die "#$PR IS MERGED and main is green, but $DEPLOY_WF run $DRID finished $DCONC. Production was NOT updated (or not proven). Read that run: gh run view $DRID --log-failed" ;;
  esac
fi

if [ -z "$E2E_WF" ] && [ -z "$STAGING" ]; then
  say "5/5  deploying"
  # Never a bare `wrangler deploy`: it ships a stale client and the LOCAL DEV
  # bindings. On 17 Sep it tried to push WP_OS_ENV "local" and a dev passcode to
  # production and failed only because of an unrelated error.
  # FROM origin/main, NEVER FROM HER CHECKOUT. Step 3 no longer switches or pulls her tree, so the
  # deploy runs through deploy_at: a throwaway detached worktree of the commit main just went green
  # on, removed afterwards.
  DSHA="$(git rev-parse origin/main 2>/dev/null)"
  [ -n "$DSHA" ] || die "#$PR IS MERGED and main is green, but origin/main could not be read here, so nothing was deployed. Re-run 'land $PR'."
  deploy_at "$DSHA" "$DEPLOY" || die "deploy failed — read the error, it explains itself (a missing CLOUDFLARE_ACCOUNT_ID surfaces as a 7403 that reads like permissions and is not)"
  say "LANDED — #$PR is merged, main is green, and it is in production."
  exit 0
fi

# STAGING NOW; PRODUCTION AS THE PLAN DECIDES (routes with STAGING / E2E_WF / PROMOTE_VIA; header).
MSHA="${MERGESHA:-$(gh pr view "$PR" --json mergeCommit -q '.mergeCommit.oid' 2>/dev/null)}"
[ -n "$MSHA" ] || die "#$PR IS MERGED and main is green, but its merge commit could not be read, so nothing was deployed. Re-run 'land $PR'."
E2E_CONC=""; REASON=""; LAST=""; PROD_STATE=""; SMALL_NOTE=""
if [ -n "$E2E_WF" ]; then
  E2E_CONC="$(e2e_verdict "$MSHA")"
  PROD_STATE="$(production_state)"
  # NEVER BACKWARDS, NEVER TWICE. Landing an already-merged PR again (a retry, or shipping what an
  # older land left on staging) must not roll production back to an older commit, nor deploy the
  # sha it already runs a second time.
  case "$PROD_STATE" in unrecorded|unreadable) : ;; *)
    if [ "$PROD_STATE" = "$MSHA" ] || git merge-base --is-ancestor "$MSHA" "$PROD_STATE" 2>/dev/null; then
      say "5/5  LANDED — #$PR is merged, main is green, and production already runs ${PROD_STATE:0:7}$([ "$PROD_STATE" = "$MSHA" ] || echo ", which contains ${MSHA:0:7}") (GitHub Deployment record). Nothing to deploy."
      exit 0
    fi ;;
  esac
  if [ "$E2E_CONC" != success ]; then
    # Measured, never guessed: this PR, then every other change production has not seen.
    pr_size "$PR"
    if [ -n "$RUN_E2E" ]; then REASON="--run-e2e given"
    else
      REASON="$(pr_large_reason)" || REASON=""
      [ -n "$REASON" ] || REASON="$(unshipped_large_reason "$PROD_STATE" "$MSHA")" || REASON=""
    fi
    if [ -z "$REASON" ]; then
      LAST="$(e2e_last_verdict)"
      SMALL_NOTE="small change: $((PR_ADD + PR_DEL)) lines, $PR_FILES files; shipped on the fast check, e2e on demand"
    fi
  fi
fi
PLAN="$(land_plan "${DEPLOY:-$PROMOTE_VIA}" "$STAGING" "$E2E_WF" "$E2E_CONC" "$REASON" "${LAST%%$'\t'*}")"
say "5/5  ${MSHA:0:7}: $PLAN${E2E_WF:+ ($E2E_WF on this sha: ${E2E_CONC:-no completed run})}"
ship_production() { # $1 sha  $2 deployment note
  say "     production <- ${1:0:7}"
  if [ -n "$PROMOTE_VIA" ]; then
    promote_dispatch "$1" "$2" || die "#$PR IS MERGED and main is green, but $NAME's own $PROMOTE_VIA did not ship ${1:0:7} — production untouched. Read that run: gh run list --workflow $PROMOTE_VIA"
    if [ -n "$SMOKE" ]; then smoke_check "$SMOKE" || die "#$PR deployed to production from ${1:0:7} but the smoke check failed; read the $PROMOTE_VIA run."; fi
    [ "$(production_sha)" = "$1" ] || die "#$PR IS MERGED and $PROMOTE_VIA ran green for ${1:0:7}, but production's GitHub Deployment record does not name it. Read that run before assuming production moved."
    echo "     recorded by $PROMOTE_VIA: production = ${1:0:7}"
  else
  deploy_at "$1" "$DEPLOY" || die "#$PR IS MERGED and main is green, but the production deploy from ${1:0:7} failed — read the error, it explains itself (a missing CLOUDFLARE_ACCOUNT_ID surfaces as a 7403 that reads like permissions and is not)."
  if [ -n "$SMOKE" ]; then smoke_check "$SMOKE" || die "#$PR deployed to production from ${1:0:7} but the smoke check failed. Not recorded; read the deploy output."; fi
  [ -z "$E2E_WF" ] || record_production "$1" "$2"
  fi
  say "LANDED — #$PR is merged, main is green, ${STAGING:+staging and }production run ${1:0:7}."
}
for step in $PLAN; do
  case "$step" in
    staging)
      say "     staging <- ${MSHA:0:7}"
      deploy_at "$MSHA" "$STAGING" || die "#$PR IS MERGED and main is green, but the STAGING deploy from ${MSHA:0:7} failed — read the error, it explains itself. Production untouched."
      ;;
    production)
      if [ -z "$SMALL_NOTE" ]; then
        ship_production "$MSHA" "land #$PR from ${MSHA:0:7}"
      else
        # A SMALL CHANGE SHIPS ON THE FAST CHECK (owner, 2 Oct 2026; header). The reason is printed
        # here and recorded on the production deployment. A repo promote run already in flight (a
        # green e2e someone dispatched) is waited for first, never deployed on top of.
        say "     SMALL CHANGE — $SMALL_NOTE (last $E2E_WF verdict on main: ${LAST%%$'\t'*}). To prove it with the suite instead: land $PR --run-e2e"
        promote_wait_inflight
        if [ "$(production_sha)" = "$MSHA" ]; then say "LANDED — #$PR is merged, main is green, and the repo's own $PROMOTE_WF already shipped ${MSHA:0:7} to production."
        else ship_production "$MSHA" "land #$PR, $SMALL_NOTE"; fi
      fi
      ;;
    blocked)
      # KNOWN RED BLOCKS A SMALL CHANGE (header). Unread is not "not red": a different stop, exit 75.
      if [ -z "$LAST" ] && { [ -z "$E2E_CONC" ] || [ "$E2E_CONC" = cancelled ] || [ "$E2E_CONC" = skipped ]; }; then
        printf '\n\033[31mSTOPPED: could not verify (%s) — the %s history on main could not be read, so "the suite is not known red" is unproven: %s. #%s IS MERGED%s; production untouched. Land again when GitHub answers: land %s\033[0m\n' \
          "$(gh_kind "$(gh_err)")" "$E2E_WF" "$(gh_err)" "$PR" "${STAGING:+, staging runs ${MSHA:0:7}}" "$PR"
        exit "$LAND_RC_UNVERIFIED"
      fi
      IFS=$'\t' read -r LCONC LRID LSHA <<<"$LAST"
      case "$E2E_CONC" in ""|cancelled|skipped) : ;; *) LCONC="$E2E_CONC"; LRID=""; LSHA="$MSHA" ;; esac
      die "NAMED STOP [E2E_KNOWN_RED] $E2E_WF is known red on main: ${LRID:+run $LRID }on ${LSHA:0:7} ended $LCONC and no green run is newer. #$PR is small ($((PR_ADD + PR_DEL)) lines, $PR_FILES files) and would have shipped on the fast check, but a known-red suite is never shipped past. ${STAGING:+Staging runs ${MSHA:0:7}; }production untouched. Fix main, then: land $PR --run-e2e${LRID:+   (the red run: gh run view $LRID)}"
      ;;
    suite)
      # A LARGE CHANGE RUNS THE SUITE NOW (owner, 2 Oct 2026; header). The e2e workflows are
      # dispatch-only, so after a merge nothing runs them unless this does. Measured, never guessed:
      # the reason is printed here and recorded on the production deployment.
      say "     LARGE CHANGE — $REASON: running $E2E_WF on main before production"
      git fetch -q origin main 2>/dev/null || true
      HEADSHA="$(git rev-parse origin/main 2>/dev/null)"; [ -n "$HEADSHA" ] || HEADSHA="$MSHA"
      [ "$HEADSHA" = "$MSHA" ] || echo "     main has moved on to ${HEADSHA:0:7} since #$PR merged — the suite proves that head, which contains #$PR"
      RID=""; CONC=""
      run_e2e_on_main "$HEADSHA" || true
      case "$CONC" in
        could-not-dispatch) die "NAMED STOP [E2E_NOT_DISPATCHED] could not dispatch $E2E_WF on main for #$PR ($REASON). ${STAGING:+Staging runs ${MSHA:0:7}; }production untouched. Run it: land --promote $NAME --run-e2e" ;;
        no-run-appeared) die "NAMED STOP [E2E_NOT_DISPATCHED] dispatched $E2E_WF on main for #$PR ($REASON) but no run appeared in 2 minutes. ${STAGING:+Staging runs ${MSHA:0:7}; }production untouched. Check: gh run list --workflow $E2E_WF" ;;
        success) : ;;
        *) die "NAMED STOP [E2E_RED_AFTER_LARGE_CHANGE] $E2E_WF run $RID on main ${HEADSHA:0:7} ended $CONC after #$PR ($REASON). ${STAGING:+Staging runs ${MSHA:0:7}; }production untouched. Fix main first: gh run view $RID" ;;
      esac
      # That success is exactly what the repo's own promote workflow (if any) fires on: wait for it,
      # then read production — it has usually just shipped this very sha.
      promote_wait_inflight "$HEADSHA"
      PROD="$(production_sha)"
      if [ "$PROD" = "$HEADSHA" ]; then say "LANDED — #$PR is merged, $E2E_WF is green on ${HEADSHA:0:7} ($REASON), and the repo's own $PROMOTE_WF shipped it to production."
      else ship_production "$HEADSHA" "land #$PR, large change ($REASON), $E2E_WF green on ${HEADSHA:0:7}"; fi
      ;;
  esac
done
exit 0
