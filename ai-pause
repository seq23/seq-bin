#!/bin/bash
# ai-pause — her ONE pause for every scheduled AI job (her yes 25 Nov 2026; built 27 Nov 2026).
#
#   ai-pause 2026-11-29   pause until that date (jobs run again ON that date)
#   ai-pause 1            pause for 1 day (until tomorrow); any whole number of days
#   ai-pause off          end the pause now
#   ai-pause status       say whether a pause is on
#
# It writes one date to ~/.boss-os/ai-pause-until. ai-run (every scheduled job's runner) and post-land-check
# read that file: until the date, no model runs, each job says NAMED STOP [PAUSED] and keeps its place, and the
# first slot on or after the date runs the work. Nothing is lost and the file expires by its own date.
# Runs she starts by hand with AI_RUN_IGNORE_PAUSE=1 are not paused. Jobs that reach a model without ai-run are
# not covered; `ai-pause status` says so every time, so the pause is never taken for more than it is.
set -uo pipefail
FILE="${AI_RUN_PAUSE_FILE:-$HOME/.boss-os/ai-pause-until}"
today="$(date +%Y-%m-%d)"
status() {
  if [ ! -e "$FILE" ]; then echo "ai-pause: no pause. Scheduled AI jobs run as usual."; return 0; fi
  local d; d="$(tr -d '[:space:]' < "$FILE" 2>/dev/null)"
  if ! [[ "$d" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    echo "ai-pause: PAUSED, but $FILE holds no readable date, so it will not end by itself. Run: ai-pause <date> or ai-pause off"; return 0
  fi
  if [[ "$today" < "$d" ]]; then echo "ai-pause: PAUSED until $d. Every job that runs through ai-run waits and runs on $d. (Jobs that reach a model without ai-run are not covered.)"
  else echo "ai-pause: no pause (the last one ended $d). Scheduled AI jobs run as usual."; fi
}
case "${1:-status}" in
  status) status ;;
  off) rm -f "$FILE" || { echo "NAMED STOP [PAUSE_NOT_CLEARED] could not remove $FILE"; exit 1; }; status ;;
  *)
    if [[ "$1" =~ ^[0-9]{1,3}$ ]] && [ "$1" -gt 0 ]; then
      until="$(date -v+"$1"d +%Y-%m-%d 2>/dev/null || date -d "+$1 day" +%Y-%m-%d)"
    elif [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && { date -j -f %Y-%m-%d "$1" +%s >/dev/null 2>&1 || date -d "$1" +%s >/dev/null 2>&1; }; then
      until="$1"
    else
      echo "NAMED STOP [BAD_DATE] '$1' is not a date (YYYY-MM-DD), a number of days, off or status. Nothing changed."; exit 64
    fi
    [[ "$today" < "$until" ]] || { echo "NAMED STOP [DATE_NOT_AHEAD] $until is not after today ($today), so it would pause nothing. Nothing changed."; exit 64; }
    mkdir -p "$(dirname "$FILE")" && printf '%s\n' "$until" > "$FILE.tmp" && mv "$FILE.tmp" "$FILE" \
      || { echo "NAMED STOP [PAUSE_NOT_WRITTEN] could not write $FILE; nothing is paused."; exit 1; }
    status ;;
esac
