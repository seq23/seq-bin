#!/bin/bash
# land-after — hand the wait for CI and the land to a cheap detached script, so an agent never pays to wait.
#
# WHY THIS EXISTS (her words, 22 Nov 2026): "Hand waiting to a script, not an agent ... it ends there and
# a cheap script finishes the job." The token review that day measured polling CI and the cache rewrites
# after each wait at 14-20% of all usage. A builder whose PR is ready (a review-class PR: with its fresh reviewer's PASS) runs
#
#   land-after <pr> [--task <slug>] [--repo owner/name] [--then "<cmd>"]...
#
# and ends its turn. This prints ONE line (pid + log) and exits 0 at once; a detached worker (its own
# session, so it outlives the agent's shell) waits for the PR's checks (bounded), runs `land <pr>` (the ONE
# lander; this never merges by itself), confirms the merge on GitHub, runs each --then in order, and writes
# the result where the next reader finds it:
#   ~/Work/tasks/<slug>.md      line 1 `STATUS: landing|PASS|FAIL <owner/repo>#<pr> <sha> <date>[ — <step>; log <path>]`
#                               PASS → moved to ~/Work/tasks/done/; FAIL stays open for the coordinator, who
#                               reads line 1 and fixes it that session. Never a row on her Open Loops list (her
#                               ruling 22 Nov 2026: "they should have been done today and 0 out").
#                               DONE MEANS CHECKED (her order 24 Nov 2026): a land whose PR declared a real Outcome
#                               is `STATUS: LANDED-UNCHECKED … — landed, not yet proven: outcome check due <day>`
#                               and stays open; post-land-check turns it DONE (moved to done/) only on the live
#                               outcome PASS, or FAIL ("outcome NOT WORKING"). The PR's `## Not built` is copied
#                               word for word under line 1 on every land, so nothing cut is hidden.
#                               A LANDED-UNCHECKED land then runs open-loops-proof.mjs --sync (env LAND_AFTER_LOOPS_SYNC,
#                               tests), so the PR's "Landed, not yet proven" row exists at once (28 Nov 2026). That is
#                               a row on HER list's proving section only, never the main list; a failed sync never
#                               fails the land (tonight's post-land-check sync retries it).
#   ~/Work/tasks/logs/<slug>-<pr>.log   everything land printed, secrets masked.
#
#   land-after --status      one line per open sheet (its line 1 and path), for HANDOFF's Jobs list; a
#                            `landing` sheet with no live worker, or older than 90 min, is "stale"; any open
#                            sheet untouched 7+ days is "stale". LANDED-UNCHECKED shows "[landed, not yet proven:
#                            outcome check due <day>]", or "[NOT CHECKED …]" once 2+ days past it (an unreadable
#                            day counts as late); DONE shows "[done: live outcome checked]". Neither is running.
#   land-after --self-test   runs tests/test-land-after.sh.
#   land-after --holds <owner/repo> <pr>   rc 0 (pid on stdout) while a live land holds that PR; 1 when none does.
#   land-after <pr> ... --dry-run          every check, then "would land": nothing written, locked or started.
#   BEFORE ANYTHING STARTS it runs land's read-only `land --check <pr>` and refuses AT ONCE with the full list of
#   what the PR's description still lacks, each with the line to add (pr-body-template.md carries them all).
#   A refusal exits 1, except "it needs a fresh reviewer's PASS first" (none, voided, stale, builder-signed,
#   no Engineering, or a protected PR's REVIEW_REQUIRED): exit 4, so pr-watch can say "needs a reviewer" without reading the words.
#
#   land-after --sweep       (nightly, housekeeping.sh) a `landing` sheet whose worker is gone (power loss,
#                            kill -9) becomes FAIL unknown on its sheet, so nothing waits unseen.
#
# A sheet is one job's: line 1 naming another <owner/repo>#<n> is refused, and one land at a time holds each
# PR and each sheet (two atomic locks). The PASS line may stand in the body or in a comment by the repo's
# owner account (land's review_text). Never PASS on a guess: a GitHub read that does not answer is asked
# again with backoff for LAND_AFTER_READ_PATIENCE_SECS (10 min), and a spent allowance is waited out to its
# reset when that falls inside the wait; only then is it `FAIL unknown: <reason>`. land exiting 0 with the
# PR not merged is `FAIL NAMED STOP [LAND_MERGED_NOTHING]` (Rule 0).
# Every run deletes files older than 14 days in done/ and logs/ only, never a log an open sheet names.
# Open sheets are never deleted.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SELF="$HERE/$(basename "${BASH_SOURCE[0]}")"
TASKS="${LAND_AFTER_TASKS:-$HOME/Work/tasks}"
DONE="$TASKS/done"; LOGS="$TASKS/logs"; LOCKS="$TASKS/locks"
DUE_FILE="$TASKS/post-land-checks.md"   # the post-land-check list (land writes it): in this folder, never a task sheet
LAND_BIN="${LAND_AFTER_LAND:-$HERE/land}"          # tests point this at a fake lander
LAND_SRC="$HERE/land"                               # the gates block is read from the real one
LAND_DIR="${LAND_DIR:-$HERE}"                    # land-surfaces.json sits beside land (the gates read it)
POLL="${LAND_AFTER_POLL_SECS:-30}"
CHECKS_MAX="${LAND_AFTER_CHECKS_MAX_SECS:-2700}"    # 45 min for the PR's checks to finish
APPEAR_MAX="${LAND_AFTER_APPEAR_SECS:-300}"         # 5 min for checks to show up at all
RETRY="${LAND_AFTER_RETRY_SECS:-2}"                # first backoff step; doubles to 60 s
PATIENCE="${LAND_AFTER_READ_PATIENCE_SECS:-600}"    # how long one unanswered GitHub read is asked again
START_WAIT="${LAND_AFTER_START_WAIT_SECS:-15}"      # how long the starter waits to see its worker running
KEEP_MIN=$((14 * 1440)); STALE_LANDING_MIN=90; STALE_OPEN_MIN=$((7 * 1440))

say() { printf 'land-after: %s\n' "$*"; }
refuse() { say "REFUSED — $*"; exit 1; }
now() { date '+%Y-%m-%dT%H:%M'; }
age_min() { perl -e '@s = stat $ARGV[0] or exit 1; print int((time - $s[9]) / 60)' "$1"; }
valid_slug() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$ ]] && [[ "$1" != *..* ]]; }
alive() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null && ps -p "$1" -o command= 2>/dev/null | grep -q 'land-after'; }
# Mask anything that looks like a credential before it reaches a log (line-buffered, so the log is live).
redact() {
  perl -pe 'BEGIN { $| = 1 }
    s/\e\[[0-9;]*[A-Za-z]//g;
    s/\b(gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{16,}|xox[abprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|olt_[A-Za-z0-9_]{8,}|npm_[A-Za-z0-9]{30,}|AIza[0-9A-Za-z_-]{30,}|eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,})/[masked]/g;
    s/(?<![A-Za-z0-9_-])(?=[A-Za-z0-9_-]{40}(?![A-Za-z0-9_-]))(?=[A-Za-z0-9_-]*[A-Z])(?=[A-Za-z0-9_-]*[0-9])[A-Za-z0-9_-]{40}/[masked]/g;
    s/((?:authorization|bearer)[:= ]+)(?:bearer\s+)?\S+/$1\[masked]/gi;
    s/\b((?:[A-Z0-9_]*(?:TOKEN|SECRET|PASSWORD|PASSCODE|API_KEY|APIKEY))=)\S+/$1\[masked]/g;'
}
cleanup() { # done/ and logs/ only, files only, older than 14 days only; a log an open sheet names is evidence, kept
  local f
  [ -d "$DONE" ] && find "$DONE" -maxdepth 1 -type f -mmin +"$KEEP_MIN" -delete 2>/dev/null
  [ -d "$LOGS" ] && find "$LOGS" -maxdepth 1 -type f -mmin +"$KEEP_MIN" -print 2>/dev/null | while IFS= read -r f; do
    grep -qsF -- "$f" "$TASKS"/*.md || rm -f -- "$f"
  done
  return 0
}
repo_of_dir() { git -C "$1" remote get-url origin 2>/dev/null | sed -nE 's#\.git$##; s#.*github\.com[:/]([^/]+/[^/]+)$#\1#p'; }
slug_lock() { printf '%s/slugs/%s.lock' "$LOCKS" "$1"; }
lock_pid_for_slug() { cat "$(slug_lock "$1")/pid" 2>/dev/null; }
pr_lock() { printf '%s/%s-%s.lock' "$LOCKS" "${1//\//_}" "$2"; }   # $1 owner/repo $2 PR -> its lock dir
lock_holder() { # $1 lock dir -> rc 0 with its live holder (pid, or "starting") on stdout | 1 free or held by a dead land
  local l="$1" holder
  [ -d "$l" ] || return 1
  holder="$(cat "$l/pid" 2>/dev/null || true)"
  if alive "$holder" || { [ -z "$holder" ] && [ "$(age_min "$l" || echo 99)" -lt 2 ]; }; then printf '%s' "${holder:-starting}"; return 0; fi
  return 1
}
take_lock() { # $1 lock dir -> rc 0 taken | 1 held by a live land (its pid, or "starting", on stdout). A dead holder's lock is taken over.
  local l="$1"
  mkdir "$l" 2>/dev/null && return 0
  lock_holder "$l" && return 1
  drop_lock "$l"; mkdir "$l" 2>/dev/null && return 0
  printf 'unknown'; return 1
}
drop_lock() { [ -n "$1" ] && [ -d "$1" ] || return 0; rm -f "$1"/pid "$1"/slug "$1"/then; rmdir "$1" 2>/dev/null; return 0; }
sheet_owner() { # $1 slug -> the <owner/repo>#<n> its line 1 names (empty when it names none)
  head -1 "$TASKS/$1.md" 2>/dev/null | grep -oE '[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+' | head -1
}

# --- GitHub's rate limit, read with land's own functions (one definition, never a copy); the gates run as `land --check` ---
load_land_blocks() {
  local block
  block="$(sed -n '/^# --- gates begin/,/^# --- gates end/p' "$LAND_SRC" 2>/dev/null)"
  [ -n "$block" ] || return 1
  eval "$block"
  declare -F is_rate_limit rate_reset_in >/dev/null
}

# --- task sheet: only ever $TASKS/<slug>.md (and its move to done/) ---
SHEET_REPO=""; SHEET_PR=""; SHEET_TITLE=""; SHEET_URL=""; SHEET_BRANCH=""
new_sheet() { # $1 path $2 status line
  printf '%s\nGoal: land %s#%s (%s)\nBranch/PR/worktree: %s / %s / (sheet created by land-after)\nDone:\nNext:\n- land-after finishes the land and writes the result on line 1\nOpen questions:\nGotchas found:\n' \
    "$2" "$SHEET_REPO" "$SHEET_PR" "$SHEET_TITLE" "${SHEET_BRANCH:-?}" "${SHEET_URL:-?}" > "$1"
}
set_status() { # $1 slug  $2 full status line. A missing sheet is recreated, never a lost result.
  local f="$TASKS/$1.md" tmp
  tmp="$(mktemp "$TASKS/.$1.XXXXXX")" || return 1
  if [ -f "$f" ]; then
    if head -1 "$f" | grep -q '^STATUS:'; then { printf '%s\n' "$2"; tail -n +2 "$f"; } > "$tmp"
    else { printf '%s\n' "$2"; cat "$f"; } > "$tmp"; fi
  else new_sheet "$tmp" "$2"; fi
  mv -f "$tmp" "$f"
}
add_not_built() { # $1 slug $2 pr $3 the PR's "## Not built" text from land. Under line 1; a re-run replaces its own block.
  [ -n "$3" ] || return 0
  local f="$TASKS/$1.md" tmp
  [ -f "$f" ] || return 0
  tmp="$(mktemp "$TASKS/.$1.XXXXXX")" || return 1
  if NB="$3" PRN="$2" python3 -c '
import os, re, sys
lines = open(sys.argv[1]).read().split("\n")
head, rest = lines[:1], "\n".join(lines[1:])
rest = re.sub(r"(?s)^## Not built \(PR #\d+, from land\)\n.*?\n## End Not built\n", "", rest)
block = "## Not built (PR #%s, from land)\n%s\n## End Not built\n" % (os.environ["PRN"], os.environ["NB"].rstrip("\n"))
sys.stdout.write("\n".join(head) + "\n" + block + rest)
' "$f" > "$tmp"; then mv -f "$tmp" "$f"; else rm -f "$tmp"; return 1; fi
}
add_note() { printf -- '- %s land-after: %s\n' "$(now)" "$2" >> "$TASKS/$1.md"; }
move_done() { # $1 slug -> done/<slug>.md (an older done copy of the same slug is kept, the new one is dated)
  local dest="$DONE/$1.md"
  [ -e "$dest" ] && dest="$DONE/$1.$(date '+%Y%m%d-%H%M%S').md"
  mv "$TASKS/$1.md" "$dest" && printf '%s\n' "$dest"
}

# ============================== --sweep (nightly) ==============================
# A worker killed outright (power loss, forced shutdown, kill -9) runs no trap and files nothing; its sheet
# would say "landing" until someone reads --status. This turns each such sheet into a FAIL on line 1.
sweep() {
  local f slug line rp repo pr pid n=0
  for f in "$TASKS"/*.md; do
    [ -f "$f" ] || continue
    slug="$(basename "$f" .md)"; line="$(head -1 "$f")"
    case "$line" in "STATUS: landing"*) ;; *) continue ;; esac
    pid="$(lock_pid_for_slug "$slug" || true)"
    alive "$pid" && continue
    [ "$(age_min "$f" || echo 0)" -ge 2 ] || continue        # a land that is starting right now
    rp="$(sheet_owner "$slug")"; repo="${rp%#*}"; pr="${rp##*#}"
    [ -n "$rp" ] || { repo="?"; pr="?"; }
    set_status "$slug" "STATUS: FAIL $rp $(awk '{print $4}' <<<"$line") $(now) — unknown: the land-after worker is gone (power loss, forced shutdown or kill); nothing says whether it merged. Read the log, then run land-after again; log $LOGS/$slug-$pr.log"
    drop_lock "$(slug_lock "$slug")"
    n=$((n + 1)); say "$slug: landing with no live worker -> FAIL unknown"
  done
  echo "OUTPUT land-after sweep: $n dead land(s) filed"
}

# ============================== --status ==============================
status() {
  cleanup
  local f slug line flags pid age n=0
  for f in "$TASKS"/*.md; do
    [ -f "$f" ] || continue
    [ "$f" = "$DUE_FILE" ] && continue
    n=$((n + 1)); slug="$(basename "$f" .md)"; line="$(head -1 "$f")"; flags=""
    age="$(age_min "$f" || echo 0)"
    case "$line" in
      "STATUS: landing"*)
        pid="$(lock_pid_for_slug "$slug" || true)"
        if ! alive "$pid"; then flags="  [stale: landing, no land running]"
        elif [ "$age" -ge "$STALE_LANDING_MIN" ]; then flags="  [stale: landing ${age}m, pid $pid past 90 min]"
        else flags="  [running: pid $pid, ${age}m]"; fi ;;
      "STATUS: LANDED-UNCHECKED"*) # landed, its live outcome not yet checked: never running, never failed
        local due late
        due="$(grep -oE 'outcome check due [0-9]{4}-[0-9]{2}-[0-9]{2}' <<<"$line" | grep -oE '[0-9-]{10}$')"
        late="$(python3 -c 'import sys,datetime as d; t=d.date.fromisoformat(sys.argv[2]); print(1 if d.date.fromisoformat(sys.argv[1])+d.timedelta(days=2)<=t else 0)' "$due" "${LAND_AFTER_TODAY:-$(TZ=America/Chicago date +%F)}" 2>/dev/null || echo 1)"
        if [ "$late" = 1 ]; then flags="  [NOT CHECKED: outcome check ${due:-date unreadable} is 2+ days late; post-land-check has not judged it]"
        else flags="  [landed, not yet proven: outcome check due $due]"; fi ;;
      "STATUS: DONE"*) flags="  [done: live outcome checked]" ;;
    esac
    [ "$age" -ge "$STALE_OPEN_MIN" ] && flags="$flags  [stale: untouched $((age / 1440))d]"
    printf '%s  %s%s  %s\n' "$slug" "$line" "$flags" "$f"
  done
  [ "$n" -gt 0 ] || say "no open task sheets in $TASKS"
  return 0
}

# ============================== worker (detached) ==============================
# One GitHub read that keeps asking through a short outage (22 Nov 2026 review F2: three tries 2 s apart
# turned a one-minute rate limit into a FAIL). Backoff from RETRY s, doubling to 60 s, for PATIENCE s; a
# spent allowance is slept out to the reset GitHub reports (land's rate_reset_in) when that falls before the deadline.
# stdout the answer; rc 0 answered | 3 "no checks reported" | 1 gave up (why: first line of $ERRF, set by the caller).
patient() { # $1 deadline (epoch) $2 ERE an answer matches $3.. gh args
  local deadline="$1" ok="$2" out delay give tries=0 left
  shift 2
  delay="$RETRY"; [ "$delay" -ge 1 ] 2>/dev/null || delay=1
  give=$(( $(date +%s) + PATIENCE )); [ "$give" -le "$deadline" ] || give="$deadline"
  while :; do
    out="$(GH_SHARE_UNTIL="$deadline" gh "$@" 2>"$ERRF")"   # ~/bin/gh never sleeps past this deadline
    grep -qE "$ok" <<<"$out" && { printf '%s\n' "$out"; return 0; }
    grep -qi 'no checks reported' "$ERRF" && return 3
    tries=$((tries + 1))
    if is_rate_limit "$(cat "$ERRF")"; then # land's rate_reset_in: one reading of GitHub's reset for both scripts
      left="$(rate_reset_in)"
      [ $(( $(date +%s) + left )) -le "$deadline" ] \
        || { echo "rate limit: GitHub's allowance resets in $(( (left + 59) / 60 )) min, after this wait ends" > "$ERRF"; return 1; }
      echo "GitHub's allowance is spent; waiting ${left}s for its reset, then asking again" >&2
      sleep "$left"
      give=$(( $(date +%s) + PATIENCE )); [ "$give" -le "$deadline" ] || give="$deadline"
      continue
    fi
    [ $(( $(date +%s) + delay )) -le "$give" ] || return 1
    echo "GitHub did not answer (try $tries: $(head -1 "$ERRF" | redact)); asking again in ${delay}s" >&2
    sleep "$delay"; delay=$(( delay * 2 )); [ "$delay" -le 60 ] || delay=60
  done
}

worker() {
  local DIR="$1" REPO="$2" PR="$3" SLUG="$4" LOG="$5" LOCK="$6" SLOCK="$7" HEADSHA="$8"
  local THENS=() FINISHED="" ERRF LANDOUT c
  # The --then commands come in a file only this user can read, never on the command line (where ps shows them).
  if [ -f "$LOCK/then" ]; then while IFS= read -r -d '' c; do THENS+=("$c"); done < "$LOCK/then"; fi
  SHEET_REPO="$REPO"; SHEET_PR="$PR"; SHEET_TITLE="(sheet recreated at finish)"
  echo "$$" > "$LOCK/pid"; echo "$$" > "$SLOCK/pid"
  ERRF="$(mktemp)"; LANDOUT="$(mktemp)"
  trap 'rm -f "$ERRF" "$LANDOUT"; drop_lock "$LOCK"; drop_lock "$SLOCK"' EXIT
  trap '[ -n "$FINISHED" ] || fail "unknown: land-after was stopped by a signal mid-land (sleep, reboot or kill); read the log, then run land-after again"' TERM HUP INT
  local SHEET="$TASKS/$SLUG.md" MERGE_SHA=""
  echo "=== land-after worker $(now) pid $$: $REPO#$PR in $DIR (sheet $SHEET)"

  fail() { # $1 reason
    FINISHED=1
    local reason
    reason="$(printf '%s' "$1" | tr '\n' ' ' | redact | cut -c1-600)"   # 600: a deploy STOPPED line is its reason (up to ~460) and then what was merged
    set_status "$SLUG" "STATUS: FAIL $REPO#$PR ${MERGE_SHA:-$HEADSHA} $(now) — $reason; log $LOG"
    echo "OUTPUT land-after $REPO#$PR FAIL — $reason"
    exit 1
  }

  # 1. the PR's checks, bounded. Pending is waited for; red, past the ceiling or unreadable is a FAIL.
  local start out red pending n prc
  start="$(date +%s)"
  while :; do
    out="$(patient $((start + CHECKS_MAX)) '^\[' pr checks "$PR" -R "$REPO" --json name,bucket)"; prc=$?
    if [ "$prc" -eq 0 ]; then
      n="$(jq length <<<"$out")"
      red="$(jq -r '[.[] | select(.bucket == "fail" or .bucket == "cancel") | .name] | join(", ")' <<<"$out")"
      [ -z "$red" ] || fail "checks red: $red"
      pending="$(jq '[.[] | select(.bucket == "pending")] | length' <<<"$out")"
      [ "$n" -gt 0 ] && [ "$pending" -eq 0 ] && { echo "checks green ($n)"; break; }
      [ "$n" -gt 0 ] || [ $(( $(date +%s) - start )) -lt "$APPEAR_MAX" ] || { echo "no checks appeared in $((APPEAR_MAX / 60)) min; land decides"; break; }
    elif [ "$prc" -eq 3 ]; then
      [ $(( $(date +%s) - start )) -lt "$APPEAR_MAX" ] || { echo "no checks appeared in $((APPEAR_MAX / 60)) min; land decides"; break; }
    else
      fail "unknown: the PR's checks could not be read ($(head -1 "$ERRF"))"
    fi
    [ $(( $(date +%s) - start )) -lt "$CHECKS_MAX" ] || fail "checks still pending after $((CHECKS_MAX / 60)) min"
    sleep "$POLL"
  done

  # 2. land — the ONE lander. Its words go to the log (masked) and to a scratch copy for the failing step.
  echo "=== land $PR ($(now))"
  (cd "$DIR" && LAND_TASK="$SLUG" "$LAND_BIN" "$PR" </dev/null) 2>&1 | redact | tee "$LANDOUT"   # LAND_TASK: the slug goes on land's OUTCOME-CHECK DUE line
  local rc="${PIPESTATUS[0]}" step
  echo "=== land exited $rc ($(now))"
  if [ "$rc" -ne 0 ]; then
    step="$(grep -E 'STOPPED:|NAMED STOP' "$LANDOUT" | tail -1 | sed -E 's/^[[:space:]]+//')"
    [ -n "$step" ] || step="$(grep -E '^[0-9]/[0-9]' "$LANDOUT" | tail -1 | sed 's/^/during /')"
    [ -n "$step" ] || step="land exited $rc with no step named"
    if [ "$rc" -eq 75 ] || grep -qiE 'could not verify|rate limit|timed? ?out|TLS|network|HTTP 5[0-9][0-9]|no such host|connection (reset|refused)|Something went wrong' <<<"$step"; then
      fail "unknown: $step"
    fi
    fail "$step"
  fi

  # 3. Rule 0: exit 0 is not proof. GitHub must say MERGED, with a merge sha.
  local view
  view="$(patient $(( $(date +%s) + PATIENCE )) '"state"' pr view "$PR" -R "$REPO" --json state,mergeCommit)" \
    || fail "unknown: land exited 0 but the merge could not be confirmed ($(head -1 "$ERRF"))"
  local state; state="$(jq -r '.state' <<<"$view")"; MERGE_SHA="$(jq -r '.mergeCommit.oid // empty' <<<"$view")"
  { [ "$state" = MERGED ] && [ -n "$MERGE_SHA" ]; } || fail "NAMED STOP [LAND_MERGED_NOTHING] land exited 0 but $REPO#$PR is $state with no merge commit"

  # 4. each --then, in order; the first failure is the FAIL.
  local cmd
  for cmd in ${THENS[@]+"${THENS[@]}"}; do
    echo "=== then: $cmd" | redact
    (cd "$DIR" && bash -c "$cmd" </dev/null) 2>&1 | redact
    rc="${PIPESTATUS[0]}"
    [ "$rc" -eq 0 ] || fail "then failed (exit $rc): $cmd"
  done

  # 5. Landed. land's "## Not built" goes on the sheet under line 1, word for word (her order 24 Nov 2026:
  # nothing cut is hidden). A PR whose Outcome is a live check is LANDED-UNCHECKED and stays open: only
  # post-land-check's live PASS makes it DONE (and moves it to done/). An Outcome of "none" is PASS, to done/.
  FINISHED=1
  local nb due dest
  nb="$(awk '/^--- END NOT BUILT ---$/{f=0} f; /^--- NOT BUILT \(PR #[0-9]+, word for word\) ---$/{f=1}' "$LANDOUT")"
  due="$(grep -oE '^ *OUTCOME: check due [0-9]{4}-[0-9]{2}-[0-9]{2}' "$LANDOUT" | tail -1 | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}$')"
  if [ -n "$due" ]; then
    set_status "$SLUG" "STATUS: LANDED-UNCHECKED $REPO#$PR $MERGE_SHA $(now) — landed, not yet proven: outcome check due $due (post-land-check 23:15)"
    add_not_built "$SLUG" "$PR" "$nb"
    # Its "Landed, not yet proven" row on Open Loops, now rather than at 23:15 (her words 28 Nov 2026). The land
    # stands whatever this does: a failed sync is said here and tonight's post-land-check sync makes the row.
    local sync_out src loopnote
    echo "=== open-loops sync ($(now))"
    if [ -n "${LAND_AFTER_LOOPS_SYNC:-}" ]; then sync_out="$("$LAND_AFTER_LOOPS_SYNC" "$DUE_FILE" </dev/null 2>&1)"; src=$?
    else sync_out="$(cd "$HOME/.boss-os/runtime" 2>/dev/null && npm run --silent vault:run -- node "$HERE/open-loops-proof.mjs" --sync "$DUE_FILE" </dev/null 2>&1)"; src=$?
    fi
    printf '%s\n' "$sync_out" | redact
    if [ "$src" -eq 0 ]; then loopnote="its Open Loops row is made"
    else loopnote="NAMED STOP [OPEN_LOOPS_SYNC_FAILED] its Open Loops row was not made (exit $src); tonight's post-land-check makes it"; fi
    echo "OUTPUT land-after $REPO#$PR LANDED-UNCHECKED $MERGE_SHA — outcome check due $due; $loopnote; sheet $SHEET"
    exit 0
  fi
  set_status "$SLUG" "STATUS: PASS $REPO#$PR $MERGE_SHA $(now)"
  add_not_built "$SLUG" "$PR" "$nb"
  dest="$(move_done "$SLUG")" || dest="$SHEET (could not be moved to done/)"
  echo "OUTPUT land-after $REPO#$PR PASS $MERGE_SHA — sheet $dest"
  exit 0
}

# ============================== start ==============================
main() {
  local PR="" SLUG="" REPO="" THENS=() DRY=""
  case "${1:-}" in
    --self-test) exec bash "$HERE/tests/test-land-after.sh" ;;
    --status) mkdir -p "$TASKS"; status; exit 0 ;;
    --holds) # <owner/repo> <pr>: rc 0 with the holder's pid when a live land holds that PR, 1 when none does (pr-watch)
      [[ "${2:-}" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] && [[ "${3:-}" =~ ^[0-9]+$ ]] || refuse "usage: land-after --holds <owner/repo> <pr>"
      lock_holder "$(pr_lock "$2" "$3")"; exit $? ;;
    --sweep) mkdir -p "$TASKS" "$LOGS" "$LOCKS"; load_land_blocks || { echo "FAIL: land's blocks could not be read"; exit 1; }; sweep; exit 0 ;;
    --worker) shift; mkdir -p "$TASKS" "$DONE" "$LOGS"; load_land_blocks || { echo "FAIL: land's blocks could not be read"; exit 1; }; worker "$@" ;;
    -h|--help|"") sed -n '2,38p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
  esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --task) SLUG="${2:-}"; shift ;;
      --task=*) SLUG="${1#--task=}" ;;
      --repo) REPO="${2:-}"; shift ;;
      --repo=*) REPO="${1#--repo=}" ;;
      --then) THENS+=("${2:-}"); shift ;;
      --then=*) THENS+=("${1#--then=}") ;;
      --dry-run) DRY=1 ;;
      --*) refuse "unknown flag $1 (land-after <pr> [--task <slug>] [--repo owner/name] [--then \"<cmd>\"]... [--dry-run] | --holds <owner/repo> <pr> | --status | --sweep | --self-test)" ;;
      *) [ -z "$PR" ] || refuse "one PR at a time (got $PR and $1)"; PR="$1" ;;
    esac
    shift
  done
  [[ "$PR" =~ ^[0-9]+$ ]] || refuse "the PR must be a number (got '${PR}')"
  [ -z "$SLUG" ] || valid_slug "$SLUG" || refuse "task slug '$SLUG' must be letters, digits, . _ - (no / and no ..)"
  local c; for c in ${THENS[@]+"${THENS[@]}"}; do [ -n "$c" ] || refuse "--then needs a command"; done
  if [ -z "$DRY" ]; then mkdir -p "$TASKS" "$DONE" "$LOGS" "$LOCKS/slugs" || refuse "cannot create $TASKS"; cleanup; fi
  load_land_blocks || refuse "land's gate block could not be read from $LAND_SRC, so GitHub's rate limit cannot be read"

  # The repo: --repo names it (this checkout if it is that repo, else ~/GitHub/<name>); else this checkout.
  local DIR=""
  if [ -n "$REPO" ]; then
    [[ "$REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || refuse "--repo must be owner/name"
    if [ "$(repo_of_dir .)" = "$REPO" ]; then DIR="$(git rev-parse --show-toplevel)"
    elif [ "$(repo_of_dir "$HOME/GitHub/${REPO#*/}")" = "$REPO" ]; then DIR="$HOME/GitHub/${REPO#*/}"
    else refuse "no checkout of $REPO here or at ~/GitHub/${REPO#*/}"; fi
  else
    DIR="$(git rev-parse --show-toplevel 2>/dev/null)" || refuse "not in a git checkout; pass --repo owner/name"
    REPO="$(repo_of_dir "$DIR")"; [ -n "$REPO" ] || refuse "$DIR has no GitHub origin; pass --repo owner/name"
  fi
  # The worker runs in the repo's MAIN checkout, never a linked worktree: agents remove their worktree right
  # after starting a land, and a worker cd'd into a removed folder fails (23 Nov 2026: lands lost this way).
  local main_dir; main_dir="$(cd "$DIR" && dirname "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)")"
  [ -n "$main_dir" ] && [ -d "$main_dir" ] && [ "$(repo_of_dir "$main_dir")" = "$REPO" ] && DIR="$main_dir"

  # The PR. A read that never answers starts nothing (exit 75, "could not verify").
  # Asked patiently: a spent allowance is slept out to its reset (22 Nov 2026, #134), never "nothing started".
  local VIEW="" ERRF; ERRF="$(mktemp)"
  VIEW="$(patient $(( $(date +%s) + ${LAND_AFTER_RATE_WAIT_SECS:-3900} )) '"state"' pr view "$PR" -R "$REPO" --json state,body,comments,headRefOid,headRefName,title,url,author,commits,labels,files,changedFiles)" \
    || { say "could not verify $REPO#$PR ($(head -1 "$ERRF")); nothing started"; rm -f "$ERRF"; exit 75; }
  rm -f "$ERRF"
  local state HEADSHA
  state="$(jq -r .state <<<"$VIEW")"; HEADSHA="$(jq -r '.headRefOid // ""' <<<"$VIEW")"
  [ "$state" != CLOSED ] || refuse "$REPO#$PR is closed without merging"
  [[ "$HEADSHA" =~ ^[0-9a-f]{40}$ ]] || { say "could not verify $REPO#$PR (no head commit in GitHub's answer); nothing started"; exit 75; }
  # EVERY DESCRIPTION GATE, BEFORE ANYTHING STARTS (her words 27 Nov 2026: "give a root fix to this"). land's own
  # read-only `land --check` (never a copy of its gates) reads the PR as land will: the review class and its fresh
  # reviewer's PASS, mutation proof, patch or rebuild, forms, outcome, not built, click-through. A description that
  # lacks three lines is told all three here, at once, never one per run after a CI wait. Only a PR in a review
  # class waits on a reviewer (land's list: money, private-data, delete, store, launch, outreach, a review-required
  # label ever, a change to live-repos.json, and a protected PR: a noelle/ branch or a .github/ change, REVIEW_REQUIRED,
  # read by land's own trusted_review_required, which no Owner override clears); everything else starts on its own.
  local CHK crc list codes n why
  CHK="$(cd "$DIR" && "$LAND_SRC" --check "$PR" </dev/null 2>&1 | sed $'s/\033\\[[0-9;]*m//g'; exit "${PIPESTATUS[0]}")"; crc=$?
  if [ "$crc" -eq 75 ]; then
    why="$(sed -nE 's/^STOPPED: could not verify \([a-z ]+\) — (.*)\. Nothing was merged by this step.*/\1/p' <<<"$CHK" | tail -1 | cut -c1-300)"
    say "could not verify $REPO#$PR (${why:-land --check got no answer from GitHub}); nothing started"; exit 75
  elif [ "$crc" -ne 0 ]; then
    list="$(grep -E '^  [0-9]+\. \[[A-Z_]+\] |^       add: ' <<<"$CHK")"
    codes="$(sed -nE 's/^  [0-9]+\. \[([A-Z_]+)\] .*/\1/p' <<<"$list")"; n="$(grep -c . <<<"$codes")"
    [ -n "$codes" ] || refuse "land --check stopped on $REPO#$PR: $(grep -E 'STOPPED:|NAMED STOP' <<<"$CHK" | tail -1 | sed 's/^STOPPED: //' | cut -c1-400); nothing started"
    if grep -qxE 'REVIEW_PASS_MISSING|REVIEW_REQUIRED|STALE_PASS|LAUNCH_PASS_MISSING' <<<"$codes"; then
      why="$(sed -nE 's/^  [0-9]+\. \[(REVIEW_PASS_MISSING|REVIEW_REQUIRED|STALE_PASS|LAUNCH_PASS_MISSING)\] (PR #[0-9]+(.s)? )?//p' <<<"$list" | head -1)"
      say "REFUSED — $REPO#$PR needs a reviewer: $why; nothing started. All $n thing(s) to fix, each with its line:"
      printf '%s\n' "$list"
      say "the fresh reviewer posts its line with: gh pr comment $PR -R $REPO --body '<the add: line above, filled in>'"
      exit 4   # pr-watch reads this code: "needs a reviewer"
    fi
    say "REFUSED — $REPO#$PR's description has $n thing(s) to fix ($(paste -sd',' - <<<"$codes" | sed 's/,/, /g')); nothing started. Each with the line to add (pr-body-template.md carries them all):"
    printf '%s\n' "$list"
    exit 1
  fi

  SHEET_REPO="$REPO"; SHEET_PR="$PR"
  SHEET_TITLE="$(jq -r '.title // ""' <<<"$VIEW" | tr -d '\n' | cut -c1-120)"
  SHEET_URL="$(jq -r '.url // ""' <<<"$VIEW")"; SHEET_BRANCH="$(jq -r '.headRefName // ""' <<<"$VIEW")"
  [ -n "$SLUG" ] || SLUG="pr-$(printf '%s' "${REPO#*/}" | tr -c 'A-Za-z0-9._-' '-')-$PR"
  valid_slug "$SLUG" || refuse "derived slug '$SLUG' is not valid; pass --task"

  # One land per PR, and one per sheet, at a time: atomic mkdir locks; a dead holder's lock is taken over.
  local LOCK SLOCK holder
  LOCK="$(pr_lock "$REPO" "$PR")"
  SLOCK="$(slug_lock "$SLUG")"
  # --dry-run: every check above ran; nothing is written, locked or started (pr-watch --dry-run).
  if [ -n "$DRY" ]; then
    holder="$(lock_holder "$LOCK")" && refuse "$REPO#$PR is already being landed (pid $holder); nothing started"
    say "would land $REPO#$PR (sheet $TASKS/$SLUG.md); --dry-run, nothing started"; exit 0
  fi
  holder="$(take_lock "$LOCK")" \
    || refuse "$REPO#$PR is already being landed (pid $holder, sheet $(cat "$LOCK/slug" 2>/dev/null || echo '?')); nothing started"
  echo "$SLUG" > "$LOCK/slug"
  holder="$(take_lock "$SLOCK")" \
    || { drop_lock "$LOCK"; refuse "the sheet $TASKS/$SLUG.md is held by another land (pid $holder); nothing started. One sheet is one job: give this PR its own --task"; }
  # A sheet is one job's (22 Nov 2026 review F1): line 1 naming another PR is that job's status, never overwritten.
  local named; named="$(sheet_owner "$SLUG")"
  if [ -n "$named" ] && [ "$named" != "$REPO#$PR" ]; then
    drop_lock "$SLOCK"; drop_lock "$LOCK"
    refuse "$TASKS/$SLUG.md belongs to $named (its line 1), not $REPO#$PR; nothing started. Pass this job's own --task, or set that sheet's line 1 to name $REPO#$PR first"
  fi

  # The backup sits beside the lock, never in it (22 Nov 2026 re-check R3): a worker that ends inside the
  # starter's 0.2 s poll must be able to rmdir its lock, or an empty lock holds the sheet for 2 minutes.
  # It carries this starter's pid, and older ones are cleared under the slug lock (N13): a backup a killed
  # starter left is never restored over the sheet.
  local LOG="$LOGS/$SLUG-$PR.log" WPID BACKUP="$SLOCK.sheet.before.$$" c
  for c in ${THENS[@]+"${THENS[@]}"}; do printf '%s\0' "$c"; done > "$LOCK/then" && chmod 600 "$LOCK/then"
  rm -f "$SLOCK".sheet.before*
  [ -f "$TASKS/$SLUG.md" ] && cp -p "$TASKS/$SLUG.md" "$BACKUP"
  set_status "$SLUG" "STATUS: landing $REPO#$PR $HEADSHA $(now)" \
    || { rm -f "$BACKUP"; drop_lock "$SLOCK"; drop_lock "$LOCK"; refuse "could not write $TASKS/$SLUG.md"; }
  printf '\n=== land-after %s: %s#%s from %s\n' "$(now)" "$REPO" "$PR" "$DIR" >> "$LOG"
  # Detached: its own session (setsid), no terminal, stdin closed, HUP ignored, so the agent's shell
  # ending (or its process group being killed) does not end the land. A setsid that fails says so in the log.
  nohup perl -MPOSIX=setsid -e 'defined(setsid()) or print STDERR "land-after: setsid failed ($!): the worker stays in the starting shell session, so ending that session may end the land\n"; exec @ARGV or die "land-after: exec failed: $!\n"' -- \
    "$SELF" --worker "$DIR" "$REPO" "$PR" "$SLUG" "$LOG" "$LOCK" "$SLOCK" "$HEADSHA" \
    </dev/null >>"$LOG" 2>&1 &
  WPID=$!
  echo "$WPID" > "$LOCK/pid"; echo "$WPID" > "$SLOCK/pid"
  # The starter reports a land only once its worker is seen running (it writes its first log line).
  local waited=0
  until grep -qF "=== land-after worker" "$LOG" 2>/dev/null && grep -q "pid $WPID:" "$LOG"; do
    if [ "$waited" -ge $((START_WAIT * 5)) ] || ! kill -0 "$WPID" 2>/dev/null && ! grep -q "pid $WPID:" "$LOG"; then
      kill "$WPID" 2>/dev/null
      if [ -f "$BACKUP" ]; then mv -f "$BACKUP" "$TASKS/$SLUG.md"; else rm -f "$TASKS/$SLUG.md"; fi
      drop_lock "$SLOCK"; drop_lock "$LOCK"
      refuse "the worker for $REPO#$PR did not start ($(tail -1 "$LOG" | redact)); nothing is landing, the sheet is as it was. Log $LOG"
    fi
    sleep 0.2; waited=$((waited + 1))
  done
  [ -n "${LAND_AFTER_TEST_CLEANUP_DELAY:-}" ] && sleep "$LAND_AFTER_TEST_CLEANUP_DELAY"   # tests only: widen the R3 window
  rm -f "$BACKUP"
  say "landing $REPO#$PR detached (pid $WPID); log $LOG; result on line 1 of $TASKS/$SLUG.md"
  exit 0
}

main "$@"
