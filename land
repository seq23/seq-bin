PRMETA="$(with_label_history "$PR" <<<"$PRMETA")"
jq -e '.label_history | type == "array"' <<<"$PRMETA" >/dev/null 2>&1 \
  || unverified network "PR #$PR's label history (its issue events) could not be read, so whether it was ever labeled review-required is unknown"
