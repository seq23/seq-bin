# A spent allowance refuses the merge without making it: wait for the reset and ask again (rate_wait).
# A race with another PR's merge ("Base branch was modified") is tried again, up to 3 tries in all, 5 s then 10 s
# apart, each after still_ready has verified the PR again. Any other merge error stops below.
MERGE_TRY=1
until MERGE_OUT="$(gh pr merge "$PR" --squash --match-head-commit "$HEAD" 2>&1)"; MERGE_RC=$?; [ "$MERGE_RC" -eq 0 ]; do
  rate_wait "$MERGE_OUT" && continue
  grep -qi 'Base branch was modified' <<<"$MERGE_OUT" && [ "$MERGE_TRY" -lt 3 ] || break
  echo "     main moved under the merge (another PR landed): verifying PR #$PR again, then try $((MERGE_TRY + 1)) of 3 in $((MERGE_TRY * ${LAND_RACE_SECS:-5}))s"
  sleep $((MERGE_TRY * ${LAND_RACE_SECS:-5}))
  still_ready
  MERGE_TRY=$((MERGE_TRY + 1))
done
if [ "$MERGE_RC" -ne 0 ]; then
  echo "$MERGE_OUT"
  # A merge whose ANSWER was lost may still have happened; ask before calling it a failure.
  MSTATE="$(gh_read '^(OPEN|CLOSED|MERGED)$' pr view "$PR" --json state -q .state)" || MSTATE=""
  case "$MSTATE" in
    MERGED) echo "     the merge call errored but PR #$PR reads MERGED — carrying on" ;;
    OPEN) [ "$(gh_kind "$MERGE_OUT")" != api ] && unverified "$(gh_kind "$MERGE_OUT")" "the merge call did not answer and PR #$PR is still open"
          grep -qi 'Base branch was modified' <<<"$MERGE_OUT" && die "merge failed: main moved under all 3 tries (other PRs landing). Nothing was merged; land $PR again."
          die "merge failed" ;;
    "") unverified "$(gh_kind "$(gh_err)")" "the merge call failed and PR #$PR's state could not be read back — check it: gh pr view $PR" ;;
