// ---------- reports ----------
// The cited list as she reads it: no picture files, and one App Store link per app (ChatGPT cites the same app in
// a dozen countries).
function tidyCited(list) {
  const seen = new Set(), out = [];
  for (const u of list || []) {
    if (/\.(jpe?g|png|gif|webp|svg|avif)$/i.test(u) || /^media\.gettyimages\./.test(u)) continue;
    const id = u.match(/^apps\.apple\.com\/[a-z]{2}\/app\/[^/]+\/(id\d+)/)?.[1];
    const key = id || u;
    if (seen.has(key)) continue;
    seen.add(key); out.push(id ? u.replace(/^apps\.apple\.com\/[a-z]{2}\//, "apps.apple.com/us/") : u);
  }
  return out;
}
const yes = (r) => (r.ours ? `**YES** (${[...r.ours_read.map((u) => `read ${u}`), ...r.ours_cited.map((u) => `cited ${u}`), ...r.ours_named.map((n) => `named "${n}"`)].join("; ")})` : "no");
function siteReport(site, week, night, wk, tonight) {
  const rows = Object.values(wk.asked || {}).sort((a, b) => a.n - b.n);
  const checked = rows.filter((r) => r.status === "CHECKED");
  const L = [`# ${site.label}: what ChatGPT searches before it recommends (${week})`, "",
    `Night of ${night} (Central). Asked in chatgpt.com, her signed-in Chrome, a Temporary Chat for every question (not kept in her history, no memory), Web search on. Searches come from ChatGPT's own answer stream; sites read from its search results; sites cited from its citations; businesses named are the ones the answer names, each found word for word in the answer. Ours = ${site.domains.join(", ")} read or cited, or ${site.names.map((n) => `"${n}"`).join(", ")} named.`, "",
    `**Ours showed up in ${checked.filter((r) => r.ours).length} of ${checked.length} checked chats** (${rows.length ? `${checked.length} of ${QUESTIONS} questions checked this week` : "none checked yet"}${tonight.length ? `; asked tonight: ${tonight.join(", ")}` : ""}).`, ""];
  for (let n = 1; n <= QUESTIONS; n++) {
