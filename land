# 17 Sep, and one had read `mergeable` (merge conflicts) rather than the checks.
# The checks are read as JSON and judged here, never by gh's exit code, which is 1 both for a
# failing check and for a network error. A valid JSON array IS the answer; anything else is no answer.
# PENDING IS A WAIT, NOT A STOP (22 Nov 2026: land stopped at once on a queued check, and every caller grew
# its own wait). While any check is pending or queued, land waits, bounded by LAND_PENDING_WAIT (30 min);
# a failure among them stops at once, and past the bound it is a named stop.
# NO CHECKS ON A CONFLICTED PR IS A CONFLICT, NOT A MYSTERY (22 Nov 2026, boss-os #539: GitHub runs no
# pull_request CI on a PR that cannot merge, and "no checks at all" read as stuck for an hour).
no_checks_stop() {
  local m; m="$(gh_read '^[A-Z_]+$' pr view "$PR" --json mergeable -q .mergeable 2>/dev/null)" || m=""
  [ "$m" = CONFLICTING ] && die "NAMED STOP [MERGE_CONFLICT] PR #$PR conflicts with main, so GitHub runs no CI on it. Merge origin/main into the branch, resolve, push, then land $PR again."
  die "PR #$PR has no checks at all — green cannot be verified"
}
EXPECT="every check on PR #$PR to run on its head and pass"; LOOK=""
PENDING_UNTIL=$(( $(date +%s) + ${LAND_PENDING_WAIT:-1800} ))
while :; do
