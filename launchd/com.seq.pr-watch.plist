<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.seq.pr-watch</string>
  <!-- Stuck PRs (her question 23 Nov 2026, boss-os #552 red 3 h: "how do we catch and stop this issue?"):
       every 30 minutes, any open seq23 PR with nothing moving for 30+ min is landed (green, the owner's own,
       through land-after's review-class gate) or named in HANDOFF Today under "Stuck PRs" with one banner per
       PR per day. LIGHT class: install-launchd.sh wraps it in `mac-window run LIGHT` (boss-os manifest row
       com.seq.pr-watch), and pr-watch checks 10:00-21:59 CT itself too. Versioned copy:
       ~/bin/launchd/com.seq.pr-watch.plist; install with ~/bin/install-launchd.sh com.seq.pr-watch. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>/Users/sequoiataylor/bin/pr-watch</string>
  </array>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>
  <!-- land-after detaches its worker (setsid); without this launchd would kill it when the tick exits. -->
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>/Users/sequoiataylor/Library/Logs/pr-watch/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/sequoiataylor/Library/Logs/pr-watch/launchd.err</string>
</dict></plist>
