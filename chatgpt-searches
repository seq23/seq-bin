    if (r.status !== "CHECKED") { L.push(`- **${r.status}**: ${r.reason}${r.tries ? ` (try ${r.tries} of ${MAX_TRIES})` : ""}`, ""); continue; }
    L.push(`- Chat id: \`${r.cid}\` (Temporary Chat; ${r.model || "model unknown"}; memory in context: ${r.memory}; Web search on: ${r.search_on ? "yes" : "NO"})`);
    L.push(`- Searches ChatGPT ran (${r.queries.length}):${r.queries.length ? "" : " none (it answered without searching)"}`);
    for (const q2 of r.queries) L.push(`    - \`${q2}\``);
    const cited = tidyCited(r.cited);
    L.push(`- Sites it cited (${cited.length}${r.cited_total > r.cited.length ? ` of the first ${r.cited.length} of ${r.cited_total} links` : ""}): ${cited.length ? cited.join(", ") : "none linked"}`);
    L.push(`- Sites it read: ${r.read_pages} pages on ${r.read_domains_total} domains: ${r.read_domains.slice(0, 15).join(", ")}${r.read_domains_total > 15 ? " …" : ""}`);
    L.push(`- Businesses it named: ${r.named === null ? "not read (the session gave no list)" : r.named.length ? r.named.join(" · ") : "none"}${r.named_rejected?.length ? ` (left out, not in the answer: ${r.named_rejected.join(", ")})` : ""}`);
