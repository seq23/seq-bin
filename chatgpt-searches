    return await runNight({ sites, due, state, lastState, night, week, deadline, hand, dry });
  } finally { fs.rmSync(lock, { recursive: true, force: true }); }
}

async function runNight({ sites, due, state, lastState, night, week, deadline, hand, dry }) {
  const nightDir = path.join(OUT, night);
  if (!due.length) {
    const line = `nothing due tonight: every site due by this night was checked this week`;
    state.nights.push({ night, verdict: "NOTHING_DUE", line, at: new Date().toISOString() });
    writeAtomic(weekFile(week), JSON.stringify(state, null, 1));
    writeAtomic(path.join(OUT, `rollup-${week}.md`), rollup(sites, week, state, lastState));
    console.log(`OUTPUT 0 questions checked — ${line}`);
    return 0;
  }
  if (process.env.CSQ_OPEN_CHROME !== "0") { spawnSync("open", ["-ga", "Google Chrome"]); spawnSync("sleep", ["15"]); }
  let wall = null, checkedTonight = 0, broke = [];
  const asked = [];
  for (const site of due) {
    if (wall) break;
    const minsLeft = (deadline - Date.now()) / 60000;
    if (minsLeft < 25) { wall = "TIME_UP"; break; }
    const wk = state.sites[site.id] = state.sites[site.id] || { asked: {} };
    say(`== ${site.id}`);
    if (!wk.questions) {
      let q;
      try { q = writeQuestions(site, lastState?.sites?.[site.id] ? { rows: Object.values(lastState.sites[site.id].asked || {}) } : null); }
      catch (e) { q = { error: e.message }; }
      if (q.wall) { wall = q.wall; break; }
      if (q.error) { broke.push(`${site.id}: ${q.error}`); say(`  ${q.error}`); continue; }
      wk.questions = q.questions; wk.questions_by = q.model;
      writeAtomic(weekFile(week), JSON.stringify(state, null, 1));
    }
    const numbers = []; for (let n = 1; n <= QUESTIONS; n++) { const r = wk.asked[n]; if (!r || (r.status !== "CHECKED" && (r.tries || 0) < MAX_TRIES)) numbers.push(n); }
    if (numbers.length) {
      const maxSecs = Math.max(300, Math.min(2700, Math.floor((deadline - Date.now()) / 1000) - 120));
      const s = askInChrome(site, wk.questions, numbers, maxSecs);
      const tonight = [];
      for (const n of numbers) {
        const r = s.rows[n];
        if (r.status === "NOT_ASKED") continue;                       // owed: a wall or the end of the session
        const prev = wk.asked[n];
        wk.asked[n] = r.status === "CHECKED" ? { ...r, night } : { ...r, night, tries: (prev?.tries || 0) + 1 };
        tonight.push(`Q${n} ${r.status === "CHECKED" ? "checked" : r.status}`);
        if (r.status === "CHECKED") checkedTonight++;
      }
      for (const nn of s.notes) say(`  ${nn}`);
      if (s.badInstall || s.offScript) broke.push(`${site.id}: the session ${s.badInstall ? "changed the capture script" : "ran its own code on the page"}`);
      say(`  asked ${numbers.join(",")}: ${tonight.join(", ") || "nothing"}${s.wall ? ` — wall ${s.wall}` : ""} (model ${s.model}, exit ${s.rc})`);
      asked.push(site.id);
      writeAtomic(weekFile(week), JSON.stringify(state, null, 1));
      writeAtomic(path.join(nightDir, `${site.id}.json`), JSON.stringify({ site: site.id, night, week, questions: wk.questions, asked: wk.asked }, null, 1));
      writeAtomic(path.join(nightDir, `${site.id}.md`), siteReport(site, week, night, wk, tonight));
      if (s.wall) { wall = s.wall; break; }
    }
    const complete = Object.keys(wk.asked).length === QUESTIONS && Object.values(wk.asked).every((r) => r.status === "CHECKED" || (r.tries || 0) >= MAX_TRIES);
    if (complete && !wk.seeds) {
      try { wk.seeds = seedsForSite(site, week, wk, { dry }); } catch (e) { wk.seeds = { status: "stopped", why: e.message }; }
      if (wk.seeds.wall) { const w = wk.seeds.wall; delete wk.seeds; wall = w; }
      else say(`  seeds: ${seedLine(wk.seeds)}`);
      writeAtomic(weekFile(week), JSON.stringify(state, null, 1));
      writeAtomic(path.join(nightDir, `${site.id}.md`), siteReport(site, week, night, wk, []));
      // A drop: fewer chats with us than last week's complete set.
      const lw = lastState?.sites?.[site.id]; const now5 = Object.values(wk.asked).filter((r) => r.status === "CHECKED");
      const last5 = lw ? Object.values(lw.asked || {}).filter((r) => r.status === "CHECKED") : [];
      const a = now5.filter((r) => r.ours).length, b = last5.filter((r) => r.ours).length;
      if (last5.length && now5.length && a / now5.length < b / last5.length) {
        say(`  ${notice(`chatgpt-searches:${week}:${site.id}:drop`, `ChatGPT hidden searches: ${site.label} showed up in ${a} of ${now5.length} ChatGPT chats this week, down from ${b} of ${last5.length} last week; its gaps go to its search pages as new searches`)}`);
      }
    }
  }
  const owed = due.filter((s) => { const w = state.sites[s.id]; return !w || !w.questions || Object.keys(w.asked || {}).length < QUESTIONS || Object.values(w.asked).some((r) => r.status !== "CHECKED" && (r.tries || 0) < MAX_TRIES); }).map((s) => s.id);
  let verdict, line, code;
  if (checkedTonight === 0 && wall) { verdict = "COULDNT-CHECK"; line = `${WALL_WORDS[wall] || wall}; ${owed.length} site(s) wait for the next night: ${owed.join(", ")}`; code = 75; }
  else if (checkedTonight === 0) { verdict = "FAIL"; line = `0 questions checked for ${due.length} due site(s)${broke.length ? `: ${broke.join("; ")}` : ""}`; code = 1; }
  else if (wall) { verdict = "PARTIAL"; line = `${checkedTonight} questions checked, then ${WALL_WORDS[wall] || wall}; owed to the next night: ${owed.join(", ")}`; code = 75; }
  else { verdict = owed.length || broke.length ? "PARTIAL" : "PASS"; line = `${checkedTonight} questions checked on ${asked.join(", ") || "no site"}${owed.length ? `; still owed: ${owed.join(", ")}` : ""}${broke.length ? `; broke: ${broke.join("; ")}` : ""}`; code = broke.length ? 1 : 0; }
  state.nights.push({ night, verdict, line, wall, checked: checkedTonight, at: new Date().toISOString(), hand });
  writeAtomic(weekFile(week), JSON.stringify(state, null, 1));
  writeAtomic(path.join(nightDir, "night.json"), JSON.stringify({ night, week, verdict, line, wall, checked: checkedTonight, owed, broke }, null, 1));
  const rollFile = path.join(OUT, `rollup-${week}.md`);
  writeAtomic(rollFile, rollup(sites, week, state, lastState));
  if (verdict === "COULDNT-CHECK" || verdict === "FAIL" || (verdict === "PARTIAL" && wall)) {
    say(notice(`chatgpt-searches:${night}:${verdict.toLowerCase()}`, `ChatGPT hidden searches: ${verdict === "FAIL" ? "FAIL" : "COULDNT-CHECK"} tonight — ${line}`));
  }
  console.log(`OUTPUT ${checkedTonight} questions checked — ${verdict}: ${line}`);
  console.log(`rollup: ${rollFile}`);
  console.log(verdict === "PASS" ? `CHATGPT-SEARCHES-COMPLETE: ${checkedTonight} questions` : `CHATGPT-SEARCHES-INCOMPLETE: ${verdict}`);
  return code;
}

