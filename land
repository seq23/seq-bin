  d1_premerge "$HEAD" || die "NAMED STOP [D1_MIGRATION_FAILED] D1 migrations from ${HEAD:0:7} failed: ${DEPLOY_WHY:-see the output above}. PR #$PR was NOT merged (they go to D1 $D1_PREMERGE first, because $NAME deploys itself the moment it merges). Fix the migration, then land $PR again."
fi

RECENT="$(recent_lands "$PR")"
[ -z "$RECENT" ] || echo "     WARNING: $NAME already had $RECENT landed in the last 30 minutes — batch fixes into one round"
queue_wait; QRC=$?
[ "$QRC" -ne 75 ] || unverified "queue" "GitHub refused the read of main's post-merge run (above)"
[ "$QRC" -eq 0 ] || die "PR #$PR was NOT merged: main's post-merge run is past its ceiling (above)."
say "2/5  merging"
