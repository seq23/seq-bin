# WHAT LANDS WHERE. Pure — no gh, no git — so tests/test-land-plan.sh can prove every branch.
# --- plan begin (tests/test-land-plan.sh evals this block verbatim) ---
# land_plan DEPLOY STAGING E2E_WF E2E_CONCLUSION LARGE LAST_VERDICT -> the steps, space-separated,
# in order, out of:
#   staging     deploy staging from the merge sha
#   production  deploy production now: no e2e workflow on the route; or its run on this sha
#               succeeded; or the change is SMALL and the suite is not known red
#   suite       a LARGE change (or --run-e2e): run the e2e workflow on main, production only on green
#   blocked     a small change, but the suite is KNOWN RED — or whether it is could not be read:
#               production untouched
#   self        the repo deploys itself; nothing for this script to run
# DEPLOY is the route's deploy command, or its PROMOTE_VIA workflow (either means "land ships it").
# E2E_CONCLUSION is the conclusion of the newest COMPLETED run of E2E_WF on the exact sha, or ""
# when there is none (still running counts as none: a run that has not finished proves nothing).
# LARGE is why the change is large (non-empty: the large block's reason, an unproven large commit
# production has not seen, or "--run-e2e given"), or "" for a small change.
# LAST_VERDICT is the conclusion of the newest e2e run on main that reached a verdict (cancelled and
# skipped are not verdicts), "none" when no run ever did, or "" when the history could not be read.
# FAIL CLOSED: "" is never "not red", and neither is any word this does not know.
land_plan() {
  local deploy="$1" staging="$2" e2e="$3" conc="$4" large="${5-}" last="${6-}" out=""
  [ -n "$staging" ] && out="staging"
  if [ -z "$deploy" ]; then printf '%s\n' "${out:+$out }self"; return 0; fi
  if [ -z "$e2e" ] || [ "$conc" = success ]; then printf '%s\n' "${out:+$out }production"; return 0; fi
  if [ -n "$large" ]; then printf '%s\n' "${out:+$out }suite"; return 0; fi
  # A small change. A red verdict on this exact sha blocks it whatever came after.
  case "$conc" in ""|cancelled|skipped) : ;; *) printf '%s\n' "${out:+$out }blocked"; return 0 ;; esac
  case "$last" in
    success|none) printf '%s\n' "${out:+$out }production" ;;
    *) printf '%s\n' "${out:+$out }blocked" ;;
  esac
}
# promote_pick PRODUCTION_SHA < "sha<TAB>green|other" lines, main's commits NEWEST FIRST
#   -> prints the newest green commit that is newer than production, exit 0; exit 1 if none.
# Reaching production's own sha ends the walk: everything below it is already shipped or older.
# An unrecorded production ("") means any green commit qualifies.
promote_pick() {
  local prod="$1" sha verdict
  while IFS=$'\t' read -r sha verdict; do
    [ -n "$sha" ] || continue
    [ "$sha" = "$prod" ] && return 1
    [ "$verdict" = green ] && { printf '%s\n' "$sha"; return 0; }
  done
  return 1
}
# --- plan end ---

# WHAT COUNTS AS A LARGE CHANGE. Pure — no gh — so tests/test-land-large.sh can prove every rule.
# --- large begin (tests/test-land-large.sh evals this block verbatim) ---
# large_reason ADDITIONS DELETIONS CHANGED_FILES < the changed paths, one per line
#   -> prints WHY the change is large (one line, with the numbers that decided it) and returns 0;
#      prints nothing and returns 1 for a small change. The thresholds are env-overridable so a
#      repo can be driven harder or softer from the shell without editing this file:
#   LAND_LARGE_LINES     additions + deletions at or above this is large                (200)
#   LAND_LARGE_FILES     changed files at or above this is large                         (8)
#   LAND_LARGE_UI_LINES  a UI-surface file touched AND this many lines changed is large (40)
#   Any change to a migration, the e2e specs or a Playwright config is large at any size: the
#   schema and the browser-test contract are exactly what the suite exists to prove.
LAND_LARGE_LINES="${LAND_LARGE_LINES:-200}"
LAND_LARGE_FILES="${LAND_LARGE_FILES:-8}"
LAND_LARGE_UI_LINES="${LAND_LARGE_UI_LINES:-40}"
LAND_UI_PATH='(^|/)(client|app|public|pages|components|views|ui|routes|functions)/|\.(tsx|jsx|html|css|vue|svelte)$'
LAND_CONTRACT_PATH='(^|/)(migrations|e2e)/|(^|/)tests/e2e/|(^|/)playwright[a-z.]*\.config\.[jt]s$'
large_reason() {
  local add="${1-}" del="${2-}" files="${3-}" lines paths ui contract
  case "${add:-?}${del:-?}${files:-?}" in *[!0-9]*) echo "PR size unreadable (+${add:-?}/-${del:-?}, ${files:-?} files) — treated as large, fail closed"; return 0 ;; esac
  lines=$((add + del))
  paths="$(cat)"
  contract="$(grep -E "$LAND_CONTRACT_PATH" <<<"$paths" | head -1)"
  ui="$(grep -Ec "$LAND_UI_PATH" <<<"$paths")"
  if [ "$lines" -ge "$LAND_LARGE_LINES" ]; then echo "$lines lines changed (+$add/-$del) ≥ $LAND_LARGE_LINES"; return 0; fi
  if [ "$files" -ge "$LAND_LARGE_FILES" ]; then echo "$files files changed ≥ $LAND_LARGE_FILES"; return 0; fi
  if [ -n "$contract" ]; then echo "touches the schema or the browser-test contract ($contract)"; return 0; fi
  if [ "$ui" -gt 0 ] && [ "$lines" -ge "$LAND_LARGE_UI_LINES" ]; then echo "$ui UI-surface file(s) touched with $lines lines changed (≥ $LAND_LARGE_UI_LINES)"; return 0; fi
  return 1
}
# --- large end ---

# The newest completed run of the e2e workflow on exactly this sha, or "" (none, or none finished).
e2e_verdict() { # $1 sha
  gh run list --workflow "$E2E_WF" --branch main --limit 50 --json headSha,status,conclusion \
    -q "[.[] | select(.headSha == \"$1\" and .status == \"completed\")][0].conclusion // empty" 2>/dev/null
}
# --- verdict begin (tests/test-land-plan.sh evals this block verbatim) ---
# KNOWN RED (header). The newest run of the e2e workflow on main that reached a verdict: cancelled
# and skipped runs are passed over. Prints "<conclusion><TAB><run id><TAB><sha>", or "none" when no
# run on main ever reached one. Prints NOTHING when the history could not be read (after gh_read's
# retries) — land_plan reads nothing as blocked, never as "not red".
e2e_last_verdict() {
  gh_read $'^(none|[a-z_]+\t[0-9]+\t[0-9a-f]{40})$' run list --workflow "$E2E_WF" --branch main --limit 30 --json conclusion,headSha,databaseId,status \
    -q '[.[] | select(.status == "completed" and .conclusion != "cancelled" and .conclusion != "skipped")][0] | if . == null then "none" else "\(.conclusion)\t\(.databaseId)\t\(.headSha)" end' || true
}
# --- verdict end ---
# What production runs, as an ANSWER: the sha, "unrecorded" (no production deployment yet), or
# "unreadable" (the API did not answer — never mistaken for unrecorded).
production_state() {
  gh_read '^(unrecorded|[0-9a-f]{40})$' api "repos/{owner}/{repo}/deployments?environment=production&per_page=1" --jq '.[0].sha // "unrecorded"' || echo unreadable
}
# --- range begin (tests/test-land-large.sh evals this block verbatim, after the large block) ---
# EVERY CHANGE PRODUCTION HAS NOT SEEN IS JUDGED (header). Walks main's commits between what
# production runs and the sha about to ship (first-parent: one commit per squash-merged PR) and
# judges each with large_reason from its own diff. Prints why (0) when one is large, or when the
# range cannot be judged (fail closed); prints nothing (1) when every one is small. An unrecorded
# production has no range to judge: the PR alone decides.
LAND_RANGE_MAX="${LAND_RANGE_MAX:-30}"
unshipped_large_reason() { # $1 production state  $2 sha about to ship
  local prod="$1" sha="$2" c n=0 stat add del files why subj
  case "$prod" in
    unrecorded) return 1 ;;
    unreadable) echo "what production runs could not be read, so the changes it has not seen cannot be judged — treated as large, fail closed"; return 0 ;;
  esac
  [ "$prod" != "$sha" ] || return 1
  git merge-base --is-ancestor "$prod" "$sha" 2>/dev/null \
    || { echo "production's recorded sha ${prod:0:7} is not an ancestor of ${sha:0:7} in this checkout, so the changes it has not seen cannot be judged — treated as large, fail closed"; return 0; }
  n="$(git rev-list --count --first-parent "$prod..$sha" 2>/dev/null)" || n=""
  case "${n:-?}" in *[!0-9]*) echo "the commits since production ${prod:0:7} could not be counted — treated as large, fail closed"; return 0 ;; esac
  [ "$n" -le "$LAND_RANGE_MAX" ] || { echo "$n commits on main since production ${prod:0:7} (more than $LAND_RANGE_MAX) — treated as large"; return 0; }
  for c in $(git rev-list --first-parent "$prod..$sha"); do
    stat="$(git diff --numstat "$c^" "$c" 2>/dev/null)" || { echo "commit ${c:0:7} since production ${prod:0:7} could not be measured — treated as large, fail closed"; return 0; }
    add="$(awk -F'\t' '{a += $1} END {print a + 0}' <<<"$stat")"; del="$(awk -F'\t' '{d += $2} END {print d + 0}' <<<"$stat")"
    files="$(grep -c . <<<"$stat" || true)"
    if why="$(cut -f3- <<<"$stat" | large_reason "$add" "$del" "$files")"; then
      subj="$(git log --format=%s -1 "$c" 2>/dev/null)"
      echo "main carries ${c:0:7} (${subj:0:50}) past production ${prod:0:7}, large and not yet proven: $why"
      return 0
    fi
  done
  echo "     judged all $n change(s) main carries past production ${prod:0:7}: none is large" >&2
  return 1
}
# --- range end ---
# What production runs, from the GitHub Deployments record this script writes (newest first).
production_sha() {
  gh api "repos/{owner}/{repo}/deployments?environment=production&per_page=1" --jq '.[0].sha // empty' 2>/dev/null
}
record_production() { # $1 sha  $2 note -> one GitHub deployment (environment production) + a success status
  # GitHub refuses a description over 140 characters (422), and a refused record is an unrecorded
  # production. Quotes and backslashes would break the JSON below. Neither is worth losing it for.
  local id note
  note="${2//\"/}"; note="${note//\\/}"; note="${note:0:140}"
  set -- "$1" "$note"
  id="$(printf '{"ref":"%s","environment":"production","auto_merge":false,"required_contexts":[],"description":"%s","production_environment":true}' "$1" "$2" \
        | gh api -X POST "repos/{owner}/{repo}/deployments" --input - --jq '.id' 2>/dev/null)"
  if [ -z "$id" ]; then
    say "     WARNING: production is live on ${1:0:7} but the GitHub deployment record could not be written; land --promote will not know. Record by hand: gh api -X POST repos/{owner}/{repo}/deployments -f ref=$1 -f environment=production"
    return 0
  fi
  printf '{"state":"success","environment":"production","description":"%s"%s}' "$2" "${SMOKE:+,\"environment_url\":\"${SMOKE%/healthz}\"}" \
    | gh api -X POST "repos/{owner}/{repo}/deployments/$id/statuses" --input - >/dev/null 2>&1 || true
  echo "     recorded: GitHub deployment $id — production = ${1:0:7}"
}
# NEVER A DIRTY TREE. Deploy from a detached worktree at exactly the sha, so what ships is what
# main's checks read — not a branch checkout, not a working tree with edits. node_modules is
# shared from this checkout when the lockfile at that sha is identical (the repo convention for
# worktrees); otherwise `npm ci` in the worktree.
# THE REAL ERROR IN THE STOPPED LINE, ONE DEPLOY AT A TIME, NEVER ON A FULL DISK (22 Nov 2026: boss-os
# and aplayer-mode#103 landed at the same time, each ran a full `npm ci` into its own temp copy, the
# disk filled, and both stopped with "read the error, it explains itself" over no error at all: the
# install ran --silent and the deploy under `npm run -s`, which silences every npm beneath it).
#  - DEPLOY_WHY is set on every failure, and every caller puts it in its STOPPED line: the step, its
#    exit code and its own last lines, or "it printed nothing". A 2-line tail of land carries it.
#  - one local deploy at a time on this Mac: an flock on LAND_DEPLOY_LOCK, released when the deploy
#    ends or its land dies (no stale lock to clear); a second waits up to LAND_DEPLOY_WAIT seconds,
#    then stops, named. The lock is taken BEFORE free space is read, so the space read is the space it gets.
#  - free space is read before any install (a linked node_modules is no install, so it is not read then):
#    under LAND_MIN_FREE_GB stops, named; an unreadable read
#    stops too, never "enough". 4 GB: one install here is ~0.7 GB of node_modules plus npm's cache
#    and the build, and macOS swap (22 GB at peak) grows on the same volume.
# --- deploy_at begin (tests/test-land-local-ship.sh evals this block verbatim) ---
LAND_MIN_FREE_GB="${LAND_MIN_FREE_GB:-4}"
LAND_DEPLOY_WAIT="${LAND_DEPLOY_WAIT:-1800}"
LAND_DEPLOY_LOCK="${LAND_DEPLOY_LOCK:-${XDG_CACHE_HOME:-$HOME/.cache}/land/deploy.lock}"
DEPLOY_WHY=""; DEPLOY_WT=""; DEPLOY_WT_REPO=""; DEPLOY_STEP_FILE=""
deploy_cleanup() { # removes what this land's deploy made and has not removed yet: its step file, its worktree
  # Run on every exit, land_exit included (bash runs the EXIT trap on TERM, HUP and INT too), so a
  # signal mid-deploy leaks nothing (22 Nov 2026 review of #153: each kill left a land-step file and
  # a registered worktree). Only paths this land made, named by its own mktemp templates, are removed.
  case "$DEPLOY_STEP_FILE" in */land-step.*|*/land-deploy.*.out) rm -f "$DEPLOY_STEP_FILE" ;; esac
  DEPLOY_STEP_FILE=""
  case "$DEPLOY_WT" in */land-deploy.*)
    git -C "${DEPLOY_WT_REPO:-.}" worktree remove --force "$DEPLOY_WT" >/dev/null 2>&1 || rm -rf "$DEPLOY_WT" ;;
  esac
  DEPLOY_WT=""; DEPLOY_WT_REPO=""
}
# deploy_tail: why a step failed, on one line. The tool's own last lines (a TypeScript or wrangler
# error), then npm's error block from its top, where npm names the cause ("code EUSAGE", "Missing:
# left-pad@1.3.0 from lock file", "ENOSPC: no space left on device"). npm's filler is dropped: bare
# "npm error" lines, its usage/options block and the one-line summary before it, "Run "npm help",
# "A complete log", "command failed", the path/location/errno/syscall fields, where a package sits
# (`node_modules/x`, `x@"1" from the root project`), "For a full report see:" and its file path, and
# `> ` script headers (22 Nov 2026 review: a tail of the last 3 lines kept only the filler and lost
# the cause). npm's lines are kept in order until the 400-character budget runs out, never a fixed
# count of them (recheck: ERESOLVE names the conflict in its 6th line, "peer react@... from react-dom@...").
deploy_tail() { # $1 file -> that line, each part at most 120 characters and 400 in all, or "it printed nothing"
  local t
  t="$(perl -CSD -Mutf8 -e '
    my (@tool, @npm, $usage);
    while (<>) {
      s/\e\[[0-9;?]*[A-Za-z]//g; s/\r//g; s/^\s+|\s+$//g;
      next if !length || /^> /;
      if (s/^npm (?:error|ERR!)(?:\s+|$)//) {
        next if $usage;
        if ($_ eq "Usage:") { $usage = 1; pop @npm; next }
        next if !length || /^A complete log of this run/ || /^Run "npm help / || $_ eq "command failed"
          || /^(?:path|location|errno|syscall) / || m{^node_modules/} || / from the root project$/
          || $_ eq "For a full report see:" || m{^/\S+$};
        push @npm, $_;
      } else { $usage = 0; push @tool, $_ }
    }
    my $cap = sub { length($_[0]) > 120 ? substr($_[0], 0, 119) . "…" : $_[0] };
    @tool = @tool[-(@npm ? 2 : 3)..-1] if @tool > (@npm ? 2 : 3);
    my $o = join(" | ", map { $cap->($_) } @tool);
    my $pre = "npm error ";
    for my $l (map { $cap->($_) } @npm) {
      my $head = ($o eq "" ? "" : " | ") . $pre;
      if (length($o) + length($head) + length($l) > 400) {
        my $room = 400 - length($o) - length($head) - 1;
        $o .= $head . substr($l, 0, $room) . "…" if $room >= 20;
        last;
      }
      $o .= $head . $l; $pre = "";
    }
    print $o;
  ' "$1" 2>/dev/null)"
  [ -n "$t" ] || { echo "it printed nothing"; return; }
  printf '%s\n' "$t"
}
deploy_step() { # $1 step name  $2 dir  $3 command -> its exit code; output to its own file, then the terminal
  local rc out
  # Into a file, never a pipe: a pipe makes land wait for every process holding its write end, so a
  # daemon the deploy left behind (`wrangler dev &`) would hang land for ever, holding the deploy lock
  # (22 Nov 2026 recheck). Bash waits for the command alone. Each step gets a FRESH file, removed when
  # it ends: a child an earlier step left running writes only into that step's unlinked file, never
  # into the next step's reason (22 Nov 2026 follow-up). The output is printed when the step ends.
  out="$(mktemp "${TMPDIR:-/tmp}/land-step.XXXXXX" 2>/dev/null)" \
    || { DEPLOY_WHY="$1 did not run: no temp file for its output could be made"; return 1; }
  DEPLOY_STEP_FILE="$out" # so a signal mid-step still removes it (deploy_cleanup)
  (cd "$2" && eval "$3") 9>&- > "$out" 2>&1; rc=$?
  cat "$out"
  [ "$rc" -eq 0 ] || DEPLOY_WHY="$1 exited $rc: $(deploy_tail "$out")"
  rm -f "$out"; DEPLOY_STEP_FILE=""
  return "$rc"
}
deploy_lock() { # -> 0 holding the one local-deploy lock on fd 9 | 1 with DEPLOY_WHY set
  local waited=0 r
  mkdir -p "$(dirname "$LAND_DEPLOY_LOCK")" 2>/dev/null && exec 9>>"$LAND_DEPLOY_LOCK" \
    || { DEPLOY_WHY="NAMED STOP [DEPLOY_LOCK_UNAVAILABLE] the one-deploy-at-a-time lock $LAND_DEPLOY_LOCK could not be opened, so nothing was deployed"; return 1; }
  while :; do
    perl -MFcntl=:flock -e 'open(my $fh, ">&=", 9) or exit 2; flock($fh, LOCK_EX|LOCK_NB) and exit 0; exit($!{EWOULDBLOCK} ? 1 : 2)'; r=$?
    case "$r" in
      0) printf '%s %s %s\n' "$$" "${NAME:-?}" "$(date '+%H:%M')" > "$LAND_DEPLOY_LOCK.owner" 2>/dev/null; return 0 ;;
      1) : ;;
      *) exec 9>&-; DEPLOY_WHY="NAMED STOP [DEPLOY_LOCK_UNAVAILABLE] the one-deploy-at-a-time lock $LAND_DEPLOY_LOCK could not be taken (perl flock failed), so nothing was deployed"; return 1 ;;
    esac
    [ "$waited" -eq 0 ] && echo "     waiting: another local deploy is running on this Mac (pid, repo, start: $(cat "$LAND_DEPLOY_LOCK.owner" 2>/dev/null || echo "unknown")); one at a time, up to $(((LAND_DEPLOY_WAIT + 59) / 60)) min"
    if [ "$waited" -ge "$LAND_DEPLOY_WAIT" ]; then
      exec 9>&-
      DEPLOY_WHY="NAMED STOP [DEPLOY_SLOT_BUSY] another local deploy held this Mac's deploy lock for $(((LAND_DEPLOY_WAIT + 59) / 60)) min (pid, repo, start: $(cat "$LAND_DEPLOY_LOCK.owner" 2>/dev/null || echo "unknown")), so nothing was deployed; land again when it finishes"
      return 1
    fi
    sleep "${LAND_DEPLOY_POLL:-10}"; waited=$((waited + ${LAND_DEPLOY_POLL:-10}))
  done
}
deploy_space() { # -> 0 when the temp volume has LAND_MIN_FREE_GB free | 1 with DEPLOY_WHY set (low or unreadable)
  local tmp="${TMPDIR:-/tmp}" kb
  kb="$(df -Pk "$tmp" 2>/dev/null | awk 'NR == 2 { print $4 }')"
  case "$kb" in ''|*[!0-9]*)
    DEPLOY_WHY="NAMED STOP [DISK_UNREADABLE] free space on $tmp could not be read (df said '${kb:-nothing}'), so nothing was installed or deployed"; return 1 ;;
  esac
  [ "$kb" -ge $((LAND_MIN_FREE_GB * 1024 * 1024)) ] && return 0
  DEPLOY_WHY="NAMED STOP [DISK_LOW] only $((kb / 1024 / 1024)) GB free on $tmp; a local deploy needs $LAND_MIN_FREE_GB GB (a full npm install into a temp copy), so nothing was installed or deployed. Free space, then land again"
  return 1
}
deploy_at() { # $1 sha  $2 command -> its exit code; on failure DEPLOY_WHY says why, for the caller's STOPPED line
  local sha="$1" cmd="$2" wt rc inst wout
  DEPLOY_WHY=""
  deploy_lock || return 1
  # In TMPDIR, the volume deploy_space reads (macOS `mktemp -t` ignores TMPDIR).
  wt="$(mktemp -d "${TMPDIR:-/tmp}/land-deploy.XXXXXX" 2>/dev/null)" || { exec 9>&-; DEPLOY_WHY="could not make a temp folder for the deploy worktree"; return 1; }
  DEPLOY_WT="$wt"; DEPLOY_WT_REPO="$PWD"; wout="$wt.out"; DEPLOY_STEP_FILE="$wout"
  if ! git worktree add -q --detach "$wt" "$sha" 9>&- >"$wout" 2>&1; then
    DEPLOY_WHY="could not check out ${sha:0:7} into a worktree: $(deploy_tail "$wout")"
    deploy_cleanup; exec 9>&-; return 1
  fi
  rm -f "$wout"; DEPLOY_STEP_FILE=""
  rc=0; inst=""
  if [ -f "$wt/package-lock.json" ]; then
    if [ -d "$REPO_DIR/node_modules" ] && cmp -s "$wt/package-lock.json" "$REPO_DIR/package-lock.json"; then
      ln -s "$(cd "$REPO_DIR/node_modules" && pwd -P)" "$wt/node_modules"
    else inst=ci; fi
  elif [ -f "$wt/package.json" ]; then inst=install; fi
  # Free space is read only before an install: a linked node_modules writes next to nothing.
  if [ -n "$inst" ] && ! deploy_space; then rc=1
  elif [ "$inst" = ci ]; then
    echo "     installing (npm ci) in the deploy worktree at ${sha:0:7}…"
    deploy_step "npm ci in the deploy worktree at ${sha:0:7}" "$wt" 'npm ci --no-audit --no-fund --loglevel=error'; rc=$?
  elif [ "$inst" = install ]; then
    # No lockfile at the sha (aplayer-mode keeps it untracked): `npm ci` cannot run, and a worktree
    # with no node_modules builds nothing (8 Oct 2026: wrangler "Could not resolve @apm/ai", 22
    # errors). Install in the worktree, seeded with this checkout's lockfile when there is one, so
    # workspace packages resolve to the sha's own packages/, not this checkout's working tree.
    [ -f "$REPO_DIR/package-lock.json" ] && cp "$REPO_DIR/package-lock.json" "$wt/package-lock.json"
    echo "     installing (npm install, no lockfile at the sha) in the deploy worktree at ${sha:0:7}…"
    deploy_step "npm install in the deploy worktree at ${sha:0:7}" "$wt" 'npm install --no-audit --no-fund --loglevel=error'; rc=$?
  fi
  if [ "$rc" -eq 0 ]; then
    echo "     running the deploy command at ${sha:0:7}…"
    deploy_step "the deploy command" "$wt" "$cmd"; rc=$?
  fi
  deploy_cleanup; exec 9>&-
  return "$rc"
}
# --- deploy_at end ---
smoke_check() { # $1 url -> 200 and "ok":true, read up to 40 s for the edge to serve the new version
  local body="" i
  for i in 1 2 3 4 5 6 7 8; do
    body="$(curl -s -m 15 "$1" 2>/dev/null || true)"
    case "$body" in *'"ok":true'*) echo "     smoke: $1 -> $body"; return 0 ;; esac
    [ "$i" -lt 8 ] && sleep 5
  done
  echo "     smoke FAILED: $1 -> ${body:-no answer}"
  return 1
}
# --- run_conclusion begin (tests/test-land-queue.sh evals this block verbatim) ---
ran_kind() { # $1 a check bucket or run conclusion -> whether a test failed or the check never ran to the end
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    fail|failure) echo "a test failed" ;;
    cancel|cancelled|timed_out|startup_failure|stale|action_required|neutral|pending|queued|""|unreadable|cancelled-at-ceiling)
      echo "the check never ran to the end, so no test result exists" ;;
    *) echo "the check ended $1" ;;
  esac
}
# ONE READ PER POLL, A MINUTE APART (22 Nov 2026 hostile review F1): every wait here read the run twice
# (`gh run view --json conclusion` then `--json status`, 2 REST requests each) every 20 s, after a
# `gh run watch` that polled every 3 s, so one e2e wait of up to 58 min cost ~700 of the account's 5,000
# REST calls an hour. A run's conclusion comes from one `gh api …/actions/runs/<id>` GET (1 request, and 0
# when ~/bin/gh revalidates it with its ETag and GitHub answers 304), every POLL_SECS (60: e2e and CI here
# take 10-58 min, so a minute late is nothing). Empty = still running, or not read (the callers' own
# deadlines turn a run that is never read into a named stop, never a pass).
POLL_SECS="${LAND_POLL_SECS:-60}"
MAIN_WAIT_SECS="${LAND_MAIN_WAIT_SECS:-2700}" # how long main's check run (or a deploy's gate run) is waited for
run_conclusion() { # $1 run id -> its conclusion, empty while it runs or when unreadable
  gh api "repos/{owner}/{repo}/actions/runs/$1" --jq '.conclusion // ""' 2>/dev/null
}
# queue_gh lives here, above the --promote path, because every wait on a run uses it (wait_run_bounded below,
# the queue block further down). A REFUSED READ IS NOT "STILL RUNNING" (22 Nov 2026): a 403 (spent allowance) on `gh run view` gave an empty
# conclusion, read as "still running", so land waited blind to the ceiling; on `gh run list` it read as "nothing in
# flight". Every queue read goes through queue_gh: a spent allowance sleeps to GitHub's reset once (rate_wait) and
# asks again; anything else, or a second refusal, is rc 75 with a NAMED STOP line naming the reset (could not verify).
queue_gh() { # gh args -> its stdout | rc 75 with one NAMED STOP line on stderr
  local out err try ef
  ef="$(mktemp)" || return 75
  for try in 1 2; do
    out="$(gh "$@" 2>"$ef")" && { rm -f "$ef"; printf '%s\n' "$out"; return 0; }
    err="$(head -2 "$ef" | paste -sd' ' -)"; [ -n "$err" ] || err="no answer"
    [ "$try" -eq 1 ] && declare -F rate_wait >/dev/null && rate_wait "$err" && continue
    break
  done
  rm -f "$ef"
  local reset=""
  is_rate_limit "$err" 2>/dev/null && reset="; its allowance resets at $(when $(( $(date +%s) + $(rate_reset_in) )) 2>/dev/null || echo "an unknown time")"
  local why="${UNREADABLE_WHY:-}"; [ -n "$why" ] || why="main's post-merge run is unknown, so nothing was merged" # the caller names its stop and its consequence
  echo "NAMED STOP [${UNREADABLE_STOP:-QUEUE_UNREADABLE}] GitHub refused gh $1 $2 ($err)$reset: $why" >&2
  return 75
}
# Wait for one run to a terminal conclusion, bounded by 1.5x the workflow's last completed
# duration (a step past 1.5x is cancelled and investigated, never watched). Prints the conclusion.
# A REFUSED READ IS NOT "STILL RUNNING" (22 Nov 2026): the read swallowed its errors, so a 403 or a
# 502 looked like a run in progress until the ceiling, and then land cancelled a healthy run it had
# never seen. It reads through queue_gh (one wait for a spent rate allowance, one more ask): still
# refused, it prints "unreadable" with NAMED STOP [RUN_UNREADABLE] and returns 75, cancelling nothing.
wait_run_bounded() { # $1 run id  $2 ceiling seconds -> conclusion | cancelled-at-ceiling (rc 1) | unreadable (rc 75)
  local rid="$1" deadline=$(( $(date +%s) + $2 )) conc=""
  while :; do
    conc="$(UNREADABLE_STOP=RUN_UNREADABLE UNREADABLE_WHY="the result of run $rid is unknown, so it was not cancelled and nothing was decided on it" \
            queue_gh api "repos/{owner}/{repo}/actions/runs/$rid" --jq '.conclusion // ""')" || { echo unreadable; return 75; }
    [ -n "$conc" ] && break
    if [ "$(date +%s)" -ge "$deadline" ]; then
      gh run cancel "$rid" >/dev/null 2>&1 || true
      echo "cancelled-at-ceiling"; return 1
    fi
    sleep "$POLL_SECS"
  done
  echo "$conc"
}
# --- run_conclusion end ---
# Measured from the newest SUCCESSFUL run (1 Nov 2026): a failed or cancelled run ends early, and once
# a load-error run of 2 min set e2e's ceiling to the 10-min floor, so a healthy 12-min run was cut off.
# The LONGEST of the last 5 successful runs (6 Nov 2026): one quick 6-min dailystory deploy set a 9-min
# ceiling and cut off a healthy 17-min run (normal is 17-19 min) in its warm-up step.
last_duration() { # $1 workflow -> seconds of the longest of its last 5 successful runs on main (default 1800)
  gh run list --workflow "$1" --branch main --status success --limit 5 --json createdAt,updatedAt \
    -q '[.[] | ((.updatedAt | fromdateiso8601) - (.createdAt | fromdateiso8601))] | max // empty' 2>/dev/null | grep -E '^[0-9]+$' || echo 1800
}
# Run the full e2e workflow on main's head (or adopt the run already in flight on it) and wait,
# bounded by 1.5x its last completed duration (floor 10 min). Sets RID and CONC; never dies, so the
# caller words the stop for its own path.
run_e2e_on_main() { # $1 sha of main's head
  local sha="$1" t0 ceil
  RID="$(gh run list --workflow "$E2E_WF" --branch main --limit 10 --json databaseId,headSha,status \
          -q "[.[] | select(.headSha == \"$sha\" and .status != \"completed\")][0].databaseId // empty" 2>/dev/null)"
  if [ -z "$RID" ]; then
    t0="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    gh workflow run "$E2E_WF" --ref main >/dev/null || { CONC="could-not-dispatch"; return 1; }
    for _ in $(seq 1 12); do
      sleep 10
      RID="$(gh run list --workflow "$E2E_WF" --branch main --event workflow_dispatch --limit 5 --json databaseId,headSha,createdAt \
              -q "[.[] | select(.headSha == \"$sha\" and .createdAt >= \"$t0\")][0].databaseId // empty" 2>/dev/null)"
      [ -n "$RID" ] && break
    done
    [ -n "$RID" ] || { CONC="no-run-appeared"; return 1; }
  fi
  ceil=$(( $(last_duration "$E2E_WF") * 3 / 2 )); [ "$ceil" -ge 600 ] || ceil=600
  echo "     run $RID, ceiling $((ceil / 60)) min (1.5x the last completed run)"
  CONC="$(wait_run_bounded "$RID" "$ceil")" || true
  echo "     $E2E_WF on ${sha:0:7}: $CONC"
  [ "$CONC" = success ]
}
# The PR's size, read from GitHub into PR_ADD / PR_DEL / PR_FILES / PR_PATHS (so the small-change
# reason can print the numbers that decided it), then judged by large_reason: pr_large_reason
# prints the reason (0) or nothing (1). A size that cannot be read is judged large by large_reason
# itself (fail closed: the suite runs).
PR_ADD="?"; PR_DEL="?"; PR_FILES="?"; PR_PATHS=""
pr_size() { # $1 pr number
  local stats
  stats="$(gh pr view "$1" --json additions,deletions,changedFiles,files \
            -q '"\(.additions) \(.deletions) \(.changedFiles)", (.files[].path)' 2>/dev/null)" || stats=""
  [ -n "$stats" ] || stats="? ? ?"
  read -r PR_ADD PR_DEL PR_FILES <<<"$(head -1 <<<"$stats")"
  PR_PATHS="$(tail -n +2 <<<"$stats")"
}
pr_large_reason() { large_reason "$PR_ADD" "$PR_DEL" "$PR_FILES" <<<"$PR_PATHS"; }
# A SELF-DEPLOYING REPO WITH A D1 DATABASE MIGRATES BEFORE IT MERGES (D1_PREMERGE, routes block).
# 30 Oct 2026, p-n-p #162: Cloudflare Pages deployed code reading a new `corporate` column the moment
# the merge landed, nothing applied migration 0026, and porchandparty901.com's request form could
# fail until someone applied it by hand. Pages has no migration step and no deploy script to put one
# in, so land does it: migrations in that repo are ADDITIVE ONLY (the old code runs fine on the new
# schema), so they are applied from the PR head, through the repo's own wrangler.toml, BEFORE the
# merge — a failure is a NAMED STOP and nothing is merged. After the merge land reads the pending
# list from main and refuses to say LANDED while any migration is unapplied (it applies them first:
# an already-merged PR, or one that slipped past, still owes them). Never `wrangler deploy`.
# --- d1 begin (tests/test-land-d1.sh evals this block verbatim) ---
# WRANGLER NEEDS A CLOUDFLARE TOKEN, AND THIS MAC HAS NO WRANGLER LOGIN (9 Nov 2026): p-n-p #179 and
# #209 merged clean, then land stopped on a false D1_MIGRATIONS_PENDING ("the live site may be
# failing") because the list call had no token and could not be read; with the vault's token it
# said "No migrations to apply". So the D1 calls use the caller's CLOUDFLARE_API_TOKEN when set, else
# run inside the Boss OS vault (its CLOUDFLARE_API_TOKEN), as the aplayer-mode deploy does. The token
# is injected, never printed. An unreadable list still fails closed (d1_none_pending).
vault_run() { (cd "$HOME/GitHub/boss-os" && npm run --loglevel=error vault:run -- "$@"); }
cf_token_run() { # run "$@" in $PWD with a Cloudflare token: the caller's, else the vault's
  if [ -n "${CLOUDFLARE_API_TOKEN:-}" ]; then "$@"; return; fi
  vault_run sh -c 'cd "$1" && shift && exec "$@"' sh "$PWD" "$@"
}
D1_APPLY='cf_token_run env CI=true npx wrangler d1 migrations apply "$D1_PREMERGE" --remote'
D1_LIST='cf_token_run npx wrangler d1 migrations list "$D1_PREMERGE" --remote'
touches_migrations() { grep -qE '(^|/)migrations/'; } # PR paths on stdin -> 0 when any is a migration
d1_none_pending() { # $1 sha -> 0 only when wrangler, from that sha's wrangler.toml, says nothing is pending
  # Not in a $( ) subshell, so DEPLOY_WHY reaches the caller's STOPPED line; the output goes to a file.
  local out
  out="$(mktemp -t land-d1-list.XXXXXX)" || { DEPLOY_WHY="could not make a temp file for the D1 list"; return 1; }
  deploy_at "$1" "$D1_LIST" > "$out" 2>&1 || { tail -5 "$out"; rm -f "$out"; return 1; }
  tail -3 "$out"
  grep -q 'No migrations to apply' "$out"; local r=$?
  [ "$r" -eq 0 ] || DEPLOY_WHY="wrangler did not say 'No migrations to apply': $(deploy_tail "$out")"
  rm -f "$out"; return "$r"
}
d1_apply_at() { # $1 sha -> 0 applied and nothing left pending | 1 (named by the caller)
  deploy_at "$1" "$D1_APPLY" || return 1
  d1_none_pending "$1"
}
d1_premerge() { # $1 PR head sha. PR_PATHS from pr_size; empty (unreadable) = migrate anyway, fail closed
  [ -n "$D1_PREMERGE" ] || return 0
  if [ -n "$PR_PATHS" ] && ! touches_migrations <<<"$PR_PATHS"; then
    echo "     D1 $D1_PREMERGE: the PR changes no migration — nothing to apply before the merge"; return 0
  fi
  echo "     D1 $D1_PREMERGE: applying the PR's migrations from ${1:0:7} BEFORE the merge (additive; Pages deploys on merge)"
  d1_apply_at "$1"
}
d1_postmerge() { # $1 merge sha -> 0 nothing pending (applying any still owed first) | 1
  [ -n "$D1_PREMERGE" ] || return 0
  echo "     D1 $D1_PREMERGE: confirming no migration is pending on ${1:0:7}"
  d1_none_pending "$1" && return 0
  echo "     D1 $D1_PREMERGE: migrations pending after the merge — applying them from ${1:0:7}"
  d1_apply_at "$1"
}
# --- d1 end ---
# A SELF-DEPLOYING REPO SHIPS PRODUCTION THROUGH ITS OWN WORKFLOW (PROMOTE_VIA, routes block): one
# writer of production, and a gate that runs where the deploy runs. land dispatches it with the sha
# and the reason, finds the run it started, and waits for it — bounded by 1.5x that workflow's last
# completed run (floor 6 min), cancelled past it. 0 only when that run concluded success.
promote_dispatch() { # $1 sha  $2 reason
  local sha="$1" why t0 rid="" ceil conc
  why="${2//\"/}"; why="${why//\\/}"; why="${why:0:140}"
  t0="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  gh workflow run "$PROMOTE_VIA" --ref main -f sha="$sha" -f reason="$why" >/dev/null || { echo "     could not dispatch $PROMOTE_VIA"; return 1; }
  for _ in $(seq 1 12); do
    sleep 10
    rid="$(gh run list --workflow "$PROMOTE_VIA" --event workflow_dispatch --limit 5 --json databaseId,createdAt \
            -q "[.[] | select(.createdAt >= \"$t0\")][0].databaseId // empty" 2>/dev/null)"
    [ -n "$rid" ] && break
  done
  [ -n "$rid" ] || { echo "     dispatched $PROMOTE_VIA for ${sha:0:7} but no run appeared in 2 minutes. Check: gh run list --workflow $PROMOTE_VIA"; return 1; }
  ceil=$(( $(last_duration "$PROMOTE_VIA") * 3 / 2 )); [ "$ceil" -ge "${LAND_WAIT_FLOOR_SECS:-360}" ] || ceil=${LAND_WAIT_FLOOR_SECS:-360}
  echo "     $PROMOTE_VIA run $rid for ${sha:0:7} — waiting (ceiling $((ceil / 60)) min)"
  conc="$(wait_run_bounded "$rid" "$ceil")" || true
  echo "     $PROMOTE_VIA run $rid: $conc"
  [ "$conc" = success ]
}

# NEVER RACE THE REPO'S OWN PROMOTE. 26 Sep 2026: sheila-creator-dashboard grew promote.yml (fires
# on a green e2e run of main, deploys production from that sha, records the GitHub Deployment). Its
# already-live check only catches the SEQUENTIAL case; a person running `land --promote` in the same
# minutes would build + `d1 migrations apply` + `wrangler deploy` the same sha on top of it. So
# before deciding what to promote, an in-flight promote run (queued, waiting, in_progress) is
# waited for — bounded by 1.5x its last completed duration, floor 6 min — and production is read
# only after it finishes (which is then usually "NOTHING TO PROMOTE"). Past the ceiling it is
# cancelled and this stops by name; nothing is ever deployed on top of it. A repo with no
# promote.yml on origin/main has nothing to wait for and this is silent.
# $1 (optional): a sha whose promote run is EXPECTED to appear (the --run-e2e path: promote.yml
# fires on the e2e success just waited for) — polled for up to LAND_PROMOTE_APPEAR_SECS (120 s).
# PROMOTE_WF comes from the routes block (promote.yml unless the route names another).
promote_wait_inflight() {
  local expect="${1:-}" appear_by=$((SECONDS + ${LAND_PROMOTE_APPEAR_SECS:-120})) row="" rid sha st ceil conc
  git cat-file -e "origin/main:.github/workflows/$PROMOTE_WF" 2>/dev/null || return 0
  while :; do
    row="$(gh run list --workflow "$PROMOTE_WF" --limit 10 --json databaseId,headSha,status \
            -q '[.[] | select(.status != "completed")][0] | select(. != null) | "\(.databaseId)\t\(.headSha)\t\(.status)"' 2>/dev/null)"
    [ -n "$row" ] && break
    [ -n "$expect" ] && [ "$SECONDS" -lt "$appear_by" ] || return 0
    sleep 10
  done
  IFS=$'\t' read -r rid sha st <<<"$row"
  ceil=$(( $(last_duration "$PROMOTE_WF") * 3 / 2 )); [ "$ceil" -ge "${LAND_WAIT_FLOOR_SECS:-360}" ] || ceil=${LAND_WAIT_FLOOR_SECS:-360}
  echo "     promote run $rid in flight for ${sha:0:7} ($st) — waiting (ceiling $((ceil / 60)) min, 1.5x its last completed run)"
  conc="$(wait_run_bounded "$rid" "$ceil")" || true
  [ "$conc" != unreadable ] || die "NAMED STOP [RUN_UNREADABLE] $PROMOTE_WF run $rid on ${sha:0:7} could not be read, so nothing was deployed on top of it: read the run (gh run view $rid), then land --promote $NAME again."
  [ "$conc" != cancelled-at-ceiling ] || die "NAMED STOP [PROMOTE_RUN_PAST_CEILING] $PROMOTE_WF run $rid on ${sha:0:7} ran past $((ceil / 60)) min and was cancelled. Nothing deployed on top of it: read the run (gh run view $rid), then land --promote $NAME again."
  echo "     promote run $rid finished: $conc — reading production again"
}

# ---------------------------------------------------------------------------------------------
# land --promote [<repo>] [--run-e2e]: the newest e2e-green main commit, newer than production.
if [ "$MODE" = promote ]; then
  EXPECT="a main commit newer than production with a green full test run, then production to carry it"; LOOK=""
  { [ -n "$DEPLOY" ] || [ -n "$PROMOTE_VIA" ]; } && [ -n "$E2E_WF" ] || die "$NAME has no full-e2e route (E2E_WF unset): land <pr> ships it to production directly, so there is nothing to promote"
  say "1/4  reading main, production and the $E2E_WF runs for $NAME"
  git fetch -q origin main || die "could not fetch main"
  HEADSHA="$(git rev-parse origin/main)"
  promote_wait_inflight
  PROD="$(production_sha)"
  echo "     main ${HEADSHA:0:7}; production ${PROD:-unrecorded (no GitHub deployment yet: any e2e-green commit qualifies)}"
  # The list is built FIRST and promote_pick reads it from a variable: 26 Sep 2026, the first
  # real --promote piped `git rev-list | while | promote_pick`, promote_pick stopped at its
  # answer, git took SIGPIPE, pipefail made the whole pipeline 141, and `|| CAND=""` threw the
  # right sha away — "nothing to promote" with a green commit sitting right there.
  pick_candidate() {
    local greens list
    greens="$(gh run list --workflow "$E2E_WF" --branch main --status success --limit 100 --json headSha -q '.[].headSha' 2>/dev/null | sort -u)"
    list="$(git rev-list --max-count=50 origin/main | while read -r sha; do
      if grep -qx "$sha" <<<"$greens"; then printf '%s\tgreen\n' "$sha"; else printf '%s\tother\n' "$sha"; fi
    done)"
    promote_pick "$PROD" <<<"$list"
  }
  CAND="$(pick_candidate)" || CAND=""
  if [ -z "$CAND" ] && [ -n "$PROD" ] && [ "$PROD" = "$HEADSHA" ]; then
    say "NOTHING TO PROMOTE — production already runs main's head ${HEADSHA:0:7}."; exit 0
  fi
  if [ -z "$CAND" ] && [ -n "$RUN_E2E" ]; then
    say "2/4  no e2e-green commit newer than production — running $E2E_WF on main ${HEADSHA:0:7} (--run-e2e)"
    # An in-flight run on the head (someone's dispatch) is waited for, not doubled.
    RID=""; CONC=""
    run_e2e_on_main "$HEADSHA" || true
    case "$CONC" in
      could-not-dispatch) die "could not dispatch $E2E_WF on main" ;;
      no-run-appeared) die "dispatched $E2E_WF on main but no run appeared in 2 minutes. Check: gh run list --workflow $E2E_WF" ;;
    esac
    [ "$CONC" = success ] || die "$E2E_WF run $RID on main ${HEADSHA:0:7} ended $CONC ($(ran_kind "$CONC")). Nothing promoted; production stays on ${PROD:-its current build}. Fix main first: gh run view $RID"
    # That success is exactly what the repo's promote.yml (if any) fires on: wait for it, then
    # read production again — it has usually just shipped this very sha.
    promote_wait_inflight "$HEADSHA"
    PROD="$(production_sha)"
    if [ "$PROD" = "$HEADSHA" ]; then say "NOTHING TO PROMOTE — the repo's own $PROMOTE_WF shipped main's head ${HEADSHA:0:7} on that green run."; exit 0; fi
    CAND="$(pick_candidate)" || CAND=""
  fi
  if [ -z "$CAND" ]; then
    HEADCONC="$(e2e_verdict "$HEADSHA")"
    die "nothing to promote: no main commit newer than production ${PROD:0:7} has a green $E2E_WF run (main head ${HEADSHA:0:7}: ${HEADCONC:-no completed run}). A small change ships on the fast check with: land <pr> (a merged PR is fine). To prove the head with the suite: land --promote $NAME --run-e2e"
  fi
  say "2/4  promoting ${CAND:0:7} — $(git log --format='%s' -1 "$CAND")"
  [ "$CAND" = "$HEADSHA" ] || echo "     (main's head ${HEADSHA:0:7} has no green $E2E_WF run yet; ${CAND:0:7} is the newest that does)"
  say "3/4  deploying production from exactly ${CAND:0:7}"
  if [ -n "$PROMOTE_VIA" ]; then
    promote_dispatch "$CAND" "land --promote: $E2E_WF green on ${CAND:0:7}" || die "$NAME's own $PROMOTE_VIA did not ship ${CAND:0:7}. Production's record is unchanged (still ${PROD:-unrecorded}). Read that run: gh run list --workflow $PROMOTE_VIA"
    say "4/4  smoke + record"
    if [ -n "$SMOKE" ]; then smoke_check "$SMOKE" || die "production deployed from ${CAND:0:7} but the smoke check failed; read the $PROMOTE_VIA run."; fi
    [ "$(production_sha)" = "$CAND" ] || die "$PROMOTE_VIA ran green for ${CAND:0:7} but production's GitHub Deployment record does not name it. Read that run before assuming production moved."
  else
  deploy_at "$CAND" "$DEPLOY" || die "production deploy from ${CAND:0:7} failed: $DEPLOY_WHY. Production's record is unchanged (still ${PROD:-unrecorded})."
  say "4/4  smoke + record"
  if [ -n "$SMOKE" ]; then smoke_check "$SMOKE" || die "production deployed from ${CAND:0:7} but the smoke check failed. Not recorded; read the deploy output."; fi
  record_production "$CAND" "land --promote from ${CAND:0:7}"
  fi
  say "PROMOTED — $NAME production now runs ${CAND:0:7} (full $E2E_WF green on that sha)."
  exit 0
fi

# --- queue begin (tests/test-land-queue.sh evals this block verbatim) ---
# A MERGE QUEUE OF ONE (owner, 15 Nov 2026: "stop changes taking hours"). e2e.yml cancels a superseded
# run (concurrency cancel-in-progress), so a merge landed while main's post-merge e2e or deploy is still
# running threw that run away and the next land started it again from zero. So before merging: when
# main has a run of this repo's post-merge workflows (E2E_WF, PROMOTE_WF when it exists, DEPLOY_WF) in
# progress, wait for it to finish (one bounded wait, 1.5x its longest recent run, never cancelled by
# this script), then merge. And one line when another PR landed on this repo in the last 30 minutes.
queue_workflows() { printf '%s\n' "$E2E_WF" "$DEPLOY_WF" "$( [ -n "$E2E_WF" ] && printf '%s' "$PROMOTE_WF")" | grep -v '^$' | sort -u; }
queue_inflight() { # -> "<run id>\t<workflow>\t<sha>" of the first post-merge run on main still running, or nothing
  local wf st row
  for wf in $(queue_workflows); do
    for st in in_progress queued; do
      row="$(queue_gh run list --workflow "$wf" --branch main --status "$st" --limit 1 --json databaseId,headSha \
              -q ".[0] | select(. != null) | \"\(.databaseId)\t$wf\t\(.headSha)\"")" || return 75
      [ -n "$row" ] && { printf '%s\n' "$row"; return 0; }
    done
  done
  return 0
}
queue_wait() { # waits for every in-flight post-merge run on main; 0 clear | 1 one ran past its ceiling | 75 unreadable
  local row rid wf sha ceil deadline concl
  while :; do
    row="$(queue_inflight)" || return 75
    [ -n "$row" ] || break
    IFS=$'\t' read -r rid wf sha <<<"$row"
    ceil=$(( $(last_duration "$wf") * 3 / 2 )); [ "$ceil" -ge 600 ] || ceil=600
    echo "     queue: $wf run $rid on main ${sha:0:7} is still running — waiting for it before merging (ceiling $((ceil / 60)) min)"
    deadline=$(( $(date +%s) + ceil ))
    # one read per poll (#146: the run's own api row, a 304 is free), through queue_gh: a refused read is a stop, never "still running"
    while concl="$(queue_gh api "repos/{owner}/{repo}/actions/runs/$rid" --jq '.conclusion // ""')" || return 75; [ -z "$concl" ]; do
      [ "$(date +%s)" -lt "$deadline" ] || { echo "NAMED STOP [QUEUE_RUN_PAST_CEILING] $wf run $rid on main ran past $((ceil / 60)) min; nothing was merged. Read it: gh run view $rid"; return 1; }
      sleep "$POLL_SECS"
    done
    echo "     queue: $wf run $rid finished: $concl"
  done
  return 0
}
recent_lands() { # $1 this PR -> "#N" for each other PR merged into main in the last 30 minutes
  local since; since="$(date -u -v-30M +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d '30 minutes ago' +%Y-%m-%dT%H:%M:%SZ)"
  gh pr list --state merged --base main --limit 20 --json number,mergedAt \
    -q "[.[] | select(.mergedAt >= \"$since\" and .number != $1) | \"#\(.number)\"] | join(\" \")" 2>/dev/null
}
# --- queue end ---

# --- gates begin (tests/test-land-gates.sh evals this block verbatim) ---
is_rate_limit() { grep -qiE 'rate limit|abuse detection' <<<"$1"; }
rate_reset_in() { # -> seconds until GitHub's spent allowance comes back (its reported reset + 5 s; 5 when that has
  # passed); 60 when it names no reset (a secondary limit). One definition for land's rate_wait and land-after's patient().
  local reset left
  reset="$(gh api rate_limit --jq '[.resources.core, .resources.graphql] | map(select(.remaining == 0) | .reset) | max // empty' 2>/dev/null)"
  if [[ "$reset" =~ ^[0-9]+$ ]]; then left=$(( reset + 5 - $(date +%s) )); [ "$left" -gt 0 ] || left=5; else left=60; fi
  echo "$left"
}
# TWO QUESTIONS EVERY PR ANSWERS BEFORE IT MERGES (owner, 19-20 Nov 2026: "would a 20 yr veteran do
# this?" and "nothing looks and feels and sounds like AI created it"). Skills no code reads are wishes,
# so both live here, read from the PR body, each refusal one plain line saying what to add.
#  1. PATCH OR REBUILD. A PR that changes lines inside a function a `fix` commit changed in the last
#     LAND_PATCH_DAYS (30) days stops unless its body has `Patch or rebuild: <why> ... #N` naming each
#     such fix. Functions use git's default funcname rule (a line starting with a letter, _ or $ opens
#     one; it runs to the next); history is `git log -L` on the merge base. 19 Nov 2026, west-peek-os:
#     webPropertyChange.ts took #527, #531, #532, #537, #540, #546 and #551 in one day.
#  2. SHIP-READY. A PR in a REVIEW CLASS (review_class: a declared class, the `review-required` label now or ever,
#     a change to live-repos.json, or anything unread; or a first public launch: a launch marker or the first thing
#     people see, per land-surfaces.json) stops, whatever it changes, unless its body has
#     `Ship-ready: PASS — <reviewer> looked at <real output>` (in the body, or in a comment by the repo's
#     owner account: `review_text`) from a reviewer who is not the builder
#     (the PR's author, its commit authors and co-authors, their Claude sessions). Something NEW going
#     public (a launch marker added, or the repo's first surface) also needs `Launch-ready: PASS — ...`.
#     The same Ship-ready line carries `Engineering: PASS` (every automatic fail in engineering.md; no
#     numbered range, which went stale the day fail 7 was added): the reviewer who
#     passed what people see also passed how it is built (her ruling 21 Nov 2026: "our rules dont allow
#     things to be built cheaply and horribly"; a keyword guess shipped in West Peek OS that day).
#     A CI check named `ship-ready-baseline` (row 18), when the PR has one, must be green.
LAND_SURFACES="${LAND_SURFACES:-${LAND_DIR:-$HOME/bin}/land-surfaces.json}"
LAND_PATCH_DAYS="${LAND_PATCH_DAYS:-30}"
gate_lines() { # $1 jq path into land-surfaces.json -> its patterns joined into one ERE (rc 1: file unreadable)
  jq -er "[$1] | flatten | map(select(type == \"string\")) | join(\"|\")" "$LAND_SURFACES" 2>/dev/null
}
surface_re() { # stdin: every path on main -> one ERE of what people see in this repo
  local tree types detect surf re
  tree="$(cat)"; re="$(gate_lines '.everywhere')" || return 1
  types="$(jq -r '.types[] | "\(.detect)\t\(.surfaces | join("|"))"' "$LAND_SURFACES")" || return 1
  while IFS=$'\t' read -r detect surf; do
    [ -n "$detect" ] && grep -qE "$detect" <<<"$tree" && re="$re|$surf"
  done <<<"$types"
  printf '%s\n' "$re"
}
surface_files() { # $1 ERE from surface_re; stdin: changed paths -> the ones a person sees
  local ex; ex="$(gate_lines '.exclude')" || return 1
  grep -E "$1" | grep -vE "$ex" || true
}
pass_line() { # $1 Ship-ready|Launch-ready; stdin: PR body -> its last PASS line (rc 1 none)
  local line
  line="$(grep -iE "^[[:space:]>*-]*$1: *PASS *(—|–|-{1,2}|:) *.+ looked at .+" | grep -vE '<[A-Za-z][^<>]*>' | tail -1)"   # the template's own <placeholder> line is no PASS
  [ -n "$line" ] && printf '%s\n' "$line"
}
review_entries() { # [$1 voided]; stdin: PR view JSON -> "<epoch or empty>|<base64 text>" for each place a reviewer's PASS line may
  # stand: the body (no time), then each comment by the repo's OWNER account (oldest first, with its createdAt).
  # Every agent posts as the owner's login; a comment from any other account (a passer-by on a public repo, a bot)
  # is never read, so no one else can sign a PR off (22 Nov 2026 review N8).
  # The newest verdict wins: from the last text that says `VERDICT: fail` on, so a later fail comment voids an
  # earlier PASS (review N9); a PASS posted after that fail still counts.
  # A fail verdict is the comment's FIRST line only, `VERDICT: fail` as a whole word (review R5): a later
  # note that quotes an earlier fail, "failsafe" or "failed checks fixed" never voids a PASS.
  jq -r '[{at: "", b: (.body // "")}, (.comments[]? | select(.authorAssociation == "OWNER")
          | {at: ((.createdAt // "") | (try (fromdateiso8601 | tostring) catch "")), b: (.body // "")})]
    | ([to_entries[] | select(.value.b | test("\\A\\W*verdict:\\W*fail\\b"; "i")) | .key] | last // 0) as $from
    | (if $part == "voided" then .[:$from] else .[$from:] end)[] | "\(.at)|\(.b | @base64)"' --arg part "${1:-}" 2>/dev/null
  # With "voided": the texts BEFORE that fail instead, the ones it voids (voided_pass says so to the builder).
}
review_text() { # stdin: PR view JSON -> the texts of review_entries, one after another
  local at b64
  review_entries | while IFS='|' read -r at b64; do base64 -d <<<"$b64"; echo; done
}
when() { date -u -r "$1" '+%d %b %H:%M UTC' 2>/dev/null || date -u -d "@$1" '+%d %b %H:%M UTC'; }   # epoch -> "22 Nov 14:00 UTC" (BSD, GNU)
voided_pass() { # $1 Ship-ready|Launch-ready; stdin: PR view JSON -> one sentence, rc 0, when a $1 PASS line stands
  # (body or owner comment) only BEFORE the newest VERDICT: fail, so review_entries does not count it. The newest-verdict
  # rule stays; the builder is told why and the way out (22 Nov 2026: 4 PRs refused "no PASS" with a PASS in the body).
  # Reads review_entries only, so a non-owner comment is never read, trusted or echoed. rc 1 when nothing was voided.
  local json at b64 where="" failat n=0
  json="$(cat)"
  while IFS='|' read -r at b64; do   # the first entry is always the body, the rest owner comments
    n=$((n + 1)); base64 -d <<<"$b64" | pass_line "$1" >/dev/null || continue
    if [ "$n" -eq 1 ]; then where="the PR body"; else where="an owner comment${at:+ of $(when "$at")}"; fi
  done < <(review_entries voided <<<"$json")
  [ -n "$where" ] || return 1
  failat="$(review_entries <<<"$json" | head -1 | cut -d'|' -f1)"
  [ -n "$failat" ] && failat=" ($(when "$failat"))"
  echo "its $1 PASS in $where does not count: a later VERDICT: fail comment$failat voids it (the newest verdict wins). If those fails are fixed and re-checked, the reviewer posts the PASS again as a NEW PR comment"
}
owner_text() { # stdin: PR view JSON -> the body, then every comment by the repo's OWNER account: where a builder's
  # own answer (Patch or rebuild) may stand. Not a verdict, so a later fail never voids it (review R4).
  jq -r '(.body // ""), (.comments[]? | select(.authorAssociation == "OWNER") | (.body // ""))' 2>/dev/null
}
covers_engineering() { # stdin: one PASS line -> 0 when it also passes every automatic fail in engineering.md
  grep -qiE 'engineering: *pass'
}
signoff() { # $1 Ship-ready|Launch-ready; stdin: PR body -> the reviewer on its last PASS line (rc 1 none)
  local line
  line="$(pass_line "$1")" || return 1
  printf '%s\n' "$line" | sed -E "s/^[[:space:]>*-]*$1: *PASS *(—|–|-{1,2}|:) *//; s/ [Ll][Oo][Oo][Kk][Ee][Dd] [Aa][Tt] .*//; s/^[[:space:]]+//; s/[[:space:]]+$//"
}
builders() { # stdin: the PR view JSON (author, commits) -> one lowercase identity per line
  jq -r '(.author.login // empty),
         (.commits[]? | (.authors[]? | (.login // empty), (.name // empty), (.email // empty)), (.messageBody // "" | split("\n")[] | select(test("^co-authored-by:|session_"; "i"))))' 2>/dev/null \
  | awk '
      /^[Cc]o-[Aa]uthored-[Bb]y:/ { sub(/^[^:]*: */, ""); n = $0; sub(/ *<.*/, "", n); print n; if (match($0, /<[^>]*>/)) print substr($0, RSTART + 1, RLENGTH - 2); next }
      /session_[A-Za-z0-9]+/ { while (match($0, /session_[A-Za-z0-9]+/)) { print substr($0, RSTART, RLENGTH); $0 = substr($0, RSTART + RLENGTH) } next }
      /:/ || NF == 0 { next }
      { print }' \
  | tr '[:upper:]' '[:lower:]' | sed -E 's/^[[:space:]]+|[[:space:]]+$//g' | grep . | sort -u
}
is_builder() { # $1 reviewer, $2 builder identities -> 0 when the reviewer is (or cannot be told from) the builder
  local r id; r="$(tr '[:upper:]' '[:lower:]' <<<"$1" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"
  case "$r" in ""|me|i|self|myself|builder|"the builder"|"same agent"|"<reviewer>"*|"<"*) return 0 ;; esac
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    [ "$r" = "$id" ] && return 0
    case "$id" in session_*|*@*) case "$r" in *"$id"*) return 0 ;; esac ;; esac
  done <<<"$2"
  return 1
}
baseline_red() { # $1 the PR's checks JSON -> prints "<name>: <bucket>" and rc 0 when ship-ready-baseline is present and not green
  jq -er '[.[] | select(.name | test("(^|[ /])ship-ready-baseline$")) | select(.bucket != "pass" and .bucket != "skipping") | "\(.name): \(.bucket)"] | select(length > 0) | join("; ")' <<<"$1" 2>/dev/null
}
# A PASS IS FOR THE COMMIT IT LOOKED AT (22 Nov 2026: a stale PASS still landed). The PASS line names that
# commit (7-40 hex characters, at least one a-f, on the PR's history). New work in the PR's own commits after
# it refuses with STALE_PASS. A merge from main that keeps either side does not count (her ruling: "a PASS
# survives updates"). A merge's own new lines do count: `diff-tree --cc` lists only the files a merge changed
# against every parent.
# A re-check line names two commits, the old one first ("the diff A..B", "diff since A, tests at B"), so the
# NEWEST commit the line names is the one it passed (review F1).
# A PASS line that names no commit (the reviewer template's own shape) counts only where its time is known: an
# OWNER comment posted after the newest commit of the PR's own work REACHED GITHUB. In the body, or older than that
# push, it is STALE_PASS (review F2). The commit's own date is the builder's to set (review F5: committed 10:00,
# PASS 10:10 on the older head, pushed 10:20), so the time is GitHub's: its earliest check suite for that commit.
# The sha to tell a reviewer to post: 8 characters, lengthened until one is a-f (pass_sha reads a bare number as a size).
sha_name() { local n=8; while [ "$n" -lt 40 ] && [[ ! "${1:0:$n}" =~ [a-f] ]]; do n=$((n + 1)); done; printf '%s' "${1:0:$n}"; }
pass_sha() { # $1 one PASS line  $2 head sha -> the full sha of the newest commit it names (rc 1 none on the PR's history)
  local t best=""
  for t in $(tr -cs '[:alnum:]' '\n' <<<"$1" | tr '[:upper:]' '[:lower:]' | grep -E '^[0-9a-f]{7,40}$' | grep '[a-f]'); do
    t="$(git rev-parse -q --verify "$t^{commit}" 2>/dev/null)" || continue
    git merge-base --is-ancestor "$t" "$2" 2>/dev/null || continue
    { [ -z "$best" ] || git merge-base --is-ancestor "$best" "$t" 2>/dev/null; } && best="$t"
  done
  [ -n "$best" ] && printf '%s\n' "$best"
}
pass_posted() { # $1 Ship-ready|Launch-ready; stdin: PR view JSON -> epoch of the OWNER comment holding the last $1 PASS line
  # (rc 1 when that line stands in the body, or its time is unknown)
  local at b64 last=""
  while IFS='|' read -r at b64; do
    base64 -d <<<"$b64" | pass_line "$1" >/dev/null && last="${at:-none}"
  done < <(review_entries)
  [[ "$last" =~ ^[0-9]+$ ]] && echo "$last"
}
own_work_sha() { # $1 head -> the newest commit of the PR's own work: main's commits and merges that keep a side
  # excluded, as in changed_since_pass (rc 1 when there is none)
  local c
  while IFS= read -r c; do
    if [ -n "$(git rev-list --no-walk --merges "$c")" ]; then [ -n "$(git diff-tree --no-commit-id --cc --name-only "$c")" ] || continue; fi
    echo "$c"; return 0
  done < <(git rev-list --topo-order "$1" --not origin/main)
  return 1
}
arrived_at() { # $1 commit  $2 head -> epoch GitHub first saw $1: the earliest check suite on it, or on the first commit
  # after it on the way to the head that has one (a later push is never earlier). rc 1 none has a suite | 75 unread
  local c t
  for c in "$1" $(git rev-list --reverse --ancestry-path "$1..$2"); do
    t="$(gh api "repos/{owner}/{repo}/commits/$c/check-suites?per_page=100" --jq '[.check_suites[]?.created_at | fromdateiso8601] | min // empty' 2>/dev/null)" || return 75
    [[ "$t" =~ ^[0-9]+$ ]] && { echo "$t"; return 0; }
  done
  return 1
}
changed_since_pass() { # $1 the PASS's sha  $2 head -> the PR's own files changed after it (main's commits excluded)
  { git log --no-merges --format= --name-only "$1..$2" --not origin/main
    git rev-list --merges "$1..$2" --not origin/main | while IFS= read -r m; do git diff-tree --no-commit-id --cc --name-only "$m"; done
  } | grep . | sort -u
}
have_head() { # $1 PR  $2 head -> 0 once the head commit is here (rc 1 with one line: it could not be fetched)
  git cat-file -e "$2^{commit}" 2>/dev/null || git fetch -q origin "pull/$1/head" 2>/dev/null
  git cat-file -e "$2^{commit}" 2>/dev/null || { echo "PR #$1's head ${2:0:7} could not be fetched to read its commits"; return 1; }
}
fresh_pass() { # $1 Ship-ready|Launch-ready  $2 PR  $3 head  $4 PR view JSON (body, comments) -> rc 1 with one plain line
  # when stale | 75 the head could not be read. Run in the repo, after origin/main is fetched.
  local line sha stale posted="" own arrived="" rc
  line="$(review_text <<<"$4" | pass_line "$1")" || return 0
  have_head "$2" "$3" || return 75
  if ! sha="$(pass_sha "$line" "$3")"; then
    if posted="$(pass_posted "$1" <<<"$4")" && own="$(own_work_sha "$3")"; then
      arrived="$(arrived_at "$own" "$3")"; rc=$?
      [ "$rc" -eq 75 ] && { echo "PR #$2's check suites could not be read, so when its last commit reached GitHub is unknown"; return 75; }
      [ "$rc" -eq 0 ] && [ "$posted" -gt "$arrived" ] && return 0
    fi
    echo "NAMED STOP [STALE_PASS] PR #$2's $1 PASS names no commit on this PR$([ -z "$posted" ] && echo " and stands where its time is unknown (the body)" || { [ -n "$arrived" ] && echo " and was posted before its last commit reached GitHub" || echo " and when its last commit reached GitHub is unknown (no check suite)"; }), so what it passed is unknown: the reviewer posts it again as a PR comment, naming the head it looked at, e.g.  $1: PASS — <its session or run id> looked at <what> at $(sha_name "$3"); Engineering: PASS"
    return 1
  fi
  stale="$(changed_since_pass "$sha" "$3")"
  [ -z "$stale" ] && return 0
  echo "NAMED STOP [STALE_PASS] PR #$2 changed $(head -3 <<<"$stale" | paste -sd' ' -)$([ "$(grep -c . <<<"$stale")" -gt 3 ] && echo " and more") after the commit its $1 PASS names ($(sha_name "$sha")): the reviewer re-checks git diff $(sha_name "$sha")..$(sha_name "$3") and posts a new PASS line naming $(sha_name "$3")"
  return 1
}
# WHAT WAITS ON A REVIEWER (her final list, 27 Nov 2026: "everything doesnt fucking neeed a reviewr this is why shit
# is taking so long"; it replaces "new until launched" of 23 Nov). A fresh reviewer's PASS is required only of a PR
# in a REVIEW CLASS (REVIEW_CLASSES below, the ONE list): money (charges, refunds, prices, payouts); private-data
# (children's, LP or deal data, people's personal details); delete (deleting or bulk-changing people's data or live
# business records); store (App Store, Play, KDP submissions); launch (the ONE first public launch of a new site or
# app); outreach (a new email or sender going to real customers, LPs or prospects). A PR is in a class when it SAYS
# so (`Review class: <class> — <why>`, in its body or an owner-account comment), when it carries or EVER carried the
# `review-required` label, when it changes live-repos.json, when the launch markers show a first public launch
# (gate_quality), or when what it is cannot be read (unknown is never "no review needed"). Nothing else waits:
# local tools, hooks, scripts, bug fixes, tests, docs, config, refactors, content and search pages on a live site,
# internal screens, and ANY PR in a repo not yet launched land on green CI. Size never asks for a reviewer (the
# nightly ENG-CHECK DUE of a 200+ line PR holds no land).
# live-repos.json, beside land in seq-bin, lists every repo whose launch review has landed (owner/repo). Only land's
# launch path writes it (live_add: a fresh reviewer's Launch-ready PASS, landed green); a PR that changes it by hand
# needs the PASS itself. A repo missing from it is NOT a class by that alone: its one launch review is the PR that
# declares `Review class: launch` or trips the launch markers.
# Read beside the land that runs (LAND_DIR is set by land's own re-exec, never by a caller): no env var points it
# at another list.
LAND_LIVE_REPOS="${LAND_DIR:-$HOME/bin}/live-repos.json"
LAND_LIVE_HOME="seq23/seq-bin"   # the repo that holds live-repos.json (live_add commits to its main)
pr_repo() { # stdin: PR view JSON (url) -> its owner/repo (rc 1 when GitHub's answer has none)
  jq -r '.url // ""' 2>/dev/null | sed -nE 's#^https://github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/pull/[0-9]+/?$#\1#p' | grep .
}
live_repo() { # $1 owner/repo -> rc 0 on live-repos.json | 1 not on it | 2 the list could not be read
  jq -e '.live | type == "array" and length > 0 and all(.[]; type == "string")' "$LAND_LIVE_REPOS" >/dev/null 2>&1 || return 2
  jq -e --arg r "$1" 'any(.live[]; ascii_downcase == ($r | ascii_downcase))' "$LAND_LIVE_REPOS" >/dev/null 2>&1
}
# THE CLASS IS WRITTEN, OR READ FROM THE PATHS THE DIFF CHANGES, AND A LABEL NEVER COMES OFF. A PR says
# `Review class: none — <why, 3+ words>` or names its class. A PR with NO usable line is not bounced for that alone
# (her words 27 Nov 2026: "give a root fix to this"): review_class reads the changed paths. A diff touching none of
# the class surfaces land-surfaces.json names by path (.review: payments code, migrations and bulk-data scripts,
# store metadata, email templates and senders), in a repo that holds no data store, is `none`. A diff touching one,
# or any code change in a repo with a data store (private data has no honest path test: any code can read a
# person's record), cannot be told, so the line is asked for (REVIEW_CLASS_UNDECLARED), never guessed. Structure
# only: a path match never demands a reviewer and never says what a change means; the declared class does. A
# review-required label added EVER (label_history: GitHub's issue events, read once) still counts after it is taken
# off, so deleting a line or a label dodges nothing.
REVIEW_CLASSES="money|private-data|delete|store|launch|outreach"
# ONE TEMPLATE, ONE LIST (her words 27 Nov 2026: "is there a template followed?"). Every line a PR's description can
# be stopped for has ONE written form, in pr-body-template.md beside land, under a `<!-- land:CODE … -->` marker.
# The gates below say only what is wrong; problems_print adds the line to write, read from that file, never from a
# second copy here. LAND_BODY_CODES is every stop a line fixes (tests/test-land-check.sh fails when one has no
# template entry, or when a gate raises a code this list lacks); LAND_STATE_CODES are stops no line fixes.
LAND_TEMPLATE="${LAND_DIR:-$HOME/bin}/pr-body-template.md"
LAND_BODY_CODES="REVIEW_CLASS_UNDECLARED REVIEW_PASS_MISSING STALE_PASS LAUNCH_PASS_MISSING MUTATION_PROOF_MISSING PATCH_OR_REBUILD_MISSING FORMS_UNDECLARED OUTCOME_UNDECLARED OUTCOME_CHECK_NOT_READ_ONLY NOT_BUILT_UNDECLARED NOT_CLICKED_THROUGH"
LAND_STATE_CODES="LAND_SURFACES_UNREAD STACKED_PR"
problem() { # $1 code  $2 what is wrong -> one "CODE<TAB>reason" line
  printf '%s\t%s\n' "$1" "$(printf '%s' "$2" | tr '\n\t' '  ')"
}
pass_problem() { # $1 code  $2 ship_pass or launch_pass's line -> its problem line (a stale PASS keeps its own code)
  case "$2" in "NAMED STOP [STALE_PASS] "*) problem STALE_PASS "${2#"NAMED STOP [STALE_PASS] "}" ;; *) problem "$1" "$2" ;; esac
}
template_add() { # $1 code -> the line(s) pr-body-template.md carries for it (rc 1: none there, or the file is unread)
  awk -v c="$1" '
    /^<!-- land:/ { on = 0; s = $0; sub(/^<!-- land:/, "", s); sub(/[^A-Z_,].*$/, "", s)
                    n = split(s, a, ","); for (i = 1; i <= n; i++) if (a[i] == c) on = 1; next }
    on && /^[[:space:]]*$/ { on = 0 }
    on { print; found = 1 }
    END { exit !found }' "$LAND_TEMPLATE" 2>/dev/null
}
problems_print() { # $1 PR  $2 head sha; stdin: problem lines -> ALL of them, numbered, each with the line to add
  local all n=0 code why add
  all="$(grep . || true)"
  printf '\nPR #%s: %s to fix in its description. ALL of them are listed here, each with the line to add (the forms live in pr-body-template.md, seq-bin):\n' "$1" "$(grep -c . <<<"$all") problem(s)"
  while IFS=$'\t' read -r code why; do
    [ -n "$code" ] || continue
    n=$((n + 1)); printf '  %d. [%s] %s\n' "$n" "$code" "$why"
    case " $LAND_BODY_CODES " in *" $code "*) ;; *) continue ;; esac
    if add="$(template_add "$code")"; then
      [ -z "${2:-}" ] || add="${add//<head sha>/$(sha_name "$2")}"
      printf '%s\n' "$add" | sed 's/^/       add: /'
    else printf '       add: (the line for %s could not be read from %s: restore it from seq-bin main)\n' "$code" "$LAND_TEMPLATE"; fi
  done <<<"$all"
}
problems_stop() { # $1 PR; stdin: problem lines -> the ONE stop line: the first problem under its own code, and how many more stand above
  local all code why n rest
  all="$(grep . || true)"; n="$(grep -c . <<<"$all")"
  IFS=$'\t' read -r code why <<<"$(head -1 <<<"$all")"
  if [ "$n" -le 1 ]; then printf 'NAMED STOP [%s] %s' "$code" "$why"
  else rest="$(tail -n +2 <<<"$all" | cut -f1 | paste -sd',' - | sed 's/,/, /g')"
    printf 'NAMED STOP [%s] %s And %s more (%s): every one is listed above with the line to add; land --check %s prints the list again.' "$code" "$why" "$((n - 1))" "$rest" "$1"; fi
}
with_label_history() { # $1 PR; stdin: PR view JSON (url) -> it, plus .label_history (every label ever added; null = unread)
  local j repo ev try; j="$(cat)"
  if repo="$(pr_repo <<<"$j")"; then
    for try in 1 2; do
      ev="$(gh api --paginate "repos/$repo/issues/$1/events" --jq '[.[] | select(.event == "labeled") | .label.name]' 2>/dev/null)" \
        && ev="$(jq -sc 'add // []' <<<"$ev" 2>/dev/null)" && jq -e 'type == "array"' <<<"$ev" >/dev/null 2>&1 \
        && { jq -c --argjson h "$ev" '.label_history = $h' <<<"$j"; return 0; }
      [ "$try" -eq 2 ] || sleep "${LAND_RETRY_SECS:-2}"
    done
  fi
  jq -c '.label_history = null' <<<"$j"
}
class_line() { # stdin: PR body + owner comments -> rc 0 (why on stdout) a line names a class | 1 a reasoned none | 2 no usable line (why on stdout)
  # Any line that names a class wins over a none beside it. A line still carrying the template's <placeholder> is no line.
  local lines cls
  lines="$(sed -nE 's/^[[:space:]>]*([-*][[:space:]]+)?(\*\*)?Review class:(\*\*)?[[:space:]]*//Ip' | tr -d '\r' | sed -E 's/^[*`[:space:]]+//' | grep -vE '^(<|$)' || true)"
  cls="$(grep -viE '^(none|no)([[:space:]]*(—|–|--|-|:)|[[:space:]]*$)' <<<"$lines" | head -1)"
  [ -n "$cls" ] && { echo "it says Review class: $(sed -E 's/[[:space:]]*(—|–|--|:|[[:space:]]-[[:space:]]).*$//' <<<"$cls" | cut -c1-40)"; return 0; }
  grep -qiE '^(none|no)[[:space:]]*(—|–|--|-|:)[[:space:]]*[^[:space:]<]+([[:space:]]+[^[:space:]]+){2,}' <<<"$lines" && return 1
  if [ -n "$lines" ]; then echo "its \`Review class: none\` gives no reason (3+ words after the dash)"; else echo "it has no \`Review class:\` line"; fi
  return 2
}
class_paths() { # stdin: changed paths -> one "<class> (<paths>)" line per class whose surface a path names (land-surfaces.json
  # .review); nothing when none | rc 2 the list could not be read. Tests and docs (.exclude) are no surface.
  local paths ex c re hit
  paths="$(cat)"; ex="$(gate_lines '.exclude')" && [ -n "$ex" ] || return 2
  paths="$(grep -vE "$ex" <<<"$paths" || true)"
  for c in ${REVIEW_CLASSES//|/ }; do
    case "$c" in private-data|launch) continue ;; esac   # data_store and the launch markers (gate_quality) read those two
    re="$(gate_lines ".review[\"$c\"]")" && [ -n "$re" ] || return 2
    hit="$(grep -iE "$re" <<<"$paths" | head -2 | paste -sd' ' -)"
    [ -z "$hit" ] || echo "$c ($hit)"
  done
  return 0
}
data_store() { # $1 every path on main -> rc 0 (stdout: the path that shows it) this repo holds a data store | 1 none | 2 unread
  local re b ex f hit
  re="$(gate_lines '.review.data_store.paths')" && [ -n "$re" ] || return 2
  b="$(gate_lines '.review.data_store.bindings')" && [ -n "$b" ] || return 2
  ex="$(gate_lines '.exclude')" && [ -n "$ex" ] || return 2
  hit="$(grep -vE "$ex" <<<"$1" | grep -iE "$re" | head -1)"; [ -n "$hit" ] && { echo "$hit"; return 0; }
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    git show "origin/main:$f" 2>/dev/null | grep -qE "$b" && { echo "$f"; return 0; }
  done < <(grep -E '(^|/)wrangler\.(toml|jsonc?)$' <<<"$1")
  return 1
}
review_class() { # $1 every path on main; stdin: PR view JSON (labels, label_history, body, comments, files, changedFiles)
  # -> rc 0 it needs a reviewer's PASS (why on stdout) | 1 no class | 2 cannot tell: the Review class line is asked for (why on stdout)
  local j why rc hits store code
  j="$(cat)"
  jq -e '.labels | type == "array"' <<<"$j" >/dev/null 2>&1 || { echo "its labels could not be read"; return 0; }
  jq -e 'any(.labels[]; (.name // "") == "review-required")' <<<"$j" >/dev/null 2>&1 && { echo "it carries the review-required label"; return 0; }
  jq -e '.label_history | type == "array"' <<<"$j" >/dev/null 2>&1 || { echo "its label history could not be read"; return 0; }
  jq -e 'any(.label_history[]; . == "review-required")' <<<"$j" >/dev/null 2>&1 \
    && { echo "it was labeled review-required (a label taken off still counts)"; return 0; }
  why="$(owner_text <<<"$j" | class_line)"; rc=$?
  [ "$rc" -eq 0 ] && { echo "$why"; return 0; }
  jq -e '.files | type == "array"' <<<"$j" >/dev/null 2>&1 || { echo "its files could not be read"; return 0; }
  jq -e '(.changedFiles // (.files | length)) > (.files | length)' <<<"$j" >/dev/null 2>&1 \
    && { echo "GitHub listed only $(jq '.files | length' <<<"$j") of its $(jq '.changedFiles' <<<"$j") files, so the rest are unread"; return 0; }
  jq -e 'any(.files[]; (.path // "") | test("(^|/)live-repos\\.json$"))' <<<"$j" >/dev/null 2>&1 \
    && { echo "it changes live-repos.json, the list of launched repos (only land's launch path writes it)"; return 0; }
  [ "$rc" -eq 1 ] && return 1
  # No usable line: the changed paths say none, or the line is asked for. Never a guess.
  hits="$(jq -r '.files[]?.path' <<<"$j" | class_paths)" \
    || { echo "$why, and $LAND_SURFACES could not be read, so which review-class paths its diff touches is unknown"; return 2; }
  [ -n "$hits" ] && { echo "$why, and its diff touches paths a review class lives in: $(paste -sd';' - <<<"$hits" | sed 's/;/; /g')"; return 2; }
  code="$(jq -r '.files[]?.path' <<<"$j" | grep -vE "$(gate_lines '.exclude')" | head -1)"
  [ -n "$code" ] || return 1   # tests and docs only
  [ -n "${1:-}" ] || { echo "$why, and main's file list could not be read, so whether this repo holds a data store is unknown"; return 2; }
  store="$(data_store "$1")"
  case $? in
    1) return 1 ;;
    0) echo "$why, and this repo holds a data store ($store), where no path test can say a change keeps clear of private data"; return 2 ;;
    *) echo "$why, and $LAND_SURFACES could not be read, so whether this repo holds a data store is unknown"; return 2 ;;
  esac
}
ship_pass() { # $1 PR  $2 PR view JSON  $3 head  $4 what the PR does  $5 what the reviewer looks at
  # -> rc 0 when a fresh reviewer (not the builder) stands on the last Ship-ready PASS line, with Engineering: PASS,
  # for this head | 1 refused, one line on stdout | 75 could not read. One check, used by the review gate and
  # by the click-through stop (a rendered: PASS), never two copies.
  local body ids reviewer why msg
  body="$(review_text <<<"$2")"; ids="$(builders <<<"$2")"
  reviewer="$(signoff Ship-ready <<<"$body")" \
    || { why="$(voided_pass Ship-ready <<<"$2")" && { echo "PR #$1 $4, but $why, naming head $(sha_name "$3")"; return 1; }
         echo "PR #$1 $4, and no fresh reviewer's Ship-ready PASS line stands for it: a fresh reviewer looks at $5 at head $(sha_name "$3") and posts the line as a PR comment by the repo's owner account (a later VERDICT: fail voids a PASS in the body)"; return 1; }
  is_builder "$reviewer" "$ids" \
    && { echo "PR #$1's Ship-ready PASS is signed by the builder ($reviewer): a fresh reviewer must look at the real output and sign its own line"; return 1; }
  pass_line Ship-ready <<<"$body" | covers_engineering \
    || { echo "PR #$1's Ship-ready PASS ($reviewer) does not cover how it is built: that same reviewer checks every automatic fail in ~/.claude/skills/ship-ready/engineering.md on the diff and ends the line with  ; Engineering: PASS"; return 1; }
  msg="$(fresh_pass Ship-ready "$1" "$3" "$2")"; case $? in 0) return 0 ;; 75) echo "$msg"; return 75 ;; *) echo "$msg"; return 1 ;; esac
}
# FAST PRs item 4 (her ruling 23 Nov 2026): no click-through when the reviewer already rendered the screens. A
# changed screen people operate is satisfied by a "Clicked through:" line, or by `rendered:` ON the Ship-ready PASS
# line itself, and only when that PASS is a fresh reviewer's for this head (ship_pass). `rendered:` anywhere else
# (a builder's comment, a line of its own) proves nothing.
clicked_or_rendered() { # $1 PR  $2 PR view JSON  $3 head -> rc 0 with the line that satisfied it | 1 none | 75 unread
  local line rc
  line="$(jq -r '([.body // ""] + [.comments[]?.body // ""]) | .[]' <<<"$2" | grep -iE '^[[:space:]>*-]*Clicked through:' | grep -vE '<[A-Za-z][^<>]*>' | tail -1)"
  [ -n "$line" ] && { printf 'clicked through: %s\n' "$(cut -c1-140 <<<"$line")"; return 0; }
  line="$(review_text <<<"$2" | pass_line Ship-ready)" || return 1
