  slugp="$(printf '%s' "$key" | sed -E 's#^[^/]+/##; s/#/ #/')"   # "boss-os #557"
  shortout="$(printf '%s' "$outc" | one_line | cut -c1-90)"
  take "outcome-$key" || { say "outcome: $key is being checked by another run"; continue; }
  tried="$LOCKS/tried-$(printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_')-$TODAY"
  oruns=$((oruns + 1))
  if [ -e "$tried" ]; then   # replay: tonight's run already said NOT CHECKED, with its comment and Notices line
    ounproved=$((ounproved + 1)); say "outcome: $key already tried today and still NOT CHECKED; no second comment"; continue
  fi
  say "outcome: $key ($outc; check: $cmd; expect $expect; by $by)"
  verdict=""; seen=""; url=""; outf="$(mktemp)"
  if [ "$expect" = infer ]; then n=""
  elif ! why="$(readonly_gate "$cmd")"; then   # never run: it could change something (F1). Code's own verdict.
    printf '=== outcome check %s: NOT RUN, not read-only: %s (%s)\n' "$key" "$cmd" "$why" >> "$LOG"
    if [ -n "$DRY" ]; then say "[dry-run] the check would not be run: $why"; rm -f "$outf"; continue; fi
    verdict=COULDNT; seen="the check was not run, because it could change something instead of only reading"
    url="$(post_comment "$key" "Outcome check (live): COULDNT-CHECK — $seen
Refused by post-land-check's read-only gate: $(printf '%s' "$why" | mask)
Outcome: $(printf '%s' "$outc" | mask)
Check: \`$(printf '%s' "$cmd" | mask)\` (expect ${expect}), on $TODAY; decided by code, never run, no model.")" || url="(comment not posted)"
  else
    run_check "$cmd" > "$outf"; crc=$?
    printf '=== outcome check %s: %s (exit %s)\n' "$key" "$cmd" "$crc" >> "$LOG"; head -200 "$outf" >> "$LOG"   # raw output: the local log only
    n="$(count_of < "$outf")"; lines_out="$(grep -c . "$outf")"
    if [ -n "$DRY" ]; then say "[dry-run] the check printed $n (exit $crc)"; rm -f "$outf"; continue; fi
    # A count that exits 1 is still a reading (N1): `grep -c` prints 0 and exits 1 when nothing matches, which is
    # the Noelle case (0 done) and must be NOT WORKING, not NOT CHECKED. Only exit 1 with exactly one bare integer line.
    reading=""; [ "$crc" -eq 1 ] && [ "$lines_out" -eq 1 ] && grep -qE '^[[:space:]]*[0-9]+[[:space:]]*$' "$outf" && reading=1
    if { [ "$crc" -ne 0 ] && [ -z "$reading" ]; } || [ "$lines_out" -eq 0 ]; then   # failed or silent: unknown. A printed 0 is a reading (below).
      verdict=COULDNT; seen="the check failed to run"   # plain words: her Notices line carries no exit codes (N6)
      [ "$crc" -eq 124 ] && seen="the check took longer than 5 minutes and was stopped"
      [ "$crc" -eq 126 ] && seen="the check could not be run safely on this Mac"
      [ "$crc" -eq 0 ] && seen="the check printed nothing"
    elif [ "$n" -lt "${expect#>=}" ]; then
      verdict=FAIL; seen="saw $n, needed at least ${expect#>=}"
    fi
    if [ -n "$verdict" ]; then   # code's own verdict: no model run, no PASS possible
      url="$(post_comment "$key" "Outcome check (live): $([ "$verdict" = COULDNT ] && echo COULDNT-CHECK || echo FAIL) — $seen
Outcome: $(printf '%s' "$outc" | mask)
Check: \`$(printf '%s' "$cmd" | mask)\` (expect ${expect}), run by post-land-check on $TODAY; decided by code, no model.")" || url="(comment not posted)"
    fi
  fi
  if [ -z "$verdict" ]; then
    start="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    run_ai "outcome $key" "$(outcome_prompt "$key" "$sha" "$outc" "$cmd" "$expect" "${n:-?}" "$outf" "$task")"; arc=$?
    if v="$(outcome_comment "$key" "$start")"; then
      IFS=$'\t' read -r verdict url seen ranline <<<"$v"
      if [ "$expect" = infer ] && [ -z "$ranline" ]; then verdict=COULDNT; seen="the checker did not say what it ran, so nothing it saw is proven"; fi
    else
      printf '=== outcome check %s: no verdict comment (ai-run exit %s)\n' "$key" "$arc" >> "$LOG"
      verdict=COULDNT; seen="the checker gave no verdict (it was down, out of its usage limit, or posted nothing)"; url="(no comment)"
    fi
  fi
  rm -f "$outf"
  seen="$(printf '%s' "$seen" | mask | one_line)"
  case "$verdict" in
    PASS)
      outcome_mark "$key" DONE "$url"; say "  PASS $key $url — $seen"
      sheet_set "$task" "$key" "STATUS: DONE $key $sha $TODAY — outcome checked live: $seen ($url)" 1
      notice "outcome:$key:working" "$slugp $shortout: working — $seen" || ounproved=$((ounproved + 1)) ;;
    FAIL)
      outcome_mark "$key" FAIL "$url"; ofails=$((ofails + 1)); say "  FAIL $key $url — $seen"
      sheet_set "$task" "$key" "STATUS: FAIL $key $sha $TODAY — outcome NOT WORKING: $seen ($url)"
      notify "NOT WORKING: $slugp $shortout — $seen"
      notice "outcome:$key:not-working" "$slugp $shortout: NOT WORKING — $seen" || ounproved=$((ounproved + 1)) ;;
    *)
      ounproved=$((ounproved + 1)); : > "$tried"
      say "  COULDNT-CHECK $key — $seen; the line stays DUE"
      [ "$late" -ge 2 ] && notify "NOT CHECKED for $late days: $slugp $shortout — $seen"
      notice "outcome:$key:not-checked:$TODAY" "$slugp $shortout: NOT CHECKED — $seen" || true ;;
  esac
done <<<"$OUTL"
ran=$((ran + oruns)); fails=$((fails + ofails)); unproved=$((unproved + ounproved))

[ "$ran" -gt 0 ] || { say "nothing due${NOW_KEY:+ for $NOW_KEY}"; exit 0; }
[ "$fails" -eq 0 ] || notify "Post-land check: $fails FAIL(s); each is marked FAIL in HANDOFF.md with its PR comment"
if [ "$unproved" -gt 0 ]; then notify "Post-land check: $unproved line(s) got no verdict and stay DUE"; exit 1; fi
exit 0
