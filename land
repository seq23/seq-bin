  # 26 Sep 2026: staging on every land. 2 Oct 2026: the `e2e` workflow (jobs e2e, e2e-open,
  # help-screenshots) is dispatch-only — a small change ships on the fast check, a large one on a
  # green run of it.
  sheila-creator-dashboard) DEPLOY="npm run deploy:production" ; SELF="" ; STAGING="npm run deploy:staging" ; E2E_WF="e2e" ; SMOKE="https://sheilastudio.seq-taylor.workers.dev/healthz" ;;
  # Mercedes Studio (seq23/mercedes-creator-dashboard): a full-history copy of Sheila's dashboard for
  # Mercedes Asare, same shape (check.yml gate, staging on every land, promote.yml on a green nightly
  # e2e). Worker `mercedesstudio` at https://dashboard.justbeingmercedes.com. Added 26 Sep 2026.
  mercedes-creator-dashboard) DEPLOY="npm run deploy:production" ; SELF="" ; STAGING="npm run deploy:staging" ; E2E_WF="e2e" ; SMOKE="https://dashboard.justbeingmercedes.com/healthz" ;;
  # ~/bin (seq23/seq-bin): launchd runs the WORKING COPY, so fast-forwarding it IS the deploy
  # (step 5 does it without touching any file she has changed, or stops and says why).
  # Added 21 Sep 2026 with seq-bin #4.
  bin|seq-bin)          DEPLOY="" ; SELF="is the launchd working copy, fast-forwarded to origin/main in step 5" ;;
  # West Peek web properties on Cloudflare Pages Git integration: the project builds `main` on push
  # (check-run "Cloudflare Pages" on the merge commit), so the merge IS the deploy. Read from each
