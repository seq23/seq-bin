#!/bin/bash
# gh — THE SHARED GITHUB ALLOWANCE (owner, 22 Nov 2026: "landing shit takes fucking forever").
#
# WHY THIS EXISTS. On 22 Nov 2026 every agent on this Mac polled GitHub on its own: `gh pr checks --watch`
# (every 10 s by default), `gh run watch` (every 3 s), `until gh run view …; do sleep 20` loops, and `land`
# itself. Together they spent the account's 5,000 REST calls an hour before 13:37Z and again from 13:35Z,
# so nothing on the Mac could read CI state, and `land` could not tell green from red for an hour.
#
# This file sits first on PATH (~/bin) and stands in front of the real gh, so EVERY caller (agents, land,
# land-after, ci-sweep, scripts) shares one allowance without changing a line of theirs:
#   1. ONE SHARED CACHE, NEVER STALE, MOSTLY FREE. A read (gh api GET, run view/list, pr view/list/checks,
#      issue/workflow/repo/release view/list) with the same words, in the same repo, inside GH_SHARE_TTL
#      seconds (5) is answered from ~/.cache/gh-share, so ten agents watching one run cost one call. The
#      key is the question: the checkout's branch and HEAD join it only when the read names no target (a
#      bare `gh pr view`, `pr status`, `{branch}`), so `run view 123 -R o/r` is one answer for every
#      worktree. After the TTL an api GET is asked again WITH ITS ETag (If-None-Match): GitHub answers 304
#      "unchanged" without charging the allowance (measured 22 Nov 2026), and the kept body is served; a
#      changed answer is a normal 200. A write bumps a generation: every answer older than it counts as
#      expired (its ETag is kept, so the re-ask is still free), and a read in flight across a write is
#      returned to its caller but not kept. Only a successful answer is kept; a failed fetch returns the
#      failure, never the old answer ("green" is never served stale).
#   2. WATCHERS POLL THROUGH HERE. `gh run watch` and `gh pr checks --watch` never reach the real gh: each
#      becomes a loop of ordinary reads of this file (`api repos/<o>/<r>/actions/runs/<id>`, one request
#      and free while unchanged; `pr checks`), so every poll is shared, logged, held at the floor and
#      charged to its caller, no faster than every GH_SHARE_WATCH_SECS (30) seconds (a shorter --interval
#      is raised to it). Exit codes are gh's: `pr checks` 0 passed / 1 failed (--fail-fast stops at the
#      first fail), `run watch --exit-status` 1 on a failed run.
#   3. LOW ALLOWANCE WAITS, IT DOES NOT FAIL. Before a read reaches GitHub, the allowance left (from
#      GitHub's free rate_limit endpoint, re-read every 30 s and shared) is checked; at or under
#      GH_SHARE_FLOOR (300) the read waits for the reset in ONE bounded sleep, then runs. The floor is
#      kept for writes: a merge, a cancel, a deploy dispatch or a PR comment is never held (landing first).
#      The budget checked is the one the read spends: REST ("core") for api/run/workflow, GraphQL for
#      pr/issue/repo/release (GitHub counts them apart; either can run out alone).
#      A reset further away than GH_SHARE_MAX_WAIT (3700 s), or past GH_SHARE_UNTIL (the caller's own
#      deadline, an epoch: land and land-after set it), is not slept: exit 75 at once with "rate limit: …"
#      on stderr, so the caller's own rate-limit handling (and its one deadline) decides. One owner of waiting.
#   4. NO POLLER TAKES MORE THAN ITS SHARE. Each caller (its process group: one agent's Bash call, one
#      land run) may spend GH_SHARE_PER_CALLER (500, a tenth of the hour) REST requests in any hour,
#      priced by rest_cost (run view/list = 2: one gh call is not one request); over that it waits until
#      its oldest call in the window is an hour old. Cache hits and 304s are free. The share file is
#      append only (one "epoch cost" line per charged call, so parallel siblings never lose a line); the
#      hourly sweep deletes a caller's file an hour after its last call.
# Every call is logged (the last 48 h are kept), one line, to ~/.cache/gh-share/calls.log (epoch, caller, kind, subcommand), so
# calls per hour are measured, not guessed:
#   awk -v c="$(( $(date +%s) - 3600 ))" '$1 > c {n[$3]++} END {for (k in n) print k, n[k]}' ~/.cache/gh-share/calls.log
# (miss, write, watch and graphql reached GitHub; 304 asked GitHub and was free; hit was answered here;
# wait/share/stop are holds).
#
# AN UNREADABLE ALLOWANCE IS A STOP, never a blind call: when rate_limit fails twice, a read exits 75 with
# "rate limit: NAMED STOP [GH_ALLOWANCE_UNKNOWN]" and is not sent (writes are never held).
# FAIL TOWARD WORKING. Anything this wrapper cannot do (no cache dir, no real gh found twice, a TTY
# caller) passes the command straight to the real gh unchanged. A terminal on stdout is never cached
# (her own Terminal gets gh exactly as it is).
#
# Settings (env): GH_SHARE_REAL (the real gh), GH_SHARE_DIR, GH_SHARE_TTL, GH_SHARE_WATCH_SECS,
# GH_SHARE_FLOOR, GH_SHARE_MAX_WAIT, GH_SHARE_PER_CALLER, GH_SHARE_UNTIL, GH_SHARE_SWEEP_EVERY, GH_SHARE_OFF=1 (plain pass-through).
set -u

real_gh() {
  if [ -n "${GH_SHARE_REAL:-}" ]; then printf '%s' "$GH_SHARE_REAL"; return; fi
  local self dir
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  local IFS=:
  for dir in $PATH; do
    [ -n "$dir" ] || continue
    [ "$(cd "$dir" 2>/dev/null && pwd -P)" = "$self" ] && continue
    [ -x "$dir/gh" ] && [ ! -d "$dir/gh" ] && { printf '%s' "$dir/gh"; return; }
  done
}
REAL="$(real_gh)"
[ -n "$REAL" ] || { echo "gh: the real gh is not on PATH (only ~/bin/gh, the shared-allowance wrapper)" >&2; exit 127; }
[ "${GH_SHARE_OFF:-}" = 1 ] && exec "$REAL" "$@"

DIR="${GH_SHARE_DIR:-$HOME/.cache/gh-share}"
mkdir -p "$DIR/resp" "$DIR/callers" "$DIR/tmp" 2>/dev/null && [ -w "$DIR" ] || exec "$REAL" "$@"
TTL="${GH_SHARE_TTL:-5}"
WATCH_SECS="${GH_SHARE_WATCH_SECS:-30}"
FLOOR="${GH_SHARE_FLOOR:-300}"
MAX_WAIT="${GH_SHARE_MAX_WAIT:-3700}"
PER_CALLER="${GH_SHARE_PER_CALLER:-500}"
NOW="$(date +%s)"
CALLER="$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')"; [ -n "$CALLER" ] || CALLER=$$

mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }
log() { printf '%s %s %s %s\n' "$(date +%s)" "$CALLER" "$1" "${2:-}" >> "$DIR/calls.log" 2>/dev/null || true; }

# --- classify: read (cacheable) | watch | graphql | write ---------------------------------------------
classify() { # args -> one word
  local sub="${1:-}" verb="${2:-}" a method="" body=0
  case "$sub" in
    api)
      [ "$verb" = graphql ] && { echo graphql; return; }
      shift
      while [ $# -gt 0 ]; do
        a="$1"
        case "$a" in
          -X|--method) method="${2:-}"; shift ;;
          -X*) method="${a#-X}" ;;
          --method=*) method="${a#--method=}" ;;
          -f|-F|--field|--raw-field|--input) body=1; shift ;;
          -f*|-F*|--field=*|--raw-field=*|--input=*) body=1 ;;
          rate_limit|/rate_limit) echo free; return ;;
        esac
        shift
      done
      method="$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')"
      if [ "$method" = GET ] || { [ -z "$method" ] && [ "$body" = 0 ]; }; then echo read; else echo write; fi ;;
    run)
      case "$verb" in view|list) has_flag --web "$@" && echo write || echo read ;; watch) echo watch ;; *) echo write ;; esac ;;
    pr)
      case "$verb" in
        checks) if has_flag --watch "$@"; then echo watch; else echo read; fi ;;
        view|list|diff) has_flag --web "$@" && echo write || echo read ;;
        *) echo write ;;
      esac ;;
    issue|workflow|repo|release)
      case "$verb" in view|list) has_flag --web "$@" && echo write || echo read ;; *) echo write ;; esac ;;
    *) echo write ;;
  esac
}
has_flag() { local f="$1" a; shift; for a in "$@"; do [ "$a" = "$f" ] && return 0; done; return 1; }

# --- the allowance ------------------------------------------------------------------------------------
# rate file: "<remaining> <reset epoch> <read at epoch>", from the rate_limit endpoint (costs nothing).
# rate file: "<core remaining> <core reset> <graphql remaining> <graphql reset> <read at epoch>".
budget_of() { case "${1:-}" in pr|issue|repo|release) echo graphql ;; *) echo core ;; esac; }
allowance() { # $1 core|graphql -> "<remaining> <reset>"
  local f="$DIR/rate" cr cs gr gs at line
  line="$(cat "$f" 2>/dev/null)"
  read -r cr cs gr gs at <<<"$line"
  if [ -z "${at:-}" ] || [ $(( NOW - at )) -ge 30 ]; then
    line="$("$REAL" api rate_limit --jq '"\(.resources.core.remaining) \(.resources.core.reset) \(.resources.graphql.remaining) \(.resources.graphql.reset)"' 2>/dev/null)"
    read -r cr cs gr gs <<<"$line"
    if [[ "${cr:-}" =~ ^[0-9]+$ && "${cs:-}" =~ ^[0-9]+$ && "${gr:-}" =~ ^[0-9]+$ && "${gs:-}" =~ ^[0-9]+$ ]]; then
      printf '%s %s %s %s %s\n' "$cr" "$cs" "$gr" "$gs" "$NOW" > "$f.$$" && mv -f "$f.$$" "$f"
    else
      echo "unknown 0"; return   # unreadable: the read is refused (wait_for_reset), never sent uncounted
    fi
  fi
  if [ "${1:-core}" = graphql ]; then echo "$gr $gs"; else echo "$cr $cs"; fi
}
# A sleep that would end past the caller's deadline (GH_SHARE_UNTIL) or past MAX_WAIT is not slept:
# exit 75 with "rate limit:" so land/land-after (which match that) handle it under their one deadline.
too_long() { # $1 seconds $2 what -> exits 75 if the wait may not be slept
  local until="${GH_SHARE_UNTIL:-}" why=""
  [ "$1" -gt "$MAX_WAIT" ] && why="over the ${MAX_WAIT}s wait"
  [[ "$until" =~ ^[0-9]+$ ]] && [ $(( NOW + $1 )) -gt "$until" ] && why="past the caller's deadline, $(date -r "$until" +%H:%M 2>/dev/null || date -d "@$until" +%H:%M)"
  [ -n "$why" ] || return 0
  echo "rate limit: NAMED STOP [GH_ALLOWANCE_SPENT] $2 would wait ${1}s ($why); run again later" >&2
  log stop "$2"; exit 75
}
wait_for_reset() { # holds a read while the allowance is at or under the floor (one bounded sleep)
  local rem reset secs budget
  budget="$(budget_of "${1:-}")"
  read -r rem reset <<<"$(allowance "$budget")"
  if ! [[ "$rem" =~ ^[0-9]+$ ]]; then
    # OUTAGE: the allowance could not be read (rate_limit failed twice). The read is not sent blind: it
    # comes back as "rate limit:" with exit 75, so the caller's own rate-limit handling decides. Writes
    # never come here (the floor is theirs).
    sleep 2; rm -f "$DIR/rate"; NOW="$(date +%s)"
    read -r rem reset <<<"$(allowance "$budget")"
    if ! [[ "$rem" =~ ^[0-9]+$ ]]; then
      echo "rate limit: NAMED STOP [GH_ALLOWANCE_UNKNOWN] GitHub's $budget allowance could not be read (rate_limit failed twice); this read was not sent" >&2
      log unknown "$budget"; exit 75
    fi
  fi
  [ "$rem" -gt "$FLOOR" ] && return 0
  secs=$(( reset - NOW + 5 )); [ "$secs" -ge 1 ] || secs=1
  too_long "$secs" "GitHub's $budget allowance is down to $rem and resets at $(date -r "$reset" +%H:%M 2>/dev/null || date -d "@$reset" +%H:%M); this read"
  echo "gh-share: GitHub $budget allowance is down to $rem (floor $FLOOR, kept for merges and deploys); this read waits ${secs}s for the $(date -r "$reset" +%H:%M 2>/dev/null || date -d "@$reset" +%H:%M) reset" >&2
  log wait "$secs"
  sleep "$secs"
  rm -f "$DIR/rate"; NOW="$(date +%s)"
}
# What one real call costs GitHub's REST core allowance, in requests: THE ONE TABLE. Measured with
# GH_DEBUG=api on gh 2.86 (22 Nov 2026): run view and run list send 2 requests each (the run, then its
# attempt/jobs or the workflow), --log/--log-failed 3, workflow view/list 2, gh api GET 1, pr diff 1.
# pr/issue/repo/release reads are GraphQL (0 REST) and cost 1 here so a GraphQL poller is still bounded.
rest_cost() {
  case "${1:-} ${2:-}" in
    "run view") if has_flag --log "$@" || has_flag --log-failed "$@"; then echo 3; else echo 2; fi ;;
    "run list"|"workflow view"|"workflow list") echo 2 ;;
    *) echo 1 ;;
  esac
}
# APPEND ONLY (22 Nov 2026 hostile review F5): the share file was rewritten (awk + mv) on every call
# while sibling calls in the same process group appended to it, so lines were lost and the share was
# undercounted. Now a call only appends one line; lines over an hour old are skipped when counting, and a
# file nobody has appended to for an hour is deleted in the sweep. Nothing ever rewrites it.
share_check() { # $1 cost: holds (bounded) while this caller's last hour plus this call would pass its share
  local f="$DIR/callers/$CALLER" n oldest secs
  read -r n oldest <<<"$(awk -v c=$(( NOW - 3600 )) '$1 > c {n += ($2 == "" ? 1 : $2); if (o == "") o = $1} END {print n + 0, o + 0}' "$f" 2>/dev/null)"
  if [ $(( ${n:-0} + $1 )) -gt "$PER_CALLER" ]; then
    secs=$(( ${oldest:-0} + 3600 - NOW + 1 )); [ "$secs" -ge 1 ] || secs=1
    too_long "$secs" "this caller has spent $n GitHub requests this hour (its share is $PER_CALLER); its next read"
    echo "gh-share: this caller has spent $n GitHub requests this hour (its share is $PER_CALLER); waiting ${secs}s — poll less often or wait in one bounded call" >&2
    log share "$secs"
    sleep "$secs"; NOW="$(date +%s)"
  fi
}
share_charge() { echo "$NOW $1" >> "$DIR/callers/$CALLER"; }   # $1 cost; one small append (atomic)

# the generation: any write moves it (a unique token, so two writes at once still both move it)
gen() { cat "$DIR/gen" 2>/dev/null; }
bump() { printf '%s.%s.%s\n' "$(date +%s)" "$$" "$RANDOM" > "$DIR/gen.$$" && mv -f "$DIR/gen.$$" "$DIR/gen"; }

# --- watchers: a loop of reads through this file -------------------------------------------------------
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
watch_loop() { # gh run watch <id> [...] | gh pr checks [<pr>] --watch [...]
  local sub="$1" iv="$WATCH_SECS" fail_fast=0 exit_status=0 rest=() out rc v tty=0
  shift 2
  [ -t 1 ] && tty=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --watch|--compact) ;;
      -i|--interval) v="${2:-}"; [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -gt "$iv" ] && iv="$v"; shift ;;
      --interval=*) v="${1#--interval=}"; [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -gt "$iv" ] && iv="$v" ;;
      --fail-fast) fail_fast=1 ;;
      --exit-status) exit_status=1 ;;
      *) rest+=("$1") ;;
    esac
    shift
  done
  local run_id="" run_repo="{owner}/{repo}" i
  for ((i = 0; i < ${#rest[@]}; i++)); do
    case "${rest[$i]}" in
      -R|--repo) run_repo="${rest[$((i + 1))]:-}"; run_repo="${run_repo#https://github.com/}"; i=$((i + 1)) ;;
      --repo=*) run_repo="${rest[$i]#--repo=}" ;;
      [0-9]*) run_id="${rest[$i]}" ;;
    esac
  done
  if [ "$sub" = run ] && [ -z "$run_id" ]; then   # no run named: gh's own picker in a terminal, else gh's own error
    [ -t 0 ] && [ -t 1 ] && exec "$REAL" run watch "${rest[@]}"
    echo "run ID required when not running interactively" >&2; exit 1
  fi
  log watch "$sub $iv"
  while :; do
    if [ "$sub" = run ]; then
      # one api GET of the run (1 REST request, 0 on a 304), not `run view --json` (2)
      out="$("$SELF" api "repos/$run_repo/actions/runs/$run_id" --jq '.status+" "+(.conclusion // "")')"; rc=$?
      [ "$rc" -eq 0 ] || exit "$rc"
      case "$out" in
        completed*)
          if [ "$exit_status" = 1 ]; then "$SELF" run view "${rest[@]}" --exit-status; else "$SELF" run view "${rest[@]}"; fi
          exit $? ;;
      esac
      [ "$tty" = 1 ] && echo "$(date +%H:%M:%S) run ${rest[*]}: $out (next look in ${iv}s)"
    else
      out="$("$SELF" pr checks "${rest[@]}")"; rc=$?
      if [ "$rc" -ne 8 ]; then printf '%s\n' "$out"; exit "$rc"; fi
      if [ "$fail_fast" = 1 ] && grep -q "$(printf '\tfail\t')" <<<"$out"; then printf '%s\n' "$out"; exit 1; fi
      [ "$tty" = 1 ] && printf '%s\n%s checks pending (next look in %ss)\n' "$out" "$(date +%H:%M:%S)" "$iv"
    fi
    sleep "$iv"; NOW="$(date +%s)"
  done
}

KIND="$(classify "$@")"

case "$KIND" in
  free)
    log free "${1:-} ${2:-}"
    exec "$REAL" "$@" ;;
  graphql)
    # never cached (a query may be a mutation), but held at the GraphQL floor like any pr read
    [ -t 1 ] || wait_for_reset pr
    log graphql "${1:-} ${2:-}"
    exec "$REAL" "$@" ;;
  write)
    # A write changes what the reads would say (a merge makes the PR MERGED, a dispatch adds a run), so the
    # generation moves before it and again after it: every answer kept before the second move is stale (a
    # read that ran during the write is not kept either), and land's own "did it merge?" read after the
    # merge always reaches GitHub. The answers stay on disk with their ETags, so an api read after a write
    # revalidates (a 304 is free) instead of paying again. (mtimes are whole seconds, so an answer kept in the
    # same second as the move counts as before it: one extra read, never a stale one.)
    log write "${1:-} ${2:-}"
    bump; "$REAL" "$@"; rc=$?; bump
    exit "$rc" ;;
  watch)
    # A watcher polls THROUGH this wrapper (22 Nov 2026: an exec'd `gh run watch` / `pr checks --watch`
    # polled GitHub on its own, uncounted, unshared and never held at the floor). Each poll is an ordinary
    # read of this file: shared with every other caller, one line in calls.log, held at the floor, and
    # charged to this caller's share. No real gh is ever left polling by itself.
    watch_loop "$@" ;;
esac

# --- a read ----------------------------------------------------------------------------------------------
[ -t 1 ] && { wait_for_reset "$@"; log read-tty "${1:-} ${2:-}"; exec "$REAL" "$@"; }
# THE KEY NAMES THE QUESTION, NOT THE ASKER (22 Nov 2026 hostile review F3: branch and HEAD were in every
# key, so lands in different worktrees never shared `run view 123` and 9% of reads were hits). The
# checkout's branch and commit count only when the answer depends on them: a pr read that names no PR
# ("this branch's PR"; a push changes it) or a {branch} placeholder. The checkout's repo counts unless -R
# names one (`gh api repos/{owner}/{repo}/…` and a bare `gh run list` mean this checkout's repo).
needs_branch() {
  local a skip=0
  case " $* " in *"{branch}"*) return 0 ;; esac
  [ "${1:-}" = pr ] || return 1
  case "${2:-}" in status) return 0 ;; view|checks|diff) ;; *) return 1 ;; esac
  shift 2
  for a in "$@"; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    case "$a" in
      -R|--repo|--json|-q|--jq|-t|--template|--color|-i|--interval) skip=1 ;;
      -*) ;;
      *) return 1 ;;   # a PR number, URL or branch: an explicit target
    esac
  done
  return 0
}
repo_hint=""
has_flag -R "$@" || has_flag --repo "$@" || repo_hint="$(git config --get remote.origin.url 2>/dev/null)"
branch=""
needs_branch "$@" && branch="$(git symbolic-ref -q HEAD 2>/dev/null) $(git rev-parse -q HEAD 2>/dev/null)"
key="$(printf '%s\0' "$@" "${GH_REPO:-}" "${GH_HOST:-}" "$repo_hint" "$branch" | shasum -a 256 2>/dev/null | cut -c1-40)"
[ -n "$key" ] || exec "$REAL" "$@"
cache="$DIR/resp/$key"
# Fresh = younger than the TTL AND kept after the last write (a write moves the generation file; it no
# longer deletes answers, so their ETags survive it and the next read revalidates for free).
if [ -f "$cache" ] && [ $(( NOW - $(mtime "$cache") )) -lt "$TTL" ] && [ "$(mtime "$cache")" -gt "$(mtime "$DIR/gen")" ]; then
  log hit "${1:-} ${2:-}"
  # the first line is the exit code the answer came with; the rest is its stdout, byte for byte
  { IFS= read -r crc; cat; } < "$cache"; exit "${crc:-0}"
fi
# A 304 IS FREE (22 Nov 2026 hostile review F2, measured live: a GET with If-None-Match came back HTTP 304
# and core did not move). Every `gh api` GET keeps its ETag beside its answer; once the answer is past
# its TTL (or a write), it is asked again WITH that ETag, and a 304 refreshes it and serves it: never
# stale (GitHub just said nothing changed) and charged to nobody. A changed answer is a normal 200.
etag_ok=0
if [ "${1:-}" = api ] && ! has_flag -i "$@" && ! has_flag --include "$@" && ! has_flag --paginate "$@" && ! has_flag --silent "$@" && ! has_flag --verbose "$@"; then
  case "$*" in *[Ii][Ff]-[Nn][Oo][Nn][Ee]-[Mm][Aa][Tt][Cc][Hh]*) ;; *) etag_ok=1 ;; esac
fi
wait_for_reset "$@"
cost="$(rest_cost "$@")"
share_check "$cost"
g0="$(gen)"
tmp="$DIR/tmp/$key.$$"   # outside resp/: nothing clearing resp/ may take an answer in flight
cond=""
# the old answer is copied first: a 304 is served from that copy, so a body swept away meanwhile can
# never become an empty answer (no copy -> no ETag sent -> a full fetch)
[ "$etag_ok" = 1 ] && [ -s "$cache.etag" ] && cp "$cache" "$tmp.old" 2>/dev/null && cond="$(cat "$cache.etag")"
if [ "$etag_ok" = 1 ]; then
  if [ -n "$cond" ]; then "$REAL" "$@" -i -H "If-None-Match: $cond" > "$tmp.raw" 2> "$tmp.err"; rc=$?
  else "$REAL" "$@" -i > "$tmp.raw" 2> "$tmp.err"; rc=$?; fi
  code="$(head -1 "$tmp.raw" 2>/dev/null | awk '$1 ~ /^HTTP\// {print $2}')"
  if [ -n "$cond" ] && [ "$code" = 304 ]; then
    log 304 "${1:-} ${2:-}"
    if [ "$(gen)" = "$g0" ]; then cp "$tmp.old" "$tmp.k" && mv -f "$tmp.k" "$cache"; fi
    { IFS= read -r crc; cat; } < "$tmp.old"; rm -f "$tmp.old" "$tmp.raw" "$tmp.err"; exit "${crc:-0}"
  fi
  share_charge "$cost"; log miss "${1:-} ${2:-}"
  CR="$(printf '\r')"
  if [[ "$code" =~ ^[0-9]{3}$ ]]; then
    sed "1,/^${CR}*\$/d" "$tmp.raw" > "$tmp"
    etag="$(sed -n "1,/^${CR}*\$/p" "$tmp.raw" | grep -i '^etag:' | head -1 | cut -d' ' -f2- | tr -d '\r')"
  else
    mv -f "$tmp.raw" "$tmp"; etag=""; [ "$rc" -eq 0 ] && rc=1   # no status line: not an answer to keep
  fi
  cat "$tmp.err" >&2; rm -f "$tmp.raw" "$tmp.err" "$tmp.old"
else
  share_charge "$cost"; log miss "${1:-} ${2:-}"
  "$REAL" "$@" > "$tmp"; rc=$?; etag=""
fi
# A real answer is kept: 0, and 8 from `gh pr checks` (checks still pending). Anything else (an error, a
# failed check list, GitHub down) is never kept; an expired answer is never served without a 304.
if { [ "$rc" -eq 0 ] || { [ "$rc" -eq 8 ] && [ "${1:-}" = pr ]; }; } && [ "$(gen)" = "$g0" ]; then
  cat "$tmp"; { echo "$rc"; cat "$tmp"; } > "$tmp.k" && mv -f "$tmp.k" "$cache"
  if [ -n "$etag" ]; then printf '%s\n' "$etag" > "$tmp.e" && mv -f "$tmp.e" "$cache.etag"; else rm -f "$cache.etag"; fi
  rm -f "$tmp"
else
  cat "$tmp"; rm -f "$tmp"
  [ "$rc" -eq 0 ] || rm -f "$cache" "$cache.etag"   # a failed fetch leaves nothing to revalidate
fi
# now and then (a cheap sweep, about one call in fifty): answers unused for an hour go, callers silent for
# an hour go, and calls.log keeps its last 48 h (about 10k calls an hour would otherwise grow it by 240k
# lines a day)
if [ $(( NOW % ${GH_SHARE_SWEEP_EVERY:-50} )) -eq 0 ]; then
  find "$DIR/resp" "$DIR/callers" "$DIR/tmp" -type f -mmin +60 -delete 2>/dev/null
  awk -v c=$(( NOW - 172800 )) '$1 > c' "$DIR/calls.log" > "$DIR/calls.log.$$" 2>/dev/null && mv -f "$DIR/calls.log.$$" "$DIR/calls.log"
fi
exit "$rc"
