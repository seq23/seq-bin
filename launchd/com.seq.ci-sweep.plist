<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.seq.ci-sweep</string>
  <!-- Monday and Friday, 08:00 local (CT). 2 Oct 2026, owner: Mon+Fri 08:00,
       first run Mon 5 Oct — replaces the daily cadence (her design 23 Sep
       2026 at 06:00, moved to 07:00 on 24 Sep 2026). Each run day: one
       progress-driven run with a 3h30 budget (done ~11:30) that parks what
       only she can clear, fixes and merges the rest, and sends one morning
       summary. If it does not end MAIN-GREEN, com.seq.ci-sweep-retry.plist
       tries it exactly once more at 09:00 the same day; a second non-green
       ending waits for the next Mon/Fri 08:00 run, briefed with what both
       tries did. If the Mac is asleep at 08:00, launchd fires the missed run
       once at wake. Two calendar entries, one per weekday (launchd Weekday:
       1 = Monday, 5 = Friday).
       Versioned in seq23/seq-bin (launchd/com.seq.ci-sweep.plist); install with
       the steps in README.md. ci-sweep-selftest.sh asserts this schedule. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>/Users/sequoiataylor/bin/ci-sweep.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>
  <key>StandardOutPath</key><string>/Users/sequoiataylor/Library/Logs/ci-sweep/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/sequoiataylor/Library/Logs/ci-sweep/launchd.err</string>
  <key>RunAtLoad</key><false/>
</dict></plist>
