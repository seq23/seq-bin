  fi
  PENDING="$(jq -r '.[] | select(.bucket == "pending") | .name' <<<"$CHECKS")"
  [ -n "$PENDING" ] || break
  jq -e 'any(.[]; .bucket == "fail" or .bucket == "cancel")' <<<"$CHECKS" >/dev/null && break
  [ "$(date +%s)" -lt "$PENDING_UNTIL" ] \
    || die "NAMED STOP [CHECKS_PENDING] PR #$PR still has checks pending after $(( ${LAND_PENDING_WAIT:-1800} / 60 )) min ($(paste -sd',' - <<<"$PENDING")): GitHub has no free runner or the run hung. Nothing was merged; land $PR again once they finish."
  echo "     waiting for $(grep -c . <<<"$PENDING") pending check(s): $(head -3 <<<"$PENDING" | paste -sd',' -)"
  sleep "${LAND_PENDING_POLL:-30}"
done
jq -r '.[] | "\(.name)\t\(.bucket)\t\(.link)"' <<<"$CHECKS"
[ "$(jq 'length' <<<"$CHECKS")" -gt 0 ] || no_checks_stop
# EVERY BUCKET, NOT THE EXIT CODE. 21 Sep 2026, boss-os #35: the Playwright job had been CANCELLED
# at its 30-minute cap, `gh pr checks` printed it as "fail" and still exited 0, and this script
# merged a PR whose merge state read UNSTABLE. A cancelled, skipped-by-failure or failing check is
# not green whatever the exit code says; only `pass` (and a genuinely `skipping` job) is.
# Row 18's shared baseline (renders the real output, fails on the automatic fails): its own sentence.
BASELINE_RED="$(baseline_red "$CHECKS")" && die "PR #$PR's ship-ready-baseline check is not green ($BASELINE_RED): fix what its job summary lists, push, and land again."
NOTGREEN="$(not_green "$CHECKS")"
if [ -n "$NOTGREEN" ]; then
  # failed tests first (they say what broke), then the checks that never ran; the look is the first failed check's own run
  LOOK="$(jq -r '[.[] | select(.bucket != "pass" and .bucket != "skipping")] | sort_by(if .bucket == "fail" then 0 else 1 end) | map(.link) | map(select(. != null and . != "")) | .[0:2] | join(" ; ")' <<<"$CHECKS" 2>/dev/null)"
  NOTGREEN="$( { grep -E ': fail$' <<<"$NOTGREEN"; grep -vE ': fail$' <<<"$NOTGREEN"; } | grep .)"
  die "PR #$PR is not green — $(while IFS= read -r l; do printf '%s (%s); ' "$l" "$(ran_kind "${l##*: }")"; done <<<"$NOTGREEN" | sed 's/; $//')"
fi
EXPECT="PR #$PR to pass land's description gates and merge cleanly into main"; LOOK="land --check $PR"
# --owner: write her words into the PR body once, so the bypass is on the record (owner_override reads it).
if [ -n "$OWNER_WORDS" ]; then
