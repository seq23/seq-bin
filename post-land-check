        | map(select(.first | ascii_downcase | startswith($m | ascii_downcase)))
        | last // empty
        | ((.first | ascii_downcase | ltrimstr($m | ascii_downcase) | gsub("^[ :]+"; "") | ascii_upcase | .[0:4]) + "\t" + .html_url)' \
