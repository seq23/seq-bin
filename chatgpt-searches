  if (!site.seeds) return { status: "no-home", why: site.seeds_why, gaps: gaps.length };
  if (!gaps.length) return { status: "none", why: "no gap this week (we showed up, or ChatGPT did not search)", gaps: 0 };
  const name = site.seeds.repo.split("/")[1]; const repoDir = path.join(REPOS, name);
  if (!fs.existsSync(path.join(repoDir, ".git"))) return { status: "stopped", why: `SEEDS_REPO_MISSING: no checkout at ${repoDir}`, gaps: gaps.length };
  if (git(repoDir, ["fetch", "-q", "origin", "main"]).status !== 0) return { status: "stopped", why: "SEEDS_REPO_UNREAD: git fetch failed", gaps: gaps.length };
  const shown = git(repoDir, ["show", `origin/main:${site.seeds.config}`]);
  const cfg = shown.status === 0 ? (() => { try { return JSON.parse(shown.stdout); } catch { return null; } })() : null;
  if (!cfg) return { status: "stopped", why: `SEEDS_CONFIG_UNREAD: ${site.seeds.config} on origin/main`, gaps: gaps.length };
  if (!(Array.isArray(cfg.product?.facts) && cfg.product.facts.length)) return { status: "waiting", why: `NO_PRODUCT_FACTS: ${site.seeds.repo} ${site.seeds.config} has no product.facts, and search-loop v1.17.0 refuses seeds without them`, gaps: gaps.length };
  const branch = `chatgpt-seeds/${site.id}-${week}`;
  const open = spawnSync(GH, ["pr", "list", "-R", site.seeds.repo, "--head", branch, "--state", "all", "--json", "number,url", "-q", ".[0].url"], { encoding: "utf8" });
  if (open.status === 0 && open.stdout.trim()) return { status: "pr", url: open.stdout.trim(), why: "already opened this week", gaps: gaps.length };
  const written = writeSeedList(site, gaps);
  if (written.wall) return { status: "stopped", why: `seed writer: ${WALL_WORDS[written.wall] || written.wall}`, wall: written.wall, gaps: gaps.length };
  const existing = Array.isArray(cfg.seeds) ? cfg.seeds : [];
  const have = new Set(existing.map((s) => norm(typeof s === "string" ? s : s.query)));
  const fresh = written.seeds.filter((s) => !have.has(norm(s.query)) && (have.add(norm(s.query)) || true));
  if (!fresh.length) return { status: "none", why: `every gap's search is already a seed${written.refused.length ? `; refused: ${written.refused.join("; ")}` : ""}`, gaps: gaps.length, refused: written.refused };
  // Room: drop only seeds THIS job added that the engine has finished (built, strengthened, answered).
  const ledgerFile = path.join(STATE, "seeds-ledger.json"); const ledger = readJson(ledgerFile, {});
  const mine = new Set((ledger[site.seeds.repo] || []).map(norm));
  const book = (() => { const r = git(repoDir, ["show", `origin/main:${cfg.ledger_dir || "data/search-loop"}/seeds.json`]); try { return r.status === 0 ? JSON.parse(r.stdout).seeds || {} : {}; } catch { return {}; } })();
  const doneQueries = new Set(Object.values(book).filter((b) => SEED_DONE.has(b?.status)).map((b) => norm(b.query)));
  let kept = existing.slice();
  const dropped = [];
  while (kept.length + fresh.length > MAX_SEEDS) {
    const i = kept.findIndex((s) => { const q = norm(typeof s === "string" ? s : s.query); return mine.has(q) && doneQueries.has(q); });
    if (i < 0) break;
    dropped.push(kept[i]); kept.splice(i, 1);
  }
  const room = MAX_SEEDS - kept.length; const add = fresh.slice(0, Math.max(0, room)); const waiting = fresh.slice(add.length);
  if (!add.length) return { status: "waiting", why: `SEEDS_FULL: ${site.seeds.repo} already lists ${existing.length} seeds the engine has not finished`, gaps: gaps.length };
  const next = { ...cfg, seeds: [...kept, ...add.map(({ q, ...s }) => s)] };
  if (dry) return { status: "dry", add, dropped, waiting, gaps: gaps.length, refused: written.refused };
  // A worktree on origin/main; the edit, the engine's validator, one commit, one PR, then land-after.
  const wt = path.join(REPOS, `.wt-csq-${site.id}-${week}`);
  git(repoDir, ["worktree", "remove", "--force", wt]);
  const add1 = git(repoDir, ["worktree", "add", "-B", branch, wt, "origin/main"]);
  if (add1.status !== 0) return { status: "stopped", why: `SEEDS_WORKTREE: ${add1.stderr.trim().slice(0, 160)}`, gaps: gaps.length };
  const cleanup = () => git(repoDir, ["worktree", "remove", "--force", wt]);
  const file = path.join(wt, site.seeds.config);
  const indent = (fs.readFileSync(file, "utf8").match(/^\{\n( +)"/) || [, "  "])[1].length;
  fs.writeFileSync(file, `${JSON.stringify(next, null, indent)}\n`);
  let check;
  try { check = spawnSync("node", [path.join(engineDir(), "bin/search-loop.mjs"), "validate-config", "--config", site.seeds.config, "--root", wt], { cwd: wt, encoding: "utf8" }); }
  catch (e) { cleanup(); return { status: "stopped", why: e.message, gaps: gaps.length }; }
  if (check.status !== 0) { cleanup(); return { status: "stopped", why: `SEEDS_INVALID: the engine's validate-config refused it: ${(check.stdout + check.stderr).trim().slice(0, 200)}`, gaps: gaps.length }; }
  const diffStat = git(wt, ["diff", "--stat"]).stdout.trim();
  const msg = `search-loop seeds: ${add.length} ChatGPT search${add.length === 1 ? "" : "es"} where ${site.label} did not show up (${week})`;
  const commit = git(wt, ["commit", "-am", `${msg}\n\nFrom chatgpt-searches (seq-bin): the searches ChatGPT ran in ${week}'s buyer questions where the site was missing.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>`]);
  const push = commit.status === 0 ? git(wt, ["push", "-q", "-f", "-u", "origin", branch]) : commit;
  if (push.status !== 0) { cleanup(); return { status: "stopped", why: `SEEDS_NOT_PUSHED: ${(push.stderr || push.stdout).trim().slice(0, 160)}`, gaps: gaps.length }; }
  const ledgerDir = cfg.ledger_dir || "data/search-loop";
  const body = prBody({ site, week, add, dropped, waiting, refused: written.refused, gaps, check: (check.stdout || "").trim(), diffStat, ledgerDir });
  const bodyFile = path.join(STATE, `pr-body-${site.id}-${week}.md`); writeAtomic(bodyFile, body);
  const pr = spawnSync(GH, ["pr", "create", "-R", site.seeds.repo, "--head", branch, "--base", "main", "--title", msg, "--body-file", bodyFile], { cwd: wt, encoding: "utf8" });
