}
const seedLine = (s) => s.status === "pr" ? `PR ${s.url}${s.add ? `: ${s.add.length} seed(s) — ${s.add.map((x) => `"${x.query}"`).join(", ")}` : ` (${s.why})`}${s.land ? `; ${s.land}` : ""}`
