#!/bin/bash
# ai-run — the ONE runner every scheduled job uses to hand a prompt to an AI.
#
#   ai-run --role worker|brain [--cwd DIR] [--network] [--out FILE] -- "<prompt>"
#   ai-run --role worker|brain [--cwd DIR] [--network] [--out FILE] < prompt.txt
#
# OWNER RULING (Sequoia, 3 Nov 2026): "after today we need to default OpenAI and Claude just be the
# brains". From 4 Nov:
#   worker  hands-on work (fixing, building, landing) -> OpenAI Codex, the `codex` CLI on her ChatGPT
#           plan: `codex exec -s workspace-write`, stdin </dev/null, network only with --network.
#           There is NO paid OpenAI API (that is money): a Codex logged in with an API key is refused.
#   brain   planning, deciding, reviewing, summarising for her, company-brain writes -> `claude -p`
#           (--model opus and --dangerously-skip-permissions, as the scheduled jobs ran it).
# A Codex usage limit means the work WAITS for the reset: exit 75 and
#   NAMED STOP [CODEX_LIMIT] resets <time from Codex's own message>
# It NEVER falls back to Claude. Codex missing or not logged in with ChatGPT:
#   NAMED STOP [CODEX_UNAVAILABLE] ...   (exit 69)
#
# THE INTERFACE IS SHARED. boss-os and west-peek-os call this file with exactly the flags above;
# change them only together. Optional knobs, all additive (none changes the interface):
#   AI_RUN_WORKER=claude   HER manual override only: the worker role runs on Claude. No job sets it
#                          (tests/test-ai-run.sh fails if any tracked file other than this one, its
#                          test and the docs does).
#   AI_RUN_CLAUDE_MODEL    brain model (default opus).
#   AI_RUN_CLAUDE_ARGS     brain flags in place of --dangerously-skip-permissions (e.g. pnp-listings:
#                          "--chrome --allowedTools=mcp__claude-in-chrome__*"). Split on spaces, no globbing.
#   AI_RUN_ADD_DIRS        colon-separated extra writable directories for the worker (a job's state dir).
#   AI_RUN_CALLER          name logged as the caller (default: the parent process's script).
#   AI_RUN_LOG             usage log (default ~/Library/Logs/ai-run.log).
#   AI_RUN_CODEX_BIN / AI_RUN_CLAUDE_BIN   the binaries (default: PATH, then /opt/homebrew/bin).
#
# OUTPUT. With --out, everything the engine prints (stdout and stderr) is APPENDED to FILE as it
# happens, so a run killed by a cap still leaves its transcript. Without --out it is printed to stdout
# when the run ends. The NAMED STOP lines go to stdout and, with --out, into FILE as well.
#
# WRITABLE .git. Codex's workspace-write sandbox keeps every `.git` read-only, so a worker could edit
# but never commit (proved 3 Nov 2026: `git add` -> index.lock: Operation not permitted). The git
# directories of --cwd's repo and of each repo directly under --cwd are added as writable roots.
#
# Every run appends one line to the usage log: time, role, engine, caller, exit.
# Exit: the engine's own code; 75 CODEX_LIMIT; 69 CODEX_UNAVAILABLE / CLAUDE_UNAVAILABLE; 64 usage.
set -uo pipefail

usage() {
  echo 'usage: ai-run --role worker|brain [--cwd DIR] [--network] [--out FILE] -- "<prompt>"   (or the prompt on stdin)' >&2
  exit "${1:-64}"
}

ROLE="" CWD="" NETWORK=0 OUT="" PROMPT="" HAVE_PROMPT=0
while [ $# -gt 0 ]; do
  case "$1" in
    --role)    [ $# -ge 2 ] || usage; ROLE="$2"; shift 2 ;;
    --role=*)  ROLE="${1#*=}"; shift ;;
    --cwd)     [ $# -ge 2 ] || usage; CWD="$2"; shift 2 ;;
    --cwd=*)   CWD="${1#*=}"; shift ;;
    --out)     [ $# -ge 2 ] || usage; OUT="$2"; shift 2 ;;
    --out=*)   OUT="${1#*=}"; shift ;;
    --network) NETWORK=1; shift ;;
    --)        shift; if [ $# -gt 0 ]; then PROMPT="$*"; HAVE_PROMPT=1; fi; break ;;
    -h|--help) usage 0 ;;
    *)         echo "ai-run: unknown argument: $1" >&2; usage ;;
  esac
done
case "$ROLE" in worker|brain) ;; *) echo "ai-run: --role must be worker or brain (got '${ROLE}')" >&2; usage ;; esac
[ "$HAVE_PROMPT" -eq 1 ] || PROMPT="$(cat)"
[ -n "${PROMPT//[[:space:]]/}" ] || { echo "NAMED STOP [NO_PROMPT] ai-run was given an empty prompt." ; exit 64; }
if [ -n "$CWD" ]; then
  [ -d "$CWD" ] || { echo "NAMED STOP [NO_CWD] $CWD is not a directory."; exit 64; }
  CWD="$(cd "$CWD" && pwd)"
fi

LOG="${AI_RUN_LOG:-$HOME/Library/Logs/ai-run.log}"
caller_name() { # the job that ran us, climbing past wrappers (timeout, nohup, caffeinate, env)
  [ -n "${AI_RUN_CALLER:-}" ] && { echo "$AI_RUN_CALLER"; return; }
  local pid="$PPID" args first _
  for _ in 1 2 3 4 5 6; do
    args="$(ps -o args= -p "$pid" 2>/dev/null)"; [ -n "$args" ] || break
    set -f; # shellcheck disable=SC2086
    set -- $args; set +f
    first="${1##*/}"
    case "$first" in
      timeout|gtimeout|nohup|caffeinate|env) pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"; continue ;;
      bash|-bash|sh|zsh|-zsh|dash|node|python|python3) [ -n "${2:-}" ] && { echo "${2##*/}"; return; } ;;
    esac
    echo "$first"; return
  done
  echo unknown
}
CALLER="$(caller_name)"
ENGINE=""
log_line() { # log_line <exit> [stop]
  mkdir -p "$(dirname "$LOG")" 2>/dev/null
  printf '%s\trole=%s\tengine=%s\tcaller=%s\texit=%s%s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" "$ROLE" "${ENGINE:-none}" \
    "$CALLER" "$1" "${2:+	stop=$2}" >> "$LOG" 2>/dev/null
}
stop() { # stop <code> <NAME> <text>
  local line="NAMED STOP [$2] $3"
  echo "$line"
  [ -n "$OUT" ] && echo "$line" >> "$OUT"
  log_line "$1" "$2"
  exit "$1"
}

ENGINE_KIND=""
case "$ROLE" in
  brain) ENGINE_KIND=claude; ENGINE=claude ;;
  worker)
    case "${AI_RUN_WORKER:-}" in
      ""|codex) ENGINE_KIND=codex; ENGINE=codex ;;
      claude)   ENGINE_KIND=claude; ENGINE=claude-override ;;
      *) echo "ai-run: AI_RUN_WORKER must be unset, codex or claude (got '$AI_RUN_WORKER')" >&2; exit 64 ;;
    esac ;;
esac

# --- where the output goes ----------------------------------------------------------------------
if [ -n "$OUT" ]; then
  case "$OUT" in /*) ;; *) OUT="$PWD/$OUT" ;; esac
  mkdir -p "$(dirname "$OUT")" || { echo "NAMED STOP [NO_OUT_DIR] cannot create the directory of $OUT"; exit 64; }
  touch "$OUT" || { echo "NAMED STOP [NO_OUT_FILE] cannot write $OUT"; exit 64; }
  DEST="$OUT"
  START_BYTES="$(wc -c < "$OUT" | tr -d ' ')"
else
  DEST="$(mktemp "${TMPDIR:-/tmp}/ai-run.XXXXXX")"
  START_BYTES=0
  trap 'rm -f "$DEST"' EXIT
fi

# --- build the command --------------------------------------------------------------------------
toml_list() { # newline-separated paths -> ["a","b"]
  awk 'NF && !seen[$0]++ { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); printf "%s\"%s\"", (n++ ? "," : ""), $0 } END { }' |
    { printf '['; cat; printf ']'; }
}
writable_roots() {
  local base="${CWD:-$PWD}" d
  d="$(git -C "$base" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" && [ -d "$d" ] && echo "$d"
  for d in "$base"/.git "$base"/*/.git; do [ -d "$d" ] && echo "$d"; done
  if [ -n "${AI_RUN_ADD_DIRS:-}" ]; then
    printf '%s\n' "$AI_RUN_ADD_DIRS" | tr ':' '\n' | while IFS= read -r d; do [ -n "$d" ] && mkdir -p "$d" 2>/dev/null; [ -d "$d" ] && (cd "$d" && pwd); done
  fi
}

if [ "$ENGINE_KIND" = codex ]; then
  CODEX="${AI_RUN_CODEX_BIN:-$(command -v codex || echo /opt/homebrew/bin/codex)}"
  [ -x "$CODEX" ] || stop 69 CODEX_UNAVAILABLE "no codex CLI at $CODEX — install it (brew install codex) and run: codex login"
  if ! STATUS="$("$CODEX" login status 2>&1 < /dev/null)"; then
    stop 69 CODEX_UNAVAILABLE "codex is not logged in ($(printf '%s' "$STATUS" | head -1)) — run: codex login (with her ChatGPT account)"
  fi
  # Her ChatGPT plan only. An API-key login bills per token, which is money (owner ruling 3 Nov 2026).
  printf '%s' "$STATUS" | grep -qi 'chatgpt' ||
    stop 69 CODEX_UNAVAILABLE "codex is logged in without ChatGPT ($(printf '%s' "$STATUS" | head -1)); an API key bills per token — run: codex logout && codex login"
  CMD=("$CODEX" exec -s workspace-write --skip-git-repo-check --color never)
  [ -n "$CWD" ] && CMD+=(-C "$CWD")
  [ "$NETWORK" -eq 1 ] && CMD+=(-c sandbox_workspace_write.network_access=true)
  ROOTS="$(writable_roots)"
  [ -n "$ROOTS" ] && CMD+=(-c "sandbox_workspace_write.writable_roots=$(printf '%s\n' "$ROOTS" | toml_list)")
  CMD+=("$PROMPT")
else
  CLAUDE="${AI_RUN_CLAUDE_BIN:-$(command -v claude || echo /opt/homebrew/bin/claude)}"
  [ -x "$CLAUDE" ] || stop 69 CLAUDE_UNAVAILABLE "no claude CLI at $CLAUDE"
  if [ -n "${AI_RUN_CLAUDE_ARGS+set}" ]; then
    set -f; read -r -a EXTRA <<< "$AI_RUN_CLAUDE_ARGS"; set +f
  else
    EXTRA=(--dangerously-skip-permissions)
  fi
  CMD=("$CLAUDE" -p --model "${AI_RUN_CLAUDE_MODEL:-opus}" ${EXTRA[@]+"${EXTRA[@]}"})
fi

# --- run it, forwarding a kill to the engine (a watchdog or a cap kills THIS pid) ----------------
CHILD=""
# shellcheck disable=SC2329  # invoked by the trap below
forward() { [ -n "$CHILD" ] && kill -TERM "$CHILD" 2>/dev/null; }
trap forward TERM INT HUP
if [ -n "$CWD" ]; then cd "$CWD" || exit 64; fi
if [ "$ENGINE_KIND" = codex ]; then
  "${CMD[@]}" < /dev/null >> "$DEST" 2>&1 &
else
  printf '%s' "$PROMPT" | "${CMD[@]}" >> "$DEST" 2>&1 &   # $! is claude itself, the last in the pipe
fi
CHILD=$!
wait "$CHILD"; RC=$?
while kill -0 "$CHILD" 2>/dev/null; do wait "$CHILD"; RC=$?; done
trap - TERM INT HUP

[ -n "$OUT" ] || cat "$DEST"

# --- a Codex usage limit: the work waits for the reset -------------------------------------------
# Only Codex's own error line counts, and only on a failed exit, near the end: a run that merely
# PRINTED such a line (a test fixture, this file) and finished is not a limit.
if [ "$ENGINE_KIND" = codex ] && [ "$RC" -ne 0 ]; then
  LIMIT_LINE="$(tail -c +"$((START_BYTES + 1))" "$DEST" | tail -n 60 |
    grep -iE '^(\[[^]]*\])?[^[:alpha:]]*(error:)?[[:space:]]*(you.{1,3}ve hit your usage limit|.*usage_limit_reached)' | tail -1)"
  if [ -n "$LIMIT_LINE" ]; then
    RESET="$(printf '%s' "$LIMIT_LINE" | grep -oiE 'try again (at|in) [^.]+' | head -1 | sed -E 's/^[Tt]ry again (at )?//')"
    stop 75 CODEX_LIMIT "resets ${RESET:-unknown (Codex gave no reset time: $(printf '%s' "$LIMIT_LINE" | cut -c1-160))} — the work waits for the reset; it is never handed to Claude."
  fi
fi

log_line "$RC"
exit "$RC"
