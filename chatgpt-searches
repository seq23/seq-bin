  const now = process.env.CSQ_NOW ? new Date(process.env.CSQ_NOW) : new Date();
  const c = central(now); const night = nightOf(c); const week = isoWeek(night); const slot = slotOf(night);
  const lastState = readJson(weekFile(prevWeekOf(night)), null); const state = loadWeek(week, slot, !lastState);
  if (rollOnly) { const f = path.join(OUT, `rollup-${week}.md`); writeAtomic(f, rollup(sites, week, state, lastState)); console.log(`rollup: ${f}`); return 0; }
  const done = (s) => { const w = state.sites[s.id]; return !!w && Object.keys(w.asked || {}).length === QUESTIONS && Object.values(w.asked).every((r) => r.status === "CHECKED" || (r.tries || 0) >= MAX_TRIES); };
  let due = sites.filter((s) => (only ? only.has(s.id) : s.night <= slot && s.night >= (state.start_slot || 1)) && !done(s)).sort((a, b) => a.night - b.night);
  if (plan) { console.log(`night ${night} (${week}, slot ${slot}): due ${due.map((s) => s.id).join(", ") || "nothing"}`); return 0; }
  const hhmm = `${String(c.hour).padStart(2, "0")}:${String(c.minute).padStart(2, "0")}`;
  if (!hand && !(c.hour >= 22 || c.hour < 2)) throw new Stop(3, "OUTSIDE_NIGHT", `it is ${hhmm} Central; the night runs 22:00-01:59, so tonight's sites wait for the next night (a Mac asleep at 22:00 runs a missed job on wake).`);
  if (hand && c.hour >= 7 && c.hour < 10) throw new Stop(3, "MAC_REST", `it is ${hhmm} Central, the Mac's rest (07:00-09:59); run it after 10:00.`);
  const deadline = Date.now() + (hand ? 4 * 60 : minutesToTwo(c)) * 60000;
