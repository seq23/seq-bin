function rollup(sites, week, state, lastState) {
  const L = [`# ChatGPT hidden searches — week ${week}`, "",
    "One row per site: how many of the week's 5 buyer questions were checked, in how many chats our site showed up (read, cited or named), last week's number, and where the gaps went.", "",
    "| Site | Checked | Ours showed up | Last week | Searches captured | Seeds |", "|---|---|---|---|---|---|"];
  let checkedAll = 0;
