<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Hours here are CENTRAL. install-launchd.sh moves them to the Mac's zone (boss-os scripts/ops/plist-central.mjs). -->
<!-- 1st and 15th at 22:05 CT (her rulings 8 Nov 2026; moved from 10:00 on 21 Nov 2026: a big upload is heavy work, so it runs at night, ahead of the PBS fill's 22:30 ramp). Encrypted snapshot to sequoialtaylor's Drive. -->
<dict>
	<key>Label</key>
	<string>com.seq.mac-snapshot</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-lc</string>
		<string>~/bin/mac-snapshot.sh --now</string>
	</array>
	<key>StandardOutPath</key>
	<string>/Users/sequoiataylor/Library/Logs/mac-snapshot/launchd.out</string>
	<key>StandardErrorPath</key>
	<string>/Users/sequoiataylor/Library/Logs/mac-snapshot/launchd.err</string>
	<key>StartCalendarInterval</key>
  <array>
    <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Day</key><integer>15</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>5</integer></dict>
  </array>
</dict>
</plist>
