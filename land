  # employmentverificationletter.com and letterofexplanation.com).
  approvalprep)         DEPLOY="" ; SELF="deploys itself through Cloudflare Pages on push to main (approvalprep.com)" ;;
  # OpenNext Worker (wrangler.jsonc main = .open-next/worker.js). Workers Builds builds and deploys
