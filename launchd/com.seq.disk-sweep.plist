<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Hours here are CENTRAL. install-launchd.sh moves them to the Mac's zone (boss-os scripts/ops/plist-central.mjs). -->
<!-- Daily 07:15 CT: removes leaked Chrome code-sign clones, repair-fixture-* folders and merged worktrees, then checks free space (alert under 15 GB). Before Kendra mac-cleanup at 09:00 CT. -->
<dict>
	<key>Label</key>
	<string>com.seq.disk-sweep</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>/Users/sequoiataylor/bin/disk-sweep.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/sequoiataylor/Library/Logs/disk-sweep.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/sequoiataylor/Library/Logs/disk-sweep.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>15</integer>
	</dict>
</dict>
</plist>
