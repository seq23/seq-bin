#!/bin/bash
# post-land-check — runs the checks `land` promises after a land, so none of them depends on anyone remembering
# (her ask 23 Nov 2026: "close both gaps"). It reads the DUE lines `land` writes into Today in ~/HANDOFF.md:
#
#   - ENG-CHECK DUE <owner/repo>#<pr> <sha> — …   a land no fresh reviewer read (her bypass, or a Fast PR on
#                                                  green CI). Fast PRs item 1: ONE batched engineering check of
#                                                  the day's merged diffs, same day, never holding a land.
#   - FORM-PROOF DUE <owner/repo>#<pr> <sha> — …  a land that touched a form (land's gate_forms). Her words
#                                                  23 Nov 2026: "after theee fixes u need to test them"; the
#                                                  live form gets a marked TEST submission right after deploy.
#   - OUTCOME-CHECK DUE <owner/repo>#<pr> <sha> — task:<slug> by:<day> expect:>=N — outcome: … — check: <cmd>
#                                                  a green land whose PR declared a real Outcome (land's Outcome
#                                                  gate, her order 24 Nov 2026: nothing is "working" until its real
#                                                  output is checked live the next day). expect:infer = her bypass.
#
#   post-land-check                 every DUE line: each FORM-PROOF on its own, then all ENG-CHECKs in ONE batch,
#                                   then each OUTCOME-CHECK whose by-day has come
#   post-land-check --now <key>     only the FORM-PROOF line for <owner/repo>#<pr> (land starts this, detached)
#   post-land-check --dry-run       print what would run, run nothing
#   post-land-check --read-only-gate '<cmd>'   rc 0 when the check only reads, rc 1 and why (land calls this)
#
# Meaning is a model's job: each check is ONE `ai-run --role brain` (a fresh Claude that never built the PR).
# Code only checks structure: after the run, the PR must carry a NEW comment from this account whose first line
# is `Engineering check: PASS|FAIL — …` or `Form proof (production): PASS|FAIL — …`. That comment, never the
# model's own word, turns the line DONE or FAIL (with the comment's link). No such comment leaves the line DUE
# and the exit non-zero (rule 0: a run that proved nothing never ends 0). A FAIL, or a run that proved nothing,
# raises a macOS banner; a form FAIL also files a GitHub issue on that repo (GitHub emails her: a broken live
# form is a break a real person hits). Never an Open Loops row (her ruling 22 Nov 2026).
#
# An OUTCOME-CHECK is decided in three steps, and nothing skips the first two. (1) CODE runs the PR's own check
# command itself, but only once the read-only gate (readonly_gate, below) has passed it: a check that could send,
# post, create, delete or change anything is never run, and is COULDNT-CHECK ("the check was not run"). It runs under
# macOS sandbox-exec (no FILE writes outside temp and tool caches; the network is the gate's job) with a 5-min
# timeout, and code reads the count it printed (an integer on its last line, else its non-empty line count). A
# non-zero exit or no output is COULDNT-CHECK (an outage: D1 5xx, a gh rate limit, a site down), except exit 1 with
# one bare integer line (`grep -c` finding none prints 0 and exits 1): that is a reading. A count under the floor is FAIL (NOT WORKING), posted by code
# with no model run. (2) Only a count that meets the floor goes to ONE fresh `ai-run --role brain`, which judges
# whether that output is the promised outcome and posts `Outcome check (live): PASS|FAIL|COULDNT-CHECK — <what it
# saw, with counts>`; a count below the floor never reaches it, and the model's FAIL stands. No comment, ai-run down
# or a usage limit is COULDNT-CHECK. (3) PASS → the line DONE, the task sheet's line 1 DONE (moved to done/), a
# Notices line "<repo> #<pr> <outcome>: working — <seen>". FAIL → FAIL, line 1 FAIL, a banner, "… NOT WORKING —
# <seen>". COULDNT-CHECK → the line stays DUE, exit 1, a "… NOT CHECKED — <seen>" Notices line each day, and a
# banner once it is 2+ days past its by-day. One try per line per night (a replay posts nothing twice). Public
# comments and Notices carry counts only (emails masked); the check's raw output stays in the local log.
#
# Scheduled nightly by launchd/com.seq.post-land-check.plist (23:15 Central, inside the Mac's 22:00–07:00
# window; an ai-run job, so it stays on the Mac: her ruling 22 Nov 2026). Exit: 0 every line got a verdict
# (FAILs included: they are results, and they are raised) · 1 a line got no verdict · 2 HANDOFF unreadable.
# Env (tests): POST_LAND_HANDOFF, POST_LAND_AI_RUN, POST_LAND_LOG, POST_LAND_NOTIFY (a command given the text),
#   POST_LAND_TASKS (task sheets dir), POST_LAND_TODAY (YYYY-MM-DD), POST_LAND_SANDBOX=off (Linux CI and tests),
#   POST_LAND_NOTICE (a command given key and text; default: boss-os scripts/ops/outcome-notice.mjs via the vault),
#   POST_LAND_LOCKS.
set -uo pipefail

HANDOFF="${POST_LAND_HANDOFF:-$HOME/HANDOFF.md}"
AI_RUN="${POST_LAND_AI_RUN:-$HOME/bin/ai-run}"
LOG="${POST_LAND_LOG:-$HOME/Work/tasks/logs/post-land-check.log}"
# THE CHECK ONLY READS (the re-review's F1, 24 Nov 2026). An Outcome check runs every night with her gh and wrangler
# logins and no one watching, and the sandbox below stops only FILE writes: a POST, a `gh api -f`, a D1 DELETE goes
# straight out over the network. So every check passes this gate first: `land` calls it on the PR's check before it
# writes the DUE line (`post-land-check --read-only-gate '<cmd>'`, this one function, never a copy), and the nightly
# run calls it again just before it runs each check (a hand-edited HANDOFF line is covered too). An allowlist by tool;
# everything else is refused by name. Every part of the command is checked: each pipeline stage, each `;` `&&` `||`
# segment and each $(...), `...` and <(...) body.
#   curl            no -d/--data*/-F/--form*/-T/--upload-file/--json/-K/--config/-Q; -X/--request only GET or HEAD;
#                   http(s) addresses only
#   gh api          GET only (-X/--method GET); -f/-F/--field/--raw-field only on `gh api graphql` whose query has no
#                   `mutation`; --input and @file fields refused (the gate cannot see them)
#   gh <group>      only list|view|status|search|diff|checks (`gh search …` and `gh status` are reads); built-in groups only
#   wrangler        (or npx wrangler) only `d1 execute <db> --command '<one SELECT or WITH>'` (no write word in it, no
#                   --file), `kv key get|list`, `r2 object get`
#   text tools      grep, jq, wc, head, tail, cut, tr, cat, echo, printf, date, ls, test, cd …; sed without -i/-f/w/e,
#                   awk without system/|, sort without -o, uniq without an output file, find without -exec/-delete
#   repo scripts    only those on READ_ONLY_SCRIPTS below, with the argument named there
# Refused anywhere: a variable set before a command, a command or flag built from an expansion, a redirect to any file
# but /dev/null, a heredoc, loops and if-blocks, eval/bash/xargs/python and every tool not named here.
# rc 0: it only reads. rc 1: one plain line naming the part refused and why.
readonly_gate() { # $1 a check command
  python3 - "$1" <<'PY'
import os, re, sys

class Refuse(Exception):
    pass

EXP = "\x00"   # stands in for an expansion's (unknown) text

class Word:
    def __init__(self):
        self.text = ""; self.quoted = False; self.exp = False; self.bare_exp = False; self.lead_exp = None
    def lit(self, c):
        if self.lead_exp is None: self.lead_exp = False
        self.text += c
    def expn(self, in_dq):
        if self.lead_exp is None: self.lead_exp = True
        self.exp = True; self.bare_exp = self.bare_exp or not in_dq; self.text += EXP

def close_paren(s, i):  # s[i] is just past "(" -> index of the matching ")" (quotes and nesting aware)
    depth, n = 1, len(s)
    while i < n:
        c = s[i]
        if c == "\\": i += 2; continue
        if c == "'":
            j = s.find("'", i + 1)
            if j < 0: raise Refuse("a quote is never closed")
            i = j + 1; continue
        if c == '"':
            i += 1
            while i < n and s[i] != '"':
                i += 2 if s[i] == "\\" else 1
            if i >= n: raise Refuse("a quote is never closed")
            i += 1; continue
        if c == "(": depth += 1
        elif c == ")":
            depth -= 1
            if depth == 0: return i
        i += 1
    raise Refuse("a bracket is never closed")

def dollar(s, i, w, in_dq, subs):  # s[i] == "$" -> index after the expansion
    nxt = s[i + 1] if i + 1 < len(s) else ""
    if s.startswith("$((", i): raise Refuse("it uses $((...)) arithmetic")
    if nxt == "(":
        j = close_paren(s, i + 2); subs.append(s[i + 2:j]); w.expn(in_dq); return j + 1
    if nxt == "{":
        m = re.match(r"\$\{[A-Za-z_][A-Za-z0-9_]*\}", s[i:])
        if not m: raise Refuse("it uses a ${...} form other than ${NAME}")
        w.expn(in_dq); return i + len(m.group())
    if nxt in ("'", '"') and not in_dq: raise Refuse("it uses $'...' or $\"...\" quoting")
    m = re.match(r"\$(?:[A-Za-z_][A-Za-z0-9_]*|[0-9@*#?$!-])", s[i:])
    if m: w.expn(in_dq); return i + len(m.group())
    w.lit("$"); return i + 1

def lex(s, subs):
    """Shell text -> segments: each a list of Words plus its redirections. Operators split segments;
    $(...), `...` and <(...) bodies go to subs, each checked as a whole command of its own."""
    segs, cur, redirs, w, i, n = [], [], [], None, 0, len(s)
    def end_word():
        nonlocal w
        if w is not None: cur.append(w); w = None
    def end_seg():
        nonlocal cur, redirs
        end_word(); segs.append((cur, redirs)); cur, redirs = [], []
    while i < n:
        c = s[i]
        if c in " \t":
            end_word(); i += 1; continue
        if c == "#" and w is None:
            j = s.find("\n", i); i = n if j < 0 else j; continue
        if c in "<>" and s.startswith("(", i + 1):
            j = close_paren(s, i + 2); subs.append(s[i + 2:j])
            if w is None: w = Word()
            w.expn(False); i = j + 1; continue
        if c in "<>" or (c == "&" and s.startswith(">", i + 1)):
            fd = ""
            if w is not None and not w.quoted and not w.exp and re.fullmatch(r"\d+", w.text): fd, w = w.text, None
            end_word()
            m = re.match(r"&>>|&>|>>|>\||>&|>|<<<|<<-|<<|<&|<>|<", s[i:]); op = m.group(); i += len(op)
            if op in ("<<", "<<-"): raise Refuse("it uses a heredoc (<<)")
            if op in (">&", "<&"):
                m2 = re.match(r"\s*(\d+|-)(?=[\s;|&)]|$)", s[i:])
                if not m2: raise Refuse("it redirects output to a file")
                i += len(m2.group()); continue
            while i < n and s[i] in " \t": i += 1
            m2 = re.match(r"[^\s;|&()<>]+", s[i:]); target = m2.group() if m2 else ""
            i += len(target)
            if op in ("<", "<<<"):
                if any(ch in target for ch in "$`"): raise Refuse("it reads input from an expansion")
                continue
            if target != "/dev/null": raise Refuse(f"it writes to a file ({fd}{op} {target or 'nothing'}): only /dev/null is allowed")
            continue
        if c in "|;&\n()":
            end_seg()
            i += 2 if s[i:i + 2] in ("||", "&&", ";;", "|&") else 1; continue
        if w is None: w = Word()
        if c == "\\":
            if i + 1 < n and s[i + 1] != "\n": w.lit(s[i + 1])
            i += 2; continue
        if c == "'":
            j = s.find("'", i + 1)
            if j < 0: raise Refuse("a quote is never closed")
            w.quoted = True
            for ch in s[i + 1:j]: w.lit(ch)
            if i + 1 == j: w.lit("")
            i = j + 1; continue
        if c == '"':
            w.quoted = True; i += 1
            if i < n and s[i] == '"': w.lit("")
            while i < n and s[i] != '"':
                if s[i] == "\\" and i + 1 < n and s[i + 1] in '$`"\\\n':
                    w.lit(s[i + 1]); i += 2
                elif s[i] == "$": i = dollar(s, i, w, True, subs)
                elif s[i] == "`":
                    j = s.find("`", i + 1)
                    if j < 0: raise Refuse("a backtick is never closed")
                    subs.append(s[i + 1:j]); w.expn(True); i = j + 1
                else: w.lit(s[i]); i += 1
            if i >= n: raise Refuse("a quote is never closed")
            i += 1; continue
        if c == "$": i = dollar(s, i, w, False, subs); continue
        if c == "`":
            j = s.find("`", i + 1)
            if j < 0: raise Refuse("a backtick is never closed")
            subs.append(s[i + 1:j]); w.expn(False); i = j + 1; continue
        w.lit(c); i += 1
    end_seg()
    return segs

# Text tools whose every argument only shapes what is read or printed.
FILTERS = {"grep", "egrep", "fgrep", "wc", "head", "tail", "cut", "tr", "jq", "cat", "echo", "printf", "date", "ls",
           "test", "[", "true", "false", "exit", "basename", "dirname", "nl", "paste", "column", "comm", "seq", "expr",
           "rev", "fold", "cd"}
SYSTEM_DIRS = ("/bin/", "/usr/bin/", "/usr/local/bin/", "/opt/homebrew/bin/")
# Repo scripts that only read, each with the argument it must start with. Add one only after reading the
# script end to end; anything not here is refused.
READ_ONLY_SCRIPTS = {
    "land-after": ["--holds"],   # rc 0 and a pid while a live land holds that PR (reads a lock dir)
}
GH_GROUPS = {"pr", "issue", "run", "workflow", "repo", "release", "gist", "label", "secret", "variable", "cache",
             "ruleset", "project", "org", "auth"}
GH_READ_SUBS = {"list", "view", "status", "search", "diff", "checks"}
WRITE_SQL = re.compile(r"\b(insert|update|delete|drop|alter|create|attach|detach|pragma|vacuum|reindex|analyze|begin|"
                       r"commit|rollback|savepoint|release|truncate|grant|upsert)\b|\breplace\s+into\b", re.I)

def args_safe(name, words):
    for w in words:
        if w.exp and (w.bare_exp or w.lead_exp or w.text.startswith("-")):
            raise Refuse(f"{name} is given an argument built from an expansion ({shown(w)}), which could become any flag")

def shown(w): return w.text.replace(EXP, "$…")[:60]

def check_curl(a):
    i, urls = 0, []
    takes = set("AbcCdDeEFHKmoPQrtTuUwxXyYz")
    while i < len(a):
        t = a[i]
        if t.startswith("--"):
            o = t.split("=", 1)[0]
            if re.match(r"--(data|form|json|upload|mail|config|quote|post)", o): raise Refuse(f"curl {o} sends data")
            if o == "--request":
                if "=" in t: raise Refuse("curl --request=… is not a form curl reads")
                v = a[i + 1] if i + 1 < len(a) else ""
                if v.upper() not in ("GET", "HEAD"): raise Refuse(f"curl --request {v} is not GET or HEAD")
                i += 2; continue
            if o == "--url":
                urls.append(a[i + 1] if i + 1 < len(a) else ""); i += 2; continue
            i += 1; continue
        if t.startswith("-") and len(t) > 1:
            for k, ch in enumerate(t[1:], 1):
                if ch in "dFT": raise Refuse(f"curl -{ch} sends data")
                if ch in "KQ": raise Refuse(f"curl -{ch} reads its options from a file or sends server commands")
                if ch in takes:
                    rest = t[k + 1:]; v = rest if rest else (a[i + 1] if i + 1 < len(a) else "")
                    if not rest: i += 1
                    if ch == "X" and v.upper() not in ("GET", "HEAD"): raise Refuse(f"curl -X {v} is not GET or HEAD")
                    break
            i += 1; continue
        urls.append(t); i += 1
    for u in urls:
        m = re.match(r"([A-Za-z][A-Za-z0-9+.-]*)://", u)
        if m and m.group(1).lower() not in ("http", "https"): raise Refuse(f"curl to a {m.group(1)}:// address (only http and https are read)")

def check_gh_api(a):
    VAL = {"-X": "m", "--method": "m", "-f": "f", "-F": "f", "--field": "f", "--raw-field": "f", "--input": "i",
           "-H": "", "--header": "", "-q": "", "--jq": "", "-t": "", "--template": "", "--hostname": "", "-p": "",
           "--preview": "", "--cache": ""}
    BOOL = {"--paginate", "--slurp", "-i", "--include", "--silent", "--verbose"}
    method, fields, endpoint, i = None, [], None, 0
    while i < len(a):
        t = a[i]
        if t.startswith("-"):
            o, v = t, None
            if t.startswith("--") and "=" in t: o, v = t.split("=", 1)
            elif not t.startswith("--") and len(t) > 2: o, v = t[:2], t[2:]
            if o in BOOL and v is None: i += 1; continue
            if o not in VAL: raise Refuse(f"gh api {o} is not a flag the read-only gate knows")
            if v is None:
                if i + 1 >= len(a): raise Refuse(f"gh api {o} has no value")
                v = a[i + 1]; i += 1
            kind = VAL[o]
            if kind == "m": method = v.upper()
            elif kind == "f": fields.append(v)
            elif kind == "i": raise Refuse("gh api --input sends a file the gate cannot see")
            i += 1; continue
        if endpoint is None: endpoint = t
        i += 1
    graphql = endpoint == "graphql"
    if fields and not graphql: raise Refuse(f"gh api {endpoint} with -f/-F fields sends a write (fields are only for a graphql query)")
    if graphql:
        if method not in (None, "POST", "GET"): raise Refuse(f"gh api graphql -X {method}")
        q = [f for f in fields if f.split("=", 1)[0] == "query"]
        if not q: raise Refuse("gh api graphql has no query the gate can read")
        for f in fields:
            if "=" in f and f.split("=", 1)[1].startswith("@"): raise Refuse("gh api graphql reads a field from a file the gate cannot see")
            if re.search(r"\bmutation\b", f, re.I): raise Refuse("gh api graphql runs a mutation")
        return
    if method not in (None, "GET"): raise Refuse(f"gh api -X {method} is not GET")

def check_gh(a):
    if not a: raise Refuse("gh with no command")
    g = a[0]
    if g == "api": return check_gh_api(a[1:])
    if g in ("search", "status"): return
    if g not in GH_GROUPS: raise Refuse(f"gh {g} is not a gh command the read-only gate knows")
    sub = next((t for t in a[1:] if not t.startswith("-")), "")
    if sub not in GH_READ_SUBS: raise Refuse(f"gh {g} {sub or '(none)'} is not list, view, status, search, diff or checks")

def check_sql(q):
    s = re.sub(r"--[^\n]*|/\*.*?\*/", " ", q, flags=re.S)
    s = re.sub(r"'(?:[^']|'')*'|\"(?:[^\"]|\"\")*\"|`[^`]*`|\[[^\]]*\]", "''", s)
    stmts = [x for x in s.split(";") if x.strip()]
    if len(stmts) != 1: raise Refuse(f"the D1 command has {len(stmts)} statements (one SELECT or WITH only)")
    if not re.match(r"\s*(select|with)\b", stmts[0], re.I): raise Refuse("the D1 command does not start with SELECT or WITH")
    m = WRITE_SQL.search(stmts[0])
    if m: raise Refuse(f"the D1 command contains {m.group().upper()}")

def check_wrangler(a):
    VALS = {"--config", "-c", "--env", "-e", "--command", "--file", "--binding", "--namespace-id", "--persist-to",
            "--prefix", "--jurisdiction", "--cwd"}
    BOOLS = {"--remote", "--local", "--json", "--yes", "-y", "--preview", "--text", "--pipe"}
    pos, opts, i = [], {}, 0
    while i < len(a):
        t = a[i]
        if t.startswith("-"):
            o, v = (t.split("=", 1) + [None])[:2] if t.startswith("--") else (t, None)
            if o in BOOLS and v is None: i += 1; continue
            if o not in VALS: raise Refuse(f"wrangler {o} is not a flag the read-only gate knows")
            if v is None:
                if i + 1 >= len(a): raise Refuse(f"wrangler {o} has no value")
                v = a[i + 1]; i += 1
            opts.setdefault(o, []).append(v); i += 1; continue
        pos.append(t); i += 1
    p = [x for x in pos]
    if p[:1] == ["kv:key"]: p = ["kv", "key"] + p[1:]
    if p[:2] == ["d1", "execute"] and len(p) == 3:
        if "--file" in opts: raise Refuse("wrangler d1 execute --file runs SQL the gate cannot see")
        cmds = opts.get("--command", [])
        if len(cmds) != 1: raise Refuse("wrangler d1 execute needs exactly one --command")
        return check_sql(cmds[0])
    if p[:3] in (["kv", "key", "get"], ["kv", "key", "list"]) or p[:3] == ["r2", "object", "get"]:
        return
    raise Refuse(f"wrangler {' '.join(p[:3]) or '(nothing)'} is not d1 execute SELECT, kv key get/list or r2 object get")

def check_sed(a):
    scripts, i, have_e = [], 0, False
    while i < len(a):
        t = a[i]
        if t.startswith("--"):
            if t.startswith(("--in-place", "--file")): raise Refuse(f"sed {t.split('=')[0]}")
            if t.startswith("--expression"):
                if "=" in t: scripts.append(t.split("=", 1)[1])
                else: scripts.append(a[i + 1] if i + 1 < len(a) else ""); i += 1
                have_e = True
            i += 1; continue
        if t.startswith("-") and len(t) > 1:
            for k, ch in enumerate(t[1:], 1):
                if ch in "if": raise Refuse(f"sed -{ch} edits a file in place or reads its script from one")
                if ch in "el":
                    rest = t[k + 1:]; v = rest if rest else (a[i + 1] if i + 1 < len(a) else "")
                    if not rest: i += 1
                    if ch == "e": scripts.append(v); have_e = True
                    break
            i += 1; continue
        if not have_e and not scripts: scripts.append(t)
        i += 1
    for sc in scripts:
        s_cmd = re.compile(r"s(.)((?:\\.|(?!\1).)*)\1((?:\\.|(?!\1).)*)\1([^;}\n]*)")
        rest = sc
        for m in s_cmd.finditer(sc):
            if re.search(r"[ewW]", m.group(4)): raise Refuse("sed s///w or s///e writes a file or runs a command")
        rest = s_cmd.sub(";", sc)
        if re.search(r"(^|[;{}\n])\s*(\d+|\$|/(\\.|[^/])*/)?\s*(,\s*(\d+|\$|/(\\.|[^/])*/))?\s*!?\s*[ewW]", rest):
            raise Refuse("sed w/e writes a file or runs a command")

def check_awk(a):
    prog = None; i = 0
    while i < len(a):
        t = a[i]
        if t in ("-f", "--file") or t.startswith("-f"): raise Refuse("awk -f reads its program from a file")
        if t == "-v" or t == "-F": i += 2; continue
        if t.startswith("-"): i += 1; continue
        prog = t; break
    if prog is None: raise Refuse("awk with no program")
    if re.search(r"system|\||@", prog): raise Refuse("awk runs a command (system, | or @load): not read-only")

def check_find(a):
    for t in a:
        if t in ("-exec", "-execdir", "-ok", "-okdir", "-delete", "-fprint", "-fprint0", "-fprintf", "-fls"):
            raise Refuse(f"find {t} runs a command or changes files")

def check_sort_uniq(name, a):
    if name == "sort":
        for t in a:
            if t.startswith("--output") or t.startswith("--compress-program") or (re.match(r"-[^-]", t) and "o" in t):
                raise Refuse("sort -o writes a file")
    else:
        pos = [t for t in a if not t.startswith("-")]
        if len(pos) > 1: raise Refuse("uniq with an output file writes it")

def check_segment(words):
    while words and words[0].text == "!" and not words[0].quoted: words = words[1:]
    if not words: return
    w0 = words[0]
    if not w0.quoted and not w0.exp and re.match(r"[A-Za-z_][A-Za-z0-9_]*\+?=", w0.text):
        raise Refuse(f"it sets a variable ({w0.text.split('=')[0]}=…), which can change what a tool does")
    if w0.exp: raise Refuse("the command's name comes from an expansion")
    name = w0.text
    if not w0.quoted and name in ("if", "then", "else", "elif", "fi", "for", "while", "until", "do", "done", "case", "esac",
                                  "function", "select", "{", "}", "[[", "]]", "time", "coproc"):
        raise Refuse(f"shell '{name}' is not allowed in a check (one plain command, pipes, ; && ||)")
    home = os.path.expanduser("~")
    if name.startswith("~/"): name = home + name[1:]
    if "/" in name:
        base = name.rsplit("/", 1)[1]
        if name.rsplit("/", 1)[0] + "/" in SYSTEM_DIRS: name = base
        elif name == f"{home}/bin/{base}" and base in READ_ONLY_SCRIPTS: name = base
        else: raise Refuse(f"{w0.text} is not a tool or script on the read-only list")
    args = words[1:]; a = [x.text for x in args]
    if name in FILTERS: return
    if name in READ_ONLY_SCRIPTS:
        need = READ_ONLY_SCRIPTS[name]
        if a[:len(need)] != need: raise Refuse(f"{name} is read-only only as '{name} {' '.join(need)} …'")
        return args_safe(name, args)
    args_safe(name, args)
    if name == "npx":
        k = 0
        while k < len(a) and a[k] in ("-y", "--yes"): k += 1
        if k < len(a) and re.fullmatch(r"wrangler(@[\w.^~-]+)?", a[k]): return check_wrangler(a[k + 1:])
        raise Refuse(f"npx {a[k] if k < len(a) else ''} is not wrangler")
    if name == "wrangler": return check_wrangler(a)
    if name == "curl": return check_curl(a)
    if name == "gh": return check_gh(a)
    if name == "sed": return check_sed(a)
    if name in ("awk", "gawk", "mawk", "nawk"): return check_awk(a)
    if name == "find": return check_find(a)
    if name in ("sort", "uniq"): return check_sort_uniq(name, a)
    raise Refuse(f"{name} is not a tool the read-only gate knows (curl GET, gh reads, wrangler reads, text filters)")

def gate(cmd, depth=0):
    if depth > 8: raise Refuse("expansions nested too deep")
    subs = []
    segs = lex(cmd, subs)
    for words, _ in segs:
        try: check_segment(words)
        except Refuse as e:
            raise Refuse(f"`{' '.join(shown(w) for w in words)[:100]}`: {e}")
    for sub in subs: gate(sub, depth + 1)

cmd = sys.argv[1] if len(sys.argv) > 1 else ""
try:
    if not cmd.strip(): raise Refuse("there is no check command")
    gate(cmd)
except Refuse as e:
    print(" ".join(str(e).split())); sys.exit(1)
except Exception as e:   # the gate itself failed: nothing proves the check only reads
    print(f"the read-only gate could not read the command ({type(e).__name__})"); sys.exit(1)
sys.exit(0)
PY
}
