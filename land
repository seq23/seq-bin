else
GREEN="main is green"
# Give GitHub a moment to register main's run before asking. Never on the same-tree path (Fast PRs item 6,
# 23 Nov 2026): CI already green on that code is not waited on again.
sleep 12
# --- pick_run begin (tests/test-land-pick-run.sh evals this block verbatim) ---
# Read from origin/main, not the working tree: the local checkout may be on any branch (step 3).
GATE_WF="$(git show origin/main:.github/workflows/deploy.yml 2>/dev/null | deploy_gates | head -1)"
pick_run() {
  # $1: a jq boolean over one run. Newest matching run of the gate workflow (deploy.yml's); else
  # of the workflow that ran the PR's own checks (PR_WF); else the newest match.
  # The full e2e workflow (E2E_WF, routes block) is never "main's run": production waits for it
  # separately, and the fast check is what a merge is judged on.
  gh run list --branch main --limit 20 --json databaseId,headSha,event,name \
    -q "[.[] | select($1) | select(.name != \"${E2E_WF:-}\")] as \$r | ((\$r | map(select(.name == \"${GATE_WF:-}\")) | .[0]) // (\$r | map(select(.name == \"${PR_WF:-}\")) | .[0]) // \$r[0]) | .databaseId // empty" 2>/dev/null
}
# --- pick_run end ---
# THE RUN FOR THIS MERGE COMMIT, fresh merge or not. 7 Oct 2026 (sprylabs-hpc-site #119): a fresh
# merge took pick_run "true" 12 s after merging, before GitHub had created the merge commit's run,
# and watched a JULY "Validate Repo" run (30281425800) to "failure" - main was red on paper while the
# real run for a8190f1 was still in progress. So the merge sha is read back and its push run is
# waited for (LAND_RUN_APPEAR_SECS, default 180 s); only a repo whose merge starts no run at all
# falls back to the newest run, and says so.
[ -n "${MERGESHA:-}" ] || MERGESHA="$(gh pr view "$PR" --json mergeCommit -q '.mergeCommit.oid // empty' 2>/dev/null || true)"
RID=""
if [ -n "$MERGESHA" ]; then
  APPEAR_DEADLINE=$(( $(date +%s) + ${LAND_RUN_APPEAR_SECS:-180} ))
  while :; do
    RID="$(pick_run ".headSha == \"$MERGESHA\" and .event == \"push\"")"
    [ -n "$RID" ] && break
    [ "$(date +%s)" -ge "$APPEAR_DEADLINE" ] && break
    sleep 10
  done
fi
# A DROPPED PUSH IS RE-RAISED, NEVER WATCHED PAST. 21 Oct 2026, p-n-p #124 (3d4ae11): GitHub merged
# the PR and moved main, but recorded no `pr_merge` in the repository activity log, no PushEvent, no
# webhook — so no push-triggered workflow ran and Cloudflare Pages never built (its deployments list
# has github:push for every merge before and after, and only a hand-triggered ad_hoc build for this
# one). p-n-p's deploy-distribution.yml documents the same on 1c9c6cb6 (17 Sep). The fallback below
# then watched the PREVIOUS commit's run to "success". So when no run for the merge sha appears AND
# the activity log (which answered) has no entry for it, the push was dropped: the PR's own workflow
# is dispatched on main (its run carries the merge sha), and step 5 triggers the Pages build itself.
# --- dropped_push begin (tests/test-land-dropped-push.sh) ---
DROPPED_PUSH=""
if [ -z "$RID" ] && [ -n "$MERGESHA" ]; then
  ACT="$(gh api "repos/{owner}/{repo}/activity?ref=refs/heads/main&per_page=50" --jq '.[].after' 2>/dev/null)" && [ -n "$ACT" ] \
    && ! grep -qx "$MERGESHA" <<<"$ACT" && DROPPED_PUSH=1
  if [ -n "$DROPPED_PUSH" ]; then
    say "     GitHub dropped the push event for ${MERGESHA:0:7}: no activity-log entry and no run after ${LAND_RUN_APPEAR_SECS:-180} s, so nothing push-triggered (Actions or Cloudflare) will run on its own."
    WF_PATH="$( [ -z "$PR_WF" ] || gh api "repos/{owner}/{repo}/actions/workflows?per_page=100" --jq ".workflows[] | select(.name == \"$PR_WF\") | .path" 2>/dev/null | head -1)"
    if [ -n "$WF_PATH" ] && git show "origin/main:$WF_PATH" 2>/dev/null | grep -q '^[[:space:]]*workflow_dispatch:'; then
      gh workflow run "$WF_PATH" --ref main >/dev/null 2>&1 || die "#$PR IS MERGED, GitHub dropped its push event, and dispatching $WF_PATH on main failed. Nothing ran on ${MERGESHA:0:7}; dispatch it by hand: gh workflow run $WF_PATH --ref main"
      echo "     dispatched \"$PR_WF\" ($WF_PATH) on main in its place"
      APPEAR_DEADLINE=$(( $(date +%s) + ${LAND_RUN_APPEAR_SECS:-180} ))
      while :; do
        RID="$(pick_run ".headSha == \"$MERGESHA\" and .event == \"workflow_dispatch\"")"
        [ -n "$RID" ] && break
        [ "$(date +%s)" -ge "$APPEAR_DEADLINE" ] && break
        sleep 10
      done
      [ -n "$RID" ] || die "#$PR IS MERGED, GitHub dropped its push event, and the dispatched $WF_PATH run on ${MERGESHA:0:7} did not appear. Check: gh run list --branch main"
    else
      die "NAMED STOP [PUSH_DROPPED] #$PR IS MERGED, but GitHub dropped the push event for ${MERGESHA:0:7} and the PR's workflow (${PR_WF:-unknown}${WF_PATH:+, $WF_PATH}) has no workflow_dispatch to re-raise it. Nothing ran on the merge commit; main is NOT confirmed green or deployed."
    fi
  fi
fi
# --- dropped_push end ---
if [ -z "$RID" ]; then
  RID="$(pick_run "true")"
  [ -z "$RID" ] || echo "     no run for merge commit ${MERGESHA:0:7} appeared in ${LAND_RUN_APPEAR_SECS:-180} s — watching main's newest run instead"
fi
[ -z "$RID" ] || echo "     watching run $RID${PR_WF:+ (the PR was judged by \"$PR_WF\"${GATE_WF:+; deploy.yml gate \"$GATE_WF\"})}"
if [ -z "$RID" ]; then
  die "could not read main's latest run (API error or rate limit). #$PR IS MERGED. Nothing was deployed. Re-run 'land $PR' when the API answers, or deploy by hand once main is green."
fi
# POLL FOR A TERMINAL CONCLUSION. `gh run watch` is not a reliable block: on 18 Sep it returned
# while the run was still `in_progress`, leaving the conclusion empty, and this script reported
# "could not read whether main is green" on a run that was simply not finished yet. Watching is a
# convenience; the terminal state is the contract, so wait for it explicitly.
#
# A transient API error must not end the wait either — that is the same "silence looks like
# failure" trap one layer down. Read errors are tolerated for a while and only become an answer
# if they persist to the deadline.
# (One read per poll, a minute apart: run_conclusion, above. The `gh run watch` that came first polled
# every 3 s and was dropped, 22 Nov 2026.)
CONC=""
DEADLINE=$(( $(date +%s) + MAIN_WAIT_SECS ))   # 45 min: CI here runs ~14 min, twice over is ample
while :; do
  CONC="$(run_conclusion "$RID")"
  [ -n "$CONC" ] && break
  [ "$(date +%s)" -ge "$DEADLINE" ] && break
  sleep "$POLL_SECS"
done
echo "     ${CONC:+completed }${CONC:-unreadable}"
case "$CONC" in
  success) : ;;
  "")
    die "could not read whether main is green (API error or rate limit). #$PR IS MERGED. Nothing was deployed — this is NOT a failing build, it is an unanswered question. Re-run 'land $PR' when the API answers."
    ;;
  cancelled|skipped)
    # SUPERSEDED ONLY IF SOMETHING SUPERSEDED IT. On 21 Sep 2026 (boss-os #33) the run on main was
    # cancelled with NO later commit behind it — the concurrency group fired on something other
    # than a merge — and this branch declared it superseded, exited 0, and the Deploy workflow
    # skipped: an undeployed main wearing a reassuring sentence. So the claim is checked: if the
    # cancelled run's SHA is still main's head, nothing superseded it, and the run is re-run and
    # watched to its own terminal state instead. Only a run whose commit has been passed by a
    # newer one is superseded.
    RSHA="$(gh run view "$RID" --json headSha -q '.headSha' 2>/dev/null)"
    git fetch -q origin main 2>/dev/null || true
    MSHA="$(git rev-parse origin/main 2>/dev/null)"
    if [ -n "$RSHA" ] && [ "$RSHA" = "$MSHA" ]; then
      say "     cancelled with NO later commit on main — nothing superseded it. Re-running $RID."
      gh run rerun "$RID" >/dev/null 2>&1 || die "could not re-run $RID. #$PR IS MERGED and NOT deployed; main has no green run for $MSHA. Re-run it by hand: gh run rerun $RID"
      sleep 15
      CONC=""; DEADLINE=$(( $(date +%s) + MAIN_WAIT_SECS ))
      while :; do
        CONC="$(run_conclusion "$RID")"
        [ -n "$CONC" ] && [ "$CONC" != "cancelled" ] && break
        [ "$(date +%s)" -ge "$DEADLINE" ] && break
        sleep "$POLL_SECS"
      done
      echo "     re-run: ${CONC:-unreadable}"
      case "$CONC" in
        success) ;;
        "") die "could not read the re-run's conclusion. #$PR IS MERGED and NOT deployed. Check: gh run view $RID" ;;
        *) die "main is $CONC on the re-run after merging #$PR ($(ran_kind "$CONC")). Not deploying. Fix main first." ;;
      esac
    else
    # SUPERSEDED IS NOT BROKEN. `ci.yml` sets concurrency with cancel-in-progress, so merging a
    # second PR while the first one's run is still going cancels the first — by design, because
    # validating a commit nobody will deploy is waste. On 18 Sep this script read that as
    # "main is cancelled after merging #101. Not deploying. Fix main first." Nothing was wrong:
    # #104 had merged thirty seconds later and its run was validating BOTH changes.
    #
    # Nothing is deployed from here, and that is correct — the newer run carries this commit and
    # the Deploy workflow fires on it. Saying so is the whole point; the previous wording sent the
    # operator hunting a failure that did not exist.
    say "     superseded — a later merge cancelled this run and is validating your commit too"
    say "#$PR IS MERGED. Not deploying from here: the newer run on main carries it, and the"
    say "Deploy workflow ships on that run's success. Watch it with:  gh run list --branch main"
    exit 0
    fi
    ;;
  *)
    die "main is $CONC after merging #$PR ($(ran_kind "$CONC")). Not deploying. Fix main first."
    ;;
esac
fi

# A SELF-DEPLOYING REPO IS NOT DEPLOYED UNTIL EVERY ONE OF ITS CLOUDFLARE BUILDS SAYS SO. 25 Sep 2026,
# local-guides-generator #48: main's GitHub workflows went green, this script printed "nothing to
# run", and the base Cloudflare Pages project's production build had failed on the merge commit.
# The Cloudflare app posts one check-run per project ("Cloudflare Pages: <project>", "Workers
# Builds: <worker>") on the commit it builds. 12 Oct 2026, local-guides-generator #61: this printed
# "every Cloudflare build succeeded" with ONE of the repo's five projects reported — Cloudflare posts
# each check-run only when that project's build finishes (already completed, ~30 s apart), so the
# four still queued were simply absent and "nothing pending" read as "all done". So the set of
# projects is now decided BEFORE looking at the merge commit: the route's PAGES_PROJECTS (passed as
# $2) plus every Cloudflare check-run name on the newest earlier main commit whose Cloudflare runs all
# finished (one commit, so a project retired since — the base project, 11 Oct — is not waited on). Each
# expected project must post a completed, successful run on the merge commit; one not yet posted is
# a WAIT, never a success. The deadline is 4x the slowest build on the last 3 such commits (commit -> last
# check-run), floor 600 s, cap 3600 s — a fault detector, never a budget; PAGES_WAIT_SECS overrides.
# Prints one line per project. A repo with nothing expected and nothing posted (the Actions-driven
# loop repos, ~/bin) gets the old sentence (rc 2) once PAGES_APPEAR_SECS passes.
# A PROJECT WITH BUILD WATCH PATHS DOES NOT BUILD EVERY MERGE. 3 Nov 2026, heygetonmylevel #12: the
# merge changed only .github/workflows/search-loop.yml, Pages project heygetonmylevel-learn builds
# only on questions/*, learn-static/*, scripts/learn-build.mjs, so no build ever started and land
# waited on the one it saw on an earlier commit until it STOPPED with main green. So each expected
# Pages project's watch paths (source.config.path_includes/path_excludes, Cloudflare API via
# wrangler's OAuth login) are matched against the merge commit's changed files; a project none of
# them reach AND that posted nothing is "no deploy needed". Anything that does post is judged as
# before (a started-then-failed build is still FAILED). Unreadable paths, files or login: fail
# closed (waited on, as before). rc 3 = every expected project was "no deploy needed".
# --- pages_watch begin (tests/test-land-pages-watch.sh evals this block verbatim) ---
PAGES_RE='^(Cloudflare Pages|Workers Builds)'
pages_history() { # $1 merge sha -> "<secs>\t<n>\t<check-run name>" for up to 3 earlier main commits with Cloudflare runs (n = 1 newest)
  local s d out all used=0
  while IFS=$'\t' read -r s d; do
    [ -n "$s" ] && [ "$s" != "$1" ] || continue
    all="$(gh api "repos/{owner}/{repo}/commits/$s/check-runs?per_page=100" \
      --jq ".check_runs[] | select(.name | test(\"$PAGES_RE\")) | \"\(.completed_at)\t\(.name)\"" 2>/dev/null)"
    [ -n "$all" ] || continue
    # a commit whose builds never all finished (superseded mid-queue) is no evidence of the set
    printf '%s\n' "$all" | grep -q '^null'$'\t' && continue
    used=$((used + 1))
    out="$(gh api "repos/{owner}/{repo}/commits/$s/check-runs?per_page=100" \
      --jq ".check_runs[] | select(.name | test(\"$PAGES_RE\")) | select(.completed_at != null) | \"\((.completed_at | fromdateiso8601) - (\"$d\" | fromdateiso8601))\t$used\t\(.name)\"" 2>/dev/null)"
    printf '%s\n' "$out"
    [ "$used" -ge 3 ] && break
  done < <(gh api "repos/{owner}/{repo}/commits?sha=main&per_page=10" --jq '.[] | "\(.sha)\t\(.commit.committer.date)"' 2>/dev/null)
}
pages_cf_token() { # -> a Cloudflare token that can read Pages (wrangler OAuth, else the Boss OS vault's) | rc 1 none
  local cfg tok n
  wrangler whoami >/dev/null 2>&1 || true
  cfg="$(ls -t "$HOME/.wrangler/config/default.toml" "$HOME/Library/Preferences/.wrangler/config/default.toml" 2>/dev/null | head -1)"
  tok="$( [ -z "$cfg" ] || sed -n 's/^oauth_token = "\(.*\)"$/\1/p' "$cfg")"
  n=""; [ -z "$tok" ] || n="$(curl -sS --max-time 30 -H @<(printf 'Authorization: Bearer %s\n' "$tok") "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/pages/projects?page=1" 2>/dev/null)"
  if ! jq -e '.success == true' >/dev/null 2>&1 <<<"$n"; then
    # -s stays here alone: this reads a VALUE, and npm's banner would land in it. Empty = unreadable.
    tok="$( (cd "$HOME/GitHub/boss-os" 2>/dev/null && npm run -s vault:run -- sh -c 'printf %s "$CLOUDFLARE_API_TOKEN"') 2>/dev/null)"
    [ -n "$tok" ] || return 1
  fi
  printf '%s' "$tok"
}
# GITHUB'S CHECK ROW CAN STICK (23 Nov 2026: keepmyproof #75 and local-guides-citation-velocity #308
# both STOPPED "in_progress — TIMED OUT" while Cloudflare showed the merge commit Active in production
# and the site served it). At the deadline each still-pending "Cloudflare Pages: <project>" is asked of
# Cloudflare itself: a production deployment of this exact commit whose last stage succeeded is a
# success; anything else (unreadable, other commit, failed or still building) stays a TIMED OUT.
pages_cf_live() { # $1 merge sha, $2 project -> 0 Cloudflare shows that commit deployed to production
  local tok n
  tok="$(pages_cf_token)" || return 1
  n="$(curl -sS --max-time 30 -H @<(printf 'Authorization: Bearer %s\n' "$tok") "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/pages/projects/$2/deployments?env=production&per_page=10" 2>/dev/null)" || return 1
  jq -e --arg s "$1" '.success == true and any(.result[]?; .deployment_trigger.metadata.commit_hash == $s and .latest_stage.name == "deploy" and .latest_stage.status == "success")' >/dev/null 2>&1 <<<"$n"
}
pages_cf_sources() { # -> one JSON array [{name,inc,exc}] of the Pages projects building this repo's main from Git | rc 1 unreadable
  local tok slug rid page=1 total=1 n all="[]"
  slug="$(gh api "repos/{owner}/{repo}" --jq .full_name 2>/dev/null)"; [ -n "$slug" ] || return 1
  # Cloudflare keeps the repo name from when the project was connected (authority-backlink-network
  # was "authority-network" there, so it matched nothing); the numeric repo id survives a rename.
  rid="$(gh api "repos/{owner}/{repo}" --jq .id 2>/dev/null)"
  # A dead wrangler OAuth login (8 Nov 2026: "Failed to fetch auth token: 400") made every repo's
  # watch paths unreadable, so a paused or idle project was waited for until TIMED OUT. The Boss OS
  # vault's Cloudflare token reads the same Pages list; it is held in a variable, never printed.
  tok="$(pages_cf_token)" || return 1
  while [ "$page" -le "$total" ]; do
    n="$(curl -sS --max-time 30 -H @<(printf 'Authorization: Bearer %s\n' "$tok") "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/pages/projects?page=$page")" || return 1
    jq -e '.success == true' >/dev/null 2>&1 <<<"$n" || return 1
    total="$(jq -r '.result_info.total_pages // 1' <<<"$n")"
    all="$(jq -c --arg s "$slug" --arg rid "${rid:-}" --argjson a "$all" '$a + [.result[]? | select(.source.type == "github" and ("\(.source.config.owner)/\(.source.config.repo_name)" == $s or ($rid != "" and "\(.source.config.repo_id)" == $rid)) and .source.config.production_branch == "main") | {name, inc: (.source.config.path_includes // ["*"]), exc: (.source.config.path_excludes // []), paused: (.source.config.production_deployments_enabled == false)}]' <<<"$n")" || return 1
    page=$((page + 1))
  done
  printf '%s\n' "$all"
}
pages_idle() { # $1 merge sha -> check-run names of Pages projects whose watch paths no changed file reaches, or whose Git production builds are paused (empty = none known idle)
  local files nf src
  files="$(gh api "repos/{owner}/{repo}/commits/$1" --jq '.files[].filename' 2>/dev/null)" || return 0
  nf="$(printf '%s\n' "$files" | grep -c . || true)"
  { [ "$nf" -gt 0 ] && [ "$nf" -lt 300 ]; } || return 0   # none read, or GitHub's 300-file page cap: unknown
  src="$(pages_cf_sources)" || return 0
  jq -r --arg f "$files" '
    def g2r: "^" + (gsub("(?<c>[.+?^${}()|\\[\\]\\\\])"; "\\\(.c)") | gsub("\\*"; ".*")) + "$";
    ($f | split("\n") | map(select(. != ""))) as $files | length as $np
    | .[] | select(.paused or (. as $p | [$files[] | . as $x | select(any($p.inc[]; g2r as $r | $x | test($r)) and (any($p.exc[]?; g2r as $r | $x | test($r)) | not))] | length == 0))
    | "Cloudflare Pages: \(.name)", (if $np == 1 then "Cloudflare Pages" else empty end)' <<<"$src" 2>/dev/null
}
pages_watch() { # $1 merge sha, $2 PAGES_PROJECTS -> 0 every expected build succeeded | 1 failed/timed out | 2 none expected, none posted | 3 none needed (watch paths)
  local sha="$1" hist expected p rows name st co line bad pending slow wait idle idled total
  hist="$(pages_history "$sha")"
  expected="$( { for p in ${2:-}; do echo "Cloudflare Pages: $p"; done; [ -z "$hist" ] || printf '%s\n' "$hist" | awk -F'\t' '$2 == 1 {print $3}'; } | sort -u | sed '/^$/d')"
  slow="$( [ -z "$hist" ] || printf '%s\n' "$hist" | cut -f1 | sort -n | tail -1)"; slow="${slow%%.*}"
  wait=$(( ${slow:-0} * 4 )); [ "$wait" -lt 600 ] && wait=600; [ "$wait" -gt 3600 ] && wait=3600
  local appear_by=$((SECONDS + ${PAGES_APPEAR_SECS:-180})) deadline=$((SECONDS + ${PAGES_WAIT_SECS:-$wait}))
  idle="$( [ -z "$expected" ] || pages_idle "$sha")"
  while :; do
    rows="$(gh api "repos/{owner}/{repo}/commits/$sha/check-runs?per_page=100" \
      --jq ".check_runs[] | select(.name | test(\"$PAGES_RE\")) | \"\(.status)\t\(.conclusion)\t\(.name)\"" 2>/dev/null)"
    if [ -z "$expected" ] && [ -z "$rows" ]; then
      [ "$SECONDS" -ge "$appear_by" ] && return 2
    else
      # every project that should build, plus any that posted without being expected
      expected="$( { printf '%s\n' "$expected"; [ -z "$rows" ] || printf '%s\n' "$rows" | cut -f3-; } | sed '/^$/d' | sort -u)"
      pending=0; bad=0; idled=0; total=0; line=""
      while IFS= read -r name; do
        total=$((total + 1))
        st="$(printf '%s\n' "$rows" | awk -F'\t' -v n="$name" '$3 == n {print $1 "\t" $2; exit}')"
        co="${st#*$'\t'}"; st="${st%%$'\t'*}"
        if [ -z "$st" ] && grep -qxF -- "$name" <<<"$idle"; then idled=$((idled + 1)); line+="     $name — no deploy needed (no file changed in ${sha:0:7} is in its build watch paths, or its Git production builds are paused)"$'\n'
        elif [ -z "$st" ]; then pending=$((pending + 1)); line+="     $name — not yet reported (queued)"$'\n'
        elif [ "$st" != completed ]; then pending=$((pending + 1)); line+="     $name — $st"$'\n'
        elif [ "$co" = success ] || [ "$co" = skipped ] || [ "$co" = neutral ]; then line+="     $name — $co"$'\n'
        else bad=$((bad + 1)); line+="     $name — FAILED ($co)"$'\n'
        fi
      done <<<"$expected"
      if [ "$pending" -gt 0 ] && [ "$bad" = 0 ] && [ "$SECONDS" -ge "$deadline" ]; then
        while IFS= read -r name; do
          case "$line" in *"     $name — "*) ;; *) continue ;; esac
          printf '%s\n' "$line" | grep -qxE -- "     $(printf '%s' "$name" | sed 's/[][\.*^$/]/\\&/g') — (not yet reported \(queued\)|queued|in_progress|pending|waiting|requested)" || continue
          case "$name" in "Cloudflare Pages: "*) ;; *) continue ;; esac
          pages_cf_live "$sha" "${name#Cloudflare Pages: }" || continue
          line="$(printf '%s' "$line" | awk -v n="     $name — " 'index($0, n) == 1 {print n "success (Cloudflare shows this commit live in production; GitHub'"'"'s check row is stuck)"; next} {print}')"$'\n'
          pending=$((pending - 1))
        done <<<"$expected"
      fi
      if [ "$pending" = 0 ] || [ "$bad" -gt 0 ] || [ "$SECONDS" -ge "$deadline" ]; then
        if [ "$pending" -gt 0 ] && [ "$bad" = 0 ]; then
          line="$(printf '%s' "$line" | sed -E "/ — (not yet reported \(queued\)|queued|in_progress|pending|waiting|requested)\$/s/\$/ — TIMED OUT at the ${PAGES_WAIT_SECS:-$wait}s deadline/")"$'\n'
        fi
        printf '%s' "$line"
        [ "$pending" = 0 ] && [ "$bad" = 0 ] && { [ "$idled" = "$total" ] && return 3; return 0; }
        return 1
      fi
    fi
    sleep 15
  done
}
# --- pages_watch end ---

# A DROPPED PUSH ALSO MEANS CLOUDFLARE NEVER HEARD OF THE MERGE (dropped_push above): Pages' Git
# integration builds on GitHub's push webhook, so nothing would ever post a check-run and pages_watch
# would time out on a build that was never queued. So every Pages project that builds THIS repo from
# Git is asked for a production build of main through the Pages API (deployment_trigger "ad_hoc"),
# which builds main's head and posts the same check-run pages_watch then confirms. Auth is wrangler's
# own OAuth login (refreshed by `wrangler whoami`); the token goes to curl on a file descriptor, never
# on a command line.
# --- pages_kick begin (tests/test-land-dropped-push.sh) ---
pages_kick() { # -> 0 at least one build triggered | 1 none (named on stdout)
  local cfg tok slug page=1 total=1 names n ok=0
  wrangler whoami >/dev/null 2>&1 || true
  cfg="$(ls -t "$HOME/.wrangler/config/default.toml" "$HOME/Library/Preferences/.wrangler/config/default.toml" 2>/dev/null | head -1)"
  tok="$( [ -z "$cfg" ] || sed -n 's/^oauth_token = "\(.*\)"$/\1/p' "$cfg")"
  [ -n "$tok" ] || { echo "     no wrangler OAuth login to trigger the Pages build with (run: wrangler login)"; return 1; }
  slug="$(gh repo view --json owner,name -q '"\(.owner.login)/\(.name)"' 2>/dev/null)"
  [ -n "$slug" ] || { echo "     could not read this repo's owner/name"; return 1; }
  cf() { curl -sS --max-time 30 -H @<(printf 'Authorization: Bearer %s\n' "$tok") "$@"; }
  names=""
  while [ "$page" -le "$total" ]; do
    n="$(cf "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/pages/projects?page=$page")" || break
    total="$(jq -r '.result_info.total_pages // 1' <<<"$n" 2>/dev/null)"; [ -n "$total" ] || total=1
    names+="$(jq -r --arg s "$slug" '.result[]? | select(.source.type == "github" and "\(.source.config.owner)/\(.source.config.repo_name)" == $s and .source.config.production_branch == "main" and .source.config.production_deployments_enabled != false) | .name' <<<"$n" 2>/dev/null)"$'\n'
    page=$((page + 1))
  done
  names="$(sed '/^$/d' <<<"$names" | sort -u)"
  [ -n "$names" ] || { echo "     no Cloudflare Pages project builds $slug from Git — nothing to trigger"; return 1; }
  while IFS= read -r n; do
    if cf -X POST -F branch=main "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/pages/projects/$n/deployments" | jq -e '.success' >/dev/null 2>&1; then
      echo "     triggered a Cloudflare Pages production build of main: $n"; ok=1
    else echo "     Cloudflare refused the Pages build trigger for $n"; fi
  done <<<"$names"
  [ "$ok" = 1 ]
}
# --- pages_kick end ---

# ~/bin IS PRODUCTION: launchd runs its working copy, so here — and only here — the local checkout
# must move. Her uncommitted work in it is never touched: the fast-forward runs only on main and only
# when no file she has changed is one the incoming commits change (git refuses to clobber either way).
# The launchd copy is the repo's MAIN checkout (the folder holding the shared .git), never the
# worktree land runs from (20 Nov 2026: land from ~/GitHub/.wt-* said "STOPPED: ... is on <branch>,
# not main, so launchd still runs the old scripts" after a good merge — it judged the worktree).
# --- launchd begin (tests/test-land-launchd-copy.sh) ---
if [ -z "$DEPLOY" ] && { [ "$NAME" = bin ] || [ "$NAME" = seq-bin ]; }; then
  LIVE_DIR="$(git rev-parse --path-format=absolute --git-common-dir | sed 's#/\.git$##')"
  say "5/5  $NAME $SELF"
  if [ "$(git -C "$LIVE_DIR" rev-parse HEAD)" = "$(git rev-parse origin/main)" ]; then
    say "LANDED — #$PR is merged, $GREEN, and $LIVE_DIR is already at $(git -C "$LIVE_DIR" log --oneline -1)."
    exit 0
  fi
EXPECT="$LIVE_DIR (what launchd runs) to fast-forward to main with #$PR"; LOOK="git -C $LIVE_DIR status; git -C $LIVE_DIR log --oneline -3"
  LIVE_CUR="$(git -C "$LIVE_DIR" symbolic-ref -q --short HEAD)"
  [ "$LIVE_CUR" = main ] || die "#$PR IS MERGED and $GREEN, but $LIVE_DIR is on ${LIVE_CUR:-a detached HEAD}, not main, so launchd still runs the old scripts. Switch it back: git -C $LIVE_DIR checkout main && git -C $LIVE_DIR merge --ff-only origin/main"
  LIVE_DIRTY="$(git -C "$LIVE_DIR" status --porcelain --untracked-files=no)"
  OVERLAP="$(comm -12 <(cut -c4- <<<"$LIVE_DIRTY" | sed '/^$/d' | sort -u) <(git -C "$LIVE_DIR" diff --name-only HEAD origin/main | sort -u))"
  [ -z "$OVERLAP" ] || die "#$PR IS MERGED and $GREEN, but the merge changes file(s) with uncommitted local edits in $LIVE_DIR ($(echo "$OVERLAP" | paste -sd, -)), so it was NOT fast-forwarded and launchd still runs the old scripts. Nothing of hers was touched."
  git -C "$LIVE_DIR" merge -q --ff-only origin/main || die "#$PR IS MERGED and $GREEN, but $LIVE_DIR could not fast-forward to origin/main (local commits?), so launchd still runs the old scripts."
  say "LANDED — #$PR is merged, $GREEN, and $LIVE_DIR is at $(git -C "$LIVE_DIR" log --oneline -1) (her $(grep -c . <<<"$LIVE_DIRTY") uncommitted change(s) untouched)."
  exit 0
fi
# --- launchd end ---

if [ -z "$DEPLOY" ]; then
  say "5/5  $NAME $SELF — confirming the Cloudflare build(s) on the merge commit"
EXPECT="every Cloudflare build on #$PR's merge commit to succeed"; LOOK="the Cloudflare check runs on the merge commit: gh pr view $PR --json mergeCommit; gh api repos/{owner}/{repo}/commits/<merge sha>/check-runs"
  MSHA_PAGES="${MERGESHA:-$(gh pr view "$PR" --json mergeCommit -q '.mergeCommit.oid' 2>/dev/null)}"
  [ -n "$MSHA_PAGES" ] || die "#$PR IS MERGED and $GREEN, but its merge commit could not be read, so the Cloudflare build was not confirmed. Check the check-runs on main."
  d1_postmerge "$MSHA_PAGES" || die "NAMED STOP [D1_MIGRATIONS_PENDING] D1 migrations unconfirmed on ${MSHA_PAGES:0:7}: ${DEPLOY_WHY:-see the output above}. #$PR IS MERGED and $NAME is deploying it against D1 $D1_PREMERGE. The live site may be failing. Apply them now from the repo: npx wrangler d1 migrations apply $D1_PREMERGE --remote"
  [ -z "${DROPPED_PUSH:-}" ] || pages_kick || say "     the Pages build could not be triggered (above); pages_watch will report it unconfirmed"
  PW_OUT="$(pages_watch "$MSHA_PAGES" "$PAGES_PROJECTS")"; PW=$?
  [ -z "$PW_OUT" ] || printf '%s\n' "$PW_OUT"
  PW_N="$(printf '%s\n' "$PW_OUT" | grep -c ' — ')"
  # A route with PROMOTE_VIA is only STAGED by that build: production moves through the repo's own
  # workflow, and the plan below decides when (small: now, on the fast check; large: after a green
  # suite). Every other self-deploying repo is done here, as before.
  case "$PW" in
    0) if [ -n "$PROMOTE_VIA" ]; then echo "     staging: all $PW_N Cloudflare builds on ${MSHA_PAGES:0:7} succeeded"
       elif [ -n "$DEPLOY_WF" ]; then echo "     all $PW_N Cloudflare builds on ${MSHA_PAGES:0:7} succeeded (upload only — production moves through $DEPLOY_WF)"
       else say "LANDED — #$PR is merged, $GREEN, and all $PW_N Cloudflare builds on ${MSHA_PAGES:0:7} succeeded (each listed above)."; fi ;;
    2) if [ -n "$PROMOTE_VIA" ]; then echo "     no Cloudflare check-run on ${MSHA_PAGES:0:7}; staging is published by the repo's own workflow on push"
       elif [ -n "$DEPLOY_WF" ]; then echo "     no Cloudflare check-run on ${MSHA_PAGES:0:7}; production moves through $DEPLOY_WF"
       else say "     no Cloudflare check-run on ${MSHA_PAGES:0:7}; $NAME $SELF — nothing to run"; fi ;;
    3) if [ -n "$PROMOTE_VIA" ]; then echo "     staging: no deploy needed — no file changed in ${MSHA_PAGES:0:7} is in any Cloudflare project's build watch paths"
       elif [ -n "$DEPLOY_WF" ]; then echo "     no Cloudflare build needed on ${MSHA_PAGES:0:7} (build watch paths); production moves through $DEPLOY_WF"
       else say "LANDED — #$PR is merged, $GREEN; no deploy needed: no file changed in ${MSHA_PAGES:0:7} is in any Cloudflare project's build watch paths (listed above)."; fi ;;
    *) die "#$PR IS MERGED and $GREEN, but not every Cloudflare build on ${MSHA_PAGES:0:7} succeeded — the project(s) listed above were NOT confirmed updated: $(echo "$PW_OUT" | grep -E 'FAILED|TIMED OUT|not yet reported' | sed 's/^ *//' | paste -sd';' -). Fix main now." ;;
  esac
  # A DEPLOY_WF route is not deployed by that build either: production moves only when the repo's
  # own deploy workflow finishes on the merge commit, so it falls through to the wait below.
  { [ -n "$PROMOTE_VIA" ] && [ -n "$E2E_WF" ]; } || [ -n "$DEPLOY_WF" ] || exit 0
  if [ -n "$DEPLOY_WF" ] && ! git cat-file -e "origin/main:.github/workflows/$DEPLOY_WF" 2>/dev/null; then
    die "NAMED STOP [DEPLOY_WF_MISSING] #$PR IS MERGED and $GREEN, but $NAME's route ships production through .github/workflows/$DEPLOY_WF and origin/main carries no such file, so production was NOT confirmed. Fix the route in ~/bin/land (or restore the workflow)."
  fi
fi

# DO NOT RACE THE WORKFLOW. Since `deploy.yml` landed, a green `main` deploys itself, and this
# script deploying too means two `wrangler d1 migrations apply` runs against the same database at
# once. On 18 Sep they collided four seconds apart: the workflow started at 16:54:25, this script's
# deploy failed at 16:54:29 with a 7403 that reads like a revoked token and was nothing of the kind.
# The workflow's `concurrency` group serialises workflow runs; it cannot see a laptop.
#
# So where the repo deploys itself, this script WAITS and reports rather than competing. It still
# has a job: confirming the deploy actually happened. An automation nobody checks is how "merged"
# and "shipped" came apart in the first place.
# A ROUTE WITH E2E_WF IS NOT DEPLOYED BY GREEN MAIN. Since 26 Sep 2026 boss-os's deploy.yml fires on
# the nightly e2e workflow, not on CI: after a merge there is no Deploy run to wait for, and the
# newest "Deploy" on the list would be an OLDER commit's — "LANDED, the Deploy workflow shipped it"
# about a deploy that never happened. Those routes fall through to the plan below.
# Read from origin/main, not the working tree: the local checkout may be on any branch (step 3).
# The run is found BY THE MERGE COMMIT (deploy_wf_pick), never "the newest run named Deploy": that
# was an older commit's run whenever this one had not appeared yet, and a workflow named anything
# else ("Deploy Cloudflare Worker") was never found at all.
# --- deploy_wf begin (tests/test-land-routes.sh evals this block verbatim) ---
# deploy_wf_pick SHA < rows "id<TAB>headSha<TAB>status<TAB>conclusion", newest first -> the newest
# run whose headSha CONTAINS sha (it, or a later main commit — a concurrency group that cancels an
# older run in progress ships the newer one, which carries this merge), skipping runs that were
# skipped (the job's `if` refused that trigger) or cancelled (superseded). Prints
# "id<TAB>status<TAB>conclusion", or nothing when no such run exists yet. contains_sha is
# overridable (tests); here it asks git.
contains_sha() { [ "$1" = "$2" ] || git merge-base --is-ancestor "$1" "$2" 2>/dev/null; } # $1 sha  $2 later?
deploy_wf_pick() {
  local sha="$1" rid head st conc
  while IFS=$'\t' read -r rid head st conc || [ -n "$rid" ]; do
    [ -n "$rid" ] || continue
    case "$conc" in skipped|cancelled) continue ;; esac
    contains_sha "$sha" "$head" || continue
    printf '%s\t%s\t%s\n' "$rid" "$st" "$conc"; return 0
  done
  return 0
}
# --- deploy_wf end ---
# --- gate_wait begin (tests/test-land-gate-wait.sh evals this block verbatim) ---
# A DEPLOY THAT FIRES ON CI IS NOT LOOKED FOR UNTIL CI HAS FINISHED (22 Nov 2026, west-peek-os #584):
# the same-tree path shipped on the PR's run without waiting for main's, so land printed "#584 IS
# MERGED and main is green" and, 5 min later, NAMED STOP [DEPLOY_RUN_NOT_FOUND] — while CI on 4d69588
# was still queued on runners, and deploy.yml runs only on CI's workflow_run. Where the deploy workflow
# fires on workflow_run (and not on push), land first waits, as long as main's own check wait
# (MAIN_WAIT_SECS), for the gate's run that carries the merge, and only then starts the deploy run's
# appear window. Every outcome is distinct: success goes on (and only now is main called green); a red
# or cancelled run refuses; an unread list is "could not verify" (exit 75); a run still going at the
# bound is a NAMED STOP with exit 75 and is never cancelled.
deploy_fires_on_push() { grep -qE '^on:[[:space:]]*(push|\[[^]]*push)|^[[:space:]]{1,4}push:' ; } # deploy workflow text on stdin
gate_wait() { # $1 merge sha  $2 gate workflow names, one per line -> 0 once a run carrying $1 finished success
  local sha="$1" gj rows pick rid st conc said="" seen deadline=$(( $(date +%s) + MAIN_WAIT_SECS ))
  gj="$(printf '%s\n' "$2" | jq -Rsc 'split("\n") | map(select(length > 0))')"
  while :; do
    rows="$(UNREADABLE_STOP=MAIN_CI_UNREADABLE UNREADABLE_WHY="whether main's CI passed on ${sha:0:7} is unknown, so $DEPLOY_WF's run was not looked for" \
            queue_gh run list --branch main --limit 30 --json databaseId,headSha,status,conclusion,name \
            -q ".[] | select(.name as \$n | $gj | any(.[]; . == \$n)) | \"\(.databaseId)\t\(.headSha)\t\(.status)\t\(.conclusion // \"\")\"")" || {
      printf '\n\033[31mSTOPPED: could not verify — main'"'"'s CI on %s could not be read. #%s IS MERGED; main is NOT confirmed green and production is NOT confirmed. Land again when GitHub answers: land %s\033[0m\n' "${sha:0:7}" "$PR" "$PR"
      unanswered_parts "GitHub (main's CI)"; exit "$LAND_RC_UNVERIFIED"; }
    pick="$(deploy_wf_pick "$sha" <<<"$rows")"
    if [ -n "$pick" ]; then
      IFS=$'\t' read -r rid st conc <<<"$pick"
      if [ "$st" = completed ]; then
        [ "$conc" = success ] || die "#$PR IS MERGED, but main's CI run $rid on ${sha:0:7} finished $conc ($(ran_kind "$conc")), so $DEPLOY_WF will not ship it. Main is NOT green; production NOT updated. Read that run: gh run view $rid --log-failed"
        echo "     main's CI run $rid carrying ${sha:0:7}: completed success"
        return 0
      fi
      [ -n "$said" ] || echo "     main's CI run $rid on ${sha:0:7} is $st — $DEPLOY_WF fires only when it finishes, so waiting for it first (up to $((MAIN_WAIT_SECS / 60)) min)"
      said=1
    else
      seen="$(awk -F'\t' -v s="$sha" '$2 == s && $3 == "completed" {print $1 " " $4}' <<<"$rows" | head -1)"
      if [ -n "$seen" ] && [ "$(git rev-parse origin/main 2>/dev/null)" = "$sha" ]; then
        die "NAMED STOP [MAIN_CI_CANCELLED] #$PR IS MERGED, but main's CI run ${seen% *} on ${sha:0:7} ended ${seen#* } with no later commit to carry it, so $DEPLOY_WF will not fire. Main is NOT confirmed green; production NOT updated. Re-run it: gh run rerun ${seen% *}"
      fi
    fi
    if [ "$(date +%s)" -ge "$deadline" ]; then
      if [ -n "$said" ]; then
        printf '\n\033[31mSTOPPED: could not verify — NAMED STOP [MAIN_CI_UNFINISHED] #%s IS MERGED, but main'"'"'s CI run %s on %s was still %s after %s min (left running, not cancelled), so %s has not fired. Main is NOT confirmed green; production NOT confirmed. Land again once it finishes: land %s\033[0m\n' "$PR" "$rid" "${sha:0:7}" "$st" "$((MAIN_WAIT_SECS / 60))" "$DEPLOY_WF" "$PR"
        unanswered_parts "main's CI run (still running)"; exit "$LAND_RC_UNVERIFIED"
      fi
      die "NAMED STOP [MAIN_CI_NOT_FOUND] #$PR IS MERGED, but no run of $(printf '%s' "$2" | paste -sd/ -) carrying ${sha:0:7} appeared on main in $((MAIN_WAIT_SECS / 60)) min, so $DEPLOY_WF has nothing to fire on. Main is NOT confirmed green; production NOT confirmed: gh run list --branch main"
    fi
    sleep "$POLL_SECS"; git fetch -q origin main 2>/dev/null || true
  done
}
# --- gate_wait end ---
DEPLOY_WF="${DEPLOY_WF:-deploy.yml}"
# --- deploy_wait begin (tests/test-land-gate-wait.sh evals this block verbatim) ---
if git cat-file -e "origin/main:.github/workflows/$DEPLOY_WF" 2>/dev/null && [ -z "$E2E_WF" ]; then
  say "5/5  $NAME deploys itself through $DEPLOY_WF — waiting for its run on the merge commit rather than racing it"
EXPECT="$DEPLOY_WF to run on #$PR's merge commit and finish green, so production carries it"; LOOK=""
  DMSHA="${MERGESHA:-$(gh pr view "$PR" --json mergeCommit -q '.mergeCommit.oid' 2>/dev/null)}"
  [ -n "$DMSHA" ] || die "#$PR IS MERGED and $GREEN, but its merge commit could not be read, so the $DEPLOY_WF run was not found. Production NOT confirmed: gh run list --workflow $DEPLOY_WF"
  git fetch -q origin main 2>/dev/null || true
  DTEXT="$(git show "origin/main:.github/workflows/$DEPLOY_WF" 2>/dev/null)"
  DGATES="$(deploy_gates <<<"$DTEXT")"
  if [ -n "$DGATES" ] && ! deploy_fires_on_push <<<"$DTEXT"; then gate_wait "$DMSHA" "$DGATES"; GREEN="main is green"; fi
  DCEIL=$(( $(last_duration "$DEPLOY_WF") * 3 / 2 )); [ "$DCEIL" -ge "${LAND_WAIT_FLOOR_SECS:-360}" ] || DCEIL=${LAND_WAIT_FLOOR_SECS:-360}
  DAPPEAR=$((SECONDS + ${LAND_DEPLOY_APPEAR_SECS:-300})); DSEEN=""
  while :; do
    DROWS="$(gh run list --workflow "$DEPLOY_WF" --limit 20 --json databaseId,headSha,status,conclusion \
              -q '.[] | "\(.databaseId)\t\(.headSha)\t\(.status)\t\(.conclusion // "")"' 2>/dev/null)"
    DPICK="$(deploy_wf_pick "$DMSHA" <<<"$DROWS")"
    if [ -z "$DPICK" ]; then
      DSEEN="$(awk -F'\t' -v s="$DMSHA" '$2 == s {print $1 " " $4}' <<<"$DROWS" | paste -sd, -)"
      [ "$SECONDS" -lt "$DAPPEAR" ] || die "NAMED STOP [DEPLOY_RUN_NOT_FOUND] #$PR IS MERGED and $GREEN, but no $DEPLOY_WF run that ships ${DMSHA:0:7} appeared in $(( ${LAND_DEPLOY_APPEAR_SECS:-300} / 60 )) min${DSEEN:+ (only skipped/cancelled: $DSEEN)}. Production NOT confirmed: gh run list --workflow $DEPLOY_WF"
      sleep 15; git fetch -q origin main 2>/dev/null || true; continue
    fi
    IFS=$'\t' read -r DRID DST DCONC <<<"$DPICK"
    if [ "$DST" != completed ]; then
      echo "     $DEPLOY_WF run $DRID ($DST) — waiting (ceiling $((DCEIL / 60)) min, 1.5x its last completed run)"
      DCONC="$(wait_run_bounded "$DRID" "$DCEIL")" || true
      [ "$DCONC" != cancelled-at-ceiling ] || die "NAMED STOP [DEPLOY_RUN_PAST_CEILING] #$PR IS MERGED, but $DEPLOY_WF run $DRID ran past $((DCEIL / 60)) min and was cancelled. Production NOT confirmed: gh run view $DRID"
      # Superseded while we waited (concurrency cancel-in-progress): the newer run carries this merge.
      [ "$DCONC" != cancelled ] || { echo "     run $DRID was cancelled (superseded) — looking for the run that carries ${DMSHA:0:7}"; DAPPEAR=$((SECONDS + ${LAND_DEPLOY_APPEAR_SECS:-300})); continue; }
    fi
    break
  done
  case "$DCONC" in
    success) if [ -n "$SMOKE" ]; then smoke_check "$SMOKE" || die "#$PR IS MERGED and $DEPLOY_WF run $DRID finished green, but the production smoke check failed. Read that run: gh run view $DRID"; fi
             say "LANDED — #$PR is merged, $GREEN, and $DEPLOY_WF run $DRID shipped ${DMSHA:0:7} to production."; exit 0 ;;
    ""|unreadable) die "#$PR IS MERGED and $GREEN, but $DEPLOY_WF run $DRID's outcome could not be read. Check it before assuming production changed: gh run view $DRID" ;;
    *)       die "#$PR IS MERGED and $GREEN, but $DEPLOY_WF run $DRID finished $DCONC ($(ran_kind "$DCONC")). Production was NOT updated (or not proven). Read that run: gh run view $DRID --log-failed" ;;
  esac
fi
# --- deploy_wait end ---

if [ -z "$E2E_WF" ] && [ -z "$STAGING" ]; then
  say "5/5  deploying"
  # Never a bare `wrangler deploy`: it ships a stale client and the LOCAL DEV
  # bindings. On 17 Sep it tried to push WP_OS_ENV "local" and a dev passcode to
  # production and failed only because of an unrelated error.
  # FROM origin/main, NEVER FROM HER CHECKOUT. Step 3 no longer switches or pulls her tree, so the
  # deploy runs through deploy_at: a throwaway detached worktree of the commit main just went green
  # on, removed afterwards.
EXPECT="the deploy from main to finish and production to carry #$PR"; LOOK="the deploy output above"
  DSHA="$(git rev-parse origin/main 2>/dev/null)"
  [ -n "$DSHA" ] || die "#$PR IS MERGED and $GREEN, but origin/main could not be read here, so nothing was deployed. Re-run 'land $PR'."
  deploy_at "$DSHA" "$DEPLOY" || die "the deploy from ${DSHA:0:7} failed: $DEPLOY_WHY. #$PR IS MERGED and $GREEN (a 7403 is a missing CLOUDFLARE_ACCOUNT_ID, not permissions)."
  say "LANDED — #$PR is merged, $GREEN, and it is in production."
  exit 0
fi

# STAGING NOW; PRODUCTION AS THE PLAN DECIDES (routes with STAGING / E2E_WF / PROMOTE_VIA; header).
EXPECT="staging, then production as the plan decides, to carry #$PR"; LOOK=""
MSHA="${MERGESHA:-$(gh pr view "$PR" --json mergeCommit -q '.mergeCommit.oid' 2>/dev/null)}"
[ -n "$MSHA" ] || die "#$PR IS MERGED and $GREEN, but its merge commit could not be read, so nothing was deployed. Re-run 'land $PR'."
E2E_CONC=""; REASON=""; LAST=""; PROD_STATE=""; SMALL_NOTE=""
if [ -n "$E2E_WF" ]; then
  E2E_CONC="$(e2e_verdict "$MSHA")"
  PROD_STATE="$(production_state)"
  # NEVER BACKWARDS, NEVER TWICE. Landing an already-merged PR again (a retry, or shipping what an
  # older land left on staging) must not roll production back to an older commit, nor deploy the
  # sha it already runs a second time.
  case "$PROD_STATE" in unrecorded|unreadable) : ;; *)
    if [ "$PROD_STATE" = "$MSHA" ] || git merge-base --is-ancestor "$MSHA" "$PROD_STATE" 2>/dev/null; then
      say "5/5  LANDED — #$PR is merged, $GREEN, and production already runs ${PROD_STATE:0:7}$([ "$PROD_STATE" = "$MSHA" ] || echo ", which contains ${MSHA:0:7}") (GitHub Deployment record). Nothing to deploy."
      exit 0
    fi ;;
  esac
  if [ "$E2E_CONC" != success ]; then
    # Measured, never guessed: this PR, then every other change production has not seen.
    pr_size "$PR"
    if [ -n "$RUN_E2E" ]; then REASON="--run-e2e given"
    else
      REASON="$(pr_large_reason)" || REASON=""
      [ -n "$REASON" ] || REASON="$(unshipped_large_reason "$PROD_STATE" "$MSHA")" || REASON=""
    fi
    if [ -z "$REASON" ]; then
      LAST="$(e2e_last_verdict)"
      SMALL_NOTE="small change: $((PR_ADD + PR_DEL)) lines, $PR_FILES files; shipped on the fast check, e2e on demand"
    fi
  fi
fi
PLAN="$(land_plan "${DEPLOY:-$PROMOTE_VIA}" "$STAGING" "$E2E_WF" "$E2E_CONC" "$REASON" "${LAST%%$'\t'*}")"
say "5/5  ${MSHA:0:7}: $PLAN${E2E_WF:+ ($E2E_WF on this sha: ${E2E_CONC:-no completed run})}"
ship_production() { # $1 sha  $2 deployment note
  say "     production <- ${1:0:7}"
  if [ -n "$PROMOTE_VIA" ]; then
    promote_dispatch "$1" "$2" || die "#$PR IS MERGED and $GREEN, but $NAME's own $PROMOTE_VIA did not ship ${1:0:7} — production untouched. Read that run: gh run list --workflow $PROMOTE_VIA"
    if [ -n "$SMOKE" ]; then smoke_check "$SMOKE" || die "#$PR deployed to production from ${1:0:7} but the smoke check failed; read the $PROMOTE_VIA run."; fi
    [ "$(production_sha)" = "$1" ] || die "#$PR IS MERGED and $PROMOTE_VIA ran green for ${1:0:7}, but production's GitHub Deployment record does not name it. Read that run before assuming production moved."
    echo "     recorded by $PROMOTE_VIA: production = ${1:0:7}"
  else
  deploy_at "$1" "$DEPLOY" || die "the production deploy from ${1:0:7} failed: $DEPLOY_WHY. #$PR IS MERGED and $GREEN (a 7403 is a missing CLOUDFLARE_ACCOUNT_ID, not permissions)."
  if [ -n "$SMOKE" ]; then smoke_check "$SMOKE" || die "#$PR deployed to production from ${1:0:7} but the smoke check failed. Not recorded; read the deploy output."; fi
  [ -z "$E2E_WF" ] || record_production "$1" "$2"
  fi
  say "LANDED — #$PR is merged, $GREEN, ${STAGING:+staging and }production run ${1:0:7}."
}
for step in $PLAN; do
  case "$step" in
    staging)
      say "     staging <- ${MSHA:0:7}"
      deploy_at "$MSHA" "$STAGING" || die "the STAGING deploy from ${MSHA:0:7} failed: $DEPLOY_WHY. #$PR IS MERGED and $GREEN; production untouched."
      ;;
    production)
      if [ -z "$SMALL_NOTE" ]; then
        ship_production "$MSHA" "land #$PR from ${MSHA:0:7}"
      else
        # A SMALL CHANGE SHIPS ON THE FAST CHECK (owner, 2 Oct 2026; header). The reason is printed
        # here and recorded on the production deployment. A repo promote run already in flight (a
        # green e2e someone dispatched) is waited for first, never deployed on top of.
        say "     SMALL CHANGE — $SMALL_NOTE (last $E2E_WF verdict on main: ${LAST%%$'\t'*}). To prove it with the suite instead: land $PR --run-e2e"
        promote_wait_inflight
        if [ "$(production_sha)" = "$MSHA" ]; then say "LANDED — #$PR is merged, $GREEN, and the repo's own $PROMOTE_WF already shipped ${MSHA:0:7} to production."
        else ship_production "$MSHA" "land #$PR, $SMALL_NOTE"; fi
      fi
      ;;
    blocked)
      # KNOWN RED BLOCKS A SMALL CHANGE (header). Unread is not "not red": a different stop, exit 75.
      if [ -z "$LAST" ] && { [ -z "$E2E_CONC" ] || [ "$E2E_CONC" = cancelled ] || [ "$E2E_CONC" = skipped ]; }; then
        printf '\n\033[31mSTOPPED: could not verify (%s) — the %s history on main could not be read, so "the suite is not known red" is unproven: %s. #%s IS MERGED%s; production untouched. Land again when GitHub answers: land %s\033[0m\n' \
          "$(gh_kind "$(gh_err)")" "$E2E_WF" "$(gh_err)" "$PR" "${STAGING:+, staging runs ${MSHA:0:7}}" "$PR"
          unanswered_parts "GitHub (the $E2E_WF history)"
        exit "$LAND_RC_UNVERIFIED"
      fi
      IFS=$'\t' read -r LCONC LRID LSHA <<<"$LAST"
      case "$E2E_CONC" in ""|cancelled|skipped) : ;; *) LCONC="$E2E_CONC"; LRID=""; LSHA="$MSHA" ;; esac
      die "NAMED STOP [E2E_KNOWN_RED] $E2E_WF is known red on main: ${LRID:+run $LRID }on ${LSHA:0:7} ended $LCONC and no green run is newer. #$PR is small ($((PR_ADD + PR_DEL)) lines, $PR_FILES files) and would have shipped on the fast check, but a known-red suite is never shipped past. ${STAGING:+Staging runs ${MSHA:0:7}; }production untouched. Fix main, then: land $PR --run-e2e${LRID:+   (the red run: gh run view $LRID)}"
      ;;
    suite)
      # A LARGE CHANGE RUNS THE SUITE NOW (owner, 2 Oct 2026; header). The e2e workflows are
      # dispatch-only, so after a merge nothing runs them unless this does. Measured, never guessed:
      # the reason is printed here and recorded on the production deployment.
      say "     LARGE CHANGE — $REASON: running $E2E_WF on main before production"
      git fetch -q origin main 2>/dev/null || true
      HEADSHA="$(git rev-parse origin/main 2>/dev/null)"; [ -n "$HEADSHA" ] || HEADSHA="$MSHA"
      [ "$HEADSHA" = "$MSHA" ] || echo "     main has moved on to ${HEADSHA:0:7} since #$PR merged — the suite proves that head, which contains #$PR"
      RID=""; CONC=""
      run_e2e_on_main "$HEADSHA" || true
      case "$CONC" in
        could-not-dispatch) die "NAMED STOP [E2E_NOT_DISPATCHED] could not dispatch $E2E_WF on main for #$PR ($REASON). ${STAGING:+Staging runs ${MSHA:0:7}; }production untouched. Run it: land --promote $NAME --run-e2e" ;;
        no-run-appeared) die "NAMED STOP [E2E_NOT_DISPATCHED] dispatched $E2E_WF on main for #$PR ($REASON) but no run appeared in 2 minutes. ${STAGING:+Staging runs ${MSHA:0:7}; }production untouched. Check: gh run list --workflow $E2E_WF" ;;
        success) : ;;
        *) die "NAMED STOP [E2E_RED_AFTER_LARGE_CHANGE] $E2E_WF run $RID on main ${HEADSHA:0:7} ended $CONC ($(ran_kind "$CONC")) after #$PR ($REASON). ${STAGING:+Staging runs ${MSHA:0:7}; }production untouched. Fix main first: gh run view $RID" ;;
      esac
      # That success is exactly what the repo's own promote workflow (if any) fires on: wait for it,
      # then read production — it has usually just shipped this very sha.
      promote_wait_inflight "$HEADSHA"
      PROD="$(production_sha)"
      if [ "$PROD" = "$HEADSHA" ]; then say "LANDED — #$PR is merged, $E2E_WF is green on ${HEADSHA:0:7} ($REASON), and the repo's own $PROMOTE_WF shipped it to production."
      else ship_production "$HEADSHA" "land #$PR, large change ($REASON), $E2E_WF green on ${HEADSHA:0:7}"; fi
      ;;
  esac
done
exit 0
