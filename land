  authority-backlink-network) DEPLOY="" ; SELF="deploys itself through Cloudflare Pages on push to main (3 projects)" ;;
  # No wrangler config; Pages project p-n-p builds from Git; deploy-distribution.yml does IndexNow/GSC.
